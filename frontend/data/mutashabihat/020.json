جَعَلَ","لَكُمُ","ٱلۡأَرۡضَ","مَهۡدًا","وَسَلَكَ","لَكُمۡ","فِيهَا","سُبُلاً","وَأَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَأَخۡرَجۡنَا","بِهِۦٓ","أَزۡوٰجًا","مِّن","نَّبَاتٍ","شَتَّىٰ"],"20:54":["كُلُواۡ","وَٱرۡعَوۡاۡ","أَنۡعَـٰمَكُمۡ‌ۗ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّأُوۡلِى","ٱلنُّهَىٰ"],"20:55":["۞مِنۡهَا","خَلَقۡنَـٰكُمۡ","وَفِيهَا","نُعِيدُكُمۡ","وَمِنۡهَا","نُخۡرِجُكُمۡ","تَارَةً","أُخۡرَىٰ"],"20:65":["قَالُواۡ","يَـٰمُوسَىٰٓ","إِمَّآ","أَن","تُلۡقِىَ","وَإِمَّآ","أَن","نَّكُونَ","أَوَّلَ","مَنۡ","أَلۡقَىٰ"],"20:66":["قَالَ","بَلۡ","أَلۡقُواۡ‌ۖ","فَإِذَا","حِبَالُهُمۡ","وَعِصِيُّهُمۡ","يُخَيَّلُ","إِلَيۡهِ","مِن","سِحۡرِهِمۡ","أَنَّهَا","تَسۡعَىٰ"],"20:70":["فَأُلۡقِىَ","ٱلسَّحَرَةُ","سُجَّدًا","قَالُوٓاۡ","ءَامَنَّا","بِرَبِّ","هَـٰرُونَ","وَمُوسَىٰ"],"20:71":["قَالَ","ءَامَنتُمۡ","لَهُۥ","قَبۡلَ","أَنۡ","ءَاذَنَ","لَكُمۡ‌ۖ","إِنَّهُۥ","لَكَبِيرُكُمُ","ٱلَّذِى","عَلَّمَكُمُ","ٱلسِّحۡرَ‌ۖ","فَلَأُقَطِّعَنَّ","أَيۡدِيَكُمۡ","وَأَرۡجُلَكُم","مِّنۡ","خِلَـٰفٍ","وَلَأُصَلِّبَنَّكُمۡ","فِى","جُذُوعِ","ٱلنَّخۡلِ","وَلَتَعۡلَمُنَّ","أَيُّنَآ","أَشَدُّ","عَذَابًا","وَأَبۡقَىٰ"],"20:77":["وَلَقَدۡ","أَوۡحَيۡنَآ","إِلَىٰ","مُوسَىٰٓ","أَنۡ","أَسۡرِ","بِعِبَادِى","فَٱضۡرِبۡ","لَهُمۡ","طَرِيقًا","فِى","ٱلۡبَحۡرِ","يَبَسًا","لَّا","تَخَـٰفُ","دَرَكًا","وَلَا","تَخۡشَىٰ"],"20:86":["فَرَجَعَ","مُوسَىٰٓ","إِلَىٰ","قَوۡمِهِۦ","غَضۡبَـٰنَ","أَسِفًا‌ۚ","قَالَ","يَـٰقَوۡمِ","أَلَمۡ","يَعِدۡكُمۡ","رَبُّكُمۡ","وَعۡدًا","حَسَنًا‌ۚ","أَفَطَالَ","عَلَيۡكُمُ","ٱلۡعَهۡدُ","أَمۡ","أَرَدتُّمۡ","أَن","يَحِلَّ","عَلَيۡكُمۡ","غَضَبٌ","مِّن","رَّبِّكُمۡ","فَأَخۡلَفۡتُم","مَّوۡعِدِى"],"20:89":["أَفَلَا","يَرَوۡنَ","أَلَّا","يَرۡجِعُ","إِلَيۡهِمۡ","قَوۡلاً","وَلَا","يَمۡلِكُ","لَهُمۡ","ضَرًّا","وَلَا","نَفۡعًا"],"20:102":["يَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ‌ۚ","وَنَحۡشُرُ","ٱلۡمُجۡرِمِينَ","يَوۡمَئِذٍ","زُرۡقًا"],"20:109":["يَوۡمَئِذٍ","لَّا","تَنفَعُ","ٱلشَّفَـٰعَةُ","إِلَّا","مَنۡ","أَذِنَ","لَهُ","ٱلرَّحۡمَـٰنُ","وَرَضِىَ","لَهُۥ","قَوۡلاً"],"20:114":["فَتَعَـٰلَى","ٱللَّهُ","ٱلۡمَلِكُ","ٱلۡحَقُّ‌ۗ","وَلَا","تَعۡجَلۡ","بِٱلۡقُرۡءَانِ","مِن","قَبۡلِ","أَن","يُقۡضَىٰٓ","إِلَيۡكَ","وَحۡيُهُۥ‌ۖ","وَقُل","رَّبِّ","زِدۡنِى","عِلۡمًا"],"20:116":["وَإِذۡ","قُلۡنَا","لِلۡمَلَـٰٓئِكَةِ","ٱسۡجُدُواۡ","لِأَدَمَ","فَسَجَدُوٓاۡ","إِلَّآ","إِبۡلِيسَ","أَبَىٰ"],"20:123":["قَالَ","ٱهۡبِطَا","مِنۡهَا","جَمِيعَۢا‌ۖ","بَعۡضُكُمۡ","لِبَعۡضٍ","عَدُوٌّ‌ۖ","فَإِمَّا","يَأۡتِيَنَّكُم","مِّنِّى","هُدًى","فَمَنِ","ٱتَّبَعَ","هُدَاىَ","فَلَا","يَضِلُّ","وَلَا","يَشۡقَىٰ"],"20:128":["أَفَلَمۡ","يَهۡدِ","لَهُمۡ","كَمۡ","أَهۡلَكۡنَا","قَبۡلَهُم","مِّنَ","ٱلۡقُرُونِ","يَمۡشُونَ","فِى","مَسَـٰكِنِهِمۡ‌ۗ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّأُوۡلِى","ٱلنُّهَىٰ"],"20:129":["وَلَوۡلَا","كَلِمَةٌ","سَبَقَتۡ","مِن","رَّبِّكَ","لَكَانَ","لِزَامًا","وَأَجَلٌ","مُّسَمًّى"],"20:130":["فَٱصۡبِرۡ","عَلَىٰ","مَا","يَقُولُونَ","وَسَبِّحۡ","بِحَمۡدِ","رَبِّكَ","قَبۡلَ","طُلُوعِ","ٱلشَّمۡسِ","وَقَبۡلَ","غُرُوبِهَا‌ۖ","وَمِنۡ","ءَانَآىِٕ","ٱلَّيۡلِ","فَسَبِّحۡ","وَأَطۡرَافَ","ٱلنَّهَارِ","لَعَلَّكَ","تَرۡضَىٰ"],"20:131":["وَلَا","تَمُدَّنَّ","عَيۡنَيۡكَ","إِلَىٰ","مَا","مَتَّعۡنَا","بِهِۦٓ","أَزۡوٰجًا","مِّنۡهُمۡ","زَهۡرَةَ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","لِنَفۡتِنَهُمۡ","فِيهِ‌ۚ","وَرِزۡقُ","رَبِّكَ","خَيۡرٌ","وَأَبۡقَىٰ"],"20:134":["وَلَوۡ","أَنَّآ","أَهۡلَكۡنَـٰهُم","بِعَذَابٍ","مِّن","قَبۡلِهِۦ","لَقَالُواۡ","رَبَّنَا","لَوۡلَآ","أَرۡسَلۡتَ","إِلَيۡنَا","رَسُولاً","فَنَتَّبِعَ","ءَايَـٰتِكَ","مِن","قَبۡلِ","أَن","نَّذِلَّ","وَنَخۡزَىٰ"],"21:66":["قَالَ","أَفَتَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُكُمۡ","شَيۡــًٔا","وَلَا","يَضُرُّكُمۡ"],"23:116":["فَتَعَـٰلَى","ٱللَّهُ","ٱلۡمَلِكُ","ٱلۡحَقُّ‌ۖ","لَآ","إِلَـٰهَ","إِلَّا","هُوَ","رَبُّ","ٱلۡعَرۡشِ","ٱلۡكَرِيمِ"],"25:3":["وَٱتَّخَذُواۡ","مِن","دُونِهِۦٓ","ءَالِهَةً","لَّا","يَخۡلُقُونَ","شَيۡــًٔا","وَهُمۡ","يُخۡلَقُونَ","وَلَا","يَمۡلِكُونَ","لِأَنفُسِهِمۡ","ضَرًّا","وَلَا","نَفۡعًا","وَلَا","يَمۡلِكُونَ","مَوۡتًا","وَلَا","حَيَوٰةً","وَلَا","نُشُورًا"],"25:55":["وَيَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُهُمۡ","وَلَا","يَضُرُّهُمۡ‌ۗ","وَكَانَ","ٱلۡكَافِرُ","عَلَىٰ","رَبِّهِۦ","ظَهِيرًا"],"26:16":["فَأۡتِيَا","فِرۡعَوۡنَ","فَقُولَآ","إِنَّا","رَسُولُ","رَبِّ","ٱلۡعَـٰلَمِينَ"],"26:44":["فَأَلۡقَوۡاۡ","حِبَالَهُمۡ","وَعِصِيَّهُمۡ","وَقَالُواۡ","بِعِزَّةِ","فِرۡعَوۡنَ","إِنَّا","لَنَحۡنُ","ٱلۡغَـٰلِبُونَ"],"26:46":["فَأُلۡقِىَ","ٱلسَّحَرَةُ","سَـٰجِدِينَ"],"26:47":["قَالُوٓاۡ","ءَامَنَّا","بِرَبِّ","ٱلۡعَـٰلَمِينَ"],"26:48":["رَبِّ","مُوسَىٰ","وَهَـٰرُونَ"],"26:49":["قَالَ","ءَامَنتُمۡ","لَهُۥ","قَبۡلَ","أَنۡ","ءَاذَنَ","لَكُمۡ‌ۖ","إِنَّهُۥ","لَكَبِيرُكُمُ","ٱلَّذِى","عَلَّمَكُمُ","ٱلسِّحۡرَ","فَلَسَوۡفَ","تَعۡلَمُونَ‌ۚ","لَأُقَطِّعَنَّ","أَيۡدِيَكُمۡ","وَأَرۡجُلَكُم","مِّنۡ","خِلَـٰفٍ","وَلَأُصَلِّبَنَّكُمۡ","أَجۡمَعِينَ"],"26:52":["۞وَأَوۡحَيۡنَآ","إِلَىٰ","مُوسَىٰٓ","أَنۡ","أَسۡرِ","بِعِبَادِىٓ","إِنَّكُم","مُّتَّبَعُونَ"],"27:7":["إِذۡ","قَالَ","مُوسَىٰ","لِأَهۡلِهِۦٓ","إِنِّىٓ","ءَانَسۡتُ","نَارًا","سَـَٔـاتِيكُم","مِّنۡهَا","بِخَبَرٍ","أَوۡ","ءَاتِيكُم","بِشِهَابٍ","قَبَسٍ","لَّعَلَّكُمۡ","تَصۡطَلُونَ"],"27:87":["وَيَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ","فَفَزِعَ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","إِلَّا","مَن","شَآءَ","ٱللَّهُ‌ۚ","وَكُلٌّ","أَتَوۡهُ","دٰخِرِينَ"],"28:12":["۞وَحَرَّمۡنَا","عَلَيۡهِ","ٱلۡمَرَاضِعَ","مِن","قَبۡلُ","فَقَالَتۡ","هَلۡ","أَدُلُّكُمۡ","عَلَىٰٓ","أَهۡلِ","بَيۡتٍ","يَكۡفُلُونَهُۥ","لَكُمۡ","وَهُمۡ","لَهُۥ","نَـٰصِحُونَ"],"28:13":["فَرَدَدۡنَـٰهُ","إِلَىٰٓ","أُمِّهِۦ","كَىۡ","تَقَرَّ","عَيۡنُهَا","وَلَا","تَحۡزَنَ","وَلِتَعۡلَمَ","أَنَّ","وَعۡدَ","ٱللَّهِ","حَقٌّ","وَلَـٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"28:29":["۞فَلَمَّا","قَضَىٰ","مُوسَى","ٱلۡأَجَلَ","وَسَارَ","بِأَهۡلِهِۦٓ","ءَانَسَ","مِن","جَانِبِ","ٱلطُّورِ","نَارًا","قَالَ","لِأَهۡلِهِ","ٱمۡكُثُوٓاۡ","إِنِّىٓ","ءَانَسۡتُ","نَارًا","لَّعَلِّىٓ","ءَاتِيكُم","مِّنۡهَا","بِخَبَرٍ","أَوۡ","جَذۡوَةٍ","مِّنَ","ٱلنَّارِ","لَعَلَّكُمۡ","تَصۡطَلُونَ"],"28:32":["ٱسۡلُكۡ","يَدَكَ","فِى","جَيۡبِكَ","تَخۡرُجۡ","بَيۡضَآءَ","مِنۡ","غَيۡرِ","سُوٓءٍ","وَٱضۡمُمۡ","إِلَيۡكَ","جَنَاحَكَ","مِنَ","ٱلرَّهۡبِ‌ۖ","فَذٰنِكَ","بُرۡهَـٰنَانِ","مِن","رَّبِّكَ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦٓ‌ۚ","إِنَّهُمۡ","كَانُواۡ","قَوۡمًا","فَـٰسِقِينَ"],"28:47":["وَلَوۡلَآ","أَن","تُصِيبَهُم","مُّصِيبَةُۢ","بِمَا","قَدَّمَتۡ","أَيۡدِيهِمۡ","فَيَقُولُواۡ","رَبَّنَا","لَوۡلَآ","أَرۡسَلۡتَ","إِلَيۡنَا","رَسُولاً","فَنَتَّبِعَ","ءَايَـٰتِكَ","وَنَكُونَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"28:87":["وَلَا","يَصُدُّنَّكَ","عَنۡ","ءَايَـٰتِ","ٱللَّهِ","بَعۡدَ","إِذۡ","أُنزِلَتۡ","إِلَيۡكَ‌ۖ","وَٱدۡعُ","إِلَىٰ","رَبِّكَ‌ۖ","وَلَا","تَكُونَنَّ","مِنَ","ٱلۡمُشۡرِكِينَ"],"32:26":["أَوَلَمۡ","يَهۡدِ","لَهُمۡ","كَمۡ","أَهۡلَكۡنَا","مِن","قَبۡلِهِم","مِّنَ","ٱلۡقُرُونِ","يَمۡشُونَ","فِى","مَسَـٰكِنِهِمۡ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ‌ۖ","أَفَلَا","يَسۡمَعُونَ"],"34:23":["وَلَا","تَنفَعُ","ٱلشَّفَـٰعَةُ","عِندَهُۥٓ","إِلَّا","لِمَنۡ","أَذِنَ","لَهُۚۥ","حَتَّىٰٓ","إِذَا","فُزِّعَ","عَن","قُلُوبِهِمۡ","قَالُواۡ","مَاذَا","قَالَ","رَبُّكُمۡۖ","قَالُواۡ","ٱلۡحَقَّۖ","وَهُوَ","ٱلۡعَلِىُّ","ٱلۡكَبِيرُ"],"34:42":["فَٱلۡيَوۡمَ","لَا","يَمۡلِكُ","بَعۡضُكُمۡ","لِبَعۡضٍ","نَّفۡعًا","وَلَا","ضَرًّا","وَنَقُولُ","لِلَّذِينَ","ظَلَمُواۡ","ذُوقُواۡ","عَذَابَ","ٱلنَّارِ","ٱلَّتِى","كُنتُم","بِهَا","تُكَذِّبُونَ"],"36:31":["أَلَمۡ","يَرَوۡاۡ","كَمۡ","أَهۡلَكۡنَا","قَبۡلَهُم","مِّنَ","ٱلۡقُرُونِ","أَنَّهُمۡ","إِلَيۡهِمۡ","لَا","يَرۡجِعُونَ"],"38:3":["كَمۡ","أَهۡلَكۡنَا","مِن","قَبۡلِهِم","مِّن","قَرۡنٍ","فَنَادَواۡ","وَّلَاتَ","حِينَ","مَنَاصٍ"],"38:74":["إِلَّآ","إِبۡلِيسَ","ٱسۡتَكۡبَرَ","وَكَانَ","مِنَ","ٱلۡكَـٰفِرِينَ"],"43:10":["ٱلَّذِى","جَعَلَ","لَكُمُ","ٱلۡأَرۡضَ","مَهۡدًا","وَجَعَلَ","لَكُمۡ","فِيهَا","سُبُلاً","لَّعَلَّكُمۡ","تَهۡتَدُونَ"],"50:39":["فَٱصۡبِرۡ","عَلَىٰ","مَا","يَقُولُونَ","وَسَبِّحۡ","بِحَمۡدِ","رَبِّكَ","قَبۡلَ","طُلُوعِ","ٱلشَّمۡسِ","وَقَبۡلَ","ٱلۡغُرُوبِ"],"78:18":["يَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ","فَتَأۡتُونَ","أَفۡوَاجًا"],"79:15":["هَلۡ","أَتَـٰكَ","حَدِيثُ","مُوسَىٰٓ"],"79:16":["إِذۡ","نَادَٮٰهُ","رَبُّهُۥ","بِٱلۡوَادِ","ٱلۡمُقَدَّسِ","طُوًى"],"79:17":["ٱذۡهَبۡ","إِلَىٰ","فِرۡعَوۡنَ","إِنَّهُۥ","طَغَىٰ"],"79:18":["فَقُلۡ","هَل","لَّكَ","إِلَىٰٓ","أَن","تَزَكَّىٰ"]}}