عَلَيۡهِمۡ","ءَايَـٰتُنَا","قَالُواۡ","قَدۡ","سَمِعۡنَا","لَوۡ","نَشَآءُ","لَقُلۡنَا","مِثۡلَ","هَـٰذَآ‌ۙ","إِنۡ","هَـٰذَآ","إِلَّآ","أَسَـٰطِيرُ","ٱلۡأَوَّلِينَ"],"8:39":["وَقَـٰتِلُوهُمۡ","حَتَّىٰ","لَا","تَكُونَ","فِتۡنَةٌ","وَيَكُونَ","ٱلدِّينُ","كُلُّهُۥ","لِلَّهِ‌ۚ","فَإِنِ","ٱنتَهَوۡاۡ","فَإِنَّ","ٱللَّهَ","بِمَا","يَعۡمَلُونَ","بَصِيرٌ"],"8:40":["وَإِن","تَوَلَّوۡاۡ","فَٱعۡلَمُوٓاۡ","أَنَّ","ٱللَّهَ","مَوۡلَـٰكُمۡ‌ۚ","نِعۡمَ","ٱلۡمَوۡلَىٰ","وَنِعۡمَ","ٱلنَّصِيرُ"],"8:45":["يَـٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاۡ","إِذَا","لَقِيتُمۡ","فِئَةً","فَٱثۡبُتُواۡ","وَٱذۡكُرُواۡ","ٱللَّهَ","كَثِيرًا","لَّعَلَّكُمۡ","تُفۡلِحُونَ"],"8:49":["إِذۡ","يَقُولُ","ٱلۡمُنَـٰفِقُونَ","وَٱلَّذِينَ","فِى","قُلُوبِهِم","مَّرَضٌ","غَرَّ","هَـٰٓؤُلَآءِ","دِينُهُمۡ‌ۗ","وَمَن","يَتَوَكَّلۡ","عَلَى","ٱللَّهِ","فَإِنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٌ"],"8:52":["كَدَأۡبِ","ءَالِ","فِرۡعَوۡنَ‌ۙ","وَٱلَّذِينَ","مِن","قَبۡلِهِمۡ‌ۚ","كَفَرُواۡ","بِـَٔـايَـٰتِ","ٱللَّهِ","فَأَخَذَهُمُ","ٱللَّهُ","بِذُنُوبِهِمۡ‌ۗ","إِنَّ","ٱللَّهَ","قَوِىٌّ","شَدِيدُ","ٱلۡعِقَابِ"],"8:53":["ذٰلِكَ","بِأَنَّ","ٱللَّهَ","لَمۡ","يَكُ","مُغَيِّرًا","نِّعۡمَةً","أَنۡعَمَهَا","عَلَىٰ","قَوۡمٍ","حَتَّىٰ","يُغَيِّرُواۡ","مَا","بِأَنفُسِهِمۡ‌ۙ","وَأَنَّ","ٱللَّهَ","سَمِيعٌ","عَلِيمٌ"],"8:54":["كَدَأۡبِ","ءَالِ","فِرۡعَوۡنَ‌ۙ","وَٱلَّذِينَ","مِن","قَبۡلِهِمۡ‌ۚ","كَذَّبُواۡ","بِـَٔـايَـٰتِ","رَبِّهِمۡ","فَأَهۡلَكۡنَـٰهُم","بِذُنُوبِهِمۡ","وَأَغۡرَقۡنَآ","ءَالَ","فِرۡعَوۡنَ‌ۚ","وَكُلٌّ","كَانُواۡ","ظَـٰلِمِينَ"],"8:55":["إِنَّ","شَرَّ","ٱلدَّوَآبِّ","عِندَ","ٱللَّهِ","ٱلَّذِينَ","كَفَرُواۡ","فَهُمۡ","لَا","يُؤۡمِنُونَ"],"8:62":["وَإِن","يُرِيدُوٓاۡ","أَن","يَخۡدَعُوكَ","فَإِنَّ","حَسۡبَكَ","ٱللَّهُ‌ۚ","هُوَ","ٱلَّذِىٓ","أَيَّدَكَ","بِنَصۡرِهِۦ","وَبِٱلۡمُؤۡمِنِينَ"],"8:69":["فَكُلُواۡ","مِمَّا","غَنِمۡتُمۡ","حَلَـٰلاً","طَيِّبًا‌ۚ","وَٱتَّقُواۡ","ٱللَّهَ‌ۚ","إِنَّ","ٱللَّهَ","غَفُورٌ","رَّحِيمٌ"],"8:71":["وَإِن","يُرِيدُواۡ","خِيَانَتَكَ","فَقَدۡ","خَانُواۡ","ٱللَّهَ","مِن","قَبۡلُ","فَأَمۡكَنَ","مِنۡهُمۡ‌ۗ","وَٱللَّ