"ٱلظَّنَّ","وَإِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"10:67":["هُوَ","ٱلَّذِى","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","لِتَسۡكُنُواۡ","فِيهِ","وَٱلنَّهَارَ","مُبۡصِرًا‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يَسۡمَعُونَ"],"10:75":["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِم","مُّوسَىٰ","وَهَـٰرُونَ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦ","بِـَٔـايَـٰتِنَا","فَٱسۡتَكۡبَرُواۡ","وَكَانُواۡ","قَوۡمًا","مُّجۡرِمِينَ"],"10:104":["قُلۡ","يَـٰٓأَيُّهَا","ٱلنَّاسُ","إِن","كُنتُمۡ","فِى","شَكٍّ","مِّن","دِينِى","فَلَآ","أَعۡبُدُ","ٱلَّذِينَ","تَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","وَلَـٰكِنۡ","أَعۡبُدُ","ٱللَّهَ","ٱلَّذِى","يَتَوَفَّـٰكُمۡ‌ۖ","وَأُمِرۡتُ","أَنۡ","أَكُونَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"15:60":["إِلَّا","ٱمۡرَأَتَهُۥ","قَدَّرۡنَآ‌ۙ","إِنَّهَا","لَمِنَ","ٱلۡغَـٰبِرِينَ"],"16:36":["وَلَقَدۡ","بَعَثۡنَا","فِى","كُلِّ","أُمَّةٍ","رَّسُولاً","أَنِ","ٱعۡبُدُواۡ","ٱللَّهَ","وَٱجۡتَنِبُواۡ","ٱلطَّـٰغُوتَ‌ۖ","فَمِنۡهُم","مَّنۡ","هَدَى","ٱللَّهُ","وَمِنۡهُم","مَّنۡ","حَقَّتۡ","عَلَيۡهِ","ٱلضَّلَـٰلَةُ‌ۚ","فَسِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُكَذِّبِينَ"],"16:127":["وَٱصۡبِرۡ","وَمَا","صَبۡرُكَ","إِلَّا","بِٱللَّهِ‌ۚ","وَلَا","تَحۡزَنۡ","عَلَيۡهِمۡ","وَلَا","تَكُ","فِى","ضَيۡقٍ","مِّمَّا","يَمۡكُرُونَ"],"16:128":["إِنَّ","ٱللَّهَ","مَعَ","ٱلَّذِينَ","ٱتَّقَواۡ","وَّٱلَّذِينَ","هُم","مُّحۡسِنُونَ"],"17:49":["وَقَالُوٓاۡ","أَءِذَا","كُنَّا","عِظَـٰمًا","وَرُفَـٰتًا","أَءِنَّا","لَمَبۡعُوثُونَ","خَلۡقًا","جَدِيدًا"],"17:50":["۞قُلۡ","كُونُواۡ","حِجَارَةً","أَوۡ","حَدِيدًا"],"17:98":["ذٰلِكَ","جَزَآؤُهُم","بِأَنَّهُمۡ","كَفَرُواۡ","بِـَٔـايَـٰتِنَا","وَقَالُوٓاۡ","أَءِذَا","كُنَّا","عِظَـٰمًا","وَرُفَـٰتًا","أَءِنَّا","لَمَبۡعُوثُونَ","خَلۡقًا","جَدِيدًا"],"17:99":["۞أَوَلَمۡ","يَرَوۡاۡ","أَنَّ","ٱللَّهَ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","قَادِرٌ","عَلَىٰٓ","أَن","يَخۡلُقَ","مِثۡلَهُمۡ","وَجَعَلَ","لَهُمۡ","أَجَلاً","لَّا","رَيۡبَ","فِيهِ","فَأَبَى","ٱلظَّـٰلِمُونَ","إِلَّا","كُفُورًا"],"20:10":["إِذۡ","رَءَا","نَارًا","فَقَالَ","لِأَهۡلِهِ","ٱمۡكُثُوٓاۡ","إِنِّىٓ","ءَانَسۡتُ","نَارًا","لَّعَلِّىٓ","ءَاتِيكُم","مِّنۡهَا","بِقَبَسٍ","أَوۡ","أَجِدُ","عَلَى","ٱلنَّارِ","هُدًى"],"20:102":["يَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ‌ۚ","وَنَحۡشُرُ","ٱلۡمُجۡرِمِينَ","يَوۡمَئِذٍ","زُرۡقًا"],"21:38":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"21:39":["لَوۡ","يَعۡلَمُ","ٱلَّذِينَ","كَفَرُواۡ","حِينَ","لَا","يَكُفُّونَ","عَن","وُجُوهِهِمُ","ٱلنَّارَ","وَلَا","عَن","ظُهُورِهِمۡ","وَلَا","هُمۡ","يُنصَرُونَ"],"22:18":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يَسۡجُدُ","لَهُۥ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","وَٱلشَّمۡسُ","وَٱلۡقَمَرُ","وَٱلنُّجُومُ","وَٱلۡجِبَالُ","وَٱلشَّجَرُ","وَٱلدَّوَآبُّ","وَكَثِيرٌ","مِّنَ","ٱلنَّاسِ‌ۖ","وَكَثِيرٌ","حَقَّ","عَلَيۡهِ","ٱلۡعَذَابُ‌ۗ","وَمَن","يُهِنِ","ٱللَّهُ","فَمَا","لَهُۥ","مِن","مُّكۡرِمٍ‌ۚ","إِنَّ","ٱللَّهَ","يَفۡعَلُ","مَا","يَشَآءُ"],"23:82":["قَالُوٓاۡ","أَءِذَا","مِتۡنَا","وَكُنَّا","تُرَابًا","وَعِظَـٰمًا","أَءِنَّا","لَمَبۡعُوثُونَ"],"23:83":["لَقَدۡ","وُعِدۡنَا","نَحۡنُ","وَءَابَآؤُنَا","هَـٰذَا","مِن","قَبۡلُ","إِنۡ","هَـٰذَآ","إِلَّآ","أَسَـٰطِيرُ","ٱلۡأَوَّلِينَ"],"23:84":["قُل","لِّمَنِ","ٱلۡأَرۡضُ","وَمَن","فِيهَآ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"25:48":["وَهُوَ","ٱلَّذِىٓ","أَرۡسَلَ","ٱلرِّيَـٰحَ","بُشۡرَۢا","بَيۡنَ","يَدَىۡ","رَحۡمَتِهِۦ‌ۚ","وَأَنزَلۡنَا","مِنَ","ٱلسَّمَآءِ","مَآءً","طَهُورًا"],"26:119":["فَأَنجَيۡنَـٰهُ","وَمَن","مَّعَهُۥ","فِى","ٱلۡفُلۡكِ","ٱلۡمَشۡحُونِ"],"26:173":["وَأَمۡطَرۡنَا","عَلَيۡهِم","مَّطَرًا‌ۖ","فَسَآءَ","مَطَرُ","ٱلۡمُنذَرِينَ"],"26:174":["إِنَّ","فِى","ذٰلِكَ","لَأَيَةً‌ۖ","وَمَا","كَانَ","أَكۡثَرُهُم","مُّؤۡمِنِينَ"],"27:3":["ٱلَّذِينَ","يُقِيمُونَ","ٱلصَّلَوٰةَ","وَيُؤۡتُونَ","ٱلزَّكَوٰةَ","وَهُم","بِٱلۡأَخِرَةِ","هُمۡ","يُوقِنُونَ"],"27:7":["إِذۡ","قَالَ","مُوسَىٰ","لِأَهۡلِهِۦٓ","إِنِّىٓ","ءَانَسۡتُ","نَارًا","سَـَٔـاتِيكُم","مِّنۡهَا","بِخَبَرٍ","أَوۡ","ءَاتِيكُم","بِشِهَابٍ","قَبَسٍ","لَّعَلَّكُمۡ","تَصۡطَلُونَ"],"27:8":["فَلَمَّا","جَآءَهَا","نُودِىَ","أَنۢ","بُورِكَ","مَن","فِى","ٱلنَّارِ","وَمَنۡ","حَوۡلَهَا","وَسُبۡحَـٰنَ","ٱللَّهِ","رَبِّ","ٱلۡعَـٰلَمِينَ"],"27:10":["وَأَلۡقِ","عَصَاكَ‌ۚ","فَلَمَّا","رَءَاهَا","تَهۡتَزُّ","كَأَنَّهَا","جَآنٌّ","وَلَّىٰ","مُدۡبِرًا","وَلَمۡ","يُعَقِّبۡ‌ۚ","يَـٰمُوسَىٰ","لَا","تَخَفۡ","إِنِّى","لَا","يَخَافُ","لَدَىَّ","ٱلۡمُرۡسَلُونَ"],"27:12":["وَأَدۡخِلۡ","يَدَكَ","فِى","جَيۡبِكَ","تَخۡرُجۡ","بَيۡضَآءَ","مِنۡ","غَيۡرِ","سُوٓءٍ‌ۖ","فِى","تِسۡعِ","ءَايَـٰتٍ","إِلَىٰ","فِرۡعَوۡنَ","وَقَوۡمِهِۦٓ‌ۚ","إِنَّهُمۡ","كَانُواۡ","قَوۡمًا","فَـٰسِقِينَ"],"27:14":["وَجَحَدُواۡ","بِهَا","وَٱسۡتَيۡقَنَتۡهَآ","أَنفُسُهُمۡ","ظُلۡمًا","وَعُلُوًّا‌ۚ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُفۡسِدِينَ"],"27:15":["وَلَقَدۡ","ءَاتَيۡنَا","دَاوُۥدَ","وَسُلَيۡمَـٰنَ","عِلۡمًا‌ۖ","وَقَالَا","ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِى","فَضَّلَنَا","عَلَىٰ","كَثِيرٍ","مِّنۡ","عِبَادِهِ","ٱلۡمُؤۡمِنِينَ"],"27:17":["وَحُشِرَ","لِسُلَيۡمَـٰنَ","جُنُودُهُۥ","مِنَ","ٱلۡجِنِّ","وَٱلۡإِنسِ","وَٱلطَّيۡرِ","فَهُمۡ","يُوزَعُونَ"],"27:18":["حَتَّىٰٓ","إِذَآ","أَتَوۡاۡ","عَلَىٰ","وَادِ","ٱلنَّمۡلِ","قَالَتۡ","نَمۡلَةٌ","يَـٰٓأَيُّهَا","ٱلنَّمۡلُ","ٱدۡخُلُواۡ","مَسَـٰكِنَكُمۡ","لَا","يَحۡطِمَنَّكُمۡ","سُلَيۡمَـٰنُ","وَجُنُودُهُۥ","وَهُمۡ","لَا","يَشۡعُرُونَ"],"27:19":["فَتَبَسَّمَ","ضَاحِكًا","مِّن","قَوۡلِهَا","وَقَالَ","رَبِّ","أَوۡزِعۡنِىٓ","أَنۡ","أَشۡكُرَ","نِعۡمَتَكَ","ٱلَّتِىٓ","أَنۡعَمۡتَ","عَلَىَّ","وَعَلَىٰ","وٰلِدَىَّ","وَأَنۡ","أَعۡمَلَ","صَـٰلِحًا","تَرۡضَـٰهُ","وَأَدۡخِلۡنِى","بِرَحۡمَتِكَ","فِى","عِبَادِكَ","ٱلصَّـٰلِحِينَ"],"27:24":["وَجَدتُّهَا","وَقَوۡمَهَا","يَسۡجُدُونَ","لِلشَّمۡسِ","مِن","دُونِ","ٱللَّهِ","وَزَيَّنَ","لَهُمُ","ٱلشَّيۡطَـٰنُ","أَعۡمَـٰلَهُمۡ","فَصَدَّهُمۡ","عَنِ","ٱلسَّبِيلِ","فَهُمۡ","لَا","يَهۡتَدُونَ"],"27:40":["قَالَ","ٱلَّذِى","عِندَهُۥ","عِلۡمٌ","مِّنَ","ٱلۡكِتَـٰبِ","أَنَاۡ","ءَاتِيكَ","بِهِۦ","قَبۡلَ","أَن","يَرۡتَدَّ","إِلَيۡكَ","طَرۡفُكَ‌ۚ","فَلَمَّا","رَءَاهُ","مُسۡتَقِرًّا","عِندَهُۥ","قَالَ","هَـٰذَا","مِن","فَضۡلِ","رَبِّى","لِيَبۡلُوَنِىٓ","ءَأَشۡكُرُ","أَمۡ","أَكۡفُرُ‌ۖ","وَمَن","شَكَرَ","فَإِنَّمَا","يَشۡكُرُ","لِنَفۡسِهِۦ‌ۖ","وَمَن","كَفَرَ","فَإِنَّ","رَبِّى","غَنِىٌّ","كَرِيمٌ"],"27:53":["وَأَنجَيۡنَا","ٱلَّذِينَ","ءَامَنُواۡ","وَكَانُواۡ","يَتَّقُونَ"],"27:54":["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","أَتَأۡتُونَ","ٱلۡفَـٰحِشَةَ","وَأَنتُمۡ","تُبۡصِرُونَ"],"27:55":["أَئِنَّكُمۡ","لَتَأۡتُونَ","ٱلرِّجَالَ","شَهۡوَةً","مِّن","دُونِ","ٱلنِّسَآءِ‌ۚ","بَلۡ","أَنتُمۡ","قَوۡمٌ","تَجۡهَلُونَ"],"27:56":["۞فَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُوٓاۡ","أَخۡرِجُوٓاۡ","ءَالَ","لُوطٍ","مِّن","قَرۡيَتِكُمۡ‌ۖ","إِنَّهُمۡ","أُنَاسٌ","يَتَطَهَّرُونَ"],"27:57":["فَأَنجَيۡنَـٰهُ","وَأَهۡلَهُۥٓ","إِلَّا","ٱمۡرَأَتَهُۥ","قَدَّرۡنَـٰهَا","مِنَ","ٱلۡغَـٰبِرِينَ"],"27:58":["وَأَمۡطَرۡنَا","عَلَيۡهِم","مَّطَرًا‌ۖ","فَسَآءَ","مَطَرُ","ٱلۡمُنذَرِينَ"],"27:59":["قُلِ","ٱلۡحَمۡدُ","لِلَّهِ","وَسَلَـٰمٌ","عَلَىٰ","عِبَادِهِ","ٱلَّذِينَ","ٱصۡطَفَىٰٓ‌ۗ","ءَآللَّهُ","خَيۡرٌ","أَمَّا","يُشۡرِكُونَ"],"27:63":["أَمَّن","يَهۡدِيكُمۡ","فِى","ظُلُمَـٰتِ","ٱلۡبَرِّ","وَٱلۡبَحۡرِ","وَمَن","يُرۡسِلُ","ٱلرِّيَـٰحَ","بُشۡرَۢا","بَيۡنَ","يَدَىۡ","رَحۡمَتِهِۦٓ‌ۗ","أَءِلَـٰهٌ","مَّعَ","ٱللَّهِ‌ۚ","تَعَـٰلَى","ٱللَّهُ","عَمَّا","يُشۡرِكُونَ"],"27:67":["وَقَالَ","ٱلَّذِينَ","كَفَرُوٓاۡ","أَءِذَا","كُنَّا","تُرٰبًا","وَءَابَآؤُنَآ","أَئِنَّا","لَمُخۡرَجُونَ"],"27:68":["لَقَدۡ","وُعِدۡنَا","هَـٰذَا","نَحۡنُ","وَءَابَآؤُنَا","مِن","قَبۡلُ","إِنۡ","هَـٰذَآ","إِلَّآ","أَسَـٰطِيرُ","ٱلۡأَوَّلِينَ"],"27:69":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُجۡرِمِينَ"],"27:70":["وَلَا","تَحۡزَنۡ","عَلَيۡهِمۡ","وَلَا","تَكُن","فِى","ضَيۡقٍ","مِّمَّا","يَمۡكُرُونَ"],"27:71":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"27:72":["قُلۡ","عَسَىٰٓ","أَن","يَكُونَ","رَدِفَ","لَكُم","بَعۡضُ","ٱلَّذِى","تَسۡتَعۡجِلُونَ"],"27:73":["وَإِنَّ","رَبَّكَ","لَذُو","فَضۡلٍ","عَلَى","ٱلنَّاسِ","وَلَـٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَشۡكُرُونَ"],"27:74":["وَإِنَّ","رَبَّكَ","لَيَعۡلَمُ","مَا","تُكِنُّ","صُدُورُهُمۡ","وَمَا","يُعۡلِنُونَ"],"27:75":["وَمَا","مِنۡ","غَآئِبَةٍ","فِى","ٱلسَّمَآءِ","وَٱلۡأَرۡضِ","إِلَّا","فِى","كِتَـٰبٍ","مُّبِينٍ"],"27:80":["إِنَّكَ","لَا","تُسۡمِعُ","ٱلۡمَوۡتَىٰ","وَلَا","تُسۡمِعُ","ٱلصُّمَّ","ٱلدُّعَآءَ","إِذَا","وَلَّوۡاۡ","مُدۡبِرِينَ"],"27:81":["وَمَآ","أَنتَ","بِهَـٰدِى","ٱلۡعُمۡىِ","عَن","ضَلَـٰلَتِهِمۡ‌ۖ","إِن","تُسۡمِعُ","إِلَّا","مَن","يُؤۡمِنُ","بِـَٔـايَـٰتِنَا","فَهُم","مُّسۡلِمُونَ"],"27:82":["۞وَإِذَا","وَقَعَ","ٱلۡقَوۡلُ","عَلَيۡهِمۡ","أَخۡرَجۡنَا","لَهُمۡ","دَآبَّةً","مِّنَ","ٱلۡأَرۡضِ","تُكَلِّمُهُمۡ","أَنَّ","ٱلنَّاسَ","كَانُواۡ","بِـَٔـايَـٰتِنَا","لَا","يُوقِنُونَ"],"27:83":["وَيَوۡمَ","نَحۡشُرُ","مِن","كُلِّ","أُمَّةٍ","فَوۡجًا","مِّمَّن","يُكَذِّبُ","بِـَٔـايَـٰتِنَا","فَهُمۡ","يُوزَعُونَ"],"27:84":["حَتَّىٰٓ","إِذَا","جَآءُو","قَالَ","أَكَذَّبۡتُم","بِـَٔـايَـٰتِى","وَلَمۡ","تُحِيطُواۡ","بِهَا","عِلۡمًا","أَمَّاذَا","كُنتُمۡ","تَعۡمَلُونَ"],"27:86":["أَلَمۡ","يَرَوۡاۡ","أَنَّا","جَعَلۡنَا","ٱلَّيۡلَ","لِيَسۡكُنُواۡ","فِيهِ","وَٱلنَّهَارَ","مُبۡصِرًا‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"27:87":["وَيَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ","فَفَزِعَ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","إِلَّا","مَن","شَآءَ","ٱللَّهُ‌ۚ","وَكُلٌّ","أَتَوۡهُ","دٰخِرِينَ"],"27:89":["مَن","جَآءَ","بِٱلۡحَسَنَةِ","فَلَهُۥ","خَيۡرٌ","مِّنۡهَا","وَهُم","مِّن","فَزَعٍ","يَوۡمَئِذٍ","ءَامِنُونَ"],"27:90":["وَمَن","جَآءَ","بِٱلسَّيِّئَةِ","فَكُبَّتۡ","وُجُوهُهُمۡ","فِى","ٱلنَّارِ","هَلۡ","تُجۡزَوۡنَ","إِلَّا","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"27:91":["إِنَّمَآ","أُمِرۡتُ","أَنۡ","أَعۡبُدَ","رَبَّ","هَـٰذِهِ","ٱلۡبَلۡدَةِ","ٱلَّذِى","حَرَّمَهَا","وَلَهُۥ","كُلُّ","شَىۡءٍ‌ۖ","وَأُمِرۡتُ","أَنۡ","أَكُونَ","مِنَ","ٱلۡمُسۡلِمِينَ"],"28:29":["۞فَلَمَّا","قَضَىٰ","مُوسَى","ٱلۡأَجَلَ","وَسَارَ","بِأَهۡلِهِۦٓ","ءَانَسَ","مِن","جَانِبِ","ٱلطُّورِ","نَارًا","قَالَ","لِأَهۡلِهِ","ٱمۡكُثُوٓاۡ","إِنِّىٓ","ءَانَسۡتُ","نَارًا","لَّعَلِّىٓ","ءَاتِيكُم","مِّنۡهَا","بِخَبَرٍ","أَوۡ","جَذۡوَةٍ","مِّنَ","ٱلنَّارِ","لَعَلَّكُمۡ","تَصۡطَلُونَ"],"28:30":["فَلَمَّآ","أَتَـٰهَا","نُودِىَ","مِن","شَـٰطِىِٕ","ٱلۡوَادِ","ٱلۡأَيۡمَنِ","فِى","ٱلۡبُقۡعَةِ","ٱلۡمُبَـٰرَكَةِ","مِنَ","ٱلشَّجَرَةِ","أَن","يَـٰمُوسَىٰٓ","إِنِّىٓ","أَنَا","ٱللَّهُ","رَبُّ","ٱلۡعَـٰلَمِينَ"],"28:31":["وَأَنۡ","أَلۡقِ","عَصَاكَ‌ۖ","فَلَمَّا","رَءَاهَا","تَهۡتَزُّ","كَأَنَّهَا","جَآنٌّ","وَلَّىٰ","مُدۡبِرًا","وَلَمۡ","يُعَقِّبۡ‌ۚ","يَـٰمُوسَىٰٓ","أَقۡبِلۡ","وَلَا","تَخَفۡ‌ۖ","إِنَّكَ","مِنَ","ٱلۡأَمِنِينَ"],"28:32":["ٱسۡلُكۡ","يَدَكَ","فِى","جَيۡبِكَ","تَخۡرُجۡ","بَيۡضَآءَ","مِنۡ","غَيۡرِ","سُوٓءٍ","وَٱضۡمُمۡ","إِلَيۡكَ","جَنَاحَكَ","مِنَ","ٱلرَّهۡبِ‌ۖ","فَذٰنِكَ","بُرۡهَـٰنَانِ","مِن","رَّبِّكَ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦٓ‌ۚ","إِنَّهُمۡ","كَانُواۡ","قَوۡمًا","فَـٰسِقِينَ"],"28:69":["وَرَبُّكَ","يَعۡلَمُ","مَا","تُكِنُّ","صُدُورُهُمۡ","وَمَا","يُعۡلِنُونَ"],"28:70":["وَهُوَ","ٱللَّهُ","لَآ","إِلَـٰهَ","إِلَّا","هُوَ‌ۖ","لَهُ","ٱلۡحَمۡدُ","فِى","ٱلۡأُولَىٰ","وَٱلۡأَخِرَةِ‌ۖ","وَلَهُ","ٱلۡحُكۡمُ","وَإِلَيۡهِ","تُرۡجَعُونَ"],"28:73":["وَمِن","رَّحۡمَتِهِۦ","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","وَٱلنَّهَارَ","لِتَسۡكُنُواۡ","فِيهِ","وَلِتَبۡتَغُواۡ","مِن","فَضۡلِهِۦ","وَلَعَلَّكُمۡ","تَشۡكُرُونَ"],"28:84":["مَن","جَآءَ","بِٱلۡحَسَنَةِ","فَلَهُۥ","خَيۡرٌ","مِّنۡهَا‌ۖ","وَمَن","جَآءَ","بِٱلسَّيِّئَةِ","فَلَا","يُجۡزَى","ٱلَّذِينَ","عَمِلُواۡ","ٱلسَّيِّـَٔـاتِ","إِلَّا","مَا","كَانُواۡ","يَعۡمَلُونَ"],"29:15":["فَأَنجَيۡنَـٰهُ","وَأَصۡحَـٰبَ","ٱلسَّفِينَةِ","وَجَعَلۡنَـٰهَآ","ءَايَةً","لِّلۡعَـٰلَمِينَ"],"29:20":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","بَدَأَ","ٱلۡخَلۡقَ‌ۚ","ثُمَّ","ٱللَّهُ","يُنشِئُ","ٱلنَّشۡأَةَ","ٱلۡأَخِرَةَ‌ۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَىۡءٍ","قَدِيرٌ"],"29:24":["فَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُواۡ","ٱقۡتُلُوهُ","أَوۡ","حَرِّقُوهُ","فَأَنجَـٰهُ","ٱللَّهُ","مِنَ","ٱلنَّارِ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"29:28":["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","إِنَّكُمۡ","لَتَأۡتُونَ","ٱلۡفَـٰحِشَةَ","مَ