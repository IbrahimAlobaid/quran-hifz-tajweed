ۡسَلۡنَا","رُسُلاً","مِّن","قَبۡلِكَ","مِنۡهُم","مَّن","قَصَصۡنَا","عَلَيۡكَ","وَمِنۡهُم","مَّن","لَّمۡ","نَقۡصُصۡ","عَلَيۡكَۗ","وَمَا","كَانَ","لِرَسُولٍ","أَن","يَأۡتِىَ","بِـَٔـايَةٍ","إِلَّا","بِإِذۡنِ","ٱللَّهِۚ","فَإِذَا","جَآءَ","أَمۡرُ","ٱللَّهِ","قُضِىَ","بِٱلۡحَقِّ","وَخَسِرَ","هُنَالِكَ","ٱلۡمُبۡطِلُونَ"],"40:82":["أَفَلَمۡ","يَسِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَيَنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡۚ","كَانُوٓاۡ","أَكۡثَرَ","مِنۡهُمۡ","وَأَشَدَّ","قُوَّةً","وَءَاثَارًا","فِى","ٱلۡأَرۡضِ","فَمَآ","أَغۡنَىٰ","عَنۡهُم","مَّا","كَانُواۡ","يَكۡسِبُونَ"],"41:50":["وَلَئِنۡ","أَذَقۡنَـٰهُ","رَحۡمَةً","مِّنَّا","مِنۢ","بَعۡدِ","ضَرَّآءَ","مَسَّتۡهُ","لَيَقُولَنَّ","هَـٰذَا","لِى","وَمَآ","أَظُنُّ","ٱلسَّاعَةَ","قَآئِمَةً","وَلَئِن","رُّجِعۡتُ","إِلَىٰ","رَبِّىٓ","إِنَّ","لِى","عِندَهُۥ","لَلۡحُسۡنَىٰ‌ۚ","فَلَنُنَبِّئَنَّ","ٱلَّذِينَ","كَفَرُواۡ","بِمَا","عَمِلُواۡ","وَلَنُذِيقَنَّهُم","مِّنۡ","عَذَابٍ","غَلِيظٍ"],"42:12":["لَهُۥ","مَقَالِيدُ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ‌ۖ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّهُۥ","بِكُلِّ","شَىۡءٍ","عَلِيمٌ"],"42:29":["وَمِنۡ","ءَايَـٰتِهِۦ","خَلۡقُ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَثَّ","فِيهِمَا","مِن","دَآبَّةٍ‌ۚ","وَهُوَ","عَلَىٰ","جَمۡعِهِمۡ","إِذَا","يَشَآءُ","قَدِيرٌ"],"42:48":["فَإِنۡ","أَعۡرَضُواۡ","فَمَآ","أَرۡسَلۡنَـٰكَ","عَلَيۡهِمۡ","حَفِيظًا‌ۖ","إِنۡ","عَلَيۡكَ","إِلَّا","ٱلۡبَلَـٰغُ‌ۗ","وَإِنَّآ","إِذَآ","أَذَقۡنَا","ٱلۡإِنسَـٰنَ","مِنَّا","رَحۡمَةً","فَرِحَ","بِهَا‌ۖ","وَإِن","تُصِبۡهُمۡ","سَيِّئَةُۢ","بِمَا","قَدَّمَتۡ","أَيۡدِيهِمۡ","فَإِنَّ","ٱلۡإِنسَـٰنَ","كَفُورٌ"],"45:27":["وَلِلَّهِ","مُلۡكُ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ‌ۚ","وَيَوۡمَ","تَقُومُ","ٱلسَّاعَةُ","يَوۡمَئِذٍ","يَخۡسَرُ","ٱلۡمُبۡطِلُونَ"]}}