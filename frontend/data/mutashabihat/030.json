","فِطۡرَتَ","ٱللَّهِ","ٱلَّتِى","فَطَرَ","ٱلنَّاسَ","عَلَيۡهَا‌ۚ","لَا","تَبۡدِيلَ","لِخَلۡقِ","ٱللَّهِ‌ۚ","ذٰلِكَ","ٱلدِّينُ","ٱلۡقَيِّمُ","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"30:32":["مِنَ","ٱلَّذِينَ","فَرَّقُواۡ","دِينَهُمۡ","وَكَانُواۡ","شِيَعًا‌ۖ","كُلُّ","حِزۡبِۭ","بِمَا","لَدَيۡهِمۡ","فَرِحُونَ"],"30:33":["وَإِذَا","مَسَّ","ٱلنَّاسَ","ضُرٌّ","دَعَوۡاۡ","رَبَّهُم","مُّنِيبِينَ","إِلَيۡهِ","ثُمَّ","إِذَآ","أَذَاقَهُم","مِّنۡهُ","رَحۡمَةً","إِذَا","فَرِيقٌ","مِّنۡهُم","بِرَبِّهِمۡ","يُشۡرِكُونَ"],"30:34":["لِيَكۡفُرُواۡ","بِمَآ","ءَاتَيۡنَـٰهُمۡ‌ۚ","فَتَمَتَّعُواۡ","فَسَوۡفَ","تَعۡلَمُونَ"],"30:36":["وَإِذَآ","أَذَقۡنَا","ٱلنَّاسَ","رَحۡمَةً","فَرِحُواۡ","بِهَا‌ۖ","وَإِن","تُصِبۡهُمۡ","سَيِّئَةُۢ","بِمَا","قَدَّمَتۡ","أَيۡدِيهِمۡ","إِذَا","هُمۡ","يَقۡنَطُونَ"],"30:37":["أَوَلَمۡ","يَرَوۡاۡ","أَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"30:42":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلُ‌ۚ","كَانَ","أَكۡثَرُهُم","مُّشۡرِكِينَ"],"30:44":["مَن","كَفَرَ","فَعَلَيۡهِ","كُفۡرُهُۥ‌ۖ","وَمَنۡ","عَمِلَ","صَـٰلِحًا","فَلِأَنفُسِهِمۡ","يَمۡهَدُونَ"],"30:47":["وَلَقَدۡ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","رُسُلاً","إِلَىٰ","قَوۡمِهِمۡ","فَجَآءُوهُم","بِٱلۡبَيِّنَـٰتِ","فَٱنتَقَمۡنَا","مِنَ","ٱلَّذِينَ","أَجۡرَمُواۡ‌ۖ","وَكَانَ","حَقًّا","عَلَيۡنَا","نَصۡرُ","ٱلۡمُؤۡمِنِينَ"],"30:48":["ٱللَّهُ","ٱلَّذِى","يُرۡسِلُ","ٱلرِّيَـٰحَ","فَتُثِيرُ","سَحَابًا","فَيَبۡسُطُهُۥ","فِى","ٱلسَّمَآءِ","كَيۡفَ","يَشَآءُ","وَيَجۡعَلُهُۥ","كِسَفًا","فَتَرَى","ٱلۡوَدۡقَ","يَخۡرُجُ","مِنۡ","خِلَـٰلِهِۦ‌ۖ","فَإِذَآ","أَصَابَ","بِهِۦ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦٓ","إِذَا","هُمۡ","يَسۡتَبۡشِرُونَ"],"30:52":["فَإِنَّكَ","لَا","تُسۡمِعُ","ٱلۡمَوۡتَىٰ","وَلَا","تُسۡمِعُ","ٱلصُّمَّ","ٱلدُّعَآءَ","إِذَا","وَلَّوۡاۡ","مُدۡبِرِينَ"],"30:53":["وَمَآ","أَنتَ","بِهَـٰدِ","ٱلۡعُمۡىِ","عَن","ضَلَـٰلَتِهِمۡ‌ۖ","إِن","تُسۡمِ