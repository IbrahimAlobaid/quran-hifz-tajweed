ٓءَ","بِعِجۡلٍ","حَنِيذٍ"],"11:77":["وَلَمَّا","جَآءَتۡ","رُسُلُنَا","لُوطًا","سِىٓءَ","بِهِمۡ","وَضَاقَ","بِهِمۡ","ذَرۡعًا","وَقَالَ","هَـٰذَا","يَوۡمٌ","عَصِيبٌ"],"11:84":["۞وَإِلَىٰ","مَدۡيَنَ","أَخَاهُمۡ","شُعَيۡبًا‌ۚ","قَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥ‌ۖ","وَلَا","تَنقُصُواۡ","ٱلۡمِكۡيَالَ","وَٱلۡمِيزَانَ‌ۚ","إِنِّىٓ","أَرَٮٰكُم","بِخَيۡرٍ","وَإِنِّىٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","مُّحِيطٍ"],"13:7":["وَيَقُولُ","ٱلَّذِينَ","كَفَرُواۡ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَةٌ","مِّن","رَّبِّهِۦٓ‌ۗ","إِنَّمَآ","أَنتَ","مُنذِرٌ‌ۖ","وَلِكُلِّ","قَوۡمٍ","هَادٍ"],"13:26":["ٱللَّهُ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","وَفَرِحُواۡ","بِٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","فِى","ٱلۡأَخِرَةِ","إِلَّا","مَتَـٰعٌ"],"13:27":["وَيَقُولُ","ٱلَّذِينَ","كَفَرُواۡ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَةٌ","مِّن","رَّبِّهِۦ‌ۗ","قُلۡ","إِنَّ","ٱللَّهَ","يُضِلُّ","مَن","يَشَآءُ","وَيَهۡدِىٓ","إِلَيۡهِ","مَنۡ","أَنَابَ"],"13:43":["وَيَقُولُ","ٱلَّذِينَ","كَفَرُواۡ","لَسۡتَ","مُرۡسَلاً‌ۚ","قُلۡ","كَفَىٰ","بِٱللَّهِ","شَهِيدَۢا","بَيۡنِى","وَبَيۡنَكُمۡ","وَمَنۡ","عِندَهُۥ","عِلۡمُ","ٱلۡكِتَـٰبِ"],"16:36":["وَلَقَدۡ","بَعَثۡنَا","فِى","كُلِّ","أُمَّةٍ","رَّسُولاً","أَنِ","ٱعۡبُدُواۡ","ٱللَّهَ","وَٱجۡتَنِبُواۡ","ٱلطَّـٰغُوتَ‌ۖ","فَمِنۡهُم","مَّنۡ","هَدَى","ٱللَّهُ","وَمِنۡهُم","مَّنۡ","حَقَّتۡ","عَلَيۡهِ","ٱلضَّلَـٰلَةُ‌ۚ","فَسِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُكَذِّبِينَ"],"16:42":["ٱلَّذِينَ","صَبَرُواۡ","وَعَلَىٰ","رَبِّهِمۡ","يَتَوَكَّلُونَ"],"16:43":["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","إِلَّا","رِجَالاً","نُّوحِىٓ","إِلَيۡهِمۡ‌ۚ","فَسۡــَٔلُوٓاۡ","أَهۡلَ","ٱلذِّكۡرِ","إِن","كُنتُمۡ","لَا","تَعۡلَمُونَ"],"16:55":["لِيَكۡفُرُواۡ","بِمَآ","ءَاتَيۡنَـٰهُمۡ‌ۚ","فَتَمَتَّعُواۡ‌ۖ","فَسَوۡفَ","تَعۡلَمُونَ"],"16:56":["وَيَجۡعَلُونَ","لِمَا","لَا","يَعۡلَمُونَ","نَصِيبًا","مِّمَّا","رَزَقۡنَـٰهُمۡ‌ۗ","تَٱللَّهِ","لَتُسۡــَٔلُنَّ","عَمَّا","كُنتُمۡ","تَفۡتَرُونَ"],"16:65":["وَٱللَّهُ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَأَحۡيَا","بِهِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَآ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَةً","لِّقَوۡمٍ","يَسۡمَعُونَ"],"16:72":["وَٱللَّهُ","جَعَلَ","لَكُم","مِّنۡ","أَنفُسِكُمۡ","أَزۡوٰجًا","وَجَعَلَ","لَكُم","مِّنۡ","أَزۡوٰجِكُم","بَنِينَ","وَحَفَدَةً","وَرَزَقَكُم","مِّنَ","ٱلطَّيِّبَـٰتِ‌ۚ","أَفَبِٱلۡبَـٰطِلِ","يُؤۡمِنُونَ","وَبِنِعۡمَتِ","ٱللَّهِ","هُمۡ","يَكۡفُرُونَ"],"16:90":["۞إِنَّ","ٱللَّهَ","يَأۡمُرُ","بِٱلۡعَدۡلِ","وَٱلۡإِحۡسَـٰنِ","وَإِيتَآىِٕ","ذِى","ٱلۡقُرۡبَىٰ","وَيَنۡهَىٰ","عَنِ","ٱلۡفَحۡشَآءِ","وَٱلۡمُنكَرِ","وَٱلۡبَغۡىِ‌ۚ","يَعِظُكُمۡ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"16:96":["مَا","عِندَكُمۡ","يَنفَدُ‌ۖ","وَمَا","عِندَ","ٱللَّهِ","بَاقٍ‌ۗ","وَلَنَجۡزِيَنَّ","ٱلَّذِينَ","صَبَرُوٓاۡ","أَجۡرَهُم","بِأَحۡسَنِ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"16:97":["مَنۡ","عَمِلَ","صَـٰلِحًا","مِّن","ذَكَرٍ","أَوۡ","أُنثَىٰ","وَهُوَ","مُؤۡمِنٌ","فَلَنُحۡيِيَنَّهُۥ","حَيَوٰةً","طَيِّبَةً‌ۖ","وَلَنَجۡزِيَنَّهُمۡ","أَجۡرَهُم","بِأَحۡسَنِ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"17:30":["إِنَّ","رَبَّكَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّهُۥ","كَانَ","بِعِبَادِهِۦ","خَبِيرَۢا","بَصِيرًا"],"17:96":["قُلۡ","كَفَىٰ","بِٱللَّهِ","شَهِيدَۢا","بَيۡنِى","وَبَيۡنَكُمۡ‌ۚ","إِنَّهُۥ","كَانَ","بِعِبَادِهِۦ","خَبِيرَۢا","بَصِيرًا"],"19:73":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","قَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلَّذِينَ","ءَامَنُوٓاۡ","أَىُّ","ٱلۡفَرِيقَيۡنِ","خَيۡرٌ","مَّقَامًا","وَأَحۡسَنُ","نَدِيًّا"],"21:35":["كُلُّ","نَفۡسٍ","ذَآئِقَةُ","ٱلۡمَوۡتِ‌ۗ","وَنَبۡلُوكُم","بِٱلشَّرِّ","وَٱلۡخَيۡرِ","فِتۡنَةً‌ۖ","وَإِلَيۡنَا","تُرۡجَعُونَ"],"21:72":["وَوَهَبۡنَا","لَهُۥٓ","إِسۡحَـٰقَ","وَيَعۡقُوبَ","نَافِلَةً‌ۖ","وَكُلاًّ","جَعَلۡنَا","صَـٰلِحِينَ"],"22:42":["وَإِن","يُكَذِّبُوكَ","فَقَدۡ","كَذَّبَتۡ","قَبۡلَهُمۡ","قَوۡمُ","نُوحٍ","وَعَادٌ","وَثَمُودُ"],"25:38":["وَعَادًا","وَثَمُودَاۡ","وَأَصۡحَـٰبَ","ٱلرَّسِّ","وَقُرُونَۢا","بَيۡنَ","ذٰلِكَ","كَثِيرًا"],"26:119":["فَأَنجَيۡنَـٰهُ","وَمَن","مَّعَهُۥ","فِى","ٱلۡفُلۡكِ","ٱلۡمَشۡحُونِ"],"27:24":["وَجَدتُّهَا","وَقَوۡمَهَا","يَسۡجُدُونَ","لِلشَّمۡسِ","مِن","دُونِ","ٱللَّهِ","وَزَيَّنَ","لَهُمُ","ٱلشَّيۡطَـٰنُ","أَعۡمَـٰلَهُمۡ","فَصَدَّهُمۡ","عَنِ","ٱلسَّبِيلِ","فَهُمۡ","لَا","يَهۡتَدُونَ"],"27:54":["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","أَتَأۡتُونَ","ٱلۡفَـٰحِشَةَ","وَأَنتُمۡ","تُبۡصِرُونَ"],"27:55":["أَئِنَّكُمۡ","لَتَأۡتُونَ","ٱلرِّجَالَ","شَهۡوَةً","مِّن","دُونِ","ٱلنِّسَآءِ‌ۚ","بَلۡ","أَنتُمۡ","قَوۡمٌ","تَجۡهَلُونَ"],"27:56":["۞فَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُوٓاۡ","أَخۡرِجُوٓاۡ","ءَالَ","لُوطٍ","مِّن","قَرۡيَتِكُمۡ‌ۖ","إِنَّهُمۡ","أُنَاسٌ","يَتَطَهَّرُونَ"],"27:57":["فَأَنجَيۡنَـٰهُ","وَأَهۡلَهُۥٓ","إِلَّا","ٱمۡرَأَتَهُۥ","قَدَّرۡنَـٰهَا","مِنَ","ٱلۡغَـٰبِرِينَ"],"27:69":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُجۡرِمِينَ"],"28:82":["وَأَصۡبَحَ","ٱلَّذِينَ","تَمَنَّوۡاۡ","مَكَانَهُۥ","بِٱلۡأَمۡسِ","يَقُولُونَ","وَيۡكَأَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ‌ۖ","لَوۡلَآ","أَن","مَّنَّ","ٱللَّهُ","عَلَيۡنَا","لَخَسَفَ","بِنَا‌ۖ","وَيۡكَأَنَّهُۥ","لَا","يُفۡلِحُ","ٱلۡكَـٰفِرُونَ"],"29:4":["أَمۡ","حَسِبَ","ٱلَّذِينَ","يَعۡمَلُونَ","ٱلسَّيِّـَٔـاتِ","أَن","يَسۡبِقُونَا‌ۚ","سَآءَ","مَا","يَحۡكُمُونَ"],"29:7":["وَٱلَّذِينَ","ءَامَنُواۡ","وَعَمِلُواۡ","ٱلصَّـٰلِحَـٰتِ","لَنُكَفِّرَنَّ","عَنۡهُمۡ","سَيِّـَٔـاتِهِمۡ","وَلَنَجۡزِيَنَّهُمۡ","أَحۡسَنَ","ٱلَّذِى","كَانُواۡ","يَعۡمَلُونَ"],"29:8":["وَوَصَّيۡنَا","ٱلۡإِنسَـٰنَ","بِوٰلِدَيۡهِ","حُسۡنًا‌ۖ","وَإِن","جَـٰهَدَاكَ","لِتُشۡرِكَ","بِى","مَا","لَيۡسَ","لَكَ","بِهِۦ","عِلۡمٌ","فَلَا","تُطِعۡهُمَآ‌ۚ","إِلَىَّ","مَرۡجِعُكُمۡ","فَأُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"29:12":["وَقَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلَّذِينَ","ءَامَنُواۡ","ٱتَّبِعُواۡ","سَبِيلَنَا","وَلۡنَحۡمِلۡ","خَطَـٰيَـٰكُمۡ","وَمَا","هُم","بِحَـٰمِلِينَ","مِنۡ","خَطَـٰيَـٰهُم","مِّن","شَىۡءٍ‌ۖ","إِنَّهُمۡ","لَكَـٰذِبُونَ"],"29:15":["فَأَنجَيۡنَـٰهُ","وَأَصۡحَـٰبَ","ٱلسَّفِينَةِ","وَجَعَلۡنَـٰهَآ","ءَايَةً","لِّلۡعَـٰلَمِينَ"],"29:18":["وَإِن","تُكَذِّبُواۡ","فَقَدۡ","كَذَّبَ","أُمَمٌ","مِّن","قَبۡلِكُمۡ‌ۖ","وَمَا","عَلَى","ٱلرَّسُولِ","إِلَّا","ٱلۡبَلَـٰغُ","ٱلۡمُبِينُ"],"29:20":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","بَدَأَ","ٱلۡخَلۡقَ‌ۚ","ثُمَّ","ٱللَّهُ","يُنشِئُ","ٱلنَّشۡأَةَ","ٱلۡأَخِرَةَ‌ۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَىۡءٍ","قَدِيرٌ"],"29:24":["فَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُواۡ","ٱقۡتُلُوهُ","أَوۡ","حَرِّقُوهُ","فَأَنجَـٰهُ","ٱللَّهُ","مِنَ","ٱلنَّارِ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"29:27":["وَوَهَبۡنَا","لَهُۥٓ","إِسۡحَـٰقَ","وَيَعۡقُوبَ","وَجَعَلۡنَا","فِى","ذُرِّيَّتِهِ","ٱلنُّبُوَّةَ","وَٱلۡكِتَـٰبَ","وَءَاتَيۡنَـٰهُ","أَجۡرَهُۥ","فِى","ٱلدُّنۡيَا‌ۖ","وَإِنَّهُۥ","فِى","ٱلۡأَخِرَةِ","لَمِنَ","ٱلصَّـٰلِحِينَ"],"29:28":["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","إِنَّكُمۡ","لَتَأۡتُونَ","ٱلۡفَـٰحِشَةَ","مَا","سَبَقَكُم","بِهَا","مِنۡ","أَحَدٍ","مِّنَ","ٱلۡعَـٰلَمِينَ"],"29:29":["أَئِنَّكُمۡ","لَتَأۡتُونَ","ٱلرِّجَالَ","وَتَقۡطَعُونَ","ٱلسَّبِيلَ","وَتَأۡتُونَ","فِى","نَادِيكُمُ","ٱلۡمُنكَرَ‌ۖ","فَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُواۡ","ٱئۡتِنَا","بِعَذَابِ","ٱللَّهِ","إِن","كُنتَ","مِنَ","ٱلصَّـٰدِقِينَ"],"29:31":["وَلَمَّا","جَآءَتۡ","رُسُلُنَآ","إِبۡرٰهِيمَ","بِٱلۡبُشۡرَىٰ","قَالُوٓاۡ","إِنَّا","مُهۡلِكُوٓاۡ","أَهۡلِ","هَـٰذِهِ","ٱلۡقَرۡيَةِ‌ۖ","إِنَّ","أَهۡلَهَا","كَانُواۡ","ظَـٰلِمِينَ"],"29:33":["وَلَمَّآ","أَن","جَآءَتۡ","رُسُلُنَا","لُوطًا","سِىٓءَ","بِهِمۡ","وَضَاقَ","بِهِمۡ","ذَرۡعًا","وَقَالُواۡ","لَا","تَخَفۡ","وَلَا","تَحۡزَنۡ‌ۖ","إِنَّا","مُنَجُّوكَ","وَأَهۡلَكَ","إِلَّا","ٱمۡرَأَتَكَ","كَانَتۡ","مِنَ","ٱلۡغَـٰبِرِينَ"],"29:36":["وَإِلَىٰ","مَدۡيَنَ","أَخَاهُمۡ","شُعَيۡبًا","فَقَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","وَٱرۡجُواۡ","ٱلۡيَوۡمَ","ٱلۡأَخِرَ","وَلَا","تَعۡثَوۡاۡ","فِى","ٱلۡأَرۡضِ","مُفۡسِدِينَ"],"29:38":["وَعَادًا","وَثَمُودَاۡ","وَقَد","تَّبَيَّنَ","لَكُم","مِّن","مَّسَـٰكِنِهِمۡ‌ۖ","وَزَيَّنَ","لَهُمُ","ٱلشَّيۡطَـٰنُ","أَعۡمَـٰلَهُمۡ","فَصَدَّهُمۡ","عَنِ","ٱلسَّبِيلِ","وَكَانُواۡ","مُسۡتَبۡصِرِينَ"],"29:45":["ٱتۡلُ","مَآ","أُوحِىَ","إِلَيۡكَ","مِنَ","ٱلۡكِتَـٰبِ","وَأَقِمِ","ٱلصَّلَوٰةَ‌ۖ","إِنَّ","ٱلصَّلَوٰةَ","تَنۡهَىٰ","عَنِ","ٱلۡفَحۡشَآءِ","وَٱلۡمُنكَرِ‌ۗ","وَلَذِكۡرُ","ٱللَّهِ","أَكۡبَرُ‌ۗ","وَٱللَّهُ","يَعۡلَمُ","مَا","تَصۡنَعُونَ"],"29:47":["وَكَذٰلِكَ","أَنزَلۡنَآ","إِلَيۡكَ","ٱلۡكِتَـٰبَ‌ۚ","فَٱلَّذِينَ","ءَاتَيۡنَـٰهُمُ","ٱلۡكِتَـٰبَ","يُؤۡمِنُونَ","بِهِۦ‌ۖ","وَمِنۡ","هَـٰٓؤُلَآءِ","مَن","يُؤۡمِنُ","بِهِۦ‌ۚ","وَمَا","يَجۡحَدُ","بِـَٔـايَـٰتِنَآ","إِلَّا","ٱلۡكَـٰفِرُونَ"],"29:49":["بَلۡ","هُوَ","ءَايَـٰتُۢ","بَيِّنَـٰتٌ","فِى","صُدُورِ","ٱلَّذِينَ","أُوتُواۡ","ٱلۡعِلۡمَ‌ۚ","وَمَا","يَجۡحَدُ","بِـَٔـايَـٰتِنَآ","إِلَّا","ٱلظَّـٰلِمُونَ"],"29:50":["وَقَالُواۡ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَـٰتٌ","مِّن","رَّبِّهِۦ‌ۖ","قُلۡ","إِنَّمَا","ٱلۡأَيَـٰتُ","عِندَ","ٱللَّهِ","وَإِنَّمَآ","أَنَاۡ","نَذِيرٌ","مُّبِينٌ"],"29:52":["قُلۡ","كَفَىٰ","بِٱللَّهِ","بَيۡنِى","وَبَيۡنَكُمۡ","شَهِيدًا‌ۖ","يَعۡلَمُ","مَا","فِى","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ‌ۗ","وَٱلَّذِينَ","ءَامَنُواۡ","بِٱلۡبَـٰطِلِ","وَكَفَرُواۡ","بِٱللَّهِ","أُوۡلَـٰٓئِكَ","هُمُ","ٱلۡخَـٰسِرُونَ"],"29:54":["يَسۡتَعۡجِلُونَكَ","بِٱلۡعَذَابِ","وَإِنَّ","جَهَنَّمَ","لَمُحِيطَةُۢ","بِٱلۡكَـٰفِرِينَ"],"29:55":["يَوۡمَ","يَغۡشَـٰهُمُ","ٱلۡعَذَابُ","مِن","فَوۡقِهِمۡ","وَمِن","تَحۡتِ","أَرۡجُلِهِمۡ","وَيَقُولُ","ذُوقُواۡ","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"29:57":["كُلُّ","نَفۡسٍ","ذَآئِقَةُ","ٱلۡمَوۡتِ‌ۖ","ثُمَّ","إِلَيۡنَا","تُرۡجَعُونَ"],"29:58":["وَٱلَّذِينَ","ءَامَنُواۡ","وَعَمِلُواۡ","ٱلصَّـٰلِحَـٰتِ","لَنُبَوِّئَنَّهُم","مِّنَ","ٱلۡجَنَّةِ","غُرَفًا","تَجۡرِى","مِن","تَحۡتِهَا","ٱلۡأَنۡهَـٰرُ","خَـٰلِدِينَ","فِيهَا‌ۚ","نِعۡمَ","أَجۡرُ","ٱلۡعَـٰمِلِينَ"],"29:59":["ٱلَّذِينَ","صَبَرُواۡ","وَعَلَىٰ","رَبِّهِمۡ","يَتَوَكَّلُونَ"],"29:60":["وَكَأَيِّن","مِّن","دَآبَّةٍ","لَّا","تَحۡمِلُ","رِزۡقَهَا","ٱللَّهُ","يَرۡزُقُهَا","وَإِيَّاكُمۡ‌ۚ","وَهُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"29:61":["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَ","لَيَقُولُنَّ","ٱللَّهُ‌ۖ","فَأَنَّىٰ","يُؤۡفَكُونَ"],"29:62":["ٱللَّهُ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ","لَهُۥٓ‌ۚ","إِنَّ","ٱللَّهَ","بِكُلِّ","شَىۡءٍ","عَلِيمٌ"],"29:63":["وَلَئِن","سَأَلۡتَهُم","مَّن","نَّزَّلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَأَحۡيَا","بِهِ","ٱلۡأَرۡضَ","مِنۢ","بَعۡدِ","مَوۡتِهَا","لَيَقُولُنَّ","ٱللَّهُ‌ۚ","قُلِ","ٱلۡحَمۡدُ","لِلَّهِ‌ۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡقِلُونَ"],"29:64":["وَمَا","هَـٰذِهِ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَآ","إِلَّا","لَهۡوٌ","وَلَعِبٌ‌ۚ","وَإِنَّ","ٱلدَّارَ","ٱلۡأَخِرَةَ","لَهِىَ","ٱلۡحَيَوَانُ‌ۚ","لَوۡ","كَانُواۡ","يَعۡلَمُونَ"],"29:65":["فَإِذَا","رَكِبُواۡ","فِى","ٱلۡفُلۡكِ","دَعَوُاۡ","ٱللَّهَ","مُخۡلِصِينَ","لَهُ","ٱلدِّينَ","فَلَمَّا","نَجَّـٰهُمۡ","إِلَى","ٱلۡبَرِّ","إِذَا","هُمۡ","يُشۡرِكُونَ"],"29:66":["لِيَكۡفُرُواۡ","بِمَآ","ءَاتَيۡنَـٰهُمۡ","وَلِيَتَمَتَّعُواۡ‌ۖ","فَسَوۡفَ","يَعۡلَمُونَ"],"29:67":["أَوَلَمۡ","يَرَوۡاۡ","أَنَّا","جَعَلۡنَا","حَرَمًا","ءَامِنًا","وَيُتَخَطَّفُ","ٱلنَّاسُ","مِنۡ","حَوۡلِهِمۡ‌ۚ","أَفَبِٱلۡبَـٰطِلِ","يُؤۡمِنُونَ","وَبِنِعۡمَةِ","ٱللَّهِ","يَكۡفُرُونَ"],"29:68":["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","كَذَّبَ","بِٱلۡحَقِّ","لَمَّا","جَآءَهُۥٓ‌ۚ","أَلَيۡسَ","فِى","جَهَنَّمَ","مَثۡوًى","لِّلۡكَـٰفِرِينَ"],"29:69":["وَٱلَّذِينَ","جَـٰهَدُواۡ","فِينَا","لَنَهۡدِيَنَّهُمۡ","سُبُلَنَا‌ۚ","وَإِنَّ","ٱللَّهَ","لَمَعَ","ٱلۡمُحۡسِنِينَ"],"30:34":["لِيَكۡفُرُواۡ","بِمَآ","ءَاتَيۡنَـٰهُمۡ‌ۚ","فَتَمَتَّعُواۡ","فَسَوۡفَ","تَعۡلَمُونَ"],"30:35":["أَمۡ","أَنزَلۡنَا","عَلَيۡهِمۡ","سُلۡطَـٰنًا","فَهُوَ","يَتَكَلَّمُ","بِمَا","كَانُواۡ","بِهِۦ","يُشۡرِكُونَ"],"30:37":["أَوَلَمۡ","يَرَوۡاۡ","أَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"30:42":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلُ‌ۚ","كَانَ","أَكۡثَرُهُم","مُّشۡرِكِينَ"],"31:14":["وَوَصَّيۡنَا","ٱلۡإِنسَـٰنَ","بِوٰلِدَيۡهِ","حَمَلَتۡهُ","أُمُّهُۥ","وَهۡنًا","عَلَىٰ","وَهۡنٍ","وَفِصَـٰلُهُۥ","فِى","عَامَيۡنِ","أَنِ","ٱشۡكُرۡ","لِى","وَلِوٰلِدَيۡكَ","إِلَىَّ","ٱلۡمَصِيرُ"],"31:15":["وَإِن","جَـٰهَدَاكَ","عَلَىٰٓ","أَن","تُشۡرِكَ","بِى","مَا","لَيۡسَ","لَكَ","بِهِۦ","عِلۡمٌ","فَلَا","تُطِعۡهُمَا‌ۖ","وَصَاحِبۡهُمَا","فِى","ٱلدُّنۡيَا","مَعۡرُوفًا‌ۖ","وَٱتَّبِعۡ","سَبِيلَ","مَنۡ","أَنَابَ","إِلَىَّ‌ۚ","ثُمَّ","إِلَىَّ","مَرۡجِعُكُمۡ","فَأُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"31:25":["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","لَيَقُولُنَّ","ٱللَّهُ‌ۚ","قُلِ","ٱلۡحَمۡدُ","لِلَّهِ‌ۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡلَمُونَ"],"31:32":["وَإِذَا","غَشِيَهُم","مَّوۡجٌ","كَٱلظُّلَلِ","دَعَوُاۡ","ٱللَّهَ","مُخۡلِصِينَ","لَهُ","ٱلدِّينَ","فَلَمَّا","نَجَّـٰهُمۡ","إِلَى","ٱلۡبَرِّ","فَمِنۡهُم","مُّقۡتَصِدٌ‌ۚ","وَمَا","يَجۡحَدُ","بِـَٔـايَـٰتِنَآ","إِلَّا","كُلُّ","خَتَّارٍ","كَفُورٍ"],"34:36":["قُلۡ","إِنَّ","رَبِّى","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"34:39":["قُلۡ","إِنَّ","رَبِّى","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ","لَهُۥۚ","وَمَآ","أَنفَقۡتُم","مِّن","شَىۡءٍ","فَهُوَ","يُخۡلِفُهُۖۥ","وَهُوَ","خَيۡرُ","ٱلرّٰزِقِينَ"],"35:4":["وَإِن","يُكَذِّبُوكَ","فَقَدۡ","كُذِّبَتۡ","رُسُلٌ","مِّن","قَبۡلِكَۚ","وَإِلَى","ٱللَّهِ","تُرۡجَعُ","ٱلۡأُمُورُ"],"35:25":["وَإِن","يُكَذِّبُوكَ","فَقَدۡ","كَذَّبَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","جَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَـٰتِ","وَبِٱلزُّبُرِ","وَبِٱلۡكِتَـٰبِ","ٱلۡمُنِيرِ"],"36:47":["وَإِذَا","قِيلَ","لَهُمۡ","أَنفِقُواۡ","مِمَّا","رَزَقَكُمُ","ٱللَّهُ","قَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلَّذِينَ","ءَامَنُوٓاۡ","أَنُطۡعِمُ","مَن","لَّوۡ","يَشَآءُ","ٱللَّهُ","أَطۡعَمَهُۥٓ","إِنۡ","أَنتُمۡ","إِلَّا","فِى","ضَلَـٰلٍ","مُّبِينٍ"],"39:32":["۞فَمَنۡ","أَظۡلَمُ","مِمَّن","كَذَبَ","عَلَى","ٱللَّهِ","وَكَذَّبَ","بِٱلصِّدۡقِ","إِذۡ","جَآءَهُۥٓ‌ۚ","أَلَيۡسَ","فِى","جَهَنَّمَ","مَثۡوًى","لِّلۡكَـٰفِرِينَ"],"39:33":["وَٱلَّذِى","جَآءَ","بِٱلصِّدۡقِ","وَصَدَّقَ","بِهِۦٓ‌ۙ","أُوۡلَـٰٓئِكَ","هُمُ","ٱلۡمُتَّقُونَ"],"39:35":["لِيُكَفِّرَ","ٱللَّهُ","عَنۡهُمۡ","أَسۡوَأَ","ٱلَّذِى","عَمِلُواۡ","وَيَجۡزِيَهُمۡ","أَجۡرَهُم","بِأَحۡسَنِ","ٱلَّذِى","كَانُواۡ","يَعۡمَلُونَ"],"39:38":["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","لَيَقُولُنَّ","ٱللَّهُ‌ۚ","قُلۡ","أَفَرَءَيۡتُم","مَّا","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","إِنۡ","أَرَادَنِىَ","ٱللَّهُ","بِضُرٍّ","هَلۡ","هُنَّ","كَـٰشِفَـٰتُ","ضُرِّهِۦٓ","أَوۡ","أَرَادَنِى","بِرَحۡمَةٍ","هَلۡ","هُنَّ","مُمۡسِكَـٰتُ","رَحۡمَتِهِۦ‌ۚ","قُلۡ","حَسۡبِىَ","ٱللَّهُ‌ۖ","عَلَيۡهِ","يَتَوَكَّلُ","ٱلۡمُتَوَكِّلُونَ"],"39:52":["أَوَلَمۡ","يَعۡلَمُوٓاۡ","أَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"41:27":["فَلَنُذِيقَنَّ","ٱلَّذِينَ","كَفَرُواۡ","عَذَابًا","شَدِيدًا","وَلَنَجۡزِيَنَّهُمۡ","أَسۡوَأَ","ٱلَّذِى","كَانُواۡ","يَعۡمَلُونَ"],"42:12":["لَهُۥ","مَقَالِيدُ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ‌ۖ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّهُۥ","بِكُلِّ","شَىۡءٍ","عَلِيمٌ"],"43:9":["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","لَيَقُولُنَّ","خَلَقَهُنَّ","ٱلۡعَزِيزُ","ٱلۡعَلِيمُ"],"43:87":["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَهُمۡ","لَيَقُولُنَّ","ٱللَّهُ‌ۖ","فَأَنَّىٰ","يُؤۡفَكُونَ"],"45:5":["وَٱخۡتِلَـٰفِ","ٱلَّيۡلِ","وَٱلنَّهَارِ","وَمَآ","أَنزَلَ","ٱللَّهُ","مِنَ","ٱلسَّمَآءِ","مِن","رِّزۡقٍ","فَأَحۡيَا","بِهِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَا","وَتَصۡرِيفِ","ٱلرِّيَـٰحِ","ءَايَـٰتٌ","لِّقَوۡمٍ","يَعۡقِلُونَ"],"45:21":["أَمۡ","حَسِبَ","ٱلَّذِينَ","ٱجۡتَرَحُواۡ","ٱلسَّيِّـَٔـاتِ","أَن","نَّجۡعَلَهُمۡ","كَٱلَّذِينَ","ءَامَنُواۡ","وَعَمِلُواۡ","ٱلصَّـٰلِحَـٰتِ","سَوَآءً","مَّحۡيَاهُمۡ","وَمَمَاتُهُمۡ‌ۚ","سَآءَ","مَا","يَحۡكُمُونَ"],"46:11":["وَقَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلَّذِينَ","ءَامَنُواۡ","لَوۡ","كَانَ","خَيۡرًا","مَّا","سَبَقُونَآ","إِلَيۡهِ‌ۚ","وَإِذۡ","لَمۡ","يَهۡتَدُواۡ","بِهِۦ","فَسَيَقُولُونَ","هَـٰذَآ","إِفۡكٌ","قَدِيمٌ"],"46:15":["وَوَصَّيۡنَا","ٱلۡإِنسَـٰنَ","بِوٰلِدَيۡهِ","إِحۡسَـٰنًا‌ۖ","حَمَلَتۡهُ","أُمُّهُۥ","كُرۡهًا","وَوَضَعَتۡهُ","كُرۡهًا‌ۖ","وَحَمۡلُهُۥ","وَفِصَـٰلُهُۥ","ثَلَـٰثُونَ","شَهۡرًا‌ۚ","حَتَّىٰٓ","إِذَا","بَلَغَ","أَشُدَّهُۥ","وَبَلَغَ","أَرۡبَعِينَ","سَنَةً","قَالَ","رَبِّ","أَوۡزِعۡنِىٓ","أَنۡ","أَشۡكُرَ","نِعۡمَتَكَ","ٱلَّتِىٓ","أَنۡعَمۡتَ","عَلَىَّ","وَعَلَىٰ","وٰلِدَىَّ","وَأَنۡ","أَعۡمَلَ","صَـٰلِحًا","تَرۡضَـٰهُ","وَأَصۡلِحۡ","لِى","فِى","ذُرِّيَّتِىٓ‌ۖ","إِنِّى","تُبۡتُ","إِلَيۡكَ","وَإِنِّى","مِنَ","ٱلۡمُسۡلِمِينَ"],"47:29":["أَمۡ","حَسِبَ","ٱلَّذِينَ","فِى","قُلُوبِهِم","مَّرَضٌ","أَن","لَّن","يُخۡرِجَ","ٱللَّهُ","أَضۡغَـٰنَهُمۡ"],"47:36":["إِنَّمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","لَعِبٌ","وَلَهۡوٌ‌ۚ","وَإِن","تُؤۡمِنُواۡ","وَتَتَّقُواۡ","يُؤۡتِكُمۡ","أُجُورَكُمۡ","وَلَا","يَسۡــَٔلۡكُمۡ","أَمۡوٰلَكُمۡ"],"57:20":["ٱعۡلَمُوٓاۡ","أَنَّمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","لَعِبٌ","وَلَهۡوٌ","وَزِينَةٌ","وَتَفَاخُرُۢ","بَيۡنَكُمۡ","وَتَكَاثُرٌ","فِى","ٱلۡأَمۡوٰلِ","وَٱلۡأَوۡلَـٰدِ‌ۖ","كَمَثَلِ","غَيۡثٍ","أَعۡجَبَ","ٱلۡكُفَّارَ","نَبَاتُهُۥ","ثُمَّ","يَهِيجُ","فَتَرَٮٰهُ","مُصۡفَرًّا","ثُمَّ","يَكُونُ","حُطَـٰمًا‌ۖ","وَفِى","ٱلۡأَخِرَةِ","عَذَابٌ","شَدِيدٌ","وَمَغۡفِرَةٌ","مِّنَ","ٱللَّهِ","وَرِضۡوٰنٌ‌ۚ","وَمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَآ","إِلَّا","مَتَـٰعُ","ٱلۡغُرُورِ"],"57:26":["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحًا","وَإِبۡرٰهِيمَ","وَجَعَلۡنَا","فِى","ذُرِّيَّتِهِمَا","ٱلنُّبُوَّةَ","وَٱلۡكِتَـٰبَ‌ۖ","فَمِنۡهُم","مُّهۡتَدٍ‌ۖ","وَكَثِيرٌ","مِّنۡهُمۡ","فَـٰسِقُونَ"],"61:7":["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","وَهُوَ","يُدۡعَىٰٓ","إِلَى","ٱلۡإِسۡلَـٰمِ‌ۚ","وَٱللَّهُ","لَا","يَهۡدِى","ٱلۡقَوۡمَ","ٱلظَّـٰلِمِينَ"]}}