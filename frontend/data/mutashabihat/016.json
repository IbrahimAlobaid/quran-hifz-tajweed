:52":["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","مِن","رَّسُولٍ","وَلَا","نَبِىٍّ","إِلَّآ","إِذَا","تَمَنَّىٰٓ","أَلۡقَى","ٱلشَّيۡطَـٰنُ","فِىٓ","أُمۡنِيَّتِهِۦ","فَيَنسَخُ","ٱللَّهُ","مَا","يُلۡقِى","ٱلشَّيۡطَـٰنُ","ثُمَّ","يُحۡكِمُ","ٱللَّهُ","ءَايَـٰتِهِۦ‌ۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"22:71":["وَيَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَمۡ","يُنَزِّلۡ","بِهِۦ","سُلۡطَـٰنًا","وَمَا","لَيۡسَ","لَهُم","بِهِۦ","عِلۡمٌ‌ۗ","وَمَا","لِلظَّـٰلِمِينَ","مِن","نَّصِيرٍ"],"23:21":["وَإِنَّ","لَكُمۡ","فِى","ٱلۡأَنۡعَـٰمِ","لَعِبۡرَةً‌ۖ","نُّسۡقِيكُم","مِّمَّا","فِى","بُطُونِهَا","وَلَكُمۡ","فِيهَا","مَنَـٰفِعُ","كَثِيرَةٌ","وَمِنۡهَا","تَأۡكُلُونَ"],"24:53":["۞وَأَقۡسَمُواۡ","بِٱللَّهِ","جَهۡدَ","أَيۡمَـٰنِهِمۡ","لَئِنۡ","أَمَرۡتَهُمۡ","لَيَخۡرُجُنَّ‌ۖ","قُل","لَّا","تُقۡسِمُواۡ‌ۖ","طَاعَةٌ","مَّعۡرُوفَةٌ‌ۚ","إِنَّ","ٱللَّهَ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"27:69":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُجۡرِمِينَ"],"27:70":["وَلَا","تَحۡزَنۡ","عَلَيۡهِمۡ","وَلَا","تَكُن","فِى","ضَيۡقٍ","مِّمَّا","يَمۡكُرُونَ"],"27:71":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"29:7":["وَٱلَّذِينَ","ءَامَنُواۡ","وَعَمِلُواۡ","ٱلصَّـٰلِحَـٰتِ","لَنُكَفِّرَنَّ","عَنۡهُمۡ","سَيِّـَٔـاتِهِمۡ","وَلَنَجۡزِيَنَّهُمۡ","أَحۡسَنَ","ٱلَّذِى","كَانُواۡ","يَعۡمَلُونَ"],"29:8":["وَوَصَّيۡنَا","ٱلۡإِنسَـٰنَ","بِوٰلِدَيۡهِ","حُسۡنًا‌ۖ","وَإِن","جَـٰهَدَاكَ","لِتُشۡرِكَ","بِى","مَا","لَيۡسَ","لَكَ","بِهِۦ","عِلۡمٌ","فَلَا","تُطِعۡهُمَآ‌ۚ","إِلَىَّ","مَرۡجِعُكُمۡ","فَأُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"29:20":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","بَدَأَ","ٱلۡخَلۡقَ‌ۚ","ثُمَّ","ٱللَّهُ","يُنشِئُ","ٱلنَّشۡأَةَ","ٱلۡأَخِرَةَ‌ۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَىۡءٍ","قَدِيرٌ"],"29:45":["ٱتۡلُ","مَآ","أُوحِىَ","إِلَيۡكَ","مِنَ","ٱلۡكِتَـٰبِ","وَأَقِمِ","ٱلصَّلَوٰةَ‌ۖ","إِنَّ","ٱلصَّلَوٰةَ","تَنۡهَىٰ","عَنِ","ٱلۡفَحۡشَآءِ","وَٱلۡمُنكَرِ‌ۗ","وَلَذِكۡرُ","ٱللَّهِ","أَكۡبَرُ‌ۗ","وَٱللَّهُ","يَعۡلَمُ","مَا","تَصۡنَعُونَ"],"29:59":["ٱلَّذِينَ","صَبَرُواۡ","وَعَلَىٰ","رَبِّهِمۡ","يَتَوَكَّلُونَ"],"29:60":["وَكَأَيِّن","مِّن","دَآبَّةٍ","لَّا","تَحۡمِلُ","رِزۡقَهَا","ٱللَّهُ","يَرۡزُقُهَا","وَإِيَّاكُمۡ‌ۚ","وَهُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"29:63":["وَلَئِن","سَأَلۡتَهُم","مَّن","نَّزَّلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَأَحۡيَا","بِهِ","ٱلۡأَرۡضَ","مِنۢ","بَعۡدِ","مَوۡتِهَا","لَيَقُولُنَّ","ٱللَّهُ‌ۚ","قُلِ","ٱلۡحَمۡدُ","لِلَّهِ‌ۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡقِلُونَ"],"29:66":["لِيَكۡفُرُواۡ","بِمَآ","ءَاتَيۡنَـٰهُمۡ","وَلِيَتَمَتَّعُواۡ‌ۖ","فَسَوۡفَ","يَعۡلَمُونَ"],"29:67":["أَوَلَمۡ","يَرَوۡاۡ","أَنَّا","جَعَلۡنَا","حَرَمًا","ءَامِنًا","وَيُتَخَطَّفُ","ٱلنَّاسُ","مِنۡ","حَوۡلِهِمۡ‌ۚ","أَفَبِٱلۡبَـٰطِلِ","يُؤۡمِنُونَ","وَبِنِعۡمَةِ","ٱللَّهِ","يَكۡفُرُونَ"],"29:68":["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","كَذَّبَ","بِٱلۡحَقِّ","لَمَّا","جَآءَهُۥٓ‌ۚ","أَلَيۡسَ","فِى","جَهَنَّمَ","مَثۡوًى","لِّلۡكَـٰفِرِينَ"],"30:33":["وَإِذَا","مَسَّ","ٱلنَّاسَ","ضُرٌّ","دَعَوۡاۡ","رَبَّهُم","مُّنِيبِينَ","إِلَيۡهِ","ثُمَّ","إِذَآ","أَذَاقَهُم","مِّنۡهُ","رَحۡمَةً","إِذَا","فَرِيقٌ","مِّنۡهُم","بِرَبِّهِمۡ","يُشۡرِكُونَ"],"30:34":["لِيَكۡفُرُواۡ","بِمَآ","ءَاتَيۡنَـٰهُمۡ‌ۚ","فَتَمَتَّعُواۡ","فَسَوۡفَ","تَعۡلَمُونَ"],"30:42":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلُ‌ۚ","كَانَ","أَكۡثَرُهُم","مُّشۡرِكِينَ"],"31:10":["خَلَقَ","ٱلسَّمَـٰوٰتِ","بِغَيۡرِ","عَمَدٍ","تَرَوۡنَهَا‌ۖ","وَأَلۡقَىٰ","فِى","ٱلۡأَرۡضِ","رَوٰسِىَ","أَن","تَمِيدَ","بِكُمۡ","وَبَثَّ","فِيهَا","مِن","كُلِّ","دَآبَّةٍ‌ۚ","وَأَنزَلۡنَا","مِنَ","ٱلسَّمَآءِ","مَآءً","فَأَنۢبَتۡنَا","فِيهَا","مِن","كُلِّ","زَوۡجٍ","كَرِيمٍ"],"32:9":["ثُمَّ","سَوَّٮٰهُ","وَنَفَخَ","فِيهِ","مِن","رُّوحِهِۦ‌ۖ","وَجَعَلَ","لَكُمُ","ٱلسَّمۡعَ","وَٱلۡأَبۡصَـٰرَ","وَٱلۡأَفۡــِٔدَةَ‌ۚ","قَلِيلاً","مَّا","تَشۡكُرُونَ"],"32:25":["إِنَّ","رَبَّكَ","هُوَ","يَفۡصِلُ","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَـٰمَةِ","فِيمَا","كَانُواۡ","فِيهِ","يَخۡتَلِفُونَ"],"34:30":["قُل","لَّكُم","مِّيعَادُ","يَوۡمٍ","لَّا","تَسۡتَــٔۡخِرُونَ","عَنۡهُ","سَاعَةً","وَلَا","تَسۡتَقۡدِمُونَ"],"35:12":["وَمَا","يَسۡتَوِى","ٱلۡبَحۡرَانِ","هَـٰذَا","عَذۡبٌ","فُرَاتٌ","سَآئِغٌ","شَرَابُهُۥ","وَهَـٰذَا","مِلۡحٌ","أُجَاجٌۖ","وَمِن","كُلٍّ","تَأۡكُلُونَ","لَحۡمًا","طَرِيًّا","وَتَسۡتَخۡرِجُونَ","حِلۡيَةً","تَلۡبَسُونَهَاۖ","وَتَرَى","ٱلۡفُلۡكَ","فِيهِ","مَوَاخِرَ","لِتَبۡتَغُواۡ","مِن","فَضۡلِهِۦ","وَلَعَلَّكُمۡ","تَشۡكُرُونَ"],"35:13":["يُولِجُ","ٱلَّيۡلَ","فِى","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِى","ٱلَّيۡلِ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَ","كُلٌّ","يَجۡرِى","لِأَجَلٍ","مُّسَمًّىۚ","ذٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","لَهُ","ٱلۡمُلۡكُۚ","وَٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِهِۦ","مَا","يَمۡلِكُونَ","مِن","قِطۡمِيرٍ"],"35:42":["وَأَقۡسَمُواۡ","بِٱللَّهِ","جَهۡدَ","أَيۡمَـٰنِهِمۡ","لَئِن","جَآءَهُمۡ","نَذِيرٌ","لَّيَكُونُنَّ","أَهۡدَىٰ","مِنۡ","إِحۡدَى","ٱلۡأُمَمِۖ","فَلَمَّا","جَآءَهُمۡ","نَذِيرٌ","مَّا","زَادَهُمۡ","إِلَّا","نُفُورًا"],"35:45":["وَلَوۡ","يُؤَاخِذُ","ٱللَّهُ","ٱلنَّاسَ","بِمَا","كَسَبُواۡ","مَا","تَرَكَ","عَلَىٰ","ظَهۡرِهَا","مِن","دَآبَّةٍ","وَلَـٰكِن","يُؤَخِّرُهُمۡ","إِلَىٰٓ","أَجَلٍ","مُّسَمًّىۖ","فَإِذَا","جَآءَ","أَجَلُهُمۡ","فَإِنَّ","ٱللَّهَ","كَانَ","بِعِبَادِهِۦ","بَصِيرَۢا"],"36:76":["فَلَا","يَحۡزُنكَ","قَوۡلُهُمۡ‌ۘ","إِنَّا","نَعۡلَمُ","مَا","يُسِرُّونَ","وَمَا","يُعۡلِنُونَ"],"36:77":["أَوَلَمۡ","يَرَ","ٱلۡإِنسَـٰنُ","أَنَّا","خَلَقۡنَـٰهُ","مِن","نُّطۡفَةٍ","فَإِذَا","هُوَ","خَصِيمٌ","مُّبِينٌ"],"36:78":["وَضَرَبَ","لَنَا","مَثَلاً","وَنَسِىَ","خَلۡقَهُۥ‌ۖ","قَالَ","مَن","يُحۡىِ","ٱلۡعِظَـٰمَ","وَهِىَ","رَمِيمٌ"],"39:10":["قُلۡ","يَـٰعِبَادِ","ٱلَّذِينَ","ءَامَنُواۡ","ٱتَّقُواۡ","رَبَّكُمۡ‌ۚ","لِلَّذِينَ","أَحۡسَنُواۡ","فِى","هَـٰذِهِ","ٱلدُّنۡيَا","حَسَنَةٌ‌ۗ","وَأَرۡضُ","ٱللَّهِ","وٰسِعَةٌ‌ۗ","إِنَّمَا","يُوَفَّى","ٱلصَّـٰبِرُونَ","أَجۡرَهُم","بِغَيۡرِ","حِسَابٍ"],"39:35":["لِيُكَفِّرَ","ٱللَّهُ","عَنۡهُمۡ","أَسۡوَأَ","ٱلَّذِى","عَمِلُواۡ","وَيَجۡزِيَهُمۡ","أَجۡرَهُم","بِأَحۡسَنِ","ٱلَّذِى","كَانُواۡ","يَعۡمَلُونَ"],"39:36":["أَلَيۡسَ","ٱللَّهُ","بِكَافٍ","عَبۡدَهُۥ‌ۖ","وَيُخَوِّفُونَكَ","بِٱلَّذِينَ","مِن","دُونِهِۦ‌ۚ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَمَا","لَهُۥ","مِنۡ","هَادٍ"],"39:48":["وَبَدَا","لَهُمۡ","سَيِّـَٔـاتُ","مَا","كَسَبُواۡ","وَحَاقَ","بِهِم","مَّا","كَانُواۡ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"39:51":["فَأَصَابَهُمۡ","سَيِّـَٔـاتُ","مَا","كَسَبُواۡ‌ۚ","وَٱلَّذِينَ","ظَلَمُواۡ","مِنۡ","هَـٰٓؤُلَآءِ","سَيُصِيبُهُمۡ","سَيِّـَٔـاتُ","مَا","كَسَبُواۡ","وَمَا","هُم","بِمُعۡجِزِينَ"],"39:70":["وَوُفِّيَتۡ","كُلُّ","نَفۡسٍ","مَّا","عَمِلَتۡ","وَهُوَ","أَعۡلَمُ","بِمَا","يَفۡعَلُونَ"],"39:71":["وَسِيقَ","ٱلَّذِينَ","كَفَرُوٓاۡ","إِلَىٰ","جَهَنَّمَ","زُمَرًا‌ۖ","حَتَّىٰٓ","إِذَا","جَآءُوهَا","فُتِحَتۡ","أَبۡوٰبُهَا","وَقَالَ","لَهُمۡ","خَزَنَتُهَآ","أَلَمۡ","يَأۡتِكُمۡ","رُسُلٌ","مِّنكُمۡ","يَتۡلُونَ","عَلَيۡكُمۡ","ءَايَـٰتِ","رَبِّكُمۡ","وَيُنذِرُونَكُمۡ","لِقَآءَ","يَوۡمِكُمۡ","هَـٰذَا‌ۚ","قَالُواۡ","بَلَىٰ","وَلَـٰكِنۡ","حَقَّتۡ","كَلِمَةُ","ٱلۡعَذَابِ","عَلَى","ٱلۡكَـٰفِرِينَ"],"39:72":["قِيلَ","ٱدۡخُلُوٓاۡ","أَبۡوٰبَ","جَهَنَّمَ","خَـٰلِدِينَ","فِيهَا‌ۖ","فَبِئۡسَ","مَثۡوَى","ٱلۡمُتَكَبِّرِينَ"],"39:73":["وَسِيقَ","ٱلَّذِينَ","ٱتَّقَوۡاۡ","رَبَّهُمۡ","إِلَى","ٱلۡجَنَّةِ","زُمَرًا‌ۖ","حَتَّىٰٓ","إِذَا","جَآءُوهَا","وَفُتِحَتۡ","أَبۡوٰبُهَا","وَقَالَ","لَهُمۡ","خَزَنَتُهَا","سَلَـٰمٌ","عَلَيۡكُمۡ","طِبۡتُمۡ","فَٱدۡخُلُوهَا","خَـٰلِدِينَ"],"40:15":["رَفِيعُ","ٱلدَّرَجَـٰتِ","ذُو","ٱلۡعَرۡشِ","يُلۡقِى","ٱلرُّوحَ","مِنۡ","أَمۡرِهِۦ","عَلَىٰ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","لِيُنذِرَ","يَوۡمَ","ٱلتَّلَاقِ"],"40:40":["مَنۡ","عَمِلَ","سَيِّئَةً","فَلَا","يُجۡزَىٰٓ","إِلَّا","مِثۡلَهَاۖ","وَمَنۡ","عَمِلَ","صَـٰلِحًا","مِّن","ذَكَرٍ","أَوۡ","أُنثَىٰ","وَهُوَ","مُؤۡمِنٌ","فَأُوۡلَـٰٓئِكَ","يَدۡخُلُونَ","ٱلۡجَنَّةَ","يُرۡزَقُونَ","فِيهَا","بِغَيۡرِ","حِسَابٍ"],"40:76":["ٱدۡخُلُوٓاۡ","أَبۡوٰبَ","جَهَنَّمَ","خَـٰلِدِينَ","فِيهَاۖ","فَبِئۡسَ","مَثۡوَى","ٱلۡمُتَكَبِّرِينَ"],"40:77":["فَٱصۡبِرۡ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَۚقٌّ","فَإِمَّا","نُرِيَنَّكَ","بَعۡضَ","ٱلَّذِى","نَعِدُهُمۡ","أَوۡ","نَتَوَفَّيَنَّكَ","فَإِلَيۡنَا","يُرۡجَعُونَ"],"42:8":["وَلَوۡ","شَآءَ","ٱللَّهُ","لَجَعَلَهُمۡ","أُمَّةً","وٰحِدَةً","وَلَـٰكِن","يُدۡخِلُ","مَن","يَشَآءُ","فِى","رَحۡمَتِهِۦ‌ۚ","وَٱلظَّـٰلِمُونَ","مَا","لَهُم","مِّن","وَلِىٍّ","وَلَا","نَصِيرٍ"],"42:11":["فَاطِرُ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ‌ۚ","جَعَلَ","لَكُم","مِّنۡ","أَنفُسِكُمۡ","أَزۡوٰجًا","وَمِنَ","ٱلۡأَنۡعَـٰمِ","أَزۡوٰجًا‌ۖ","يَذۡرَؤُكُمۡ","فِيهِ‌ۚ","لَيۡسَ","كَمِثۡلِهِۦ","شَىۡءٌ‌ۖ","وَهُوَ","ٱلسَّمِيعُ","ٱلۡبَصِيرُ"],"43:17":["وَإِذَا","بُشِّرَ","أَحَدُهُم","بِمَا","ضَرَبَ","لِلرَّحۡمَـٰنِ","مَثَلاً","ظَلَّ","وَجۡهُهُۥ","مُسۡوَدًّا","وَهُوَ","كَظِيمٌ"],"43:18":["أَوَمَن","يُنَشَّؤُاۡ","فِى","ٱلۡحِلۡيَةِ","وَهُوَ","فِى","ٱلۡخِصَامِ","غَيۡرُ","مُبِينٍ"],"45:5":["وَٱخۡتِلَـٰفِ","ٱلَّيۡلِ","وَٱلنَّهَارِ","وَمَآ","أَنزَلَ","ٱللَّهُ","مِنَ","ٱلسَّمَآءِ","مِن","رِّزۡقٍ","فَأَحۡيَا","بِهِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَا","وَتَصۡرِيفِ","ٱلرِّيَـٰحِ","ءَايَـٰتٌ","لِّقَوۡمٍ","يَعۡقِلُونَ"],"45:17":["وَءَاتَيۡنَـٰهُم","بَيِّنَـٰتٍ","مِّنَ","ٱلۡأَمۡرِ‌ۖ","فَمَا","ٱخۡتَلَفُوٓاۡ","إِلَّا","مِنۢ","بَعۡدِ","مَا","جَآءَهُمُ","ٱلۡعِلۡمُ","بَغۡيَۢا","بَيۡنَهُمۡ‌ۚ","إِنَّ","رَبَّكَ","يَقۡضِى","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَـٰمَةِ","فِيمَا","كَانُواۡ","فِيهِ","يَخۡتَلِفُونَ"],"45:33":["وَبَدَا","لَهُمۡ","سَيِّـَٔـاتُ","مَا","عَمِلُواۡ","وَحَاقَ","بِهِم","مَّا","كَانُواۡ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"64:4":["يَعۡلَمُ","مَا","فِى","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ","وَيَعۡلَمُ","مَا","تُسِرُّونَ","وَمَا","تُعۡلِنُونَ‌ۚ","وَٱللَّهُ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"67:23":["قُلۡ","هُوَ","ٱلَّذِىٓ","أَنشَأَكُمۡ","وَجَعَلَ","لَكُمُ","ٱلسَّمۡعَ","وَٱلۡأَبۡصَـٰرَ","وَٱلۡأَفۡــِٔدَةَ‌ۖ","قَلِيلاً","مَّا","تَشۡكُرُونَ"]}}