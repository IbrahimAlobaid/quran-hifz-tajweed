صَّـٰبِــِٔينَ","وَٱلنَّصَـٰرَىٰ","وَٱلۡمَجُوسَ","وَٱلَّذِينَ","أَشۡرَكُوٓاۡ","إِنَّ","ٱللَّهَ","يَفۡصِلُ","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَـٰمَةِ‌ۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَىۡءٍ","شَهِيدٌ"],"22:18":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يَسۡجُدُ","لَهُۥ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","وَٱلشَّمۡسُ","وَٱلۡقَمَرُ","وَٱلنُّجُومُ","وَٱلۡجِبَالُ","وَٱلشَّجَرُ","وَٱلدَّوَآبُّ","وَكَثِيرٌ","مِّنَ","ٱلنَّاسِ‌ۖ","وَكَثِيرٌ","حَقَّ","عَلَيۡهِ","ٱلۡعَذَابُ‌ۗ","وَمَن","يُهِنِ","ٱللَّهُ","فَمَا","لَهُۥ","مِن","مُّكۡرِمٍ‌ۚ","إِنَّ","ٱللَّهَ","يَفۡعَلُ","مَا","يَشَآءُ"],"22:22":["كُلَّمَآ","أَرَادُوٓاۡ","أَن","يَخۡرُجُواۡ","مِنۡهَا","مِنۡ","غَمٍّ","أُعِيدُواۡ","فِيهَا","وَذُوقُواۡ","عَذَابَ","ٱلۡحَرِيقِ"],"22:23":["إِنَّ","ٱللَّهَ","يُدۡخِلُ","ٱلَّذِينَ","ءَامَنُواۡ","وَعَمِلُواۡ","ٱلصَّـٰلِحَـٰتِ","جَنَّـٰتٍ","تَجۡرِى","مِن","تَحۡتِهَا","ٱلۡأَنۡهَـٰرُ","يُحَلَّوۡنَ","فِيهَا","مِنۡ","أَسَاوِرَ","مِن","ذَهَبٍ","وَلُؤۡلُؤًا‌ۖ","وَلِبَاسُهُمۡ","فِيهَا","حَرِيرٌ"],"22:26":["وَإِذۡ","بَوَّأۡنَا","لِإِبۡرٰهِيمَ","مَكَانَ","ٱلۡبَيۡتِ","أَن","لَّا","تُشۡرِكۡ","بِى","شَيۡــًٔا","وَطَهِّرۡ","بَيۡتِىَ","لِلطَّآئِفِينَ","وَٱلۡقَآئِمِينَ","وَٱلرُّكَّعِ","ٱلسُّجُودِ"],"22:34":["وَلِكُلِّ","أُمَّةٍ","جَعَلۡنَا","مَنسَكًا","لِّيَذۡكُرُواۡ","ٱسۡمَ","ٱللَّهِ","عَلَىٰ","مَا","رَزَقَهُم","مِّنۢ","بَهِيمَةِ","ٱلۡأَنۡعَـٰمِ‌ۗ","فَإِلَـٰهُكُمۡ","إِلَـٰهٌ","وٰحِدٌ","فَلَهُۥٓ","أَسۡلِمُواۡ‌ۗ","وَبَشِّرِ","ٱلۡمُخۡبِتِينَ"],"22:35":["ٱلَّذِينَ","إِذَا","ذُكِرَ","ٱللَّهُ","وَجِلَتۡ","قُلُوبُهُمۡ","وَٱلصَّـٰبِرِينَ","عَلَىٰ","مَآ","أَصَابَهُمۡ","وَٱلۡمُقِيمِى","ٱلصَّلَوٰةِ","وَمِمَّا","رَزَقۡنَـٰهُمۡ","يُنفِقُونَ"],"22:40":["ٱلَّذِينَ","أُخۡرِجُواۡ","مِن","دِيَـٰرِهِم","بِغَيۡرِ","حَقٍّ","إِلَّآ","أَن","يَقُولُواۡ","رَبُّنَا","ٱللَّهُ‌ۗ","وَلَوۡلَا","دَفۡعُ","ٱللَّهِ","ٱلنَّاسَ","بَعۡضَهُم","بِبَعۡضٍ","لَّهُدِّمَتۡ","صَوٰمِعُ","وَبِيَعٌ","وَصَلَوٰتٌ","وَمَسَـٰجِدُ","يُذۡكَرُ","فِيهَا","ٱسۡمُ","ٱللَّهِ","كَثِيرًا‌ۗ","وَلَيَنصُرَنَّ","ٱللَّهُ","مَن","يَنصُرُهُۥٓ‌ۗ","إِنَّ","ٱللَّهَ","لَقَوِىٌّ","عَزِيزٌ"],"22:41":["ٱلَّذِينَ","إِن","مَّكَّنَّـٰهُمۡ","فِى","ٱلۡأَرۡضِ","أَقَامُواۡ","ٱلصَّلَوٰةَ","وَءَاتَوُاۡ","ٱلزَّكَوٰةَ","وَأَمَرُواۡ","بِٱلۡمَعۡرُوفِ","وَنَهَوۡاۡ","عَنِ","ٱلۡمُنكَرِ‌ۗ","وَلِلَّهِ","عَـٰقِبَةُ","ٱلۡأُمُورِ"],"22:42":["وَإِن","يُكَذِّبُوكَ","فَقَدۡ","كَذَّبَتۡ","قَبۡلَهُمۡ","قَوۡمُ","نُوحٍ","وَعَادٌ","وَثَمُودُ"],"22:43":["وَقَوۡمُ","إِبۡرٰهِيمَ","وَقَوۡمُ","لُوطٍ"],"22:44":["وَأَصۡحَـٰبُ","مَدۡيَنَ‌ۖ","وَكُذِّبَ","مُوسَىٰ","فَأَمۡلَيۡتُ","لِلۡكَـٰفِرِينَ","ثُمَّ","أَخَذۡتُهُمۡ‌ۖ","فَكَيۡفَ","كَانَ","نَكِيرِ"],"22:45":["فَكَأَيِّن","مِّن","قَرۡيَةٍ","أَهۡلَكۡنَـٰهَا","وَهِىَ","ظَالِمَةٌ","فَهِىَ","خَاوِيَةٌ","عَلَىٰ","عُرُوشِهَا","وَبِئۡرٍ","مُّعَطَّلَةٍ","وَقَصۡرٍ","مَّشِيدٍ"],"22:48":["وَكَأَيِّن","مِّن","قَرۡيَةٍ","أَمۡلَيۡتُ","لَهَا","وَهِىَ","ظَالِمَةٌ","ثُمَّ","أَخَذۡتُهَا","وَإِلَىَّ","ٱلۡمَصِيرُ"],"22:51":["وَٱلَّذِينَ","سَعَوۡاۡ","فِىٓ","ءَايَـٰتِنَا","مُعَـٰجِزِينَ","أُوۡلَـٰٓئِكَ","أَصۡحَـٰبُ","ٱلۡجَحِيمِ"],"22:53":["لِّيَجۡعَلَ","مَا","يُلۡقِى","ٱلشَّيۡطَـٰنُ","فِتۡنَةً","لِّلَّذِينَ","فِى","قُلُوبِهِم","مَّرَضٌ","وَٱلۡقَاسِيَةِ","قُلُوبُهُمۡ‌ۗ","وَإِنَّ","ٱلظَّـٰلِمِينَ","لَفِى","شِقَاقِۭ","بَعِيدٍ"],"22:61":["ذٰلِكَ","بِأَنَّ","ٱللَّهَ","يُولِجُ","ٱلَّيۡلَ","فِى","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِى","ٱلَّيۡلِ","وَأَنَّ","ٱللَّهَ","سَمِيعُۢ","بَصِيرٌ"],"22:62":["ذٰلِكَ","بِأَنَّ","ٱللَّهَ","هُوَ","ٱلۡحَقُّ","وَأَنَّ","مَا","يَدۡعُونَ","مِن","دُونِهِۦ","هُوَ","ٱلۡبَـٰطِلُ","وَأَنَّ","ٱللَّهَ","هُوَ","ٱلۡعَلِىُّ","ٱلۡكَبِيرُ"],"22:63":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَتُصۡبِحُ","ٱلۡأَرۡضُ","مُخۡضَرَّةً‌ۗ","إِنَّ","ٱللَّهَ","لَطِيفٌ","خَبِيرٌ"],"22:65":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","سَخَّرَ","لَكُم","مَّا","فِى","ٱلۡأَرۡضِ","وَٱلۡفُلۡكَ","تَجۡرِى","فِى","ٱلۡبَحۡرِ","بِأَمۡرِهِۦ","وَيُمۡسِكُ","ٱلسَّمَآءَ","أَن","تَقَعَ","عَلَى","ٱلۡأَرۡضِ","إِلَّا","بِإِذۡنِهِۦٓ‌ۗ","إِنَّ","ٱللَّهَ","بِٱلنَّاسِ","لَرَءُوفٌ","رَّحِيمٌ"],"22:67":["لِّكُلِّ","أُمَّةٍ","جَعَ