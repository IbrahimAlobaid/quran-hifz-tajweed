كَ‌ۖ","وَمَا","كُنتَ","لَدَيۡهِمۡ","إِذۡ","أَجۡمَعُوٓاۡ","أَمۡرَهُمۡ","وَهُمۡ","يَمۡكُرُونَ"],"12:109":["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","إِلَّا","رِجَالاً","نُّوحِىٓ","إِلَيۡهِم","مِّنۡ","أَهۡلِ","ٱلۡقُرَىٰٓ‌ۗ","أَفَلَمۡ","يَسِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَيَنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ‌ۗ","وَلَدَارُ","ٱلۡأَخِرَةِ","خَيۡرٌ","لِّلَّذِينَ","ٱتَّقَوۡاۡ‌ۗ","أَفَلَا","تَعۡقِلُونَ"],"12:110":["حَتَّىٰٓ","إِذَا","ٱسۡتَيۡــَٔسَ","ٱلرُّسُلُ","وَظَنُّوٓاۡ","أَنَّهُمۡ","قَدۡ","كُذِبُواۡ","جَآءَهُمۡ","نَصۡرُنَا","فَنُجِّىَ","مَن","نَّشَآءُ‌ۖ","وَلَا","يُرَدُّ","بَأۡسُنَا","عَنِ","ٱلۡقَوۡمِ","ٱلۡمُجۡرِمِينَ"],"12:111":["لَقَدۡ","كَانَ","فِى","قَصَصِهِمۡ","عِبۡرَةٌ","لِّأُوۡلِى","ٱلۡأَلۡبَـٰبِ‌ۗ","مَا","كَانَ","حَدِيثًا","يُفۡتَرَىٰ","وَلَـٰكِن","تَصۡدِيقَ","ٱلَّذِى","بَيۡنَ","يَدَيۡهِ","وَتَفۡصِيلَ","كُلِّ","شَىۡءٍ","وَهُدًى","وَرَحۡمَةً","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"14:12":["وَمَا","لَنَآ","أَلَّا","نَتَوَكَّلَ","عَلَى","ٱللَّهِ","وَقَدۡ","هَدَٮٰنَا","سُبُلَنَا‌ۚ","وَلَنَصۡبِرَنَّ","عَلَىٰ","مَآ","ءَاذَيۡتُمُونَا‌ۚ","وَعَلَى","ٱللَّهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُتَوَكِّلُونَ"],"16:43":["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","إِلَّا","رِجَالاً","نُّوحِىٓ","إِلَيۡهِمۡ‌ۚ","فَسۡــَٔلُوٓاۡ","أَهۡلَ","ٱلذِّكۡرِ","إِن","كُنتُمۡ","لَا","تَعۡلَمُونَ"],"21:7":["وَمَآ","أَرۡسَلۡنَا","قَبۡلَكَ","إِلَّا","رِجَالاً","نُّوحِىٓ","إِلَيۡهِمۡ‌ۖ","فَسۡــَٔلُوٓاۡ","أَهۡلَ","ٱلذِّكۡرِ","إِن","كُنتُمۡ","لَا","تَعۡلَمُونَ"],"21:25":["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","مِن","رَّسُولٍ","إِلَّا","نُوحِىٓ","إِلَيۡهِ","أَنَّهُۥ","لَآ","إِلَـٰهَ","إِلَّآ","أَنَاۡ","فَٱعۡبُدُونِ"],"22:52":["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","مِن","رَّسُولٍ","وَلَا","نَبِىٍّ","إِلَّآ","إِذَا","تَمَنَّىٰٓ","أَلۡقَى","ٱلشَّيۡطَـٰنُ","فِىٓ","أُمۡنِيَّتِهِۦ","فَيَنسَخُ","ٱللَّهُ","مَا","يُلۡقِى","ٱلشَّيۡطَـٰنُ","ثُمَّ","يُحۡكِمُ","ٱللَّهُ","ءَايَـٰتِهِۦ‌ۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"28:14":["وَلَمَّا","بَلَغَ","أَشُدَّهُۥ","وَٱسۡتَوَىٰٓ","ءَاتَيۡنَـٰهُ","حُكۡمًا","وَعِلۡمًا‌ۚ","وَكَذٰلِكَ","نَجۡزِى","ٱلۡمُحۡسِنِينَ"],"28:15":["وَدَخَلَ","ٱلۡمَدِينَةَ","عَلَىٰ","حِينِ","غَفۡلَةٍ","مِّنۡ","أَهۡلِهَا","فَوَجَدَ","فِيهَا","رَجُلَيۡنِ","يَقۡتَتِلَانِ","هَـٰذَا","مِن","شِيعَتِهِۦ","وَهَـٰذَا","مِنۡ","عَدُوِّهِۦ‌ۖ","فَٱسۡتَغَـٰثَهُ","ٱلَّذِى","مِن","شِيعَتِهِۦ","عَلَى","ٱلَّذِى","مِنۡ","عَدُوِّهِۦ","فَوَكَزَهُۥ","مُوسَىٰ","فَقَضَىٰ","عَلَيۡهِ‌ۖ","قَالَ","هَـٰذَا","مِنۡ","عَمَلِ","ٱلشَّيۡطَـٰنِ‌ۖ","إِنَّهُۥ","عَدُوٌّ","مُّضِلٌّ","مُّبِينٌ"],"30:30":["فَأَقِمۡ","وَجۡهَكَ","لِلدِّينِ","حَنِيفًا‌ۚ","فِطۡرَتَ","ٱللَّهِ","ٱلَّتِى","فَطَرَ","ٱلنَّاسَ","عَلَيۡهَا‌ۚ","لَا","تَبۡدِيلَ","لِخَلۡقِ","ٱللَّهِ‌ۚ","ذٰلِكَ","ٱلدِّينُ","ٱلۡقَيِّمُ","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"39:38":["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","لَيَقُولُنَّ","ٱللَّهُ‌ۚ","قُلۡ","أَفَرَءَيۡتُم","مَّا","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","إِنۡ","أَرَادَنِىَ","ٱللَّهُ","بِضُرٍّ","هَلۡ","هُنَّ","كَـٰشِفَـٰتُ","ضُرِّهِۦٓ","أَوۡ","أَرَادَنِى","بِرَحۡمَةٍ","هَلۡ","هُنَّ","مُمۡسِكَـٰتُ","رَحۡمَتِهِۦ‌ۚ","قُلۡ","حَسۡبِىَ","ٱللَّهُ‌ۖ","عَلَيۡهِ","يَتَوَكَّلُ","ٱلۡمُتَوَكِّلُونَ"],"43:3":["إِنَّا","جَعَلۡنَـٰهُ","قُرۡءٰنًا","عَرَبِيًّا","لَّعَلَّكُمۡ","تَعۡقِلُونَ"],"43:4":["وَإِنَّهُۥ","فِىٓ","أُمِّ","ٱلۡكِتَـٰبِ","لَدَيۡنَا","لَعَلِىٌّ","حَكِيمٌ"],"53:23":["إِنۡ","هِىَ","إِلَّآ","أَسۡمَآءٌ","سَمَّيۡتُمُوهَآ","أَنتُمۡ","وَءَابَآؤُكُم","مَّآ","أَنزَلَ","ٱللَّهُ","بِهَا","مِن","سُلۡطَـٰنٍ‌ۚ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَمَا","تَهۡوَى","ٱلۡأَنفُسُ‌ۖ","وَلَقَدۡ","جَآءَهُم","مِّن","رَّبِّهِمُ","ٱلۡهُدَىٰٓ"]}}