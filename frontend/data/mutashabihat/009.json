,"يُهَاجِرُواۡ‌ۚ","وَإِنِ","ٱسۡتَنصَرُوكُمۡ","فِى","ٱلدِّينِ","فَعَلَيۡكُمُ","ٱلنَّصۡرُ","إِلَّا","عَلَىٰ","قَوۡمِۭ","بَيۡنَكُمۡ","وَبَيۡنَهُم","مِّيثَـٰقٌ‌ۗ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"8:74":["وَٱلَّذِينَ","ءَامَنُواۡ","وَهَاجَرُواۡ","وَجَـٰهَدُواۡ","فِى","سَبِيلِ","ٱللَّهِ","وَٱلَّذِينَ","ءَاوَواۡ","وَّنَصَرُوٓاۡ","أُوۡلَـٰٓئِكَ","هُمُ","ٱلۡمُؤۡمِنُونَ","حَقًّا‌ۚ","لَّهُم","مَّغۡفِرَةٌ","وَرِزۡقٌ","كَرِيمٌ"],"8:75":["وَٱلَّذِينَ","ءَامَنُواۡ","مِنۢ","بَعۡدُ","وَهَاجَرُواۡ","وَجَـٰهَدُواۡ","مَعَكُمۡ","فَأُوۡلَـٰٓئِكَ","مِنكُمۡ‌ۚ","وَأُوۡلُواۡ","ٱلۡأَرۡحَامِ","بَعۡضُهُمۡ","أَوۡلَىٰ","بِبَعۡضٍ","فِى","كِتَـٰبِ","ٱللَّهِ‌ۗ","إِنَّ","ٱللَّهَ","بِكُلِّ","شَىۡءٍ","عَلِيمُۢ"],"9:4":["إِلَّا","ٱلَّذِينَ","عَـٰهَدتُّم","مِّنَ","ٱلۡمُشۡرِكِينَ","ثُمَّ","لَمۡ","يَنقُصُوكُمۡ","شَيۡــًٔا","وَلَمۡ","يُظَـٰهِرُواۡ","عَلَيۡكُمۡ","أَحَدًا","فَأَتِمُّوٓاۡ","إِلَيۡهِمۡ","عَهۡدَهُمۡ","إِلَىٰ","مُدَّتِهِمۡ‌ۚ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُتَّقِينَ"],"9:5":["فَإِذَا","ٱنسَلَخَ","ٱلۡأَشۡهُرُ","ٱلۡحُرُمُ","فَٱقۡتُلُواۡ","ٱلۡمُشۡرِكِينَ","حَيۡثُ","وَجَدتُّمُوهُمۡ","وَخُذُوهُمۡ","وَٱحۡصُرُوهُمۡ","وَٱقۡعُدُواۡ","لَهُمۡ","كُلَّ","مَرۡصَدٍ‌ۚ","فَإِن","تَابُواۡ","وَأَقَامُواۡ","ٱلصَّلَوٰةَ","وَءَاتَوُاۡ","ٱلزَّكَوٰةَ","فَخَلُّواۡ","سَبِيلَهُمۡ‌ۚ","إِنَّ","ٱللَّهَ","غَفُورٌ","رَّحِيمٌ"],"9:7":["كَيۡفَ","يَكُونُ","لِلۡمُشۡرِكِينَ","عَهۡدٌ","عِندَ","ٱللَّهِ","وَعِندَ","رَسُولِهِۦٓ","إِلَّا","ٱلَّذِينَ","عَـٰهَدتُّمۡ","عِندَ","ٱلۡمَسۡجِدِ","ٱلۡحَرَامِ‌ۖ","فَمَا","ٱسۡتَقَـٰمُواۡ","لَكُمۡ","فَٱسۡتَقِيمُواۡ","لَهُمۡ‌ۚ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُتَّقِينَ"],"9:11":["فَإِن","تَابُواۡ","وَأَقَامُواۡ","ٱلصَّلَوٰةَ","وَءَاتَوُاۡ","ٱلزَّكَوٰةَ","فَإِخۡوٰنُكُمۡ","فِى","ٱلدِّينِ‌ۗ","وَنُفَصِّلُ","ٱلۡأَيَـٰتِ","لِقَوۡمٍ","يَعۡلَمُونَ"],"9:20":["ٱلَّذِينَ","ءَامَنُواۡ","وَهَاجَرُواۡ","وَجَـٰهَدُواۡ","فِى","سَبِيلِ","ٱللَّهِ","بِأَمۡوٰلِهِمۡ","وَأَنفُسِهِمۡ","أَعۡظَمُ","دَرَجَةً","عِندَ","ٱللَّهِ‌ۚ","وَأُوۡلَـٰٓئِكَ","هُمُ","ٱلۡفَآئِزُونَ"],"9:26":["ثُمَّ","أَنزَلَ","ٱللَّهُ","سَكِينَتَهُۥ","عَلَىٰ","رَسُولِهِۦ","وَعَلَى","ٱلۡمُؤۡمِنِينَ","وَأَنزَلَ","جُنُودًا","لَّمۡ","تَرَوۡهَا","وَعَذَّبَ","ٱلَّذِينَ","كَفَرُواۡ‌ۚ","وَذٰلِكَ","جَزَآءُ","ٱلۡكَـٰفِرِينَ"],"9:29":["قَـٰتِلُواۡ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱللَّهِ","وَلَا","بِٱلۡيَوۡمِ","ٱلۡأَخِرِ","وَلَا","يُحَرِّمُونَ","مَا","حَرَّمَ","ٱللَّهُ","وَرَسُولُهُۥ","وَلَا","يَدِينُونَ","دِينَ","ٱلۡحَقِّ","مِنَ","ٱلَّذِينَ","أُوتُواۡ","ٱلۡكِتَـٰبَ","حَتَّىٰ","يُعۡطُواۡ","ٱلۡجِزۡيَةَ","عَن","يَدٍ","وَهُمۡ","صَـٰغِرُونَ"],"9:32":["يُرِيدُونَ","أَن","يُطۡفِــُٔواۡ","نُورَ","ٱللَّهِ","بِأَفۡوٰهِهِمۡ","وَيَأۡبَى","ٱللَّهُ","إِلَّآ","أَن","يُتِمَّ","نُورَهُۥ","وَلَوۡ","كَرِهَ","ٱلۡكَـٰفِرُونَ"],"9:33":["هُوَ","ٱلَّذِىٓ","أَرۡسَلَ","رَسُولَهُۥ","بِٱلۡهُدَىٰ","وَدِينِ","ٱلۡحَقِّ","لِيُظۡهِرَهُۥ","عَلَى","ٱلدِّينِ","كُلِّهِۦ","وَلَوۡ","كَرِهَ","ٱلۡمُشۡرِكُونَ"],"9:36":["إِنَّ","عِدَّةَ","ٱلشُّهُورِ","عِندَ","ٱللَّهِ","ٱثۡنَا","عَشَرَ","شَهۡرًا","فِى","كِتَـٰبِ","ٱللَّهِ","يَوۡمَ","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","مِنۡهَآ","أَرۡبَعَةٌ","حُرُمٌ‌ۚ","ذٰلِكَ","ٱلدِّينُ","ٱلۡقَيِّمُ‌ۚ","فَلَا","تَظۡلِمُواۡ","فِيهِنَّ","أَنفُسَكُمۡ‌ۚ","وَقَـٰتِلُواۡ","ٱلۡمُشۡرِكِينَ","كَآفَّةً","كَمَا","يُقَـٰتِلُونَكُمۡ","كَآفَّةً‌ۚ","وَٱعۡلَمُوٓاۡ","أَنَّ","ٱللَّهَ","مَعَ","ٱلۡمُتَّقِينَ"],"9:39":["إِلَّا","تَنفِرُواۡ","يُعَذِّبۡكُمۡ","عَذَابًا","أَلِيمًا","وَيَسۡتَبۡدِلۡ","قَوۡمًا","غَيۡرَكُمۡ","وَلَا","تَضُرُّوهُ","شَيۡــًٔا‌ۗ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَىۡءٍ","قَدِيرٌ"],"9:40":["إِلَّا","تَنصُرُوهُ","فَقَدۡ","نَصَرَهُ","ٱللَّهُ","إِذۡ","أَخۡرَجَهُ","ٱلَّذِينَ","كَفَرُواۡ","ثَانِىَ","ٱثۡنَيۡنِ","إِذۡ","هُمَا","فِى","ٱلۡغَارِ","إِذۡ","يَقُولُ","لِصَـٰحِبِهِۦ","لَا","تَحۡزَنۡ","إِنَّ","ٱللَّهَ","مَعَنَا‌ۖ","فَأَنزَلَ","ٱللَّهُ","سَكِينَتَهُۥ","عَلَيۡهِ","وَأَيَّدَهُۥ","بِجُنُودٍ","لَّمۡ","تَرَوۡهَا","وَجَعَلَ","كَلِمَةَ","ٱلَّذِينَ","كَفَرُواۡ","ٱلسُّفۡلَىٰ‌ۗ","وَكَلِمَةُ","ٱللَّهِ","هِىَ","ٱلۡعُلۡيَا‌ۗ","وَٱللَّهُ","عَزِيزٌ","حَكِيمٌ"],"9:41":["ٱنفِرُواۡ","خِفَافًا","وَثِقَالاً","وَجَـٰهِدُواۡ","بِأَمۡوٰلِكُمۡ","وَأَنفُسِكُمۡ","فِى","سَبِيلِ","ٱللَّهِ‌ۚ","ذٰلِكُمۡ","خَيۡرٌ","لَّكُمۡ","إِن","كُنتُمۡ","تَعۡلَمُونَ"],"9:44":["لَا","يَسۡتَــٔۡذِنُكَ","ٱلَّذِينَ","يُؤۡمِنُونَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأَخِرِ","أَن","يُجَـٰهِدُواۡ","بِأَمۡوٰلِهِمۡ","وَأَنفُسِهِمۡ‌ۗ","وَٱللَّهُ","عَلِيمُۢ","بِٱلۡمُتَّقِينَ"],"9:45":["إِنَّمَا","يَسۡتَــٔۡذِنُكَ","ٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأَخِرِ","وَٱرۡتَابَتۡ","قُلُوبُهُمۡ","فَهُمۡ","فِى","رَيۡبِهِمۡ","يَتَرَدَّدُونَ"],"9:49":["وَمِنۡهُم","مَّن","يَقُولُ","ٱئۡذَن","لِّى","وَلَا","تَفۡتِنِّىٓ‌ۚ","أَلَا","فِى","ٱلۡفِتۡنَةِ","سَقَطُواۡ‌ۗ","وَإِنَّ","جَهَنَّمَ","لَمُحِيطَةُۢ","بِٱلۡكَـٰفِرِينَ"],"9:50":["إِن","تُصِبۡكَ","حَسَنَةٌ","تَسُؤۡهُمۡ‌ۖ","وَإِن","تُصِبۡكَ","مُصِيبَةٌ","يَقُولُواۡ","قَدۡ","أَخَذۡنَآ","أَمۡرَنَا","مِن","قَبۡلُ","وَيَتَوَلَّواۡ","وَّهُمۡ","فَرِحُونَ"],"9:55":["فَلَا","تُعۡجِبۡكَ","أَمۡوٰلُهُمۡ","وَلَآ","أَوۡلَـٰدُهُمۡ‌ۚ","إِنَّمَا","يُرِيدُ","ٱللَّهُ","لِيُعَذِّبَهُم","بِهَا","فِى","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَتَزۡهَقَ","أَنفُسُهُمۡ","وَهُمۡ","كَـٰفِرُونَ"],"9:56":["وَيَحۡلِفُونَ","بِٱللَّهِ","إِنَّهُمۡ","لَمِنكُمۡ","وَمَا","هُم","مِّنكُمۡ","وَلَـٰكِنَّهُمۡ","قَوۡمٌ","يَفۡرَقُونَ"],"9:62":["يَحۡلِفُونَ","بِٱللَّهِ","لَكُمۡ","لِيُرۡضُوكُمۡ","وَٱللَّهُ","وَرَسُولُهُۥٓ","أَحَقُّ","أَن","يُرۡضُوهُ","إِن","كَانُواۡ","مُؤۡمِنِينَ"],"9:70":["أَلَمۡ","يَأۡتِهِمۡ","نَبَأُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","قَوۡمِ","نُوحٍ","وَعَادٍ","وَثَمُودَ","وَقَوۡمِ","إِبۡرٰهِيمَ","وَأَصۡحَـٰبِ","مَدۡيَنَ","وَٱلۡمُؤۡتَفِكَـٰتِ‌ۚ","أَتَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَـٰتِ‌ۖ","فَمَا","كَانَ","ٱللَّهُ","لِيَظۡلِمَهُمۡ","وَلَـٰكِن","كَانُوٓاۡ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"9:71":["وَٱلۡمُؤۡمِنُونَ","وَٱلۡمُؤۡمِنَـٰتُ","بَعۡضُهُمۡ","أَوۡلِيَآءُ","بَعۡضٍ‌ۚ","يَأۡمُرُونَ","بِٱلۡمَعۡرُوفِ","وَيَنۡهَوۡنَ","عَنِ","ٱلۡمُنكَرِ","وَيُقِيمُونَ","ٱلصَّلَوٰةَ","وَيُؤۡتُونَ","ٱلزَّكَوٰةَ","وَيُطِيعُونَ","ٱللَّهَ","وَرَسُولَهُۥٓ‌ۚ","أُوۡلَـٰٓئِكَ","سَيَرۡحَمُهُمُ","ٱللَّهُ‌ۗ","إِنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٌ"],"9:72":["وَعَدَ","ٱللَّهُ","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَـٰتِ","جَنَّـٰتٍ","تَجۡرِى","مِن","تَحۡتِهَا","ٱلۡأَنۡهَـٰرُ","خَـٰلِدِينَ","فِيهَا","وَمَسَـٰكِنَ","طَيِّبَةً","فِى","جَنَّـٰتِ","عَدۡنٍ‌ۚ","وَرِضۡوٰنٌ","مِّنَ","ٱللَّهِ","أَكۡبَرُ‌ۚ","ذٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"9:73":["يَـٰٓأَيُّهَا","ٱلنَّبِىُّ","جَـٰهِدِ","ٱلۡكُفَّارَ","وَٱلۡمُنَـٰفِقِينَ","وَٱغۡلُظۡ","عَلَيۡهِمۡ‌ۚ","وَمَأۡوَٮٰهُمۡ","جَهَنَّمُ‌ۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"9:74":["يَحۡلِفُونَ","بِٱللَّهِ","مَا","قَالُواۡ","وَلَقَدۡ","قَالُواۡ","كَلِمَةَ","ٱلۡكُفۡرِ","وَكَفَرُواۡ","بَعۡدَ","إِسۡلَـٰمِهِمۡ","وَهَمُّواۡ","بِمَا","لَمۡ","يَنَالُواۡ‌ۚ","وَمَا","نَقَمُوٓاۡ","إِلَّآ","أَنۡ","أَغۡنَـٰهُمُ","ٱللَّهُ","وَرَسُولُهُۥ","مِن","فَضۡلِهِۦ‌ۚ","فَإِن","يَتُوبُواۡ","يَكُ","خَيۡرًا","لَّهُمۡ‌ۖ","وَإِن","يَتَوَلَّوۡاۡ","يُعَذِّبۡهُمُ","ٱللَّهُ","عَذَابًا","أَلِيمًا","فِى","ٱلدُّنۡيَا","وَٱلۡأَخِرَةِ‌ۚ","وَمَا","لَهُمۡ","فِى","ٱلۡأَرۡضِ","مِن","وَلِىٍّ","وَلَا","نَصِيرٍ"],"9:81":["فَرِحَ","ٱلۡمُخَلَّفُونَ","بِمَقۡعَدِهِمۡ","خِلَـٰفَ","رَسُولِ","ٱللَّهِ","وَكَرِهُوٓاۡ","أَن","يُجَـٰهِدُواۡ","بِأَمۡوٰلِهِمۡ","وَأَنفُسِهِمۡ","فِى","سَبِيلِ","ٱللَّهِ","وَقَالُواۡ","لَا","تَنفِرُواۡ","فِى","ٱلۡحَرِّ‌ۗ","قُلۡ","نَارُ","جَهَنَّمَ","أَشَدُّ","حَرًّا‌ۚ","لَّوۡ","كَانُواۡ","يَفۡقَهُونَ"],"9:85":["وَلَا","تُعۡجِبۡكَ","أَمۡوٰلُهُمۡ","وَأَوۡلَـٰدُهُمۡ‌ۚ","إِنَّمَا","يُرِيدُ","ٱللَّهُ","أَن","يُعَذِّبَهُم","بِهَا","فِى","ٱلدُّنۡيَا","وَتَزۡهَقَ","أَنفُسُهُمۡ","وَهُمۡ","كَـٰفِرُونَ"],"9:86":["وَإِذَآ","أُنزِلَتۡ","سُورَةٌ","أَنۡ","ءَامِنُواۡ","بِٱللَّهِ","وَجَـٰهِدُواۡ","مَعَ","رَسُولِهِ","ٱسۡتَــٔۡذَنَكَ","أُوۡلُواۡ","ٱلطَّوۡلِ","مِنۡهُمۡ","وَقَالُواۡ","ذَرۡنَا","نَكُن","مَّعَ","ٱلۡقَـٰعِدِينَ"],"9:87":["رَضُواۡ","بِأَن","يَكُونُواۡ","مَعَ","ٱلۡخَوَالِفِ","وَطُبِعَ","عَلَىٰ","قُلُوبِهِمۡ","فَهُمۡ","لَا","يَفۡقَهُونَ"],"9:88":["لَـٰكِنِ","ٱلرَّسُولُ","وَٱلَّذِينَ","ءَامَنُواۡ","مَعَهُۥ","جَـٰهَدُواۡ","بِأَمۡوٰلِهِمۡ","وَأَنفُسِهِمۡ‌ۚ","وَأُوۡلَـٰٓئِكَ","لَهُمُ","ٱلۡخَيۡرٰتُ‌ۖ","وَأُوۡلَـٰٓئِكَ","هُمُ","ٱلۡمُفۡلِحُونَ"],"9:93":["۞إِنَّمَا","ٱلسَّبِيلُ","عَلَى","ٱلَّذِينَ","يَسۡتَــٔۡذِنُونَكَ","وَهُمۡ","أَغۡنِيَآءُ‌ۚ","رَضُواۡ","بِأَن","يَكُونُواۡ","مَعَ","ٱلۡخَوَالِفِ","وَطَبَعَ","ٱللَّهُ","عَلَىٰ","قُلُوبِهِمۡ","فَهُمۡ","لَا","يَعۡلَمُونَ"],"9:94":["يَعۡتَذِرُونَ","إِلَيۡكُمۡ","إِذَا","رَجَعۡتُمۡ","إِلَيۡهِمۡ‌ۚ","قُل","لَّا","تَعۡتَذِرُواۡ","لَن","نُّؤۡمِنَ","لَكُمۡ","قَدۡ","نَبَّأَنَا","ٱللَّهُ","مِنۡ","أَخۡبَارِكُمۡ‌ۚ","وَسَيَرَى","ٱللَّهُ","عَمَلَكُمۡ","وَرَسُولُهُۥ","ثُمَّ","تُرَدُّونَ","إِلَىٰ","عَـٰلِمِ","ٱلۡغَيۡبِ","وَٱلشَّهَـٰدَةِ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"9:95":["سَيَحۡلِفُونَ","بِٱللَّهِ","لَكُمۡ","إِذَا","ٱنقَلَبۡتُمۡ","إِلَيۡهِمۡ","لِتُعۡرِضُواۡ","عَنۡهُمۡ‌ۖ","فَأَعۡرِضُواۡ","عَنۡهُمۡ‌ۖ","إِنَّهُمۡ","رِجۡسٌ‌ۖ","وَمَأۡوَٮٰهُمۡ","جَهَنَّمُ","جَزَآءَۢ","بِمَا","كَانُواۡ","يَكۡسِبُونَ"],"9:96":["يَحۡلِفُونَ","لَكُمۡ","لِتَرۡضَوۡاۡ","عَنۡهُمۡ‌ۖ","فَإِن","تَرۡضَوۡاۡ","عَنۡهُمۡ","فَإِنَّ","ٱللَّهَ","لَا","يَرۡضَىٰ","عَنِ","ٱلۡقَوۡمِ","ٱلۡفَـٰسِقِينَ"],"9:105":["وَقُلِ","ٱعۡمَلُواۡ","فَسَيَرَى","ٱللَّهُ","عَمَلَكُمۡ","وَرَسُولُهُۥ","وَٱلۡمُؤۡمِنُونَ‌ۖ","وَسَتُرَدُّونَ","إِلَىٰ","عَـٰلِمِ","ٱلۡغَيۡبِ","وَٱلشَّهَـٰدَةِ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"9:106":["وَءَاخَرُونَ","مُرۡجَوۡنَ","لِأَمۡرِ","ٱللَّهِ","إِمَّا","يُعَذِّبُهُمۡ","وَإِمَّا","يَتُوبُ","عَلَيۡهِمۡ‌ۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"9:124":["وَإِذَا","مَآ","أُنزِلَتۡ","سُورَةٌ","فَمِنۡهُم","مَّن","يَقُولُ","أَيُّكُمۡ","زَادَتۡهُ","هَـٰذِهِۦٓ","إِيمَـٰنًا‌ۚ","فَأَمَّا","ٱلَّذِينَ","ءَامَنُواۡ","فَزَادَتۡهُمۡ","إِيمَـٰنًا","وَهُمۡ","يَسۡتَبۡشِرُونَ"],"9:127":["وَإِذَا","مَآ","أُنزِلَتۡ","سُورَةٌ","نَّظَرَ","بَعۡضُهُمۡ","إِلَىٰ","بَعۡضٍ","هَلۡ","يَرَٮٰكُم","مِّنۡ","أَحَدٍ","ثُمَّ","ٱنصَرَفُواۡ‌ۚ","صَرَفَ","ٱللَّهُ","قُلُوبَهُم","بِأَنَّهُمۡ","قَوۡمٌ","لَّا","يَفۡقَهُونَ"],"10:64":["لَهُمُ","ٱلۡبُشۡرَىٰ","فِى","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَفِى","ٱلۡأَخِرَةِ‌ۚ","لَا","تَبۡدِيلَ","لِكَلِمَـٰتِ","ٱللَّهِ‌ۚ","ذٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"11:57":["فَإِن","تَوَلَّوۡاۡ","فَقَدۡ","أَبۡلَغۡتُكُم","مَّآ","أُرۡسِلۡتُ","بِهِۦٓ","إِلَيۡكُمۡ‌ۚ","وَيَسۡتَخۡلِفُ","رَبِّى","قَوۡمًا","غَيۡرَكُمۡ","وَلَا","تَضُرُّونَهُۥ","شَيۡــًٔا‌ۚ","إِنَّ","رَبِّى","عَلَىٰ","كُلِّ","شَىۡءٍ","حَفِيظٌ"],"12:40":["مَا","تَعۡبُدُونَ","مِن","دُونِهِۦٓ","إِلَّآ","أَسۡمَآءً","سَمَّيۡتُمُوهَآ","أَنتُمۡ","وَءَابَآؤُكُم","مَّآ","أَنزَلَ","ٱللَّهُ","بِهَا","مِن","سُلۡطَـٰنٍ‌ۚ","إِنِ","ٱلۡحُكۡمُ","إِلَّا","لِلَّهِ‌ۚ","أَمَرَ","أَلَّا","تَعۡبُدُوٓاۡ","إِلَّآ","إِيَّاهُ‌ۚ","ذٰلِكَ","ٱلدِّينُ","ٱلۡقَيِّمُ","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"14:9":["أَلَمۡ","يَأۡتِكُمۡ","نَبَؤُاۡ","ٱلَّذِينَ","مِن","قَبۡلِكُمۡ","قَوۡمِ","نُوحٍ","وَعَادٍ","وَثَمُودَ‌ۛ","وَٱلَّذِينَ","مِنۢ","بَعۡدِهِمۡ‌ۛ","لَا","يَعۡلَمُهُمۡ","إِلَّا","ٱللَّهُ‌ۚ","جَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَـٰتِ","فَرَدُّوٓاۡ","أَيۡدِيَهُمۡ","فِىٓ","أَفۡوٰهِهِمۡ","وَقَالُوٓاۡ","إِنَّا","كَفَرۡنَا","بِمَآ","أُرۡسِلۡتُم","بِهِۦ","وَإِنَّا","لَفِى","شَكٍّ","مِّمَّا","تَدۡعُونَنَآ","إِلَيۡهِ","مُرِيبٍ"],"22:41":["ٱلَّذِينَ","إِن","مَّكَّنَّـٰهُمۡ","فِى","ٱلۡأَرۡضِ","أَقَامُواۡ","ٱلصَّلَوٰةَ","وَءَاتَوُاۡ","ٱلزَّكَوٰةَ","وَأَمَرُواۡ","بِٱلۡمَعۡرُوفِ","وَنَهَوۡاۡ","عَنِ","ٱلۡمُنكَرِ‌ۗ","وَلِلَّهِ","عَـٰقِبَةُ","ٱلۡأُمُورِ"],"29:54":["يَسۡتَعۡجِلُونَكَ","بِٱلۡعَذَابِ","وَإِنَّ","جَهَنَّمَ","لَمُحِيطَةُۢ","بِٱلۡكَـٰفِرِينَ"],"29:55":["يَوۡمَ","يَغۡشَـٰهُمُ","ٱلۡعَذَابُ","مِن","فَوۡقِهِمۡ","وَمِن","تَحۡتِ","أَرۡجُلِهِمۡ","وَيَقُولُ","ذُوقُواۡ","مَا","كُنتُمۡ","تَعۡمَلُونَ"],"30:30":["فَأَقِمۡ","وَجۡهَكَ","لِلدِّينِ","حَنِيفًا‌ۚ","فِطۡرَتَ","ٱللَّهِ","ٱلَّتِى","فَطَرَ","ٱلنَّاسَ","عَلَيۡهَا‌ۚ","لَا","تَبۡدِيلَ","لِخَلۡقِ","ٱللَّهِ‌ۚ","ذٰلِكَ","ٱلدِّينُ","ٱلۡقَيِّمُ","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"40:31":["مِثۡلَ","دَأۡبِ","قَوۡمِ","نُوحٍ","وَعَادٍ","وَثَمُودَ","وَٱلَّذِينَ","مِنۢ","بَعۡدِهِمۡۚ","وَمَا","ٱللَّهُ","يُرِيدُ","ظُلۡمًا","لِّلۡعِبَادِ"],"44:57":["فَضۡلاً","مِّن","رَّبِّكَ‌ۚ","ذٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"48:26":["إِذۡ","جَعَلَ","ٱلَّذِينَ","كَفَرُواۡ","فِى","قُلُوبِهِمُ","ٱلۡحَمِيَّةَ","حَمِيَّةَ","ٱلۡجَـٰهِلِيَّةِ","فَأَنزَلَ","ٱللَّهُ","سَكِينَتَهُۥ","عَلَىٰ","رَسُولِهِۦ","وَعَلَى","ٱلۡمُؤۡمِنِينَ","وَأَلۡزَمَهُمۡ","كَلِمَةَ","ٱلتَّقۡوَىٰ","وَكَانُوٓاۡ","أَحَقَّ","بِهَا","وَأَهۡلَهَا‌ۚ","وَكَانَ","ٱللَّهُ","بِكُلِّ","شَىۡءٍ","عَلِيمًا"],"48:28":["هُوَ","ٱلَّذِىٓ","أَرۡسَلَ","رَسُولَهُۥ","بِٱلۡهُدَىٰ","وَدِينِ","ٱلۡحَقِّ","لِيُظۡهِرَهُۥ","عَلَى","ٱلدِّينِ","كُلِّهِۦ‌ۚ","وَكَفَىٰ","بِٱللَّهِ","شَهِيدًا"],"49:15":["إِنَّمَا","ٱلۡمُؤۡمِنُونَ","ٱلَّذِينَ","ءَامَنُواۡ","بِٱللَّهِ","وَرَسُولِهِۦ","ثُمَّ","لَمۡ","يَرۡتَابُواۡ","وَجَـٰهَدُواۡ","بِأَمۡوٰلِهِمۡ","وَأَنفُسِهِمۡ","فِى","سَبِيلِ","ٱللَّهِ‌ۚ","أُوۡلَـٰٓئِكَ","هُمُ","ٱلصَّـٰدِقُونَ"],"57:12":["يَوۡمَ","تَرَى","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَـٰتِ","يَسۡعَىٰ","نُورُهُم","بَيۡنَ","أَيۡدِيهِمۡ","وَبِأَيۡمَـٰنِهِم","بُشۡرَٮٰكُمُ","ٱلۡيَوۡمَ","جَنَّـٰتٌ","تَجۡرِى","مِن","تَحۡتِهَا","ٱلۡأَنۡهَـٰرُ","خَـٰلِدِينَ","فِيهَا‌ۚ","ذٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"61:8":["يُرِيدُونَ","لِيُطۡفِــُٔواۡ","نُورَ","ٱللَّهِ","بِأَفۡوٰهِهِمۡ","وَٱللَّهُ","مُتِمُّ","نُورِهِۦ","وَلَوۡ","كَرِهَ","ٱلۡكَـٰفِرُونَ"],"61:9":["هُوَ","ٱلَّذِىٓ","أَرۡسَلَ","رَسُولَهُۥ","بِٱلۡهُدَىٰ","وَدِينِ","ٱلۡحَقِّ","لِيُظۡهِرَهُۥ","عَلَى","ٱلدِّينِ","كُلِّهِۦ","وَلَوۡ","كَرِهَ","ٱلۡمُشۡرِكُونَ"],"66:9":["يَـٰٓأَيُّهَا","ٱلنَّبِىُّ","جَـٰهِدِ","ٱلۡكُفَّارَ","وَٱلۡمُنَـٰفِقِينَ","وَٱغۡلُظۡ","عَلَيۡهِمۡ‌ۚ","وَمَأۡوَٮٰهُمۡ","جَهَنَّمُ‌ۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"66:10":["ضَرَبَ","ٱللَّهُ","مَثَلاً","لِّلَّذِينَ","كَفَرُواۡ","ٱمۡرَأَتَ","نُوحٍ","وَٱمۡرَأَتَ","لُوطٍ‌ۖ","كَانَتَا","تَحۡتَ","عَبۡدَيۡنِ","مِنۡ","عِبَادِنَا","صَـٰلِحَيۡنِ","فَخَانَتَاهُمَا","فَلَمۡ","يُغۡنِيَا","عَنۡهُمَا","مِنَ","ٱللَّهِ","شَيۡــًٔا","وَقِيلَ","ٱدۡخُلَا","ٱلنَّارَ","مَعَ","ٱلدّٰخِلِينَ"]}}