0:89":["أَفَلَا","يَرَوۡنَ","أَلَّا","يَرۡجِعُ","إِلَيۡهِمۡ","قَوۡلاً","وَلَا","يَمۡلِكُ","لَهُمۡ","ضَرًّا","وَلَا","نَفۡعًا"],"21:41":["وَلَقَدِ","ٱسۡتُهۡزِئَ","بِرُسُلٍ","مِّن","قَبۡلِكَ","فَحَاقَ","بِٱلَّذِينَ","سَخِرُواۡ","مِنۡهُم","مَّا","كَانُواۡ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"21:42":["قُلۡ","مَن","يَكۡلَؤُكُم","بِٱلَّيۡلِ","وَٱلنَّهَارِ","مِنَ","ٱلرَّحۡمَـٰنِ‌ۗ","بَلۡ","هُمۡ","عَن","ذِكۡرِ","رَبِّهِم","مُّعۡرِضُونَ"],"21:66":["قَالَ","أَفَتَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُكُمۡ","شَيۡــًٔا","وَلَا","يَضُرُّكُمۡ"],"22:44":["وَأَصۡحَـٰبُ","مَدۡيَنَ‌ۖ","وَكُذِّبَ","مُوسَىٰ","فَأَمۡلَيۡتُ","لِلۡكَـٰفِرِينَ","ثُمَّ","أَخَذۡتُهُمۡ‌ۖ","فَكَيۡفَ","كَانَ","نَكِيرِ"],"24:43":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يُزۡجِى","سَحَابًا","ثُمَّ","يُؤَلِّفُ","بَيۡنَهُۥ","ثُمَّ","يَجۡعَلُهُۥ","رُكَامًا","فَتَرَى","ٱلۡوَدۡقَ","يَخۡرُجُ","مِنۡ","خِلَـٰلِهِۦ","وَيُنَزِّلُ","مِنَ","ٱلسَّمَآءِ","مِن","جِبَالٍ","فِيهَا","مِنۢ","بَرَدٍ","فَيُصِيبُ","بِهِۦ","مَن","يَشَآءُ","وَيَصۡرِفُهُۥ","عَن","مَّن","يَشَآءُ‌ۖ","يَكَادُ","سَنَا","بَرۡقِهِۦ","يَذۡهَبُ","بِٱلۡأَبۡصَـٰرِ"],"25:3":["وَٱتَّخَذُواۡ","مِن","دُونِهِۦٓ","ءَالِهَةً","لَّا","يَخۡلُقُونَ","شَيۡــًٔا","وَهُمۡ","يُخۡلَقُونَ","وَلَا","يَمۡلِكُونَ","لِأَنفُسِهِمۡ","ضَرًّا","وَلَا","نَفۡعًا","وَلَا","يَمۡلِكُونَ","مَوۡتًا","وَلَا","حَيَوٰةً","وَلَا","نُشُورًا"],"25:55":["وَيَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُهُمۡ","وَلَا","يَضُرُّهُمۡ‌ۗ","وَكَانَ","ٱلۡكَافِرُ","عَلَىٰ","رَبِّهِۦ","ظَهِيرًا"],"28:82":["وَأَصۡبَحَ","ٱلَّذِينَ","تَمَنَّوۡاۡ","مَكَانَهُۥ","بِٱلۡأَمۡسِ","يَقُولُونَ","وَيۡكَأَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ‌ۖ","لَوۡلَآ","أَن","مَّنَّ","ٱللَّهُ","عَلَيۡنَا","لَخَسَفَ","بِنَا‌ۖ","وَيۡكَأَنَّهُۥ","لَا","يُفۡلِحُ","ٱلۡكَـٰفِرُونَ"],"29:50":["وَقَالُواۡ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَـٰتٌ","مِّن","رَّبِّهِۦ‌ۖ","قُلۡ","إِنَّمَا","ٱلۡأَيَـٰتُ","عِندَ","ٱللَّهِ","وَإِنَّمَآ","أَنَاۡ","نَذِيرٌ","مُّبِينٌ"],"29:52":["قُلۡ","