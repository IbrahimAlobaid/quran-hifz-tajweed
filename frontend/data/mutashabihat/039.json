ٓ","إِلَيۡكَ","ٱلۡكِتَـٰبَ","بِٱلۡحَقِّ","لِتَحۡكُمَ","بَيۡنَ","ٱلنَّاسِ","بِمَآ","أَرَٮٰكَ","ٱللَّهُ‌ۚ","وَلَا","تَكُن","لِّلۡخَآئِنِينَ","خَصِيمًا"],"5:36":["إِنَّ","ٱلَّذِينَ","كَفَرُواۡ","لَوۡ","أَنَّ","لَهُم","مَّا","فِى","ٱلۡأَرۡضِ","جَمِيعًا","وَمِثۡلَهُۥ","مَعَهُۥ","لِيَفۡتَدُواۡ","بِهِۦ","مِنۡ","عَذَابِ","يَوۡمِ","ٱلۡقِيَـٰمَةِ","مَا","تُقُبِّلَ","مِنۡهُمۡ‌ۖ","وَلَهُمۡ","عَذَابٌ","أَلِيمٌ"],"5:48":["وَأَنزَلۡنَآ","إِلَيۡكَ","ٱلۡكِتَـٰبَ","بِٱلۡحَقِّ","مُصَدِّقًا","لِّمَا","بَيۡنَ","يَدَيۡهِ","مِنَ","ٱلۡكِتَـٰبِ","وَمُهَيۡمِنًا","عَلَيۡهِ‌ۖ","فَٱحۡكُم","بَيۡنَهُم","بِمَآ","أَنزَلَ","ٱللَّهُ‌ۖ","وَلَا","تَتَّبِعۡ","أَهۡوَآءَهُمۡ","عَمَّا","جَآءَكَ","مِنَ","ٱلۡحَقِّ‌ۚ","لِكُلٍّ","جَعَلۡنَا","مِنكُمۡ","شِرۡعَةً","وَمِنۡهَاجًا‌ۚ","وَلَوۡ","شَآءَ","ٱللَّهُ","لَجَعَلَكُمۡ","أُمَّةً","وٰحِدَةً","وَلَـٰكِن","لِّيَبۡلُوَكُمۡ","فِى","مَآ","ءَاتَـٰكُمۡ‌ۖ","فَٱسۡتَبِقُواۡ","ٱلۡخَيۡرٰتِ‌ۚ","إِلَى","ٱللَّهِ","مَرۡجِعُكُمۡ","جَمِيعًا","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","فِيهِ","تَخۡتَلِفُونَ"],"6:15":["قُلۡ","إِنِّىٓ","أَخَافُ","إِنۡ","عَصَيۡتُ","رَبِّى","عَذَابَ","يَوۡمٍ","عَظِيمٍ"],"6:16":["مَّن","يُصۡرَفۡ","عَنۡهُ","يَوۡمَئِذٍ","فَقَدۡ","رَحِمَهُۥ‌ۚ","وَذٰلِكَ","ٱلۡفَوۡزُ","ٱلۡمُبِينُ"],"6:91":["وَمَا","قَدَرُواۡ","ٱللَّهَ","حَقَّ","قَدۡرِهِۦٓ","إِذۡ","قَالُواۡ","مَآ","أَنزَلَ","ٱللَّهُ","عَلَىٰ","بَشَرٍ","مِّن","شَىۡءٍ‌ۗ","قُلۡ","مَنۡ","أَنزَلَ","ٱلۡكِتَـٰبَ","ٱلَّذِى","جَآءَ","بِهِۦ","مُوسَىٰ","نُورًا","وَهُدًى","لِّلنَّاسِ‌ۖ","تَجۡعَلُونَهُۥ","قَرَاطِيسَ","تُبۡدُونَهَا","وَتُخۡفُونَ","كَثِيرًا‌ۖ","وَعُلِّمۡتُم","مَّا","لَمۡ","تَعۡلَمُوٓاۡ","أَنتُمۡ","وَلَآ","ءَابَآؤُكُمۡ‌ۖ","قُلِ","ٱللَّهُ‌ۖ","ثُمَّ","ذَرۡهُمۡ","فِى","خَوۡضِهِمۡ","يَلۡعَبُونَ"],"6:130":["يَـٰمَعۡشَرَ","ٱلۡجِنِّ","وَٱلۡإِنسِ","أَلَمۡ","يَأۡتِكُمۡ","رُسُلٌ","مِّنكُمۡ","يَقُصُّونَ","عَلَيۡكُمۡ","ءَايَـٰتِى","وَيُنذِرُونَكُمۡ","لِقَآءَ","يَوۡمِكُمۡ","هَـٰذَا‌ۚ","قَالُواۡ","شَهِدۡنَا","عَلَىٰٓ","أَنفُسِنَا‌ۖ","وَغَرَّتۡهُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","وَشَهِدُواۡ","عَلَىٰٓ","أَنفُسِهِمۡ","أَنَّهُمۡ","كَانُواۡ","كَـٰفِرِينَ"],"6:135":["قُلۡ","يَـٰقَوۡمِ","ٱعۡمَلُواۡ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّى","عَامِلٌ‌ۖ","فَسَوۡفَ","تَعۡلَمُونَ","مَن","تَكُونُ","لَهُۥ","عَـٰقِبَةُ","ٱلدَّارِ‌ۗ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلظَّـٰلِمُونَ"],"6:164":["قُلۡ","أَغَيۡرَ","ٱللَّهِ","أَبۡغِى","رَبًّا","وَهُوَ","رَبُّ","كُلِّ","شَىۡءٍ‌ۚ","وَلَا","تَكۡسِبُ","كُلُّ","نَفۡسٍ","إِلَّا","عَلَيۡهَا‌ۚ","وَلَا","تَزِرُ","وَازِرَةٌ","وِزۡرَ","أُخۡرَىٰ‌ۚ","ثُمَّ","إِلَىٰ","رَبِّكُم","مَّرۡجِعُكُمۡ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","فِيهِ","تَخۡتَلِفُونَ"],"7:35":["يَـٰبَنِىٓ","ءَادَمَ","إِمَّا","يَأۡتِيَنَّكُمۡ","رُسُلٌ","مِّنكُمۡ","يَقُصُّونَ","عَلَيۡكُمۡ","ءَايَـٰتِى‌ۙ","فَمَنِ","ٱتَّقَىٰ","وَأَصۡلَحَ","فَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"7:189":["۞هُوَ","ٱلَّذِى","خَلَقَكُم","مِّن","نَّفۡسٍ","وٰحِدَةٍ","وَجَعَلَ","مِنۡهَا","زَوۡجَهَا","لِيَسۡكُنَ","إِلَيۡهَا‌ۖ","فَلَمَّا","تَغَشَّـٰهَا","حَمَلَتۡ","حَمۡلاً","خَفِيفًا","فَمَرَّتۡ","بِهِۦ‌ۖ","فَلَمَّآ","أَثۡقَلَت","دَّعَوَا","ٱللَّهَ","رَبَّهُمَا","لَئِنۡ","ءَاتَيۡتَنَا","صَـٰلِحًا","لَّنَكُونَنَّ","مِنَ","ٱلشَّـٰكِرِينَ"],"10:12":["وَإِذَا","مَسَّ","ٱلۡإِنسَـٰنَ","ٱلضُّرُّ","دَعَانَا","لِجَنۢبِهِۦٓ","أَوۡ","قَاعِدًا","أَوۡ","قَآئِمًا","فَلَمَّا","كَشَفۡنَا","عَنۡهُ","ضُرَّهُۥ","مَرَّ","كَأَن","لَّمۡ","يَدۡعُنَآ","إِلَىٰ","ضُرٍّ","مَّسَّهُۥ‌ۚ","كَذٰلِكَ","زُيِّنَ","لِلۡمُسۡرِفِينَ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"10:15":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَاتُنَا","بَيِّنَـٰتٍ‌ۙ","قَالَ","ٱلَّذِينَ","لَا","يَرۡجُونَ","لِقَآءَنَا","ٱئۡتِ","بِقُرۡءَانٍ","غَيۡرِ","هَـٰذَآ","أَوۡ","بَدِّلۡهُ‌ۚ","قُلۡ","مَا","يَكُونُ","لِىٓ","أَنۡ","أُبَدِّلَهُۥ","مِن","تِلۡقَآىِٕ","نَفۡسِىٓ‌ۖ","إِنۡ","أَتَّبِعُ","إِلَّا","مَا","يُوحَىٰٓ","إِلَىَّ‌ۖ","إِنِّىٓ","أَخَافُ","إِنۡ","عَصَيۡتُ","رَبِّى","عَذَابَ","يَوۡمٍ","عَظِيمٍ"],"10:16":["قُل","لَّوۡ","شَآءَ","ٱللَّهُ","مَا","تَلَوۡتُهُۥ","عَلَيۡكُمۡ","وَلَآ","أَدۡرَٮٰكُم","بِهِۦ‌ۖ","فَقَدۡ","لَبِثۡتُ","فِيكُمۡ","عُمُرًا","مِّن","قَبۡلِهِۦٓ‌ۚ","أَفَلَا","تَعۡقِلُونَ"],"10:66":["أَلَآ","إِنَّ","لِلَّهِ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ‌ۗ","وَمَا","يَتَّبِعُ","ٱلَّذِينَ","يَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","شُرَكَآءَ‌ۚ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَإِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"10:108":["قُلۡ","يَـٰٓأَيُّهَا","ٱلنَّاسُ","قَدۡ","جَآءَكُمُ","ٱلۡحَقُّ","مِن","رَّبِّكُمۡ‌ۖ","فَمَنِ","ٱهۡتَدَىٰ","فَإِنَّمَا","يَهۡتَدِى","لِنَفۡسِهِۦ‌ۖ","وَمَن","ضَلَّ","فَإِنَّمَا","يَضِلُّ","عَلَيۡهَا‌ۖ","وَمَآ","أَنَاۡ","عَلَيۡكُم","بِوَكِيلٍ"],"11:93":["وَيَـٰقَوۡمِ","ٱعۡمَلُواۡ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّى","عَـٰمِلٌ‌ۖ","سَوۡفَ","تَعۡلَمُونَ","مَن","يَأۡتِيهِ","عَذَابٌ","يُخۡزِيهِ","وَمَنۡ","هُوَ","كَـٰذِبٌ‌ۖ","وَٱرۡتَقِبُوٓاۡ","إِنِّى","مَعَكُمۡ","رَقِيبٌ"],"12:67":["وَقَالَ","يَـٰبَنِىَّ","لَا","تَدۡخُلُواۡ","مِنۢ","بَابٍ","وٰحِدٍ","وَٱدۡخُلُواۡ","مِنۡ","أَبۡوٰبٍ","مُّتَفَرِّقَةٍ‌ۖ","وَمَآ","أُغۡنِى","عَنكُم","مِّنَ","ٱللَّهِ","مِن","شَىۡءٍ‌ۖ","إِنِ","ٱلۡحُكۡمُ","إِلَّا","لِلَّهِ‌ۖ","عَلَيۡهِ","تَوَكَّلۡتُ‌ۖ","وَعَلَيۡهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُتَوَكِّلُونَ"],"13:18":["لِلَّذِينَ","ٱسۡتَجَابُواۡ","لِرَبِّهِمُ","ٱلۡحُسۡنَىٰ‌ۚ","وَٱلَّذِينَ","لَمۡ","يَسۡتَجِيبُواۡ","لَهُۥ","لَوۡ","أَنَّ","لَهُم","مَّا","فِى","ٱلۡأَرۡضِ","جَمِيعًا","وَمِثۡلَهُۥ","مَعَهُۥ","لَٱفۡتَدَوۡاۡ","بِهِۦٓ‌ۚ","أُوۡلَـٰٓئِكَ","لَهُمۡ","سُوٓءُ","ٱلۡحِسَابِ","وَمَأۡوَٮٰهُمۡ","جَهَنَّمُ‌ۖ","وَبِئۡسَ","ٱلۡمِهَادُ"],"13:26":["ٱللَّهُ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","وَفَرِحُواۡ","بِٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","فِى","ٱلۡأَخِرَةِ","إِلَّا","مَتَـٰعٌ"],"13:33":["أَفَمَنۡ","هُوَ","قَآئِمٌ","عَلَىٰ","كُلِّ","نَفۡسِۭ","بِمَا","كَسَبَتۡ‌ۗ","وَجَعَلُواۡ","لِلَّهِ","شُرَكَآءَ","قُلۡ","سَمُّوهُمۡ‌ۚ","أَمۡ","تُنَبِّــُٔونَهُۥ","بِمَا","لَا","يَعۡلَمُ","فِى","ٱلۡأَرۡضِ","أَم","بِظَـٰهِرٍ","مِّنَ","ٱلۡقَوۡلِ‌ۗ","بَلۡ","زُيِّنَ","لِلَّذِينَ","كَفَرُواۡ","مَكۡرُهُمۡ","وَصُدُّواۡ","عَنِ","ٱلسَّبِيلِ‌ۗ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَمَا","لَهُۥ","مِنۡ","هَادٍ"],"13:34":["لَّهُمۡ","عَذَابٌ","فِى","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا‌ۖ","وَلَعَذَابُ","ٱلۡأَخِرَةِ","أَشَقُّ‌ۖ","وَمَا","لَهُم","مِّنَ","ٱللَّهِ","مِن","وَاقٍ"],"14:12":["وَمَا","لَنَآ","أَلَّا","نَتَوَكَّلَ","عَلَى","ٱللَّهِ","وَقَدۡ","هَدَٮٰنَا","سُبُلَنَا‌ۚ","وَلَنَصۡبِرَنَّ","عَلَىٰ","مَآ","ءَاذَيۡتُمُونَا‌ۚ","وَعَلَى","ٱللَّهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُتَوَكِّلُونَ"],"14:51":["لِيَجۡزِىَ","ٱللَّهُ","كُلَّ","نَفۡسٍ","مَّا","كَسَبَتۡ‌ۚ","إِنَّ","ٱللَّهَ","سَرِيعُ","ٱلۡحِسَابِ"],"16:29":["فَٱدۡخُلُوٓاۡ","أَبۡوٰبَ","جَهَنَّمَ","خَـٰلِدِينَ","فِيهَا‌ۖ","فَلَبِئۡسَ","مَثۡوَى","ٱلۡمُتَكَبِّرِينَ"],"16:30":["۞وَقِيلَ","لِلَّذِينَ","ٱتَّقَوۡاۡ","مَاذَآ","أَنزَلَ","رَبُّكُمۡ‌ۚ","قَالُواۡ","خَيۡرًا‌ۗ","لِّلَّذِينَ","أَحۡسَنُواۡ","فِى","هَـٰذِهِ","ٱلدُّنۡيَا","حَسَنَةٌ‌ۚ","وَلَدَارُ","ٱلۡأَخِرَةِ","خَيۡرٌ‌ۚ","وَلَنِعۡمَ","دَارُ","ٱلۡمُتَّقِينَ"],"16:34":["فَأَصَابَهُمۡ","سَيِّـَٔـاتُ","مَا","عَمِلُواۡ","وَحَاقَ","بِهِم","مَّا","كَانُواۡ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"16:35":["وَقَالَ","ٱلَّذِينَ","أَشۡرَكُواۡ","لَوۡ","شَآءَ","ٱللَّهُ","مَا","عَبَدۡنَا","مِن","دُونِهِۦ","مِن","شَىۡءٍ","نَّحۡنُ","وَلَآ","ءَابَآؤُنَا","وَلَا","حَرَّمۡنَا","مِن","دُونِهِۦ","مِن","شَىۡءٍ‌ۚ","كَذٰلِكَ","فَعَلَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ‌ۚ","فَهَلۡ","عَلَى","ٱلرُّسُلِ","إِلَّا","ٱلۡبَلَـٰغُ","ٱلۡمُبِينُ"],"16:96":["مَا","عِندَكُمۡ","يَنفَدُ‌ۖ","وَمَا","عِندَ","ٱللَّهِ","بَاقٍ‌ۗ","وَلَنَجۡزِيَنَّ","ٱلَّذِينَ","صَبَرُوٓاۡ","أَجۡرَهُم","بِأَحۡسَنِ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"16:97":["مَنۡ","عَمِلَ","صَـٰلِحًا","مِّن","ذَكَرٍ","أَوۡ","أُنثَىٰ","وَهُوَ","مُؤۡمِنٌ","فَلَنُحۡيِيَنَّهُۥ","حَيَوٰةً","طَيِّبَةً‌ۖ","وَلَنَجۡزِيَنَّهُمۡ","أَجۡرَهُم","بِأَحۡسَنِ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"16:98":["فَإِذَا","قَرَأۡتَ","ٱلۡقُرۡءَانَ","فَٱسۡتَعِذۡ","بِٱللَّهِ","مِنَ","ٱلشَّيۡطَـٰنِ","ٱلرَّجِيمِ"],"16:111":["۞يَوۡمَ","تَأۡتِى","كُلُّ","نَفۡسٍ","تُجَـٰدِلُ","عَن","نَّفۡسِهَا","وَتُوَفَّىٰ","كُلُّ","نَفۡسٍ","مَّا","عَمِلَتۡ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"16:112":["وَضَرَبَ","ٱللَّهُ","مَثَلاً","قَرۡيَةً","كَانَتۡ","ءَامِنَةً","مُّطۡمَئِنَّةً","يَأۡتِيهَا","رِزۡقُهَا","رَغَدًا","مِّن","كُلِّ","مَكَانٍ","فَكَفَرَتۡ","بِأَنۡعُمِ","ٱللَّهِ","فَأَذٰقَهَا","ٱللَّهُ","لِبَاسَ","ٱلۡجُوعِ","وَٱلۡخَوۡفِ","بِمَا","كَانُواۡ","يَصۡنَعُونَ"],"17:15":["مَّنِ","ٱهۡتَدَىٰ","فَإِنَّمَا","يَهۡتَدِى","لِنَفۡسِهِۦ‌ۖ","وَمَن","ضَلَّ","فَإِنَّمَا","يَضِلُّ","عَلَيۡهَا‌ۚ","وَلَا","تَزِرُ","وَازِرَةٌ","وِزۡرَ","أُخۡرَىٰ‌ۗ","وَمَا","كُنَّا","مُعَذِّبِينَ","حَتَّىٰ","نَبۡعَثَ","رَسُولاً"],"17:30":["إِنَّ","رَبَّكَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّهُۥ","كَانَ","بِعِبَادِهِۦ","خَبِيرَۢا","بَصِيرًا"],"22:18":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يَسۡجُدُ","لَهُۥ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","وَٱلشَّمۡسُ","وَٱلۡقَمَرُ","وَٱلنُّجُومُ","وَٱلۡجِبَالُ","وَٱلشَّجَرُ","وَٱلدَّوَآبُّ","وَكَثِيرٌ","مِّنَ","ٱلنَّاسِ‌ۖ","وَكَثِيرٌ","حَقَّ","عَلَيۡهِ","ٱلۡعَذَابُ‌ۗ","وَمَن","يُهِنِ","ٱللَّهُ","فَمَا","لَهُۥ","مِن","مُّكۡرِمٍ‌ۚ","إِنَّ","ٱللَّهَ","يَفۡعَلُ","مَا","يَشَآءُ"],"22:63":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَتُصۡبِحُ","ٱلۡأَرۡضُ","مُخۡضَرَّةً‌ۗ","إِنَّ","ٱللَّهَ","لَطِيفٌ","خَبِيرٌ"],"27:87":["وَيَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ","فَفَزِعَ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","إِلَّا","مَن","شَآءَ","ٱللَّهُ‌ۚ","وَكُلٌّ","أَتَوۡهُ","دٰخِرِينَ"],"28:82":["وَأَصۡبَحَ","ٱلَّذِينَ","تَمَنَّوۡاۡ","مَكَانَهُۥ","بِٱلۡأَمۡسِ","يَقُولُونَ","وَيۡكَأَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ‌ۖ","لَوۡلَآ","أَن","مَّنَّ","ٱللَّهُ","عَلَيۡنَا","لَخَسَفَ","بِنَا‌ۖ","وَيۡكَأَنَّهُۥ","لَا","يُفۡلِحُ","ٱلۡكَـٰفِرُونَ"],"29:7":["وَٱلَّذِينَ","ءَامَنُواۡ","وَعَمِلُواۡ","ٱلصَّـٰلِحَـٰتِ","لَنُكَفِّرَنَّ","عَنۡهُمۡ","سَيِّـَٔـاتِهِمۡ","وَلَنَجۡزِيَنَّهُمۡ","أَحۡسَنَ","ٱلَّذِى","كَانُواۡ","يَعۡمَلُونَ"],"29:8":["وَوَصَّيۡنَا","ٱلۡإِنسَـٰنَ","بِوٰلِدَيۡهِ","حُسۡنًا‌ۖ","وَإِن","جَـٰهَدَاكَ","لِتُشۡرِكَ","بِى","مَا","لَيۡسَ","لَكَ","بِهِۦ","عِلۡمٌ","فَلَا","تُطِعۡهُمَآ‌ۚ","إِلَىّ