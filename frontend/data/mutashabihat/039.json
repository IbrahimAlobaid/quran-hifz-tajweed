:["وَلَا","تَزِرُ","وَازِرَةٌ","وِزۡرَ","أُخۡرَىٰۚ","وَإِن","تَدۡعُ","مُثۡقَلَةٌ","إِلَىٰ","حِمۡلِهَا","لَا","يُحۡمَلۡ","مِنۡهُ","شَىۡءٌ","وَلَوۡ","كَانَ","ذَا","قُرۡبَىٰٓۗ","إِنَّمَا","تُنذِرُ","ٱلَّذِينَ","يَخۡشَوۡنَ","رَبَّهُم","بِٱلۡغَيۡبِ","وَأَقَامُواۡ","ٱلصَّلَوٰةَۚ","وَمَن","تَزَكَّىٰ","فَإِنَّمَا","يَتَزَكَّىٰ","لِنَفۡسِهِۚۦ","وَإِلَى","ٱللَّهِ","ٱلۡمَصِيرُ"],"35:27":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَأَخۡرَجۡنَا","بِهِۦ","ثَمَرٰتٍ","مُّخۡتَلِفًا","أَلۡوٰنُهَاۚ","وَمِنَ","ٱلۡجِبَالِ","جُدَدُۢ","بِيضٌ","وَحُمۡرٌ","مُّخۡتَلِفٌ","أَلۡوٰنُهَا","وَغَرَابِيبُ","سُودٌ"],"36:51":["وَنُفِخَ","فِى","ٱلصُّورِ","فَإِذَا","هُم","مِّنَ","ٱلۡأَجۡدَاثِ","إِلَىٰ","رَبِّهِمۡ","يَنسِلُونَ"],"39:2":["إِنَّآ","أَنزَلۡنَآ","إِلَيۡكَ","ٱلۡكِتَـٰبَ","بِٱلۡحَقِّ","فَٱعۡبُدِ","ٱللَّهَ","مُخۡلِصًا","لَّهُ","ٱلدِّينَ"],"39:3":["أَلَا","لِلَّهِ","ٱلدِّينُ","ٱلۡخَالِصُ‌ۚ","وَٱلَّذِينَ","ٱتَّخَذُواۡ","مِن","دُونِهِۦٓ","أَوۡلِيَآءَ","مَا","نَعۡبُدُهُمۡ","إِلَّا","لِيُقَرِّبُونَآ","إِلَى","ٱللَّهِ","زُلۡفَىٰٓ","إِنَّ","ٱللَّهَ","يَحۡكُمُ","بَيۡنَهُمۡ","فِى","مَا","هُمۡ","فِيهِ","يَخۡتَلِفُونَ‌ۗ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِى","مَنۡ","هُوَ","كَـٰذِبٌ","كَفَّارٌ"],"39:6":["خَلَقَكُم","مِّن","نَّفۡسٍ","وٰحِدَةٍ","ثُمَّ","جَعَلَ","مِنۡهَا","زَوۡجَهَا","وَأَنزَلَ","لَكُم","مِّنَ","ٱلۡأَنۡعَـٰمِ","ثَمَـٰنِيَةَ","أَزۡوٰجٍ‌ۚ","يَخۡلُقُكُمۡ","فِى","بُطُونِ","أُمَّهَـٰتِكُمۡ","خَلۡقًا","مِّنۢ","بَعۡدِ","خَلۡقٍ","فِى","ظُلُمَـٰتٍ","ثَلَـٰثٍ‌ۚ","ذٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","لَهُ","ٱلۡمُلۡكُ‌ۖ","لَآ","إِلَـٰهَ","إِلَّا","هُوَ‌ۖ","فَأَنَّىٰ","تُصۡرَفُونَ"],"39:7":["إِن","تَكۡفُرُواۡ","فَإِنَّ","ٱللَّهَ","غَنِىٌّ","عَنكُمۡ‌ۖ","وَلَا","يَرۡضَىٰ","لِعِبَادِهِ","ٱلۡكُفۡرَ‌ۖ","وَإِن","تَشۡكُرُواۡ","يَرۡضَهُ","لَكُمۡ‌ۗ","وَلَا","تَزِرُ","وَازِرَةٌ","وِزۡرَ","أُخۡرَىٰ‌ۗ","ثُمَّ","إِلَىٰ","رَبِّكُم","مَّرۡجِعُكُمۡ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ‌ۚ","إِنَّهُۥ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"39:8":["۞وَإِذَا","مَسَّ","ٱلۡإِنسَـٰنَ","ضُرٌّ","دَعَا","رَبَّهُۥ","مُنِيبًا","إِلَيۡهِ","ثُمَّ","إِذَا","خَوَّلَهُۥ","نِعۡمَةً","مِّنۡهُ","نَسِىَ","مَا","كَانَ","يَدۡعُوٓاۡ","إِلَيۡهِ","مِن","قَبۡلُ","وَجَعَلَ","لِلَّهِ","أَندَادًا","لِّيُضِلَّ","عَن","سَبِيلِهِۦ‌ۚ","قُلۡ","تَمَتَّعۡ","بِكُفۡرِكَ","قَلِيلاً‌ۖ","إِنَّكَ","مِنۡ","أَصۡحَـٰبِ","ٱلنَّارِ"],"39:10":["قُلۡ","يَـٰعِبَادِ","ٱلَّذِينَ","ءَامَنُواۡ","ٱتَّقُواۡ","رَبَّكُمۡ‌ۚ","لِلَّذِينَ","أَحۡسَنُواۡ","فِى","هَـٰذِهِ","ٱلدُّنۡيَا","حَسَنَةٌ‌ۗ","وَأَرۡضُ","ٱللَّهِ","وٰسِعَةٌ‌ۗ","إِنَّمَا","يُوَفَّى","ٱلصَّـٰبِرُونَ","أَجۡرَهُم","بِغَيۡرِ","حِسَابٍ"],"39:11":["قُلۡ","إِنِّىٓ","أُمِرۡتُ","أَنۡ","أَعۡبُدَ","ٱللَّهَ","مُخۡلِصًا","لَّهُ","ٱلدِّينَ"],"39:13":["قُلۡ","إِنِّىٓ","أَخَافُ","إِنۡ","عَصَيۡتُ","رَبِّى","عَذَابَ","يَوۡمٍ","عَظِيمٍ"],"39:14":["قُلِ","ٱللَّهَ","أَعۡبُدُ","مُخۡلِصًا","لَّهُۥ","دِينِى"],"39:15":["فَٱعۡبُدُواۡ","مَا","شِئۡتُم","مِّن","دُونِهِۦ‌ۗ","قُلۡ","إِنَّ","ٱلۡخَـٰسِرِينَ","ٱلَّذِينَ","خَسِرُوٓاۡ","أَنفُسَهُمۡ","وَأَهۡلِيهِمۡ","يَوۡمَ","ٱلۡقِيَـٰمَةِ‌ۗ","أَلَا","ذٰلِكَ","هُوَ","ٱلۡخُسۡرَانُ","ٱلۡمُبِينُ"],"39:21":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَسَلَكَهُۥ","يَنَـٰبِيعَ","فِى","ٱلۡأَرۡضِ","ثُمَّ","يُخۡرِجُ","بِهِۦ","زَرۡعًا","مُّخۡتَلِفًا","أَلۡوٰنُهُۥ","ثُمَّ","يَهِيجُ","فَتَرَٮٰهُ","مُصۡفَرًّا","ثُمَّ","يَجۡعَلُهُۥ","حُطَـٰمًا‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَذِكۡرَىٰ","لِأُوۡلِى","ٱلۡأَلۡبَـٰبِ"],"39:23":["ٱللَّهُ","نَزَّلَ","أَحۡسَنَ","ٱلۡحَدِيثِ","كِتَـٰبًا","مُّتَشَـٰبِهًا","مَّثَانِىَ","تَقۡشَعِرُّ","مِنۡهُ","جُلُودُ","ٱلَّذِينَ","يَخۡشَوۡنَ","رَبَّهُمۡ","ثُمَّ","تَلِينُ","جُلُودُهُمۡ","وَقُلُوبُهُمۡ","إِلَىٰ","ذِكۡرِ","ٱللَّهِ‌ۚ","ذٰلِكَ","هُدَى","ٱللَّهِ","يَهۡدِى","بِهِۦ","مَن","يَشَآءُ‌ۚ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَمَا","لَهُۥ","مِنۡ","هَادٍ"],"39:24":["أَفَمَن","يَتَّقِى","بِوَجۡهِهِۦ","سُوٓءَ","ٱلۡعَذَابِ","يَوۡمَ","ٱلۡقِيَـٰمَةِ‌ۚ","وَقِيلَ","لِلظَّـٰلِمِينَ","ذُوقُواۡ","مَا","كُنتُمۡ","تَكۡسِبُونَ"],"39:25":["كَذَّبَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","فَأَتَـٰهُمُ","ٱلۡعَذَابُ","مِنۡ","حَيۡثُ","لَا","يَشۡعُرُونَ"],"39:27":["وَلَقَدۡ","ضَرَبۡنَا","لِلنَّاسِ","فِى","هَـٰذَا","ٱلۡقُرۡءَانِ","مِن","كُلِّ","مَثَلٍ","لَّعَلَّهُمۡ","يَتَذَكَّرُونَ"],"39:32":["۞فَمَنۡ","أَظۡلَمُ","مِمَّن","كَذَبَ","عَلَى","ٱللَّهِ","وَكَذَّبَ","بِٱلصِّدۡقِ","إِذۡ","جَآءَهُۥٓ‌ۚ","أَلَيۡسَ","فِى","جَهَنَّمَ","مَثۡوًى","لِّلۡكَـٰفِرِينَ"],"39:35":["لِيُكَفِّرَ","ٱللَّهُ","عَنۡهُمۡ","أَسۡوَأَ","ٱلَّذِى","عَمِلُواۡ","وَيَجۡزِيَهُمۡ","أَجۡرَهُم","بِأَحۡسَنِ","ٱلَّذِى","كَانُواۡ","يَعۡمَلُونَ"],"39:36":["أَلَيۡسَ","ٱللَّهُ","بِكَافٍ","عَبۡدَهُۥ‌ۖ","وَيُخَوِّفُونَكَ","بِٱلَّذِينَ","مِن","دُونِهِۦ‌ۚ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَمَا","لَهُۥ","مِنۡ","هَادٍ"],"39:37":["وَمَن","يَهۡدِ","ٱللَّهُ","فَمَا","لَهُۥ","مِن","مُّضِلٍّ‌ۗ","أَلَيۡسَ","ٱللَّهُ","بِعَزِيزٍ","ذِى","ٱنتِقَامٍ"],"39:38":["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","لَيَقُولُنَّ","ٱللَّهُ‌ۚ","قُلۡ","أَفَرَءَيۡتُم","مَّا","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","إِنۡ","أَرَادَنِىَ","ٱللَّهُ","بِضُرٍّ","هَلۡ","هُنَّ","كَـٰشِفَـٰتُ","ضُرِّهِۦٓ","أَوۡ","أَرَادَنِى","بِرَحۡمَةٍ","هَلۡ","هُنَّ","مُمۡسِكَـٰتُ","رَحۡمَتِهِۦ‌ۚ","قُلۡ","حَسۡبِىَ","ٱللَّهُ‌ۖ","عَلَيۡهِ","يَتَوَكَّلُ","ٱلۡمُتَوَكِّلُونَ"],"39:39":["قُلۡ","يَـٰقَوۡمِ","ٱعۡمَلُواۡ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّى","عَـٰمِلٌ‌ۖ","فَسَوۡفَ","تَعۡلَمُونَ"],"39:41":["إِنَّآ","أَنزَلۡنَا","عَلَيۡكَ","ٱلۡكِتَـٰبَ","لِلنَّاسِ","بِٱلۡحَقِّ‌ۖ","فَمَنِ","ٱهۡتَدَىٰ","فَلِنَفۡسِهِۦ‌ۖ","وَمَن","ضَلَّ","فَإِنَّمَا","يَضِلُّ","عَلَيۡهَا‌ۖ","وَمَآ","أَنتَ","عَلَيۡهِم","بِوَكِيلٍ"],"39:47":["وَلَوۡ","أَنَّ","لِلَّذِينَ","ظَلَمُواۡ","مَا","فِى","ٱلۡأَرۡضِ","جَمِيعًا","وَمِثۡلَهُۥ","مَعَهُۥ","لَٱفۡتَدَوۡاۡ","بِهِۦ","مِن","سُوٓءِ","ٱلۡعَذَابِ","يَوۡمَ","ٱلۡقِيَـٰمَةِ‌ۚ","وَبَدَا","لَهُم","مِّنَ","ٱللَّهِ","مَا","لَمۡ","يَكُونُواۡ","يَحۡتَسِبُونَ"],"39:48":["وَبَدَا","لَهُمۡ","سَيِّـَٔـاتُ","مَا","كَسَبُواۡ","وَحَاقَ","بِهِم","مَّا","كَانُواۡ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"39:49":["فَإِذَا","مَسَّ","ٱلۡإِنسَـٰنَ","ضُرٌّ","دَعَانَا","ثُمَّ","إِذَا","خَوَّلۡنَـٰهُ","نِعۡمَةً","مِّنَّا","قَالَ","إِنَّمَآ","أُوتِيتُهُۥ","عَلَىٰ","عِلۡمِۭ‌ۚ","بَلۡ","هِىَ","فِتۡنَةٌ","وَلَـٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"39:51":["فَأَصَابَهُمۡ","سَيِّـَٔـاتُ","مَا","كَسَبُواۡ‌ۚ","وَٱلَّذِينَ","ظَلَمُواۡ","مِنۡ","هَـٰٓؤُلَآءِ","سَيُصِيبُهُمۡ","سَيِّـَٔـاتُ","مَا","كَسَبُواۡ","وَمَا","هُم","بِمُعۡجِزِينَ"],"39:52":["أَوَلَمۡ","يَعۡلَمُوٓاۡ","أَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"39:63":["لَّهُۥ","مَقَالِيدُ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ‌ۗ","وَٱلَّذِينَ","كَفَرُواۡ","بِـَٔـايَـٰتِ","ٱللَّهِ","أُوۡلَـٰٓئِكَ","هُمُ","ٱلۡخَـٰسِرُونَ"],"39:67":["وَمَا","قَدَرُواۡ","ٱللَّهَ","حَقَّ","قَدۡرِهِۦ","وَٱلۡأَرۡضُ","جَمِيعًا","قَبۡضَتُهُۥ","يَوۡمَ","ٱلۡقِيَـٰمَةِ","وَٱلسَّمَـٰوٰتُ","مَطۡوِيَّـٰتُۢ","بِيَمِينِهِۦ‌ۚ","سُبۡحَـٰنَهُۥ","وَتَعَـٰلَىٰ","عَمَّا","يُشۡرِكُونَ"],"39:68":["وَنُفِخَ","فِى","ٱلصُّورِ","فَصَعِقَ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","إِلَّا","مَن","شَآءَ","ٱللَّهُ‌ۖ","ثُمَّ","نُفِخَ","فِيهِ","أُخۡرَىٰ","فَإِذَا","هُمۡ","قِيَامٌ","يَنظُرُونَ"],"39:70":["وَوُفِّيَتۡ","كُلُّ","نَفۡسٍ","مَّا","عَمِلَتۡ","وَهُوَ","أَعۡلَمُ","بِمَا","يَفۡعَلُونَ"],"39:71":["وَسِيقَ","ٱلَّذِينَ","كَفَرُوٓاۡ","إِلَىٰ","جَهَنَّمَ","زُمَرًا‌ۖ","حَتَّىٰٓ","إِذَا","جَآءُوهَا","فُتِحَتۡ","أَبۡوٰبُهَا","وَقَالَ","لَهُمۡ","خَزَنَتُهَآ","أَلَمۡ","يَأۡتِكُمۡ","رُسُلٌ","مِّنكُمۡ","يَتۡلُونَ","عَلَيۡكُمۡ","ءَايَـٰتِ","رَبِّكُمۡ","وَيُنذِرُونَكُمۡ","لِقَآءَ","يَوۡمِكُمۡ","هَـٰذَا‌ۚ","قَالُواۡ","بَلَىٰ","وَلَـٰكِنۡ","حَقَّتۡ","كَلِمَةُ","ٱلۡعَذَابِ","عَلَى","ٱلۡكَـٰفِرِينَ"],"39:72":["قِيلَ","ٱدۡخُلُوٓاۡ","أَبۡوٰبَ","جَهَنَّمَ","خَـٰلِدِينَ","فِيهَا‌ۖ","فَبِئۡسَ","مَثۡوَى","ٱلۡمُتَكَبِّرِينَ"],"39:73":["وَسِيقَ","ٱلَّذِينَ","ٱتَّقَوۡاۡ","رَبَّهُمۡ","إِلَى","ٱلۡجَنَّةِ","زُمَرًا‌ۖ","حَتَّىٰٓ","إِذَا","جَآءُوهَا","وَفُتِحَتۡ","أَبۡوٰبُهَا","وَقَالَ","لَهُمۡ","خَزَنَتُهَا","سَلَـٰمٌ","عَلَيۡكُمۡ","طِبۡتُمۡ","فَٱدۡخُلُوهَا","خَـٰلِد