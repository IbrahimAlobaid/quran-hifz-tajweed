,"نَقُصُّ","عَلَيۡكَ","مِنۡ","أَنۢبَآئِهَا‌ۚ","وَلَقَدۡ","جَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَـٰتِ","فَمَا","كَانُواۡ","لِيُؤۡمِنُواۡ","بِمَا","كَذَّبُواۡ","مِن","قَبۡلُ‌ۚ","كَذٰلِكَ","يَطۡبَعُ","ٱللَّهُ","عَلَىٰ","قُلُوبِ","ٱلۡكَـٰفِرِينَ"],"7:103":["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِم","مُّوسَىٰ","بِـَٔـايَـٰتِنَآ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦ","فَظَلَمُواۡ","بِهَا‌ۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُفۡسِدِينَ"],"7:116":["قَالَ","أَلۡقُواۡ‌ۖ","فَلَمَّآ","أَلۡقَوۡاۡ","سَحَرُوٓاۡ","أَعۡيُنَ","ٱلنَّاسِ","وَٱسۡتَرۡهَبُوهُمۡ","وَجَآءُو","بِسِحۡرٍ","عَظِيمٍ"],"7:138":["وَجَـٰوَزۡنَا","بِبَنِىٓ","إِسۡرٰٓءِيلَ","ٱلۡبَحۡرَ","فَأَتَوۡاۡ","عَلَىٰ","قَوۡمٍ","يَعۡكُفُونَ","عَلَىٰٓ","أَصۡنَامٍ","لَّهُمۡ‌ۚ","قَالُواۡ","يَـٰمُوسَى","ٱجۡعَل","لَّنَآ","إِلَـٰهًا","كَمَا","لَهُمۡ","ءَالِهَةٌ‌ۚ","قَالَ","إِنَّكُمۡ","قَوۡمٌ","تَجۡهَلُونَ"],"7:188":["قُل","لَّآ","أَمۡلِكُ","لِنَفۡسِى","نَفۡعًا","وَلَا","ضَرًّا","إِلَّا","مَا","شَآءَ","ٱللَّهُ‌ۚ","وَلَوۡ","كُنتُ","أَعۡلَمُ","ٱلۡغَيۡبَ","لَٱسۡتَكۡثَرۡتُ","مِنَ","ٱلۡخَيۡرِ","وَمَا","مَسَّنِىَ","ٱلسُّوٓءُ‌ۚ","إِنۡ","أَنَاۡ","إِلَّا","نَذِيرٌ","وَبَشِيرٌ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"8:31":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","قَالُواۡ","قَدۡ","سَمِعۡنَا","لَوۡ","نَشَآءُ","لَقُلۡنَا","مِثۡلَ","هَـٰذَآ‌ۙ","إِنۡ","هَـٰذَآ","إِلَّآ","أَسَـٰطِيرُ","ٱلۡأَوَّلِينَ"],"9:72":["وَعَدَ","ٱللَّهُ","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَـٰتِ","جَنَّـٰتٍ","تَجۡرِى","مِن","تَحۡتِهَا","ٱلۡأَنۡهَـٰرُ","خَـٰلِدِينَ","فِيهَا","وَمَسَـٰكِنَ","طَيِّبَةً","فِى","جَنَّـٰتِ","عَدۡنٍ‌ۚ","وَرِضۡوٰنٌ","مِّنَ","ٱللَّهِ","أَكۡبَرُ‌ۚ","ذٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"10:3":["إِنَّ","رَبَّكُمُ","ٱللَّهُ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۖ","يُدَبِّرُ","ٱلۡأَمۡرَ‌ۖ","مَا","مِن","شَفِيعٍ","إِلَّا","مِنۢ","بَعۡدِ","إِذۡنِهِۦ‌ۚ","ذٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","فَٱعۡبُدُوهُ‌ۚ","أَفَلَا","تَذَكَّرُونَ"],"10:12":["وَإِذَا","مَسَّ","ٱلۡإِنسَـٰنَ","ٱلضُّرُّ","دَعَانَا","لِجَنۢبِهِۦٓ","أَوۡ","قَاعِدًا","أَوۡ","قَآئِمًا","فَلَمَّا","كَشَفۡنَا","عَنۡهُ","ضُرَّهُۥ","مَرَّ","كَأَن","لَّمۡ","يَدۡعُنَآ","إِلَىٰ","ضُرٍّ","مَّسَّهُۥ‌ۚ","كَذٰلِكَ","زُيِّنَ","لِلۡمُسۡرِفِينَ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"10:15":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَاتُنَا","بَيِّنَـٰتٍ‌ۙ","قَالَ","ٱلَّذِينَ","لَا","يَرۡجُونَ","لِقَآءَنَا","ٱئۡتِ","بِقُرۡءَانٍ","غَيۡرِ","هَـٰذَآ","أَوۡ","بَدِّلۡهُ‌ۚ","قُلۡ","مَا","يَكُونُ","لِىٓ","أَنۡ","أُبَدِّلَهُۥ","مِن","تِلۡقَآىِٕ","نَفۡسِىٓ‌ۖ","إِنۡ","أَتَّبِعُ","إِلَّا","مَا","يُوحَىٰٓ","إِلَىَّ‌ۖ","إِنِّىٓ","أَخَافُ","إِنۡ","عَصَيۡتُ","رَبِّى","عَذَابَ","يَوۡمٍ","عَظِيمٍ"],"10:17":["فَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","كَذَّبَ","بِـَٔـايَـٰتِهِۦٓ‌ۚ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلۡمُجۡرِمُونَ"],"10:19":["وَمَا","كَانَ","ٱلنَّاسُ","إِلَّآ","أُمَّةً","وٰحِدَةً","فَٱخۡتَلَفُواۡ‌ۚ","وَلَوۡلَا","كَلِمَةٌ","سَبَقَتۡ","مِن","رَّبِّكَ","لَقُضِىَ","بَيۡنَهُمۡ","فِيمَا","فِيهِ","يَخۡتَلِفُونَ"],"10:20":["وَيَقُولُونَ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَةٌ","مِّن","رَّبِّهِۦ‌ۖ","فَقُلۡ","إِنَّمَا","ٱلۡغَيۡبُ","لِلَّهِ","فَٱنتَظِرُوٓاۡ","إِنِّى","مَعَكُم","مِّنَ","ٱلۡمُنتَظِرِينَ"],"10:21":["وَإِذَآ","أَذَقۡنَا","ٱلنَّاسَ","رَحۡمَةً","مِّنۢ","بَعۡدِ","ضَرَّآءَ","مَسَّتۡهُمۡ","إِذَا","لَهُم","مَّكۡرٌ","فِىٓ","ءَايَاتِنَا‌ۚ","قُلِ","ٱللَّهُ","أَسۡرَعُ","مَكۡرًا‌ۚ","إِنَّ","رُسُلَنَا","يَكۡتُبُونَ","مَا","تَمۡكُرُونَ"],"10:28":["وَيَوۡمَ","نَحۡشُرُهُمۡ","جَمِيعًا","ثُمَّ","نَقُولُ","لِلَّذِينَ","أَشۡرَكُواۡ","مَكَانَكُمۡ","أَنتُمۡ","وَشُرَكَآؤُكُمۡ‌ۚ","فَزَيَّلۡنَا","بَيۡنَهُمۡ‌ۖ","وَقَالَ","شُرَكَآؤُهُم","مَّا","كُنتُمۡ","إِيَّانَا","تَعۡبُدُونَ"],"10:29":["فَكَفَىٰ","بِٱللَّهِ","شَهِيدَۢا","بَيۡنَنَا","وَبَيۡنَكُمۡ","إِن","كُنَّا","عَنۡ","عِبَادَتِكُمۡ","لَغَـٰفِلِينَ"],"10:31":["قُلۡ","مَن","يَرۡزُقُكُم","مِّنَ","ٱلسَّمَآءِ","وَٱلۡأَرۡضِ","أَمَّن","يَمۡلِكُ","ٱلسَّمۡعَ","وَٱلۡأَبۡصَـٰرَ","وَمَن","يُخۡرِجُ","ٱلۡحَىَّ","مِنَ","ٱلۡمَيِّتِ","وَيُخۡرِجُ","ٱلۡمَيِّتَ","مِنَ","ٱلۡحَىِّ","وَمَن","يُدَبِّرُ","ٱلۡأَمۡرَ‌ۚ","فَسَيَقُولُونَ","ٱللَّهُ‌ۚ","فَقُلۡ","أَفَلَا","تَتَّقُونَ"],"10:33":["كَذٰلِكَ","حَقَّتۡ","كَلِمَتُ","رَبِّكَ","عَلَى","ٱلَّذِينَ","فَسَقُوٓاۡ","أَنَّهُمۡ","لَا","يُؤۡمِنُونَ"],"10:37":["وَمَا","كَانَ","هَـٰذَا","ٱلۡقُرۡءَانُ","أَن","يُفۡتَرَىٰ","مِن","دُونِ","ٱللَّهِ","وَلَـٰكِن","تَصۡدِيقَ","ٱلَّذِى","بَيۡنَ","يَدَيۡهِ","وَتَفۡصِيلَ","ٱلۡكِتَـٰبِ","لَا","رَيۡبَ","فِيهِ","مِن","رَّبِّ","ٱلۡعَـٰلَمِينَ"],"10:38":["أَمۡ","يَقُولُونَ","ٱفۡتَرَٮٰهُ‌ۖ","قُلۡ","فَأۡتُواۡ","بِسُورَةٍ","مِّثۡلِهِۦ","وَٱدۡعُواۡ","مَنِ","ٱسۡتَطَعۡتُم","مِّن","دُونِ","ٱللَّهِ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"10:42":["وَمِنۡهُم","مَّن","يَسۡتَمِعُونَ","إِلَيۡكَ‌ۚ","أَفَأَنتَ","تُسۡمِعُ","ٱلصُّمَّ","وَلَوۡ","كَانُواۡ","لَا","يَعۡقِلُونَ"],"10:45":["وَيَوۡمَ","يَحۡشُرُهُمۡ","كَأَن","لَّمۡ","يَلۡبَثُوٓاۡ","إِلَّا","سَاعَةً","مِّنَ","ٱلنَّهَارِ","يَتَعَارَفُونَ","بَيۡنَهُمۡ‌ۚ","قَدۡ","خَسِرَ","ٱلَّذِينَ","كَذَّبُواۡ","بِلِقَآءِ","ٱللَّهِ","وَمَا","كَانُواۡ","مُهۡتَدِينَ"],"10:46":["وَإِمَّا","نُرِيَنَّكَ","بَعۡضَ","ٱلَّذِى","نَعِدُهُمۡ","أَوۡ","نَتَوَفَّيَنَّكَ","فَإِلَيۡنَا","مَرۡجِعُهُمۡ","ثُمَّ","ٱللَّهُ","شَهِيدٌ","عَلَىٰ","مَا","يَفۡعَلُونَ"],"10:48":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"10:49":["قُل","لَّآ","أَمۡلِكُ","لِنَفۡسِى","ضَرًّا","وَلَا","نَفۡعًا","إِلَّا","مَا","شَآءَ","ٱللَّهُ‌ۗ","لِكُلِّ","أُمَّةٍ","أَجَلٌ‌ۚ","إِذَا","جَآءَ","أَجَلُهُمۡ","فَلَا","يَسۡتَــٔۡخِرُونَ","سَاعَةً‌ۖ","وَلَا","يَسۡتَقۡدِمُونَ"],"10:50":["قُلۡ","أَرَءَيۡتُمۡ","إِنۡ","أَتَـٰكُمۡ","عَذَابُهُۥ","بَيَـٰتًا","أَوۡ","نَهَارًا","مَّاذَا","يَسۡتَعۡجِلُ","مِنۡهُ","ٱلۡمُجۡرِمُونَ"],"10:54":["وَلَوۡ","أَنَّ","لِكُلِّ","نَفۡسٍ","ظَلَمَتۡ","مَا","فِى","ٱلۡأَرۡضِ","لَٱفۡتَدَتۡ","بِهِۦ‌ۗ","وَأَسَرُّواۡ","ٱلنَّدَامَةَ","لَمَّا","رَأَوُاۡ","ٱلۡعَذَابَ‌ۖ","وَقُضِىَ","بَيۡنَهُم","بِٱلۡقِسۡطِ‌ۚ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"10:60":["وَمَا","ظَنُّ","ٱلَّذِينَ","يَفۡتَرُونَ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","يَوۡمَ","ٱلۡقِيَـٰمَةِ‌ۗ","إِنَّ","ٱللَّهَ","لَذُو","فَضۡلٍ","عَلَى","ٱلنَّاسِ","وَلَـٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَشۡكُرُونَ"],"10:61":["وَمَا","تَكُونُ","فِى","شَأۡنٍ","وَمَا","تَتۡلُواۡ","مِنۡهُ","مِن","قُرۡءَانٍ","وَلَا","تَعۡمَلُونَ","مِنۡ","عَمَلٍ","إِلَّا","كُنَّا","عَلَيۡكُمۡ","شُهُودًا","إِذۡ","تُفِيضُونَ","فِيهِ‌ۚ","وَمَا","يَعۡزُبُ","عَن","رَّبِّكَ","مِن","مِّثۡقَالِ","ذَرَّةٍ","فِى","ٱلۡأَرۡضِ","وَلَا","فِى","ٱلسَّمَآءِ","وَلَآ","أَصۡغَرَ","مِن","ذٰلِكَ","وَلَآ","أَكۡبَرَ","إِلَّا","فِى","كِتَـٰبٍ","مُّبِينٍ"],"10:62":["أَلَآ","إِنَّ","أَوۡلِيَآءَ","ٱللَّهِ","لَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"10:64":["لَهُمُ","ٱلۡبُشۡرَىٰ","فِى","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَفِى","ٱلۡأَخِرَةِ‌ۚ","لَا","تَبۡدِيلَ","لِكَلِمَـٰتِ","ٱللَّهِ‌ۚ","ذٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"10:65":["وَلَا","يَحۡزُنكَ","قَوۡلُهُمۡ‌ۘ","إِنَّ","ٱلۡعِزَّةَ","لِلَّهِ","جَمِيعًا‌ۚ","هُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"10:66":["أَلَآ","إِنَّ","لِلَّهِ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ‌ۗ","وَمَا","يَتَّبِعُ","ٱلَّذِينَ","يَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","شُرَكَآءَ‌ۚ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَإِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"10:67":["هُوَ","ٱلَّذِى","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","لِتَسۡكُنُواۡ","فِيهِ","وَٱلنَّهَارَ","مُبۡصِرًا‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يَسۡمَعُونَ"],"10:69":["قُلۡ","إِنَّ","ٱلَّذِينَ","يَفۡتَرُونَ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","لَا","يُفۡلِحُونَ"],"10:70":["مَتَـٰعٌ","فِى","ٱلدُّنۡيَا","ثُمَّ","إِلَيۡنَا","مَرۡجِعُهُمۡ","ثُمَّ","نُذِيقُهُمُ","ٱلۡعَذَابَ","ٱلشَّدِيدَ","بِمَا","كَانُواۡ","يَكۡفُرُونَ"],"10:73":["فَكَذَّبُوهُ","فَنَجَّيۡنَـٰهُ","وَمَن","مَّعَهُۥ","فِى","ٱلۡفُلۡكِ","وَجَعَلۡنَـٰهُمۡ","خَلَـٰٓئِفَ","وَأَغۡرَقۡنَا","ٱلَّذِينَ","كَذَّبُواۡ","بِـَٔـايَـٰتِنَا‌ۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُنذَرِينَ"],"10:74":["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِۦ","رُسُلاً","إِلَىٰ","قَوۡمِهِمۡ","فَجَآءُوهُم","بِٱلۡبَيِّنَـٰتِ","فَمَا","كَانُواۡ","لِيُؤۡمِنُواۡ","بِمَا","كَذَّبُواۡ","بِهِۦ","مِن","قَبۡلُ‌ۚ","كَذٰلِكَ","نَطۡبَعُ","عَلَىٰ","قُلُوبِ","ٱلۡمُعۡتَدِينَ"],"10:75":["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِم","مُّوسَىٰ","وَهَـٰرُونَ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦ","بِـَٔـايَـٰتِنَا","فَٱسۡتَكۡبَرُواۡ","وَكَانُواۡ","قَوۡمًا","مُّجۡرِمِينَ"],"10:76":["فَلَمَّا","جَآءَهُمُ","ٱلۡحَقُّ","مِنۡ","عِندِنَا","قَالُوٓاۡ","إِنَّ","هَـٰذَا","لَسِحۡرٌ","مُّبِينٌ"],"10:78":["قَالُوٓاۡ","أَجِئۡتَنَا","لِتَلۡفِتَنَا","عَمَّا","وَجَدۡنَا","عَلَيۡهِ","ءَابَآءَنَا","وَتَكُونَ","لَكُمَا","ٱلۡكِبۡرِيَآءُ","فِى","ٱلۡأَرۡضِ","وَمَا","نَحۡنُ","لَكُمَا","بِمُؤۡمِنِينَ"],"10:79":["وَقَالَ","فِرۡعَوۡنُ","ٱئۡتُونِى","بِكُلِّ","سَـٰحِرٍ","عَلِيمٍ"],"10:80":["فَلَمَّا","جَآءَ","ٱلسَّحَرَةُ","قَالَ","لَهُم","مُّوسَىٰٓ","أَلۡقُواۡ","مَآ","أَنتُم","مُّلۡقُونَ"],"10:81":["فَلَمَّآ","أَلۡقَوۡاۡ","قَالَ","مُوسَىٰ","مَا","جِئۡتُم","بِهِ","ٱلسِّحۡرُ‌ۖ","إِنَّ","ٱللَّهَ","سَيُبۡطِلُهُۥٓ‌ۖ","إِنَّ","ٱللَّهَ","لَا","يُصۡلِحُ","عَمَلَ","ٱلۡمُفۡسِدِينَ"],"10:88":["وَقَالَ","مُوسَىٰ","رَبَّنَآ","إِنَّكَ","ءَاتَيۡتَ","فِرۡعَوۡنَ","وَمَلَأَهُۥ","زِينَةً","وَأَمۡوٰلاً","فِى","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","رَبَّنَا","لِيُضِلُّواۡ","عَن","سَبِيلِكَ‌ۖ","رَبَّنَا","ٱطۡمِسۡ","عَلَىٰٓ","أَمۡوٰلِهِمۡ","وَٱشۡدُدۡ","عَلَىٰ","قُلُوبِهِمۡ","فَلَا","يُؤۡمِنُواۡ","حَتَّىٰ","يَرَوُاۡ","ٱلۡعَذَابَ","ٱلۡأَلِيمَ"],"10:90":["۞وَجَـٰوَزۡنَا","بِبَنِىٓ","إِسۡرٰٓءِيلَ","ٱلۡبَحۡرَ","فَأَتۡبَعَهُمۡ","فِرۡعَوۡنُ","وَجُنُودُهُۥ","بَغۡيًا","وَعَدۡوًا‌ۖ","حَتَّىٰٓ","إِذَآ","أَدۡرَكَهُ","ٱلۡغَرَقُ","قَالَ","ءَامَنتُ","أَنَّهُۥ","لَآ","إِلَـٰهَ","إِلَّا","ٱلَّذِىٓ","ءَامَنَتۡ","بِهِۦ","بَنُوٓاۡ","إِسۡرٰٓءِيلَ","وَأَنَاۡ","مِنَ","ٱلۡمُسۡلِمِينَ"],"10:93":["وَلَقَدۡ","بَوَّأۡنَا","بَنِىٓ","إِسۡرٰٓءِيلَ","مُبَوَّأَ","صِدۡقٍ","وَرَزَقۡنَـٰهُم","مِّنَ","ٱلطَّيِّبَـٰتِ","فَمَا","ٱخۡتَلَفُواۡ","حَتَّىٰ","جَآءَهُمُ","ٱلۡعِلۡمُ‌ۚ","إِنَّ","رَبَّكَ","يَقۡضِى","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَـٰمَةِ","فِيمَا","كَانُواۡ","فِيهِ","يَخۡتَلِفُونَ"],"10:100":["وَمَا","كَانَ","لِنَفۡسٍ","أَن","تُؤۡمِنَ","إِلَّا","بِإِذۡنِ","ٱللَّهِ‌ۚ","وَيَجۡعَلُ","ٱلرِّجۡسَ","عَلَى","ٱلَّذِينَ","لَا","يَعۡقِلُونَ"],"10:102":["فَهَلۡ","يَنتَظِرُونَ","إِلَّا","مِثۡلَ","أَيَّامِ","ٱلَّذِينَ","خَلَوۡاۡ","مِن","قَبۡلِهِمۡ‌ۚ","قُلۡ","فَٱنتَظِرُوٓاۡ","إِنِّى","مَعَكُم","مِّنَ","ٱلۡمُنتَظِرِينَ"],"10:103":["ثُمَّ","نُنَجِّى","رُسُلَنَا","وَٱلَّذِينَ","ءَامَنُواۡ‌ۚ","كَذٰلِكَ","حَقًّا","عَلَيۡنَا","نُنجِ","ٱلۡمُؤۡمِنِينَ"],"10:104":["قُلۡ","يَـٰٓأَيُّهَا","ٱلنَّاسُ","إِن","كُنتُمۡ","فِى","شَكٍّ","مِّن","دِينِى","فَلَآ","أَعۡبُدُ","ٱلَّذِينَ","تَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","وَلَـٰكِنۡ","أَعۡبُدُ","ٱللَّهَ","ٱلَّذِى","يَتَوَفَّـٰكُمۡ‌ۖ","وَأُمِرۡتُ","أَنۡ","أَكُونَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"10:106":["وَلَا","تَدۡعُ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُكَ","وَلَا","يَضُرُّكَ‌ۖ","فَإِن","فَعَلۡتَ","فَإِنَّكَ","إِذًا","مِّنَ","ٱلظَّـٰلِمِينَ"],"10:107":["وَإِن","يَمۡسَسۡكَ","ٱللَّهُ","بِضُرٍّ","فَلَا","كَاشِفَ","لَهُۥٓ","إِلَّا","هُوَ‌ۖ","وَإِن","يُرِدۡكَ","بِخَيۡرٍ","فَلَا","رَآدَّ","لِفَضۡلِهِۦ‌ۚ","يُصِيبُ","بِهِۦ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ‌ۚ","وَهُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"10:108":["قُلۡ","يَـٰٓأَيُّهَا","ٱلنَّاسُ","قَدۡ","جَآءَكُمُ","ٱلۡحَقُّ","مِن","رَّبِّكُمۡ‌ۖ","فَمَنِ","ٱهۡتَدَىٰ","فَإِنَّمَا","يَهۡتَدِى","لِنَفۡسِهِۦ‌ۖ","وَمَن","ضَلَّ","فَإِنَّمَا","يَضِلُّ","عَلَيۡهَا‌ۖ","وَمَآ","أَنَاۡ","عَلَيۡكُم","بِوَكِيلٍ"],"10:109":["وَٱتَّبِعۡ","مَا","يُوحَىٰٓ","إِلَيۡكَ","وَٱصۡبِرۡ","حَتَّىٰ","يَحۡكُمَ","ٱللَّهُ‌ۚ","وَهُوَ","خَيۡرُ","ٱلۡحَـٰكِمِينَ"],"11:7":["وَهُوَ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","فِى","سِتَّةِ","أَيَّامٍ","وَكَانَ","عَرۡشُهُۥ","عَلَى","ٱلۡمَآءِ","لِيَبۡلُوَكُمۡ","أَيُّكُمۡ","أَحۡسَنُ","عَمَلاً‌ۗ","وَلَئِن","قُلۡتَ","إِنَّكُم","مَّبۡعُوثُونَ","مِنۢ","بَعۡدِ","ٱلۡمَوۡتِ","لَيَقُولَنَّ","ٱلَّذِينَ","كَفَرُوٓاۡ","إِنۡ","هَـٰذَآ","إِلَّا","سِحۡرٌ","مُّبِينٌ"],"11:13":["أَمۡ","يَقُولُونَ","ٱفۡتَرَٮٰهُ‌ۖ","قُلۡ","فَأۡتُواۡ","بِعَشۡرِ","سُوَرٍ","مِّثۡلِهِۦ","مُفۡتَرَيَـٰتٍ","وَٱدۡعُواۡ","مَنِ","ٱسۡتَطَعۡتُم","مِّن","دُونِ","ٱللَّهِ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"11:53":["قَالُواۡ","يَـٰهُودُ","مَا","جِئۡتَنَا","بِبَيِّنَةٍ","وَمَا","نَحۡنُ","بِتَارِكِىٓ","ءَالِهَتِنَا","عَن","قَوۡلِكَ","وَمَا","نَحۡنُ","لَكَ","بِمُؤۡمِنِينَ"],"11:110":["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَـٰبَ","فَٱخۡتُلِفَ","فِيهِ‌ۚ","وَلَوۡلَا","كَلِمَةٌ","سَبَقَتۡ","مِن","رَّبِّكَ","لَقُضِىَ","بَيۡنَهُمۡ‌ۚ","وَإِنَّهُمۡ","لَفِى","شَكٍّ","مِّنۡهُ","مُرِيبٍ"],"11:111":["وَإِنَّ","كُلاًّ","لَّمَّا","لَيُوَفِّيَنَّهُمۡ","رَبُّكَ","أَعۡمَـٰلَهُمۡ‌ۚ","إِنَّهُۥ","بِمَا","يَعۡمَلُونَ","خَبِيرٌ"],"12:111":["لَقَدۡ","كَانَ","فِى","قَصَصِهِمۡ","عِبۡرَةٌ","لِّأُوۡلِى","ٱلۡأَلۡبَـٰبِ‌ۗ","مَا","كَانَ","حَدِيثًا","يُفۡتَرَىٰ","وَلَـٰكِن","تَصۡدِيقَ","ٱلَّذِى","بَيۡنَ","يَدَيۡهِ","وَتَفۡصِيلَ","كُلِّ","شَىۡءٍ","وَهُدًى","وَرَحۡمَةً","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"13:7":["وَيَقُولُ","ٱلَّذِينَ","كَفَرُواۡ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَةٌ","مِّن","رَّبِّهِۦٓ‌ۗ","إِنَّمَآ","أَنتَ","مُنذِرٌ‌ۖ","وَلِكُلِّ","قَوۡمٍ","هَادٍ"],"13:16":["قُلۡ","مَن","رَّبُّ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ","قُلِ","ٱللَّهُ‌ۚ","قُلۡ","أَفَٱتَّخَذۡتُم","مِّن","دُونِهِۦٓ","أَوۡلِيَآءَ","لَا","يَمۡلِكُونَ","لِأَنفُسِهِمۡ","نَفۡعًا","وَلَا","ضَرًّا‌ۚ","قُلۡ","هَلۡ","يَسۡتَوِى","ٱلۡأَعۡمَىٰ","وَٱلۡبَصِيرُ","أَمۡ","هَلۡ","تَسۡتَوِى","ٱلظُّلُمَـٰتُ","وَٱلنُّورُ‌ۗ","أَمۡ","جَعَلُواۡ","لِلَّهِ","شُرَكَآءَ","خَلَقُواۡ","كَخَلۡقِهِۦ","فَتَشَـٰبَهَ","ٱلۡخَلۡقُ","عَلَيۡهِمۡ‌ۚ","قُلِ","ٱللَّهُ","خَـٰلِقُ","كُلِّ","شَىۡءٍ","وَهُوَ","ٱلۡوٰحِدُ","ٱلۡقَهَّـٰرُ"],"13:27":["وَيَقُولُ","ٱلَّذِينَ","كَفَرُواۡ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَةٌ","مِّن","رَّبِّهِۦ‌ۗ","قُلۡ","إِنَّ","ٱللَّهَ","يُضِلُّ","مَن","يَشَآءُ","وَيَهۡدِىٓ","إِلَيۡهِ","مَنۡ","أَنَابَ"],"13:40":["وَإِن","مَّا","نُرِيَنَّكَ","بَعۡضَ","ٱلَّذِى","نَعِدُهُمۡ","أَوۡ","نَتَوَفَّيَنَّكَ","فَإِنَّمَا","عَلَيۡكَ","ٱلۡبَلَـٰغُ","وَعَلَيۡنَا","ٱلۡحِسَابُ"],"13:43":["وَيَقُولُ","ٱلَّذِينَ","كَفَرُواۡ","لَسۡتَ","مُرۡسَلاً‌ۚ","قُلۡ","كَفَىٰ","بِٱللَّهِ","شَهِيدَۢا","بَيۡنِى","وَبَيۡنَكُمۡ","وَمَنۡ","عِندَهُۥ","عِلۡمُ","ٱلۡكِتَـٰبِ"],"16:61":["وَلَوۡ","يُؤَاخِذُ","ٱللَّهُ","ٱلنَّاسَ","بِظُلۡمِهِم","مَّا","تَرَكَ","عَلَيۡهَا","مِن","دَآبَّةٍ","وَلَـٰكِن","يُؤَخِّرُهُمۡ","إِلَىٰٓ","أَجَلٍ","مُّسَمًّى‌ۖ","فَإِذَا","جَآءَ","أَجَلُهُمۡ","لَا","يَسۡتَــٔۡخِرُونَ","سَاعَةً‌ۖ","وَلَا","يَسۡتَقۡدِمُونَ"],"16:62":["وَيَجۡعَلُونَ","لِلَّهِ","مَا","يَكۡرَهُونَ","وَتَصِفُ","أَلۡسِنَتُهُمُ","ٱلۡكَذِبَ","أَنَّ","لَهُمُ","ٱلۡحُسۡنَىٰ‌ۖ","لَا","جَرَمَ","أَنَّ","لَهُمُ","ٱلنَّارَ","وَأَنَّهُم","مُّفۡرَطُونَ"],"16:116":["وَلَا","تَقُولُواۡ","لِمَا","تَصِفُ","أَلۡسِنَتُكُمُ","ٱلۡكَذِبَ","هَـٰذَا","حَلَـٰلٌ","وَهَـٰذَا","حَرَامٌ","لِّتَفۡتَرُواۡ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ‌ۚ","إِنَّ","ٱلَّذِينَ","يَفۡتَرُونَ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","لَا","يُفۡلِحُونَ"],"16:117":["مَتَـٰعٌ","قَلِيلٌ","وَلَهُمۡ","عَذَابٌ","أَلِيمٌ"],"16:124":["إِنَّمَا","جُعِلَ","ٱلسَّبۡتُ","عَلَى","ٱلَّذِينَ","ٱخۡتَلَفُواۡ","فِيهِ‌ۚ","وَإِنَّ","رَبَّكَ","لَيَحۡكُمُ","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَـٰمَةِ","فِيمَا","كَانُواۡ","فِيهِ","يَخۡتَلِفُونَ"],"17:96":["قُلۡ","كَفَىٰ","بِٱللَّهِ","شَهِيدَۢا","بَيۡنِى","وَبَيۡنَكُمۡ‌ۚ","إِنَّهُۥ","كَانَ","بِعِبَادِهِۦ","خَبِيرَۢا","بَصِيرًا"],"19:73":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","قَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلَّذِينَ","ءَامَنُوٓاۡ","أَىُّ","ٱلۡفَرِيقَيۡنِ","خَيۡرٌ","مَّقَامًا","وَأَحۡسَنُ","نَدِيًّا"],"20:66":["قَالَ","بَلۡ","أَلۡقُواۡ‌ۖ","فَإِذَا","حِبَالُهُمۡ","وَعِصِيُّهُمۡ","يُخَيَّلُ","إِلَيۡهِ","مِن","سِحۡرِهِمۡ","أَنَّهَا","تَسۡعَىٰ"],"20:89":["أَفَلَا","يَرَوۡنَ","أَلَّا","يَرۡجِعُ","إِلَيۡهِمۡ","قَوۡلاً","وَلَا","يَمۡلِكُ","لَهُمۡ","ضَرًّا","وَلَا","نَفۡعًا"],"21:38":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"21:39":["لَوۡ","يَعۡلَمُ","ٱلَّذِينَ","كَفَرُواۡ","حِينَ","لَا","يَكُفُّونَ","عَن","وُجُوهِهِمُ","ٱلنَّارَ","وَلَا","عَن","ظُهُورِهِمۡ","وَلَا","هُمۡ","يُنصَرُونَ"],"21:66":["قَالَ","أَفَتَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُكُمۡ","شَيۡــًٔا","وَلَا","يَضُرُّكُمۡ"],"22:18":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يَسۡجُدُ","لَهُۥ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","وَٱلشَّمۡسُ","وَٱلۡقَمَرُ","وَٱلنُّجُومُ","وَٱلۡجِبَالُ","وَٱلشَّجَرُ","وَٱلدَّوَآبُّ","وَكَثِيرٌ","مِّنَ","ٱلنَّاسِ‌ۖ","وَكَثِيرٌ","حَقَّ","عَلَيۡهِ","ٱلۡعَذَابُ‌ۗ","وَمَن","يُهِنِ","ٱللَّهُ","فَمَا","لَهُۥ","مِن","مُّكۡرِمٍ‌ۚ","إِنَّ","ٱللَّهَ","يَفۡعَلُ","مَا","يَشَآءُ"],"22:19":["۞هَـٰذَانِ","خَصۡمَانِ","ٱخۡتَصَمُواۡ","فِى","رَبِّهِمۡ‌ۖ","فَٱلَّذِينَ","كَفَرُواۡ","قُطِّعَتۡ","لَهُمۡ","ثِيَابٌ","مِّن","نَّارٍ","يُصَبُّ","مِن","فَوۡقِ","رُءُوسِهِمُ","ٱلۡحَمِيمُ"],"22:72":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","تَعۡرِفُ","فِى","وُجُوهِ","ٱلَّذِينَ","كَفَرُواۡ","ٱلۡمُنكَرَ‌ۖ","يَكَادُونَ","يَسۡطُونَ","بِٱلَّذِينَ","يَتۡلُونَ","عَلَيۡهِمۡ","ءَايَـٰتِنَا‌ۗ","قُلۡ","أَفَأُنَبِّئُكُم","بِشَرٍّ","مِّن","ذٰلِكُمُ‌ۗ","ٱلنَّارُ","وَعَدَهَا","ٱللَّهُ","ٱلَّذِينَ","كَفَرُواۡ‌ۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"25:3":["وَٱتَّخَذُواۡ","مِن","دُونِهِۦٓ","ءَالِهَةً","لَّا","يَخۡلُقُونَ","شَيۡــًٔا","وَهُمۡ","يُخۡلَقُونَ","وَلَا","يَمۡلِكُونَ","لِأَنفُسِهِمۡ","ضَرًّا","وَلَا","نَفۡعًا","وَلَا","يَمۡلِكُونَ","مَوۡتًا","وَلَا","حَيَوٰةً","وَلَا","نُشُورًا"],"25:55":["وَيَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُهُمۡ","وَلَا","يَضُرُّهُمۡ‌ۗ","وَكَانَ","ٱلۡكَافِرُ","عَلَىٰ","رَبِّهِۦ","ظَهِيرًا"],"25:59":["ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۚ","ٱلرَّحۡمَـٰنُ","فَسۡــَٔلۡ","بِهِۦ","خَبِيرًا"],"26:41":["فَلَمَّا","جَآءَ","ٱلسَّحَرَةُ","قَالُواۡ","لِفِرۡعَوۡنَ","أَئِنَّ","لَنَا","لَأَجۡرًا","إِن","كُنَّا","نَحۡنُ","ٱلۡغَـٰلِبِينَ"],"26:44":["فَأَلۡقَوۡاۡ","حِبَالَهُمۡ","وَعِصِيَّهُمۡ","وَقَالُواۡ","بِعِزَّةِ","فِرۡعَوۡنَ","إِنَّا","لَنَحۡنُ","ٱلۡغَـٰلِبُونَ"],"26:201":["لَا","يُؤۡمِنُونَ","بِهِۦ","حَتَّىٰ","يَرَوُاۡ","ٱلۡعَذَابَ","ٱلۡأَلِيمَ"],"27:71":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"27:72":["قُلۡ","عَسَىٰٓ","أَن","يَكُونَ","رَدِفَ","لَكُم","بَعۡضُ","ٱلَّذِى","تَسۡتَعۡجِلُونَ"],"27:73":["وَإِنَّ","رَبَّكَ","لَذُو","فَضۡلٍ","عَلَى","ٱلنَّاسِ","وَلَـٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَشۡكُرُونَ"],"27:86":["أَلَمۡ","يَرَوۡاۡ","أَنَّا","جَعَلۡنَا","ٱلَّيۡلَ","لِيَسۡكُنُواۡ","فِيهِ","وَٱلنَّهَارَ","مُبۡصِرًا‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"27:87":["وَيَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ","فَفَزِعَ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","إِلَّا","مَن","شَآءَ","ٱللَّهُ‌ۚ","وَكُلٌّ","أَتَوۡهُ","دٰخِرِينَ"],"27:88":["وَتَرَى","ٱلۡجِبَالَ","تَحۡسَبُهَا","جَامِدَةً","وَهِىَ","تَمُرُّ","مَرَّ","ٱلسَّحَابِ‌ۚ","صُنۡعَ","ٱللَّهِ","ٱلَّذِىٓ","أَتۡقَنَ","كُلَّ","شَىۡءٍ‌ۚ","إِنَّهُۥ","خَبِيرُۢ","بِمَا","تَفۡعَلُونَ"],"27:91":["إِنَّمَآ","أُمِرۡتُ","أَنۡ","أَعۡبُدَ","رَبَّ","هَـٰذِهِ","ٱلۡبَلۡدَةِ","ٱلَّذِى","حَرَّمَهَا","وَلَهُۥ","كُلُّ","شَىۡءٍ‌ۖ","وَأُمِرۡتُ","أَنۡ","أَكُونَ","مِنَ","ٱلۡمُسۡلِمِينَ"],"28:48":["فَلَمَّا","جَآءَهُمُ","ٱلۡحَقُّ","مِنۡ","عِندِنَا","قَالُواۡ","لَوۡلَآ","أُوتِىَ","مِثۡلَ","مَآ","أُوتِىَ","مُوسَىٰٓ‌ۚ","أَوَلَمۡ","يَكۡفُرُواۡ","بِمَآ","أُوتِىَ","مُوسَىٰ","مِن","قَبۡلُ‌ۖ","قَالُواۡ","سِحۡرَانِ","تَظَـٰهَرَا","وَقَالُوٓاۡ","إِنَّا","بِكُلٍّ","كَـٰفِرُونَ"],"28:73":["وَمِن","رَّحۡمَتِهِۦ","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","وَٱلنَّهَارَ","لِتَسۡكُنُواۡ","فِيهِ","وَلِتَبۡتَغُواۡ","مِن","فَضۡلِهِۦ","وَلَعَلَّكُمۡ","تَشۡكُرُونَ"],"29:50":["وَقَالُواۡ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَـٰتٌ","مِّن","رَّبِّهِۦ‌ۖ","قُلۡ","إِنَّمَا","ٱلۡأَيَـٰتُ","عِندَ","ٱللَّهِ","وَإِنَّمَآ","أَنَاۡ","نَذِيرٌ","مُّبِينٌ"],"29:52":["قُلۡ","كَفَىٰ","بِٱللَّهِ","بَيۡنِى","وَبَيۡنَكُمۡ","شَهِيدًا‌ۖ","يَعۡلَمُ","مَا","فِى","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ‌ۗ","وَٱلَّذِينَ","ءَامَنُواۡ","بِٱلۡبَـٰطِلِ","وَكَفَرُواۡ","بِٱللَّهِ","أُوۡلَـٰٓئِكَ","هُمُ","ٱلۡخَـٰسِرُونَ"],"30:19":["يُخۡرِجُ","ٱلۡحَىَّ","مِنَ","ٱلۡمَيِّتِ","وَيُخۡرِجُ","ٱلۡمَيِّتَ","مِنَ","ٱلۡحَىِّ","وَيُحۡىِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَا‌ۚ","وَكَذٰلِكَ","تُخۡرَجُونَ"],"30:33":["وَإِذَا","مَسَّ","ٱلنَّاسَ","ضُرٌّ","دَعَوۡاۡ","رَبَّهُم","مُّنِيبِينَ","إِلَيۡهِ","ثُمَّ","إِذَآ","أَذَاقَهُم","مِّنۡهُ","رَحۡمَةً","إِذَا","فَرِيقٌ","مِّنۡهُم","بِرَبِّهِمۡ","يُشۡرِكُونَ"],"30:36":["وَإِذَآ","أَذَقۡنَا","ٱلنَّاسَ","رَحۡمَةً","فَرِحُواۡ","بِهَا‌ۖ","وَإِن","تُصِبۡهُمۡ","سَيِّئَةُۢ","بِمَا","قَدَّمَتۡ","أَيۡدِيهِمۡ","إِذَا","هُمۡ","يَقۡنَطُونَ"],"31:7":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِ","ءَايَـٰتُنَا","وَلَّىٰ","مُسۡتَكۡبِرًا","كَأَن","لَّمۡ","يَسۡمَعۡهَا","كَأَنَّ","فِىٓ","أُذُنَيۡهِ","وَقۡرًا‌ۖ","فَبَشِّرۡهُ","بِعَذَابٍ","أَلِيمٍ"],"32:4":["ٱللَّهُ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۖ","مَا","لَكُم","مِّن","دُونِهِۦ","مِن","وَلِىٍّ","وَلَا","شَفِيعٍ‌ۚ","أَفَلَا","تَتَذَكَّرُونَ"],"32:25":["إِنَّ","رَبَّكَ","هُوَ","يَفۡصِلُ","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَـٰمَةِ","فِيمَا","كَانُواۡ","فِيهِ","يَخۡتَلِفُونَ"],"32:28":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡفَتۡحُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"32:29":["قُلۡ","يَوۡمَ","ٱلۡفَتۡحِ","لَا","يَنفَعُ","ٱلَّذِينَ","كَفَرُوٓاۡ","إِيمَـٰنُهُمۡ","وَلَا","هُمۡ","يُنظَرُونَ"],"34:3":["وَقَالَ","ٱلَّذِينَ","كَفَرُواۡ","لَا","تَأۡتِينَا","ٱلسَّاعَةُۖ","قُلۡ","بَلَىٰ","وَرَبِّى","لَتَأۡتِيَنَّكُمۡ","عَـٰلِمِ","ٱلۡغَيۡبِۖ","لَا","يَعۡزُبُ","عَنۡهُ","مِثۡقَالُ","ذَرَّةٍ","فِى","ٱلسَّمَـٰوٰتِ","وَلَا","فِى","ٱلۡأَرۡضِ","وَلَآ","أَصۡغَرُ","مِن","ذٰلِكَ","وَلَآ","أَكۡبَرُ","إِلَّا","فِى","كِتَـٰبٍ","مُّبِينٍ"],"34:4":["لِّيَجۡزِىَ","ٱلَّذِينَ","ءَامَنُواۡ","وَعَمِلُواۡ","ٱلصَّـٰلِحَـٰتِۚ","أُوۡلَـٰٓئِكَ","لَهُم","مَّغۡفِرَةٌ","وَرِزۡقٌ","كَرِيمٌ"],"34:29":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"34:30":["قُل","لَّكُم","مِّيعَادُ","يَوۡمٍ","لَّا","تَسۡتَــٔۡخِرُونَ","عَنۡهُ","سَاعَةً","وَلَا","تَسۡتَقۡدِمُونَ"],"34:31":["وَقَالَ","ٱلَّذِينَ","كَفَرُواۡ","لَن","نُّؤۡمِنَ","بِهَـٰذَا","ٱلۡقُرۡءَانِ","وَلَا","بِٱلَّذِى","بَيۡنَ","يَدَيۡهِۗ","وَلَوۡ","تَرَىٰٓ","إِذِ","ٱلظَّـٰلِمُونَ","مَوۡقُوفُونَ","عِندَ","رَبِّهِمۡ","يَرۡجِعُ","بَعۡضُهُمۡ","إِلَىٰ","بَعۡضٍ","ٱلۡقَوۡلَ","يَقُولُ","ٱلَّذِينَ","ٱسۡتُضۡعِفُواۡ","لِلَّذِينَ","ٱسۡتَكۡبَرُواۡ","لَوۡلَآ","أَنتُمۡ","لَكُنَّا","مُؤۡمِنِينَ"],"34:33":["وَقَالَ","ٱلَّذِينَ","ٱسۡتُضۡعِفُواۡ","لِلَّذِينَ","ٱسۡتَكۡبَرُواۡ","بَلۡ","مَكۡرُ","ٱلَّيۡلِ","وَٱلنَّهَارِ","إِذۡ","تَأۡمُرُونَنَآ","أَن","نَّكۡفُرَ","بِٱللَّهِ","وَنَجۡعَلَ","لَهُۥٓ","أَندَادًاۚ","وَأَسَرُّواۡ","ٱلنَّدَامَةَ","لَمَّا","رَأَوُاۡ","ٱلۡعَذَابَ","وَجَعَلۡنَا","ٱلۡأَغۡلَـٰلَ","فِىٓ","أَعۡنَاقِ","ٱلَّذِينَ","كَفَرُواۡۚ","هَلۡ","يُجۡزَوۡنَ","إِلَّا","مَا","كَانُواۡ","يَعۡمَلُونَ"],"34:42":["فَٱلۡيَوۡمَ","لَا","يَمۡلِكُ","بَعۡضُكُمۡ","لِبَعۡضٍ","نَّفۡعًا","وَلَا","ضَرًّا","وَنَقُولُ","لِلَّذِينَ","ظَلَمُواۡ","ذُوقُواۡ","عَذَابَ","ٱلنَّارِ","ٱلَّتِى","كُنتُم","بِهَا","تُكَذِّبُونَ"],"34:43":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","قَالُواۡ","مَا","هَـٰذَآ","إِلَّا","رَجُلٌ","يُرِيدُ","أَن","يَصُدَّكُمۡ","عَمَّا","كَانَ","يَعۡبُدُ","ءَابَآؤُكُمۡ","وَقَالُواۡ","مَا","هَـٰذَآ","إِلَّآ","إِفۡكٌ","مُّفۡتَرًىۚ","وَقَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلۡحَقِّ","لَمَّا","جَآءَهُمۡ","إِنۡ","هَـٰذَآ","إِلَّا","سِحۡرٌ","مُّبِينٌ"],"36:48":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"36:49":["مَا","يَنظُرُونَ","إِلَّا","صَيۡحَةً","وٰحِدَةً","تَأۡخُذُهُمۡ","وَهُمۡ","يَخِصِّمُونَ"],"36:76":["فَلَا","يَحۡزُنكَ","قَوۡلُهُمۡ‌ۘ","إِنَّا","نَعۡلَمُ","مَا","يُسِرُّونَ","وَمَا","يُعۡلِنُونَ"],"39:8":["۞وَإِذَا","مَسَّ","ٱلۡإِنسَـٰنَ","ضُرٌّ","دَعَا","رَبَّهُۥ","مُنِيبًا","إِلَيۡهِ","ثُمَّ","إِذَا","خَوَّلَهُۥ","نِعۡمَةً","مِّنۡهُ","نَسِىَ","مَا","كَانَ","يَدۡعُوٓاۡ","إِلَيۡهِ","مِن","قَبۡلُ","وَجَعَلَ","لِلَّهِ","أَندَادًا","لِّيُضِلَّ","عَن","سَبِيلِهِۦ‌ۚ","قُلۡ","تَمَتَّعۡ","بِكُفۡرِكَ","قَلِيلاً‌ۖ","إِنَّكَ","مِنۡ","أَصۡحَـٰبِ","ٱلنَّارِ"],"39:41":["إِنَّآ","أَنزَلۡنَا","عَلَيۡكَ","ٱلۡكِتَـٰبَ","لِلنَّاسِ","بِٱلۡحَقِّ‌ۖ","فَمَنِ","ٱهۡتَدَىٰ","فَلِنَفۡسِهِۦ‌ۖ","وَمَن","ضَلَّ","فَإِنَّمَا","يَضِلُّ","عَلَيۡهَا‌ۖ","وَمَآ","أَنتَ","عَلَيۡهِم","بِوَكِيلٍ"],"39:49":["فَإِذَا","مَسَّ","ٱلۡإِنسَـٰنَ","ضُرٌّ","دَعَانَا","ثُمَّ","إِذَا","خَوَّلۡنَـٰهُ","نِعۡمَةً","مِّنَّا","قَالَ","إِنَّمَآ","أُوتِيتُهُۥ","عَلَىٰ","عِلۡمِۭ‌ۚ","بَلۡ","هِىَ","فِتۡنَةٌ","وَلَـٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"39:68":["وَنُفِخَ","فِى","ٱلصُّورِ","فَصَعِقَ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","إِلَّا","مَن","شَآءَ","ٱللَّهُ‌ۖ","ثُمَّ","نُفِخَ","فِيهِ","أُخۡرَىٰ","فَإِذَا","هُمۡ","قِيَامٌ","يَنظُرُونَ"],"39:69":["وَأَشۡرَقَتِ","ٱلۡأَرۡضُ","بِنُورِ","رَبِّهَا","وَوُضِعَ","ٱلۡكِتَـٰبُ","وَجِاۡىٓءَ","بِٱلنَّبِيِّــۧنَ","وَٱلشُّهَدَآءِ","وَقُضِىَ","بَيۡنَهُم","بِٱلۡحَقِّ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"40:6":["وَكَذٰلِكَ","حَقَّتۡ","كَلِمَتُ","رَبِّكَ","عَلَى","ٱلَّذِينَ","كَفَرُوٓاۡ","أَنَّهُمۡ","أَصۡحَـٰبُ","ٱلنَّارِ"],"40:25":["فَلَمَّا","جَآءَهُم","بِٱلۡحَقِّ","مِنۡ","عِندِنَا","قَالُواۡ","ٱقۡتُلُوٓاۡ","أَبۡنَآءَ","ٱلَّذِينَ","ءَامَنُواۡ","مَعَهُۥ","وَٱسۡتَحۡيُواۡ","نِسَآءَهُمۡۚ","وَمَا","كَيۡدُ","ٱلۡكَـٰفِرِينَ","إِلَّا","فِى","ضَلَـٰلٍ"],"40:61":["ٱللَّهُ","ٱلَّذِى","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","لِتَسۡكُنُواۡ","فِيهِ","وَٱلنَّهَارَ","مُبۡصِرًاۚ","إِنَّ","ٱللَّهَ","لَذُو","فَضۡلٍ","عَلَى","ٱلنَّاسِ","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَشۡكُرُونَ"],"40:77":["فَٱصۡبِرۡ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَۚقٌّ","فَإِمَّا","نُرِيَنَّكَ","بَعۡضَ","ٱلَّذِى","نَعِدُهُمۡ","أَوۡ","نَتَوَفَّيَنَّكَ","فَإِلَيۡنَا","يُرۡجَعُونَ"],"41:45":["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَـٰبَ","فَٱخۡتُلِفَ","فِيهِ‌ۗ","وَلَوۡلَا","كَلِمَةٌ","سَبَقَتۡ","مِن","رَّبِّكَ","لَقُضِىَ","بَيۡنَهُمۡ‌ۚ","وَإِنَّهُمۡ","لَفِى","شَكٍّ","مِّنۡهُ","مُرِيبٍ"],"41:46":["مَّنۡ","عَمِلَ","صَـٰلِحًا","فَلِنَفۡسِهِۦ‌ۖ","وَمَنۡ","أَسَآءَ","فَعَلَيۡهَا‌ۗ","وَمَا","رَبُّكَ","بِظَلَّـٰمٍ","لِّلۡعَبِيدِ"],"41:50":["وَلَئِنۡ","أَذَقۡنَـٰهُ","رَحۡمَةً","مِّنَّا","مِنۢ","بَعۡدِ","ضَرَّآءَ","مَسَّتۡهُ","لَيَقُولَنَّ","هَـٰذَا","لِى","وَمَآ","أَظُنُّ","ٱلسَّاعَةَ","قَآئِمَةً","وَلَئِن","رُّجِعۡتُ","إِلَىٰ","رَبِّىٓ","إِنَّ","لِى","عِندَهُۥ","لَلۡحُسۡنَىٰ‌ۚ","فَلَنُنَبِّئَنَّ","ٱلَّذِينَ","كَفَرُواۡ","بِمَا","عَمِلُواۡ","وَلَنُذِيقَنَّهُم","مِّنۡ","عَذَابٍ","غَلِيظٍ"],"42:14":["وَمَا","تَفَرَّقُوٓاۡ","إِلَّا","مِنۢ","بَعۡدِ","مَا","جَآءَهُمُ","ٱلۡعِلۡمُ","بَغۡيَۢا","بَيۡنَهُمۡ‌ۚ","وَلَوۡلَا","كَلِمَةٌ","سَبَقَتۡ","مِن","رَّبِّكَ","إِلَىٰٓ","أَجَلٍ","مُّسَمًّى","لَّقُضِىَ","بَيۡنَهُمۡ‌ۚ","وَإِنَّ","ٱلَّذِينَ","أُورِثُواۡ","ٱلۡكِتَـٰبَ","مِنۢ","بَعۡدِهِمۡ","لَفِى","شَكٍّ","مِّنۡهُ","مُرِيبٍ"],"42:15":["فَلِذٰلِكَ","فَٱدۡعُ‌ۖ","وَٱسۡتَقِمۡ","كَمَآ","أُمِرۡتَ‌ۖ","وَلَا","تَتَّبِعۡ","أَهۡوَآءَهُمۡ‌ۖ","وَقُلۡ","ءَامَنتُ","بِمَآ","أَنزَلَ","ٱللَّهُ","مِن","كِتَـٰبٍ‌ۖ","وَأُمِرۡتُ","لِأَعۡدِلَ","بَيۡنَكُمُ‌ۖ","ٱللَّهُ","رَبُّنَا","وَرَبُّكُمۡ‌ۖ","لَنَآ","أَعۡمَـٰلُنَا","وَلَكُمۡ","أَعۡمَـٰلُكُمۡ‌ۖ","لَا","حُجَّةَ","بَيۡنَنَا","وَبَيۡنَكُمُ‌ۖ","ٱللَّهُ","يَجۡمَعُ","بَيۡنَنَا‌ۖ","وَإِلَيۡهِ","ٱلۡمَصِيرُ"],"43:20":["وَقَالُواۡ","لَوۡ","شَآءَ","ٱلرَّحۡمَـٰنُ","مَا","عَبَدۡنَـٰهُم‌ۗ","مَّا","لَهُم","بِذٰلِكَ","مِنۡ","عِلۡمٍ‌ۖ","إِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"43:40":["أَفَأَنتَ","تُسۡمِعُ","ٱلصُّمَّ","أَوۡ","تَهۡدِى","ٱلۡعُمۡىَ","وَمَن","كَانَ","فِى","ضَلَـٰلٍ","مُّبِينٍ"],"44:57":["فَضۡلاً","مِّن","رَّبِّكَ‌ۚ","ذٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"45:17":["وَءَاتَيۡنَـٰهُم","بَيِّنَـٰتٍ","مِّنَ","ٱلۡأَمۡرِ‌ۖ","فَمَا","ٱخۡتَلَفُوٓاۡ","إِلَّا","مِنۢ","بَعۡدِ","مَا","جَآءَهُمُ","ٱلۡعِلۡمُ","بَغۡيَۢا","بَيۡنَهُمۡ‌ۚ","إِنَّ","رَبَّكَ","يَقۡضِى","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَـٰمَةِ","فِيمَا","كَانُواۡ","فِيهِ","يَخۡتَلِفُونَ"],"45:25":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","مَّا","كَانَ","حُجَّتَهُمۡ","إِلَّآ","أَن","قَالُواۡ","ٱئۡتُواۡ","بِـَٔـابَآئِنَآ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"46:7":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","قَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلۡحَقِّ","لَمَّا","جَآءَهُمۡ","هَـٰذَا","سِحۡرٌ","مُّبِينٌ"],"46:22":["قَالُوٓاۡ","أَجِئۡتَنَا","لِتَأۡفِكَنَا","عَنۡ","ءَالِهَتِنَا","فَأۡتِنَا","بِمَا","تَعِدُنَآ","إِن","كُنتَ","مِنَ","ٱلصَّـٰدِقِينَ"],"46:23":["قَالَ","إِنَّمَا","ٱلۡعِلۡمُ","عِندَ","ٱللَّهِ","وَأُبَلِّغُكُم","مَّآ","أُرۡسِلۡتُ","بِهِۦ","وَلَـٰكِنِّىٓ","أَرَٮٰكُمۡ","قَوۡمًا","تَجۡهَلُونَ"],"57:4":["هُوَ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۚ","يَعۡلَمُ","مَا","يَلِجُ","فِى","ٱلۡأَرۡضِ","وَمَا","يَخۡرُجُ","مِنۡهَا","وَمَا","يَنزِلُ","مِنَ","ٱلسَّمَآءِ","وَمَا","يَعۡرُجُ","فِيهَا‌ۖ","وَهُوَ","مَعَكُمۡ","أَيۡنَ","مَا","كُنتُمۡ‌ۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"57:12":["يَوۡمَ","تَرَى","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَـٰتِ","يَسۡعَىٰ","نُورُهُم","بَيۡنَ","أَيۡدِيهِمۡ","وَبِأَيۡمَـٰنِهِم","بُشۡرَٮٰكُمُ","ٱلۡيَوۡمَ","جَنَّـٰتٌ","تَجۡرِى","مِن","تَحۡتِهَا","ٱلۡأَنۡهَـٰرُ","خَـٰلِدِينَ","فِيهَا‌ۚ","ذٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"67:25":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"67:26":["قُلۡ","إِنَّمَا","ٱلۡعِلۡمُ","عِندَ","ٱللَّهِ","وَإِنَّمَآ","أَنَاۡ","نَذِيرٌ","مُّبِينٌ"]}}