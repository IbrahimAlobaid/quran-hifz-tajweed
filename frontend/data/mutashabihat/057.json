وَءَاتَيۡنَـٰهُ","أَجۡرَهُۥ","فِى","ٱلدُّنۡيَا‌ۖ","وَإِنَّهُۥ","فِى","ٱلۡأَخِرَةِ","لَمِنَ","ٱلصَّـٰلِحِينَ"],"29:64":["وَمَا","هَـٰذِهِ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَآ","إِلَّا","لَهۡوٌ","وَلَعِبٌ‌ۚ","وَإِنَّ","ٱلدَّارَ","ٱلۡأَخِرَةَ","لَهِىَ","ٱلۡحَيَوَانُ‌ۚ","لَوۡ","كَانُواۡ","يَعۡلَمُونَ"],"31:18":["وَلَا","تُصَعِّرۡ","خَدَّكَ","لِلنَّاسِ","وَلَا","تَمۡشِ","فِى","ٱلۡأَرۡضِ","مَرَحًا‌ۖ","إِنَّ","ٱللَّهَ","لَا","يُحِبُّ","كُلَّ","مُخۡتَالٍ","فَخُورٍ"],"31:19":["وَٱقۡصِدۡ","فِى","مَشۡيِكَ","وَٱغۡضُضۡ","مِن","صَوۡتِكَ‌ۚ","إِنَّ","أَنكَرَ","ٱلۡأَصۡوٰتِ","لَصَوۡتُ","ٱلۡحَمِيرِ"],"31:29":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يُولِجُ","ٱلَّيۡلَ","فِى","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِى","ٱلَّيۡلِ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَ","كُلٌّ","يَجۡرِىٓ","إِلَىٰٓ","أَجَلٍ","مُّسَمًّى","وَأَنَّ","ٱللَّهَ","بِمَا","تَعۡمَلُونَ","خَبِيرٌ"],"32:4":["ٱللَّهُ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۖ","مَا","لَكُم","مِّن","دُونِهِۦ","مِن","وَلِىٍّ","وَلَا","شَفِيعٍ‌ۚ","أَفَلَا","تَتَذَكَّرُونَ"],"34:2":["يَعۡلَمُ","مَا","يَلِجُ","فِى","ٱلۡأَرۡضِ","وَمَا","يَخۡرُجُ","مِنۡهَا","وَمَا","يَنزِلُ","مِنَ","ٱلسَّمَآءِ","وَمَا","يَعۡرُجُ","فِيهَاۚ","وَهُوَ","ٱلرَّحِيمُ","ٱلۡغَفُورُ"],"35:13":["يُولِجُ","ٱلَّيۡلَ","فِى","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِى","ٱلَّيۡلِ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَ","كُلٌّ","يَجۡرِى","لِأَجَلٍ","مُّسَمًّىۚ","ذٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","لَهُ","ٱلۡمُلۡكُۚ","وَٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِهِۦ","مَا","يَمۡلِكُونَ","مِن","قِطۡمِيرٍ"],"39:21":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَسَلَكَهُۥ","يَنَـٰبِيعَ","فِى","ٱلۡأَرۡضِ","ثُمَّ","يُخۡرِجُ","بِهِۦ","زَرۡعًا","مُّخۡتَلِفًا","أَلۡوٰنُهُۥ","ثُمَّ","يَهِيجُ","فَتَرَٮٰهُ","مُصۡفَرًّا","ثُمَّ","يَجۡعَلُهُۥ","حُطَـٰمًا‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَذِكۡرَىٰ","لِأُوۡلِى","ٱلۡأَلۡبَـٰبِ"],"44:57":["فَضۡلاً","مِّن","رَّبِّكَ‌ۚ","ذٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱ