نَ","وَيَأۡمُرُونَ","ٱلنَّاسَ","بِٱلۡبُخۡلِ‌ۗ","وَمَن","يَتَوَلَّ","فَإِنَّ","ٱللَّهَ","هُوَ","ٱلۡغَنِىُّ","ٱلۡحَمِيدُ"],"57:26":["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحًا","وَإِبۡرٰهِيمَ","وَجَعَلۡنَا","فِى","ذُرِّيَّتِهِمَا","ٱلنُّبُوَّةَ","وَٱلۡكِتَـٰبَ‌ۖ","فَمِنۡهُم","مُّهۡتَدٍ‌ۖ","وَكَثِيرٌ","مِّنۡهُمۡ","فَـٰسِقُونَ"],"57:27":["ثُمَّ","قَفَّيۡنَا","عَلَىٰٓ","ءَاثَـٰرِهِم","بِرُسُلِنَا","وَقَفَّيۡنَا","بِعِيسَى","ٱبۡنِ","مَرۡيَمَ","وَءَاتَيۡنَـٰهُ","ٱلۡإِنجِيلَ","وَجَعَلۡنَا","فِى","قُلُوبِ","ٱلَّذِينَ","ٱتَّبَعُوهُ","رَأۡفَةً","وَرَحۡمَةً","وَرَهۡبَانِيَّةً","ٱبۡتَدَعُوهَا","مَا","كَتَبۡنَـٰهَا","عَلَيۡهِمۡ","إِلَّا","ٱبۡتِغَآءَ","رِضۡوٰنِ","ٱللَّهِ","فَمَا","رَعَوۡهَا","حَقَّ","رِعَايَتِهَا‌ۖ","فَـَٔـاتَيۡنَا","ٱلَّذِينَ","ءَامَنُواۡ","مِنۡهُمۡ","أَجۡرَهُمۡ‌ۖ","وَكَثِيرٌ","مِّنۡهُمۡ","فَـٰسِقُونَ"],"59:1":["سَبَّحَ","لِلَّهِ","مَا","فِى","ٱلسَّمَـٰوٰتِ","وَمَا","فِى","ٱلۡأَرۡضِ‌ۖ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"59:2":["هُوَ","ٱلَّذِىٓ","أَخۡرَجَ","ٱلَّذِينَ","كَفَرُواۡ","مِنۡ","أَهۡلِ","ٱلۡكِتَـٰبِ","مِن","دِيَـٰرِهِمۡ","لِأَوَّلِ","ٱلۡحَشۡرِ‌ۚ","مَا","ظَنَنتُمۡ","أَن","يَخۡرُجُواۡ‌ۖ","وَظَنُّوٓاۡ","أَنَّهُم","مَّانِعَتُهُمۡ","حُصُونُهُم","مِّنَ","ٱللَّهِ","فَأَتَـٰهُمُ","ٱللَّهُ","مِنۡ","حَيۡثُ","لَمۡ","يَحۡتَسِبُواۡ‌ۖ","وَقَذَفَ","فِى","قُلُوبِهِمُ","ٱلرُّعۡبَ‌ۚ","يُخۡرِبُونَ","بُيُوتَهُم","بِأَيۡدِيهِمۡ","وَأَيۡدِى","ٱلۡمُؤۡمِنِينَ","فَٱعۡتَبِرُواۡ","يَـٰٓأُوۡلِى","ٱلۡأَبۡصَـٰرِ"],"61:1":["سَبَّحَ","لِلَّهِ","مَا","فِى","ٱلسَّمَـٰوٰتِ","وَمَا","فِى","ٱلۡأَرۡضِ‌ۖ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"61:2":["يَـٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواۡ","لِمَ","تَقُولُونَ","مَا","لَا","تَفۡعَلُونَ"],"62:1":["يُسَبِّحُ","لِلَّهِ","مَا","فِى","ٱلسَّمَـٰوٰتِ","وَمَا","فِى","ٱلۡأَرۡضِ","ٱلۡمَلِكِ","ٱلۡقُدُّوسِ","ٱلۡعَزِيزِ","ٱلۡحَكِيمِ"],"62:2":["هُوَ","ٱلَّذِى","بَعَثَ","فِى","ٱلۡأُمِّيِّــۧنَ","رَسُولاً","مِّنۡهُمۡ","يَتۡلُواۡ","عَلَيۡهِمۡ","ءَايَـٰتِهِۦ","وَيُزَكِّيهِمۡ","وَيُعَلِّمُهُمُ","ٱلۡكِتَـٰبَ","وَٱلۡحِكۡمَةَ","وَإِن","كَانُواۡ","مِن","قَبۡلُ","لَفِى","ضَلَـٰلٍ","مُّبِينٍ"],"64:1":["يُسَبِّحُ","لِلَّهِ","مَا","فِى","ٱلسَّمَـٰوٰتِ","وَمَا","فِى","ٱلۡأَرۡضِ‌ۖ","لَهُ","ٱلۡمُلۡكُ","وَلَهُ","ٱلۡحَمۡدُ‌ۖ","وَهُوَ","عَلَىٰ","كُلِّ","شَىۡءٍ","قَدِيرٌ"],"64:2":["هُوَ","ٱلَّذِى","خَلَقَكُمۡ","فَمِنكُمۡ","كَافِرٌ","وَمِنكُم","مُّؤۡمِنٌ‌ۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"66:8":["يَـٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواۡ","تُوبُوٓاۡ","إِلَى","ٱللَّهِ","تَوۡبَةً","نَّصُوحًا","عَسَىٰ","رَبُّكُمۡ","أَن","يُكَفِّرَ","عَنكُمۡ","سَيِّـَٔـاتِكُمۡ","وَيُدۡخِلَكُمۡ","جَنَّـٰتٍ","تَجۡرِى","مِن","تَحۡتِهَا","ٱلۡأَنۡهَـٰرُ","يَوۡمَ","لَا","يُخۡزِى","ٱللَّهُ","ٱلنَّبِىَّ","وَٱلَّذِينَ","ءَامَنُواۡ","مَعَهُۥ‌ۖ","نُورُهُمۡ","يَسۡعَىٰ","بَيۡنَ","أَيۡدِيهِمۡ","وَبِأَيۡمَـٰنِهِمۡ","يَقُولُونَ","رَبَّنَآ","أَتۡمِمۡ","لَنَا","نُورَنَا","وَٱغۡفِرۡ","لَنَآ‌ۖ","إِنَّكَ","عَلَىٰ","كُلِّ","شَىۡءٍ","قَدِيرٌ"]}}