لِحًا","فَلِنَفۡسِهِۦ‌ۖ","وَمَنۡ","أَسَآءَ","فَعَلَيۡهَا‌ۗ","وَمَا","رَبُّكَ","بِظَلَّـٰمٍ","لِّلۡعَبِيدِ"],"41:47":["۞إِلَيۡهِ","يُرَدُّ","عِلۡمُ","ٱلسَّاعَةِ‌ۚ","وَمَا","تَخۡرُجُ","مِن","ثَمَرٰتٍ","مِّنۡ","أَكۡمَامِهَا","وَمَا","تَحۡمِلُ","مِنۡ","أُنثَىٰ","وَلَا","تَضَعُ","إِلَّا","بِعِلۡمِهِۦ‌ۚ","وَيَوۡمَ","يُنَادِيهِمۡ","أَيۡنَ","شُرَكَآءِى","قَالُوٓاۡ","ءَاذَنَّـٰكَ","مَا","مِنَّا","مِن","شَهِيدٍ"],"41:50":["وَلَئِنۡ","أَذَقۡنَـٰهُ","رَحۡمَةً","مِّنَّا","مِنۢ","بَعۡدِ","ضَرَّآءَ","مَسَّتۡهُ","لَيَقُولَنَّ","هَـٰذَا","لِى","وَمَآ","أَظُنُّ","ٱلسَّاعَةَ","قَآئِمَةً","وَلَئِن","رُّجِعۡتُ","إِلَىٰ","رَبِّىٓ","إِنَّ","لِى","عِندَهُۥ","لَلۡحُسۡنَىٰ‌ۚ","فَلَنُنَبِّئَنَّ","ٱلَّذِينَ","كَفَرُواۡ","بِمَا","عَمِلُواۡ","وَلَنُذِيقَنَّهُم","مِّنۡ","عَذَابٍ","غَلِيظٍ"],"41:51":["وَإِذَآ","أَنۡعَمۡنَا","عَلَى","ٱلۡإِنسَـٰنِ","أَعۡرَضَ","وَنَـَٔـا","بِجَانِبِهِۦ","وَإِذَا","مَسَّهُ","ٱلشَّرُّ","فَذُو","دُعَآءٍ","عَرِيضٍ"],"41:52":["قُلۡ","أَرَءَيۡتُمۡ","إِن","كَانَ","مِنۡ","عِندِ","ٱللَّهِ","ثُمَّ","كَفَرۡتُم","بِهِۦ","مَنۡ","أَضَلُّ","مِمَّنۡ","هُوَ","فِى","شِقَاقِۭ","بَعِيدٍ"],"41:53":["سَنُرِيهِمۡ","ءَايَـٰتِنَا","فِى","ٱلۡأَفَاقِ","وَفِىٓ","أَنفُسِهِمۡ","حَتَّىٰ","يَتَبَيَّنَ","لَهُمۡ","أَنَّهُ","ٱلۡحَقُّ‌ۗ","أَوَلَمۡ","يَكۡفِ","بِرَبِّكَ","أَنَّهُۥ","عَلَىٰ","كُلِّ","شَىۡءٍ","شَهِيدٌ"],"42:14":["وَمَا","تَفَرَّقُوٓاۡ","إِلَّا","مِنۢ","بَعۡدِ","مَا","جَآءَهُمُ","ٱلۡعِلۡمُ","بَغۡيَۢا","بَيۡنَهُمۡ‌ۚ","وَلَوۡلَا","كَلِمَةٌ","سَبَقَتۡ","مِن","رَّبِّكَ","إِلَىٰٓ","أَجَلٍ","مُّسَمًّى","لَّقُضِىَ","بَيۡنَهُمۡ‌ۚ","وَإِنَّ","ٱلَّذِينَ","أُورِثُواۡ","ٱلۡكِتَـٰبَ","مِنۢ","بَعۡدِهِمۡ","لَفِى","شَكٍّ","مِّنۡهُ","مُرِيبٍ"],"42:15":["فَلِذٰلِكَ","فَٱدۡعُ‌ۖ","وَٱسۡتَقِمۡ","كَمَآ","أُمِرۡتَ‌ۖ","وَلَا","تَتَّبِعۡ","أَهۡوَآءَهُمۡ‌ۖ","وَقُلۡ","ءَامَنتُ","بِمَآ","أَنزَلَ","ٱللَّهُ","مِن","كِتَـٰبٍ‌ۖ","وَأُمِرۡتُ","لِأَعۡدِلَ","بَيۡنَكُمُ‌ۖ","ٱللَّهُ","رَبُّنَا","وَرَبُّكُمۡ‌ۖ","لَنَآ","أَعۡمَـٰلُنَا","وَلَكُمۡ","أَعۡمَـٰلُكُمۡ‌ۖ","لَا","حُجَّةَ","بَيۡنَنَا","وَبَيۡنَكُمُ‌ۖ","ٱللَّهُ","يَجۡمَعُ","بَيۡنَنَا‌ۖ","وَإِلَيۡهِ","ٱلۡمَصِيرُ"],"45:15":["مَنۡ","عَمِلَ","صَـٰلِحًا","فَلِنَفۡسِهِۦ‌ۖ","وَمَنۡ","أَسَآءَ","فَعَلَيۡهَا‌ۖ","ثُمَّ","إِلَىٰ","رَبِّكُمۡ","تُرۡجَعُونَ"],"46:10":["قُلۡ","أَرَءَيۡتُمۡ","إِن","كَانَ","مِنۡ","عِندِ","ٱللَّهِ","وَكَفَرۡتُم","بِهِۦ","وَشَهِدَ","شَاهِدٌ","مِّنۢ","بَنِىٓ","إِسۡرٰٓءِيلَ","عَلَىٰ","مِثۡلِهِۦ","فَـَٔـامَنَ","وَٱسۡتَكۡبَرۡتُمۡ‌ۖ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِى","ٱلۡقَوۡمَ","ٱلظَّـٰلِمِينَ"],"46:13":["إِنَّ","ٱلَّذِينَ","قَالُواۡ","رَبُّنَا","ٱللَّهُ","ثُمَّ","ٱسۡتَقَـٰمُواۡ","فَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"46:18":["أُوۡلَـٰٓئِكَ","ٱلَّذِينَ","حَقَّ","عَلَيۡهِمُ","ٱلۡقَوۡلُ","فِىٓ","أُمَمٍ","قَدۡ","خَلَتۡ","مِن","قَبۡلِهِم","مِّنَ","ٱلۡجِنِّ","وَٱلۡإِنسِ‌ۖ","إِنَّهُمۡ","كَانُواۡ","خَـٰسِرِينَ"],"46:19":["وَلِكُلٍّ","دَرَجَـٰتٌ","مِّمَّا","عَمِلُواۡ‌ۖ","وَلِيُوَفِّيَهُمۡ","أَعۡمَـٰلَهُمۡ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"54:19":["إِنَّآ","أَرۡسَلۡنَا","عَلَيۡهِمۡ","رِيحًا","صَرۡصَرًا","فِى","يَوۡمِ","نَحۡسٍ","مُّسۡتَمِرٍّ"],"84:25":["إِلَّا","ٱلَّذِينَ","ءَامَنُواۡ","وَعَمِلُواۡ","ٱلصَّـٰلِحَـٰتِ","لَهُمۡ","أَجۡرٌ","غَيۡرُ","مَمۡنُونِۭ"],"95:6":["إِلَّا","ٱلَّذِينَ","ءَامَنُواۡ","وَعَمِلُواۡ","ٱلصَّـٰلِحَـٰتِ","فَلَهُمۡ","أَجۡرٌ","غَيۡرُ","مَمۡنُونٍ"]}}