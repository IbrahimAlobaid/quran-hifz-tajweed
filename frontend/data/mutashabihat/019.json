"بِقُرۡءَانٍ","غَيۡرِ","هَـٰذَآ","أَوۡ","بَدِّلۡهُ‌ۚ","قُلۡ","مَا","يَكُونُ","لِىٓ","أَنۡ","أُبَدِّلَهُۥ","مِن","تِلۡقَآىِٕ","نَفۡسِىٓ‌ۖ","إِنۡ","أَتَّبِعُ","إِلَّا","مَا","يُوحَىٰٓ","إِلَىَّ‌ۖ","إِنِّىٓ","أَخَافُ","إِنۡ","عَصَيۡتُ","رَبِّى","عَذَابَ","يَوۡمٍ","عَظِيمٍ"],"18:46":["ٱلۡمَالُ","وَٱلۡبَنُونَ","زِينَةُ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا‌ۖ","وَٱلۡبَـٰقِيَـٰتُ","ٱلصَّـٰلِحَـٰتُ","خَيۡرٌ","عِندَ","رَبِّكَ","ثَوَابًا","وَخَيۡرٌ","أَمَلاً"],"18:47":["وَيَوۡمَ","نُسَيِّرُ","ٱلۡجِبَالَ","وَتَرَى","ٱلۡأَرۡضَ","بَارِزَةً","وَحَشَرۡنَـٰهُمۡ","فَلَمۡ","نُغَادِرۡ","مِنۡهُمۡ","أَحَدًا"],"19:4":["قَالَ","رَبِّ","إِنِّى","وَهَنَ","ٱلۡعَظۡمُ","مِنِّى","وَٱشۡتَعَلَ","ٱلرَّأۡسُ","شَيۡبًا","وَلَمۡ","أَكُنۢ","بِدُعَآئِكَ","رَبِّ","شَقِيًّا"],"19:5":["وَإِنِّى","خِفۡتُ","ٱلۡمَوٰلِىَ","مِن","وَرَآءِى","وَكَانَتِ","ٱمۡرَأَتِى","عَاقِرًا","فَهَبۡ","لِى","مِن","لَّدُنكَ","وَلِيًّا"],"19:9":["قَالَ","كَذٰلِكَ","قَالَ","رَبُّكَ","هُوَ","عَلَىَّ","هَيِّنٌ","وَقَدۡ","خَلَقۡتُكَ","مِن","قَبۡلُ","وَلَمۡ","تَكُ","شَيۡــًٔا"],"19:10":["قَالَ","رَبِّ","ٱجۡعَل","لِّىٓ","ءَايَةً‌ۚ","قَالَ","ءَايَتُكَ","أَلَّا","تُكَلِّمَ","ٱلنَّاسَ","ثَلَـٰثَ","لَيَالٍ","سَوِيًّا"],"19:14":["وَبَرَّۢا","بِوٰلِدَيۡهِ","وَلَمۡ","يَكُن","جَبَّارًا","عَصِيًّا"],"19:15":["وَسَلَـٰمٌ","عَلَيۡهِ","يَوۡمَ","وُلِدَ","وَيَوۡمَ","يَمُوتُ","وَيَوۡمَ","يُبۡعَثُ","حَيًّا"],"19:16":["وَٱذۡكُرۡ","فِى","ٱلۡكِتَـٰبِ","مَرۡيَمَ","إِذِ","ٱنتَبَذَتۡ","مِنۡ","أَهۡلِهَا","مَكَانًا","شَرۡقِيًّا"],"19:21":["قَالَ","كَذٰلِكِ","قَالَ","رَبُّكِ","هُوَ","عَلَىَّ","هَيِّنٌ‌ۖ","وَلِنَجۡعَلَهُۥٓ","ءَايَةً","لِّلنَّاسِ","وَرَحۡمَةً","مِّنَّا‌ۚ","وَكَانَ","أَمۡرًا","مَّقۡضِيًّا"],"19:31":["وَجَعَلَنِى","مُبَارَكًا","أَيۡنَ","مَا","كُنتُ","وَأَوۡصَـٰنِى","بِٱلصَّلَوٰةِ","وَٱلزَّكَوٰةِ","مَا","دُمۡتُ","حَيًّا"],"19:32":["وَبَرَّۢا","بِوٰلِدَتِى","وَلَمۡ","يَجۡعَلۡنِى","جَبَّارًا","شَقِيًّا"],"19:33":["وَٱلسَّلَـٰمُ","عَلَىَّ","يَوۡمَ","وُلِدتُّ","وَيَوۡمَ","أَمُوتُ","وَيَوۡمَ","أُبۡعَثُ","حَيًّا"],"19:34":["ذٰلِكَ","عِيسَى","ٱبۡنُ","مَرۡيَمَ‌ۚ","قَوۡلَ","ٱلۡحَقِّ","ٱلَّذِى","فِيهِ","يَمۡتَرُونَ"],"19:36":["وَإِنَّ","ٱللَّهَ","رَبِّى","وَرَبُّكُمۡ","فَٱعۡبُدُوهُ‌ۚ","هَـٰذَا","صِرٰطٌ","مُّسۡتَقِيمٌ"],"19:37":["فَٱخۡتَلَفَ","ٱلۡأَحۡزَابُ","مِنۢ","بَيۡنِهِمۡ‌ۖ","فَوَيۡلٌ","لِّلَّذِينَ","كَفَرُواۡ","مِن","مَّشۡهَدِ","يَوۡمٍ","عَظِيمٍ"],"19:38":["أَسۡمِعۡ","بِهِمۡ","وَأَبۡصِرۡ","يَوۡمَ","يَأۡتُونَنَا‌ۖ","لَـٰكِنِ","ٱلظَّـٰلِمُونَ","ٱلۡيَوۡمَ","فِى","ضَلَـٰلٍ","مُّبِينٍ"],"19:48":["وَأَعۡتَزِلُكُمۡ","وَمَا","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","وَأَدۡعُواۡ","رَبِّى","عَسَىٰٓ","أَلَّآ","أَكُونَ","بِدُعَآءِ","رَبِّى","شَقِيًّا"],"19:49":["فَلَمَّا","ٱعۡتَزَلَهُمۡ","وَمَا","يَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","وَهَبۡنَا","لَهُۥٓ","إِسۡحَـٰقَ","وَيَعۡقُوبَ‌ۖ","وَكُلاًّ","جَعَلۡنَا","نَبِيًّا"],"19:52":["وَنَـٰدَيۡنَـٰهُ","مِن","جَانِبِ","ٱلطُّورِ","ٱلۡأَيۡمَنِ","وَقَرَّبۡنَـٰهُ","نَجِيًّا"],"19:55":["وَكَانَ","يَأۡمُرُ","أَهۡلَهُۥ","بِٱلصَّلَوٰةِ","وَٱلزَّكَوٰةِ","وَكَانَ","عِندَ","رَبِّهِۦ","مَرۡضِيًّا"],"19:58":["أُوۡلَـٰٓئِكَ","ٱلَّذِينَ","أَنۡعَمَ","ٱللَّهُ","عَلَيۡهِم","مِّنَ","ٱلنَّبِيِّــۧنَ","مِن","ذُرِّيَّةِ","ءَادَمَ","وَمِمَّنۡ","حَمَلۡنَا","مَعَ","نُوحٍ","وَمِن","ذُرِّيَّةِ","إِبۡرٰهِيمَ","وَإِسۡرٰٓءِيلَ","وَمِمَّنۡ","هَدَيۡنَا","وَٱجۡتَبَيۡنَآ‌ۚ","إِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُ","ٱلرَّحۡمَـٰنِ","خَرُّواۡ","سُجَّدًا","وَبُكِيًّا"],"19:60":["إِلَّا","مَن","تَابَ","وَءَامَنَ","وَعَمِلَ","صَـٰلِحًا","فَأُوۡلَـٰٓئِكَ","يَدۡخُلُونَ","ٱلۡجَنَّةَ","وَلَا","يُظۡلَمُونَ","شَيۡــًٔا"],"19:62":["لَّا","يَسۡمَعُونَ","فِيهَا","لَغۡوًا","إِلَّا","سَلَـٰمًا‌ۖ","وَلَهُمۡ","رِزۡقُهُمۡ","فِيهَا","بُكۡرَةً","وَعَشِيًّا"],"19:73":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","قَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلَّذِينَ","ءَامَنُوٓاۡ","أَىُّ","ٱلۡفَرِيقَيۡنِ","خَيۡرٌ","مَّقَامًا","وَأَحۡسَنُ","نَدِيًّا"],"19:74":["وَكَمۡ","أَهۡلَكۡنَا","قَبۡلَهُم","مِّن","قَرۡنٍ","هُمۡ","أَحۡسَنُ","أَثَـٰثًا","وَرِءۡيًا"],"19:75":["قُلۡ","مَن","كَانَ","فِى","ٱلضَّلَـٰلَةِ","فَلۡيَمۡدُدۡ","لَهُ","ٱلرَّحۡمَـٰنُ","