"لَقَدۡ","جَآءَتۡ","رُسُلُ","رَبِّنَا","بِٱلۡحَقِّ‌ۖ","وَنُودُوٓاۡ","أَن","تِلۡكُمُ","ٱلۡجَنَّةُ","أُورِثۡتُمُوهَا","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"7:135":["فَلَمَّا","كَشَفۡنَا","عَنۡهُمُ","ٱلرِّجۡزَ","إِلَىٰٓ","أَجَلٍ","هُم","بَـٰلِغُوهُ","إِذَا","هُمۡ","يَنكُثُونَ"],"7:136":["فَٱنتَقَمۡنَا","مِنۡهُمۡ","فَأَغۡرَقۡنَـٰهُمۡ","فِى","ٱلۡيَمِّ","بِأَنَّهُمۡ","كَذَّبُواۡ","بِـَٔـايَـٰتِنَا","وَكَانُواۡ","عَنۡهَا","غَـٰفِلِينَ"],"10:42":["وَمِنۡهُم","مَّن","يَسۡتَمِعُونَ","إِلَيۡكَ‌ۚ","أَفَأَنتَ","تُسۡمِعُ","ٱلصُّمَّ","وَلَوۡ","كَانُواۡ","لَا","يَعۡقِلُونَ"],"10:66":["أَلَآ","إِنَّ","لِلَّهِ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ‌ۗ","وَمَا","يَتَّبِعُ","ٱلَّذِينَ","يَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","شُرَكَآءَ‌ۚ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَإِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"10:67":["هُوَ","ٱلَّذِى","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","لِتَسۡكُنُواۡ","فِيهِ","وَٱلنَّهَارَ","مُبۡصِرًا‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يَسۡمَعُونَ"],"11:26":["أَن","لَّا","تَعۡبُدُوٓاۡ","إِلَّا","ٱللَّهَ‌ۖ","إِنِّىٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","أَلِيمٍ"],"11:96":["وَلَقَدۡ","أَرۡسَلۡنَا","مُوسَىٰ","بِـَٔـايَـٰتِنَا","وَسُلۡطَـٰنٍ","مُّبِينٍ"],"11:97":["إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦ","فَٱتَّبَعُوٓاۡ","أَمۡرَ","فِرۡعَوۡنَ‌ۖ","وَمَآ","أَمۡرُ","فِرۡعَوۡنَ","بِرَشِيدٍ"],"12:2":["إِنَّآ","أَنزَلۡنَـٰهُ","قُرۡءٰنًا","عَرَبِيًّا","لَّعَلَّكُمۡ","تَعۡقِلُونَ"],"12:3":["نَحۡنُ","نَقُصُّ","عَلَيۡكَ","أَحۡسَنَ","ٱلۡقَصَصِ","بِمَآ","أَوۡحَيۡنَآ","إِلَيۡكَ","هَـٰذَا","ٱلۡقُرۡءَانَ","وَإِن","كُنتَ","مِن","قَبۡلِهِۦ","لَمِنَ","ٱلۡغَـٰفِلِينَ"],"16:58":["وَإِذَا","بُشِّرَ","أَحَدُهُم","بِٱلۡأُنثَىٰ","ظَلَّ","وَجۡهُهُۥ","مُسۡوَدًّا","وَهُوَ","كَظِيمٌ"],"16:59":["يَتَوٰرَىٰ","مِنَ","ٱلۡقَوۡمِ","مِن","سُوٓءِ","مَا","بُشِّرَ","بِهِۦٓ‌ۚ","أَيُمۡسِكُهُۥ","عَلَىٰ","هُونٍ","أَمۡ","يَدُسُّهُۥ","فِى","ٱلتُّرَابِ‌ۗ","أَلَا","سَآءَ","مَا","يَحۡكُمُونَ"],"19:36":["وَإِنَّ","ٱللَّهَ","رَبِّى","وَرَبُّكُمۡ","فَٱعۡبُدُوهُ‌ۚ","هَـٰذَا","صِرٰطٌ","مُّسۡتَقِيمٌ"],"19:37":["فَٱخۡتَلَفَ","ٱلۡأَحۡزَابُ","مِنۢ","بَيۡنِهِمۡ‌ۖ","فَوَيۡلٌ","لِّلَّذِينَ","كَفَرُواۡ","مِن","مَّشۡهَدِ","يَوۡمٍ","عَظِيمٍ"],"19:38":["أَسۡمِعۡ","بِهِمۡ","وَأَبۡصِرۡ","يَوۡمَ","يَأۡتُونَنَا‌ۖ","لَـٰكِنِ","ٱلظَّـٰلِمُونَ","ٱلۡيَوۡمَ","فِى","ضَلَـٰلٍ","مُّبِينٍ"],"20:53":["ٱلَّذِى","جَعَلَ","لَكُمُ","ٱلۡأَرۡضَ","مَهۡدًا","وَسَلَكَ","لَكُمۡ","فِيهَا","سُبُلاً","وَأَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَأَخۡرَجۡنَا","بِهِۦٓ","أَزۡوٰجًا","مِّن","نَّبَاتٍ","شَتَّىٰ"],"21:44":["بَلۡ","مَتَّعۡنَا","هَـٰٓؤُلَآءِ","وَءَابَآءَهُمۡ","حَتَّىٰ","طَالَ","عَلَيۡهِمُ","ٱلۡعُمُرُ‌ۗ","أَفَلَا","يَرَوۡنَ","أَنَّا","نَأۡتِى","ٱلۡأَرۡضَ","نَنقُصُهَا","مِنۡ","أَطۡرَافِهَآ‌ۚ","أَفَهُمُ","ٱلۡغَـٰلِبُونَ"],"23:70":["أَمۡ","يَقُولُونَ","بِهِۦ","جِنَّةُۢ‌ۚ","بَلۡ","جَآءَهُم","بِٱلۡحَقِّ","وَأَكۡثَرُهُمۡ","لِلۡحَقِّ","كَـٰرِهُونَ"],"23:71":["وَلَوِ","ٱتَّبَعَ","ٱلۡحَقُّ","أَهۡوَآءَهُمۡ","لَفَسَدَتِ","ٱلسَّمَـٰوٰتُ","وَٱلۡأَرۡضُ","وَمَن","فِيهِنَّ‌ۚ","بَلۡ","أَتَيۡنَـٰهُم","بِذِكۡرِهِمۡ","فَهُمۡ","عَن","ذِكۡرِهِم","مُّعۡرِضُونَ"],"26:202":["فَيَأۡتِيَهُم","بَغۡتَةً","وَهُمۡ","لَا","يَشۡعُرُونَ"],"26:203":["فَيَقُولُواۡ","هَلۡ","نَحۡنُ","مُنظَرُونَ"],"29:61":["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَ","لَيَقُولُنَّ","ٱللَّهُ‌ۖ","فَأَنَّىٰ","يُؤۡفَكُونَ"],"31:25":["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","لَيَقُولُنَّ","ٱللَّهُ‌ۚ","قُلِ","ٱلۡحَمۡدُ","لِلَّهِ‌ۚ","بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡلَمُونَ"],"34:34":["وَمَآ","أَرۡسَلۡنَا","فِى","قَرۡيَةٍ","مِّن","نَّذِيرٍ","إِلَّا","قَالَ","مُتۡرَفُوهَآ","إِنَّا","بِمَآ","أُرۡسِلۡتُم","بِهِۦ","كَـٰفِرُونَ"],"39:38":["وَلَئِن","سَأَلۡتَهُم","مَّنۡ","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","لَيَقُولُنَّ","ٱللَّهُ‌ۚ","قُلۡ","أَفَرَءَيۡتُم","مَّا","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","إِنۡ","أَرَادَنِىَ","ٱللَّهُ","بِضُرٍّ","هَلۡ","هُنَّ","كَـٰشِفَـٰتُ","ضُرِّهِۦٓ","أَوۡ","أَرَادَنِى","بِرَحۡمَةٍ","هَلۡ","هُنَّ","مُمۡسِكَـٰتُ","رَحۡم