{"s":24,"groups":[{"src":["24:5"],"muts":[["2:160"],["3:89"]],"ctx":true},{"src":["24:21"],"muts":[["2:208"],["2:168"]]},{"src":["24:27"],"muts":[["33:53"]]},{"src":["24:34"],"muts":[["3:138"],["5:46"]],"ctx":true},{"src":["24:34"],"muts":[["24:46"]]},{"src":["24:37"],"muts":[["21:73"]]},{"src":["24:38"],"muts":[["4:173"],["35:30"],["42:26"]]},{"src":["24:43"],"muts":[["13:13"],["30:48"]]},{"src":["24:53"],"muts":[["5:53"],["6:109"],["16:38"],["35:42"]]},{"src":["24:59"],"muts":[["2:242"],["3:103"],["5:89"]]},{"src":["24:61"],"muts":[["48:17"]]}],"text":{"2:160":["إِلَّا","ٱلَّذِينَ","تَابُواۡ","وَأَصۡلَحُواۡ","وَبَيَّنُواۡ","فَأُوۡلَـٰٓئِكَ","أَتُوبُ","عَلَيۡهِمۡ‌ۚ","وَأَنَا","ٱلتَّوَّابُ","ٱلرَّحِيمُ"],"2:161":["إِنَّ","ٱلَّذِينَ","كَفَرُواۡ","وَمَاتُواۡ","وَهُمۡ","كُفَّارٌ","أُوۡلَـٰٓئِكَ","عَلَيۡهِمۡ","لَعۡنَةُ","ٱللَّهِ","وَٱلۡمَلَـٰٓئِكَةِ","وَٱلنَّاسِ","أَجۡمَعِينَ"],"2:168":["يَـٰٓأَيُّهَا","ٱلنَّاسُ","كُلُواۡ","مِمَّا","فِى","ٱلۡأَرۡضِ","حَلَـٰلاً","طَيِّبًا","وَلَا","تَتَّبِعُواۡ","خُطُوٰتِ","ٱلشَّيۡطَـٰنِ‌ۚ","إِنَّهُۥ","لَكُمۡ","عَدُوٌّ","مُّبِينٌ"],"2:208":["يَـٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواۡ","ٱدۡخُلُواۡ","فِى","ٱلسِّلۡمِ","كَآفَّةً","وَلَا","تَتَّبِعُواۡ","خُطُوٰتِ","ٱلشَّيۡطَـٰنِ‌ۚ","إِنَّهُۥ","لَكُمۡ","عَدُوٌّ","مُّبِينٌ"],"2:242":["كَذٰلِكَ","يُبَيِّنُ","ٱللَّهُ","لَكُمۡ","ءَايَـٰتِهِۦ","لَعَلَّكُمۡ","تَعۡقِلُونَ"],"3:89":["إِلَّا","ٱلَّذِينَ","تَابُواۡ","مِنۢ","بَعۡدِ","ذٰلِكَ","وَأَصۡلَحُواۡ","فَإِنَّ","ٱللَّهَ","غَفُورٌ","رَّحِيمٌ"],"3:90":["إِنَّ","ٱلَّذِينَ","كَفَرُواۡ","بَعۡدَ","إِيمَـٰنِهِمۡ","ثُمَّ","ٱزۡدَادُواۡ","كُفۡرًا","لَّن","تُقۡبَلَ","تَوۡبَتُهُمۡ","وَأُوۡلَـٰٓئِكَ","هُمُ","ٱلضَّآلُّونَ"],"3:103":["وَٱعۡتَصِمُواۡ","بِحَبۡلِ","ٱللَّهِ","جَمِيعًا","وَلَا","تَفَرَّقُواۡ‌ۚ","وَٱذۡكُرُواۡ","نِعۡمَتَ","ٱللَّهِ","عَلَيۡكُمۡ","إِذۡ","كُنتُمۡ","أَعۡدَآءً","فَأَلَّفَ","بَيۡنَ","قُلُوبِكُمۡ","فَأَصۡبَحۡتُم","بِنِعۡمَتِهِۦٓ","إِخۡوٰنًا","وَكُنتُمۡ","عَلَىٰ","شَفَا","حُفۡرَةٍ","مِّنَ","ٱلنَّارِ","فَأَنقَذَكُم","مِّنۡهَا‌ۗ","كَذٰلِكَ","يُبَيِّنُ","ٱللَّهُ","لَكُمۡ","ءَايَـٰتِهِۦ","لَعَلَّكُمۡ","تَهۡتَدُونَ"],"3:138":["هَـٰذَا","بَيَانٌ","لِّلنَّاسِ","وَهُدًى","وَمَوۡعِظَةٌ","لِّلۡمُتَّقِينَ"],"3:139":["وَلَا","تَهِنُواۡ","وَلَا","تَحۡزَنُواۡ","وَأَنتُمُ","ٱلۡأَعۡلَوۡنَ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"4:173":["فَأَمَّا","ٱلَّذِينَ","ءَامَنُواۡ","وَعَمِلُواۡ","ٱلصَّـٰلِحَـٰتِ","فَيُوَفِّيهِمۡ","أُجُورَهُمۡ","وَيَزِيدُهُم","مِّن","فَضۡلِهِۦ‌ۖ","وَأَمَّا","ٱلَّذِينَ","ٱسۡتَنكَفُواۡ","وَٱسۡتَكۡبَرُواۡ","فَيُعَذِّبُهُمۡ","عَذَابًا","أَلِيمًا","وَلَا","يَجِدُونَ","لَهُم","مِّن","دُونِ","ٱللَّهِ","وَلِيًّا","وَلَا","نَصِيرًا"],"5:46":["وَقَفَّيۡنَا","عَلَىٰٓ","ءَاثَـٰرِهِم","بِعِيسَى","ٱبۡنِ","مَرۡيَمَ","مُصَدِّقًا","لِّمَا","بَيۡنَ","يَدَيۡهِ","مِنَ","ٱلتَّوۡرَٮٰةِ‌ۖ","وَءَاتَيۡنَـٰهُ","ٱلۡإِنجِيلَ","فِيهِ","هُدًى","وَنُورٌ","وَمُصَدِّقًا","لِّمَا","بَيۡنَ","يَدَيۡهِ","مِنَ","ٱلتَّوۡرَٮٰةِ","وَهُدًى","وَمَوۡعِظَةً","لِّلۡمُتَّقِينَ"],"5:47":["وَلۡيَحۡكُمۡ","أَهۡلُ","ٱلۡإِنجِيلِ","بِمَآ","أَنزَلَ","ٱللَّهُ","فِيهِ‌ۚ","وَمَن","لَّمۡ","يَحۡكُم","بِمَآ","أَنزَلَ","ٱللَّهُ","فَأُوۡلَـٰٓئِكَ","هُمُ","ٱلۡفَـٰسِقُونَ"],"5:53":["وَيَقُولُ","ٱلَّذِينَ","ءَامَنُوٓاۡ","أَهَـٰٓؤُلَآءِ","ٱلَّذِينَ","أَقۡسَمُواۡ","بِٱللَّهِ","جَهۡدَ","أَيۡمَـٰنِهِمۡ‌ۙ","إِنَّهُمۡ","لَمَعَكُمۡ‌ۚ","حَبِطَتۡ","أَعۡمَـٰلُهُمۡ","فَأَصۡبَحُواۡ","خَـٰسِرِينَ"],"5:89":["لَا","يُؤَاخِذُكُمُ","ٱللَّهُ","بِٱللَّغۡوِ","فِىٓ","أَيۡمَـٰنِكُمۡ","وَلَـٰكِن","يُؤَاخِذُكُم","بِمَا","عَقَّدتُّمُ","ٱلۡأَيۡمَـٰنَ‌ۖ","فَكَفَّـٰرَتُهُۥٓ","إِطۡعَامُ","عَشَرَةِ","مَسَـٰكِينَ","مِنۡ","أَوۡسَطِ","مَا","تُطۡعِمُونَ","أَهۡلِيكُمۡ","أَوۡ","كِسۡوَتُهُمۡ","أَوۡ","تَحۡرِيرُ","رَقَبَةٍ‌ۖ","فَمَن","لَّمۡ","يَجِدۡ","فَصِيَامُ","ثَلَـٰثَةِ","أَيَّامٍ‌ۚ","ذٰلِكَ","كَفَّـٰرَةُ","أَيۡمَـٰنِكُمۡ","إِذَا","حَلَفۡتُمۡ‌ۚ","وَٱحۡفَظُوٓاۡ","أَيۡمَـٰنَكُمۡ‌ۚ","كَذٰلِكَ","يُبَيِّنُ","ٱللَّهُ","لَكُمۡ","ءَايَـٰتِهِۦ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"6:109":["وَأَقۡسَمُواۡ","بِٱللَّهِ","جَهۡدَ","أَيۡمَـٰنِهِمۡ","لَئِن","جَآءَتۡهُمۡ","ءَايَةٌ","لَّيُؤۡمِنُنَّ","بِهَا‌ۚ","قُلۡ","إِنَّمَا","ٱلۡأَيَـٰتُ","عِندَ","ٱللَّهِ‌ۖ","وَمَا","يُشۡعِرُكُمۡ","أَنَّهَآ","إِذَا","جَآءَتۡ","لَا","يُؤۡمِنُونَ"],"13:13":["وَيُسَبِّحُ","ٱلرَّعۡدُ","بِحَمۡدِهِۦ","وَٱلۡمَلَـٰٓئِكَةُ","مِنۡ","خِيفَتِهِۦ","وَيُرۡسِلُ","ٱلصَّوٰعِقَ","فَيُصِيبُ","بِهَا","مَن","يَشَآءُ","وَهُمۡ","يُجَـٰدِلُونَ","فِى","ٱللَّهِ","وَهُوَ","شَدِيدُ","ٱلۡمِحَالِ"],"16:38":["وَأَقۡسَمُواۡ","بِٱللَّهِ","جَهۡدَ","أَيۡمَـٰنِهِمۡ‌ۙ","لَا","يَبۡعَثُ","ٱللَّهُ","مَن","يَمُوتُ‌ۚ","بَلَىٰ","وَعۡدًا","عَلَيۡهِ","حَقًّا","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"21:73":["وَجَعَلۡنَـٰهُمۡ","أَئِمَّةً","يَهۡدُونَ","بِأَمۡرِنَا","وَأَوۡحَيۡنَآ","إِلَيۡهِمۡ","فِعۡلَ","ٱلۡخَيۡرٰتِ","وَإِقَامَ","ٱلصَّلَوٰةِ","وَإِيتَآءَ","ٱلزَّكَوٰةِ‌ۖ","وَكَانُواۡ","لَنَا","عَـٰبِدِينَ"],"24:5":["إِلَّا","ٱلَّذِينَ","تَابُواۡ","مِنۢ","بَعۡدِ","ذٰلِكَ","وَأَصۡلَحُواۡ","فَإِنَّ","ٱللَّهَ","غَفُورٌ","رَّحِيمٌ"],"24:6":["وَٱلَّذِينَ","يَرۡمُونَ","أَزۡوٰجَهُمۡ","وَلَمۡ","يَكُن","لَّهُمۡ","شُهَدَآءُ","إِلَّآ","أَنفُسُهُمۡ","فَشَهَـٰدَةُ","أَحَدِهِمۡ","أَرۡبَعُ","شَهَـٰدٰتِۭ","بِٱللَّهِ‌ۙ","إِنَّهُۥ","لَمِنَ","ٱلصَّـٰدِقِينَ"],"24:21":["۞يَـٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواۡ","لَا","تَتَّبِعُواۡ","خُطُوٰتِ","ٱلشَّيۡطَـٰنِ‌ۚ","وَمَن","يَتَّبِعۡ","خُطُوٰتِ","ٱلشَّيۡطَـٰنِ","فَإِنَّهُۥ","يَأۡمُرُ","بِٱلۡفَحۡشَآءِ","وَٱلۡمُنكَرِ‌ۚ","وَلَوۡلَا","فَضۡلُ","ٱللَّهِ","عَلَيۡكُمۡ","وَرَحۡمَتُهُۥ","مَا","زَكَىٰ","مِنكُم","مِّنۡ","أَحَدٍ","أَبَدًا","وَلَـٰكِنَّ","ٱللَّهَ","يُزَكِّى","مَن","يَشَآءُ‌ۗ","وَٱللَّهُ","سَمِيعٌ","عَلِيمٌ"],"24:27":["يَـٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواۡ","لَا","تَدۡخُلُواۡ","بُيُوتًا","غَيۡرَ","بُيُوتِكُمۡ","حَتَّىٰ","تَسۡتَأۡنِسُواۡ","وَتُسَلِّمُواۡ","عَلَىٰٓ","أَهۡلِهَا‌ۚ","ذٰلِكُمۡ","خَيۡرٌ","لَّكُمۡ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"24:34":["وَلَقَدۡ","أَنزَلۡنَآ","إِلَيۡكُمۡ","ءَايَـٰتٍ","مُّبَيِّنَـٰتٍ","وَمَثَلاً","مِّنَ","ٱلَّذِينَ","خَلَوۡاۡ","مِن","قَبۡلِكُمۡ","وَمَوۡعِظَةً","لِّلۡمُتَّقِينَ"],"24:35":["۞ٱللَّهُ","نُورُ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ‌ۚ","مَثَلُ","نُورِهِۦ","كَمِشۡكَوٰةٍ","فِيهَا","مِصۡبَاحٌ‌ۖ","ٱلۡمِصۡبَاحُ","فِى","زُجَاجَةٍ‌ۖ","ٱلزُّجَاجَةُ","كَأَنَّهَا","كَوۡكَبٌ","دُرِّىٌّ","يُوقَدُ","مِن","شَجَرَةٍ","مُّبَـٰرَكَةٍ","زَيۡتُونَةٍ","لَّا","شَرۡقِيَّةٍ","وَلَا","غَرۡبِيَّةٍ","يَكَادُ","زَيۡتُهَا","يُضِىٓءُ","وَلَوۡ","لَمۡ","تَمۡسَسۡهُ","نَارٌ‌ۚ","نُّورٌ","عَلَىٰ","نُورٍ‌ۗ","يَهۡدِى","ٱللَّهُ","لِنُورِهِۦ","مَن","يَشَآءُ‌ۚ","وَيَضۡرِبُ","ٱللَّهُ","ٱلۡأَمۡثَـٰلَ","لِلنَّاسِ‌ۗ","وَٱللَّهُ","بِكُلِّ","شَىۡءٍ","عَلِيمٌ"],"24:37":["رِجَالٌ","لَّا","تُلۡهِيهِمۡ","تِجَـٰرَةٌ","وَلَا","بَيۡعٌ","عَن","ذِكۡرِ","ٱللَّهِ","وَإِقَامِ","ٱلصَّلَوٰةِ","وَإِيتَآءِ","ٱلزَّكَوٰةِ‌ۙ","يَخَافُونَ","يَوۡمًا","تَتَقَلَّبُ","فِيهِ","ٱلۡقُلُوبُ","وَٱلۡأَبۡصَـٰرُ"],"24:38":["لِيَجۡزِيَهُمُ","ٱللَّهُ","أَحۡسَنَ","مَا","عَمِلُواۡ","وَيَزِيدَهُم","مِّن","فَضۡلِهِۦ‌ۗ","وَٱللَّهُ","يَرۡزُقُ","مَن","يَشَآءُ","بِغَيۡرِ","حِسَابٍ"],"24:43":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يُزۡجِى","سَحَابًا","ثُمَّ","يُؤَلِّفُ","بَيۡنَهُۥ","ثُمَّ","يَجۡعَلُهُۥ","رُكَامًا","فَتَرَى","ٱلۡوَدۡقَ","يَخۡرُجُ","مِنۡ","خِلَـٰلِهِۦ","وَيُنَزِّلُ","مِنَ","ٱلسَّمَآءِ","مِن","جِبَالٍ","فِيهَا","مِنۢ","بَرَدٍ","فَيُصِيبُ","بِهِۦ","مَن","يَشَآءُ","وَيَصۡرِفُهُۥ","عَن","مَّن","يَشَآءُ‌ۖ","يَكَادُ","سَنَا","بَرۡقِهِۦ","يَذۡهَبُ","بِٱلۡأَبۡصَـٰرِ"],"24:46":["لَّقَدۡ","أَنزَلۡنَآ","ءَايَـٰتٍ","مُّبَيِّنَـٰتٍ‌ۚ","وَٱللَّهُ","يَهۡدِى","مَن","يَشَآءُ","إِلَىٰ","صِرٰطٍ","مُّسۡتَقِيمٍ"],"24:53":["۞وَأَقۡسَمُواۡ","بِٱللَّهِ","جَهۡدَ","أَيۡمَـٰنِهِمۡ","لَئِنۡ","أَمَرۡتَهُمۡ","لَيَخۡرُجُنَّ‌ۖ","قُل","لَّا","تُقۡسِمُواۡ‌ۖ","طَاعَةٌ","مَّعۡرُوفَةٌ‌ۚ","إِنَّ","ٱللَّهَ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"24:59":["وَإِذَا","بَلَغَ","ٱلۡأَطۡفَـٰلُ","مِنكُمُ","ٱلۡحُلُمَ","فَلۡيَسۡتَــٔۡذِنُواۡ","كَمَا","ٱسۡتَــٔۡذَنَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ‌ۚ","كَذٰلِكَ","يُبَيِّنُ","ٱللَّهُ","لَكُمۡ","ءَايَـٰتِهِۦ‌ۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"24:61":["لَّيۡسَ","عَلَى","ٱلۡأَعۡمَىٰ","حَرَجٌ","وَلَا","عَلَى","ٱلۡأَعۡرَجِ","حَرَجٌ","وَلَا","عَلَى","ٱلۡمَرِيضِ","حَرَجٌ","وَلَا","عَلَىٰٓ","أَنفُسِكُمۡ","أَن","