"وَأَسۡبَغَ","عَلَيۡكُمۡ","نِعَمَهُۥ","ظَـٰهِرَةً","وَبَاطِنَةً‌ۗ","وَمِنَ","ٱلنَّاسِ","مَن","يُجَـٰدِلُ","فِى","ٱللَّهِ","بِغَيۡرِ","عِلۡمٍ","وَلَا","هُدًى","وَلَا","كِتَـٰبٍ","مُّنِيرٍ"],"31:21":["وَإِذَا","قِيلَ","لَهُمُ","ٱتَّبِعُواۡ","مَآ","أَنزَلَ","ٱللَّهُ","قَالُواۡ","بَلۡ","نَتَّبِعُ","مَا","وَجَدۡنَا","عَلَيۡهِ","ءَابَآءَنَآ‌ۚ","أَوَلَوۡ","كَانَ","ٱلشَّيۡطَـٰنُ","يَدۡعُوهُمۡ","إِلَىٰ","عَذَابِ","ٱلسَّعِيرِ"],"31:29":["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يُولِجُ","ٱلَّيۡلَ","فِى","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِى","ٱلَّيۡلِ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَ","كُلٌّ","يَجۡرِىٓ","إِلَىٰٓ","أَجَلٍ","مُّسَمًّى","وَأَنَّ","ٱللَّهَ","بِمَا","تَعۡمَلُونَ","خَبِيرٌ"],"31:30":["ذٰلِكَ","بِأَنَّ","ٱللَّهَ","هُوَ","ٱلۡحَقُّ","وَأَنَّ","مَا","يَدۡعُونَ","مِن","دُونِهِ","ٱلۡبَـٰطِلُ","وَأَنَّ","ٱللَّهَ","هُوَ","ٱلۡعَلِىُّ","ٱلۡكَبِيرُ"],"31:31":["أَلَمۡ","تَرَ","أَنَّ","ٱلۡفُلۡكَ","تَجۡرِى","فِى","ٱلۡبَحۡرِ","بِنِعۡمَتِ","ٱللَّهِ","لِيُرِيَكُم","مِّنۡ","ءَايَـٰتِهِۦٓ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّكُلِّ","صَبَّارٍ","شَكُورٍ"],"31:33":["يَـٰٓأَيُّهَا","ٱلنَّاسُ","ٱتَّقُواۡ","رَبَّكُمۡ","وَٱخۡشَوۡاۡ","يَوۡمًا","لَّا","يَجۡزِى","وَالِدٌ","عَن","وَلَدِهِۦ","وَلَا","مَوۡلُودٌ","هُوَ","جَازٍ","عَن","وَالِدِهِۦ","شَيۡــًٔا‌ۚ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَقٌّ‌ۖ","فَلَا","تَغُرَّنَّكُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","وَلَا","يَغُرَّنَّكُم","بِٱللَّهِ","ٱلۡغَرُورُ"],"31:34":["إِنَّ","ٱللَّهَ","عِندَهُۥ","عِلۡمُ","ٱلسَّاعَةِ","وَيُنَزِّلُ","ٱلۡغَيۡثَ","وَيَعۡلَمُ","مَا","فِى","ٱلۡأَرۡحَامِ‌ۖ","وَمَا","تَدۡرِى","نَفۡسٌ","مَّاذَا","تَكۡسِبُ","غَدًا‌ۖ","وَمَا","تَدۡرِى","نَفۡسُۢ","بِأَىِّ","أَرۡضٍ","تَمُوتُ‌ۚ","إِنَّ","ٱللَّهَ","عَلِيمٌ","خَبِيرُۢ"],"34:43":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","قَالُواۡ","مَا","هَـٰذَآ","إِلَّا","رَجُلٌ","يُرِيدُ","أَن","يَصُدَّكُمۡ","عَمَّا","كَانَ","يَعۡبُدُ","ءَابَآؤُكُمۡ","وَقَالُواۡ","مَا","هَـٰذَآ","إِلَّآ","إِفۡكٌ","مُّفۡتَرًىۚ","وَقَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلۡحَقِّ","لَمَّا","جَآءَهُمۡ","إِنۡ","هَـٰذَآ","إِلَّا","سِحۡرٌ","مُّبِينٌ"],"35:5":["يَـٰٓأَيُّهَا","ٱلنَّاسُ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَقٌّۖ","فَلَا","تَغُرَّنَّكُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَاۖ","وَلَا","يَغُرَّنَّكُم","بِٱللَّهِ","ٱلۡغَرُورُ"],"35:6":["إِنَّ","ٱلشَّيۡطَـٰنَ","لَكُمۡ","عَدُوٌّ","فَٱتَّخِذُوهُ","عَدُوًّاۚ","إِنَّمَا","يَدۡعُواۡ","حِزۡبَهُۥ","لِيَكُونُواۡ","مِنۡ","أَصۡحَـٰبِ","ٱلسَّعِيرِ"],"35:13":["يُولِجُ","ٱلَّيۡلَ","فِى","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِى","ٱلَّيۡلِ","وَسَخَّرَ","ٱلشَّمۡسَ","وَٱلۡقَمَرَ","كُلٌّ","يَجۡرِى","لِأَجَلٍ","مُّسَمًّىۚ","ذٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","لَهُ","ٱلۡمُلۡكُۚ","وَٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِهِۦ","مَا","يَمۡلِكُونَ","مِن","قِطۡمِيرٍ"],"45:8":["يَسۡمَعُ","ءَايَـٰتِ","ٱللَّهِ","تُتۡلَىٰ","عَلَيۡهِ","ثُمَّ","يُصِرُّ","مُسۡتَكۡبِرًا","كَأَن","لَّمۡ","يَسۡمَعۡهَا‌ۖ","فَبَشِّرۡهُ","بِعَذَابٍ","أَلِيمٍ"],"45:9":["وَإِذَا","عَلِمَ","مِنۡ","ءَايَـٰتِنَا","شَيۡــًٔا","ٱتَّخَذَهَا","هُزُوًا‌ۚ","أُوۡلَـٰٓئِكَ","لَهُمۡ","عَذَابٌ","مُّهِينٌ"],"45:10":["مِّن","وَرَآئِهِمۡ","جَهَنَّمُ‌ۖ","وَلَا","يُغۡنِى","عَنۡهُم","مَّا","كَسَبُواۡ","شَيۡــًٔا","وَلَا","مَا","ٱتَّخَذُواۡ","مِن","دُونِ","ٱللَّهِ","أَوۡلِيَآءَ‌ۖ","وَلَهُمۡ","عَذَابٌ","عَظِيمٌ"],"45:25":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","مَّا","كَانَ","حُجَّتَهُمۡ","إِلَّآ","أَن","قَالُواۡ","ٱئۡتُواۡ","بِـَٔـابَآئِنَآ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"46:7":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","قَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلۡحَقِّ","لَمَّا","جَآءَهُمۡ","هَـٰذَا","سِحۡرٌ","مُّبِينٌ"],"46:15":["وَوَصَّيۡنَا","ٱلۡإِنسَـٰنَ","بِوٰلِدَيۡهِ","إِحۡسَـٰنًا‌ۖ","حَمَلَتۡهُ","أُمُّهُۥ","كُرۡهًا","وَوَضَعَتۡهُ","كُرۡهًا‌ۖ","وَحَمۡلُهُۥ","وَفِصَـٰلُهُۥ","ثَلَـٰثُونَ","شَهۡرًا‌ۚ","حَتَّىٰٓ","إِذَا","بَلَغَ","أَشُدَّهُۥ","وَبَلَغَ","أَرۡبَعِينَ","سَنَةً","قَالَ","رَبِّ","أَوۡزِعۡنِىٓ","أَنۡ","أَشۡكُرَ","نِعۡمَتَكَ","ٱلَّتِىٓ","أَنۡعَمۡتَ","عَلَىَّ","وَعَلَىٰ","وٰلِدَىَّ","وَأَنۡ","أَعۡمَلَ","صَـٰلِحًا","تَرۡضَـٰهُ","وَأَصۡلِحۡ","لِى","فِى","ذُرِّيَّتِىٓ‌ۖ","إِنِّى","تُبۡتُ","إِلَيۡكَ","وَإِنِّى","مِنَ","ٱلۡمُسۡلِمِينَ"],"57:6":["يُولِجُ","ٱلَّيۡلَ","فِى","ٱلنَّهَارِ","وَيُولِجُ","ٱلنَّهَارَ","فِى","ٱلَّيۡلِ‌ۚ","وَهُوَ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"57:23":["لِّكَيۡلَا","تَأۡسَوۡاۡ","عَلَىٰ","مَا","فَاتَكُمۡ","وَلَا","تَفۡرَحُواۡ","بِمَآ","ءَاتَـٰكُمۡ‌ۗ","وَٱللَّهُ","لَا","يُحِبُّ","كُلَّ","مُخۡتَالٍ","فَخُورٍ"],"57:24":["ٱلَّذِينَ","يَبۡخَلُونَ","وَيَأۡمُرُونَ","ٱلنَّاسَ","بِٱلۡبُخۡلِ‌ۗ","وَمَن","يَتَوَلَّ","فَإِنَّ","ٱللَّهَ","هُوَ","ٱلۡغَنِىُّ","ٱلۡحَمِيدُ"]}}