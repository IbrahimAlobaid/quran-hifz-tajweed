ۡ","عَذَابَ","يَوۡمٍ","أَلِيمٍ"],"11:27":["فَقَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","كَفَرُواۡ","مِن","قَوۡمِهِۦ","مَا","نَرَٮٰكَ","إِلَّا","بَشَرًا","مِّثۡلَنَا","وَمَا","نَرَٮٰكَ","ٱتَّبَعَكَ","إِلَّا","ٱلَّذِينَ","هُمۡ","أَرَاذِلُنَا","بَادِىَ","ٱلرَّأۡىِ","وَمَا","نَرَىٰ","لَكُمۡ","عَلَيۡنَا","مِن","فَضۡلِۭ","بَلۡ","نَظُنُّكُمۡ","كَـٰذِبِينَ"],"11:28":["قَالَ","يَـٰقَوۡمِ","أَرَءَيۡتُمۡ","إِن","كُنتُ","عَلَىٰ","بَيِّنَةٍ","مِّن","رَّبِّى","وَءَاتَـٰنِى","رَحۡمَةً","مِّنۡ","عِندِهِۦ","فَعُمِّيَتۡ","عَلَيۡكُمۡ","أَنُلۡزِمُكُمُوهَا","وَأَنتُمۡ","لَهَا","كَـٰرِهُونَ"],"11:29":["وَيَـٰقَوۡمِ","لَآ","أَسۡــَٔلُكُمۡ","عَلَيۡهِ","مَالاً‌ۖ","إِنۡ","أَجۡرِىَ","إِلَّا","عَلَى","ٱللَّهِ‌ۚ","وَمَآ","أَنَاۡ","بِطَارِدِ","ٱلَّذِينَ","ءَامَنُوٓاۡ‌ۚ","إِنَّهُم","مُّلَـٰقُواۡ","رَبِّهِمۡ","وَلَـٰكِنِّىٓ","أَرَٮٰكُمۡ","قَوۡمًا","تَجۡهَلُونَ"],"11:31":["وَلَآ","أَقُولُ","لَكُمۡ","عِندِى","خَزَآئِنُ","ٱللَّهِ","وَلَآ","أَعۡلَمُ","ٱلۡغَيۡبَ","وَلَآ","أَقُولُ","إِنِّى","مَلَكٌ","وَلَآ","أَقُولُ","لِلَّذِينَ","تَزۡدَرِىٓ","أَعۡيُنُكُمۡ","لَن","يُؤۡتِيَهُمُ","ٱللَّهُ","خَيۡرًا‌ۖ","ٱللَّهُ","أَعۡلَمُ","بِمَا","فِىٓ","أَنفُسِهِمۡ‌ۖ","إِنِّىٓ","إِذًا","لَّمِنَ","ٱلظَّـٰلِمِينَ"],"11:36":["وَأُوحِىَ","إِلَىٰ","نُوحٍ","أَنَّهُۥ","لَن","يُؤۡمِنَ","مِن","قَوۡمِكَ","إِلَّا","مَن","قَدۡ","ءَامَنَ","فَلَا","تَبۡتَئِسۡ","بِمَا","كَانُواۡ","يَفۡعَلُونَ"],"11:37":["وَٱصۡنَعِ","ٱلۡفُلۡكَ","بِأَعۡيُنِنَا","وَوَحۡيِنَا","وَلَا","تُخَـٰطِبۡنِى","فِى","ٱلَّذِينَ","ظَلَمُوٓاۡ‌ۚ","إِنَّهُم","مُّغۡرَقُونَ"],"11:40":["حَتَّىٰٓ","إِذَا","جَآءَ","أَمۡرُنَا","وَفَارَ","ٱلتَّنُّورُ","قُلۡنَا","ٱحۡمِلۡ","فِيهَا","مِن","كُلٍّ","زَوۡجَيۡنِ","ٱثۡنَيۡنِ","وَأَهۡلَكَ","إِلَّا","مَن","سَبَقَ","عَلَيۡهِ","ٱلۡقَوۡلُ","وَمَنۡ","ءَامَنَ‌ۚ","وَمَآ","ءَامَنَ","مَعَهُۥٓ","إِلَّا","قَلِيلٌ"],"11:49":["تِلۡكَ","مِنۡ","أَنۢبَآءِ","ٱلۡغَيۡبِ","نُوحِيهَآ","إِلَيۡكَ‌ۖ","مَا","كُنتَ","تَعۡلَمُهَآ","أَنتَ","وَلَا","قَوۡمُكَ","مِن","قَبۡلِ","هَـٰذَا‌ۖ","فَٱصۡبِرۡ‌ۖ","إِنَّ","ٱلۡعَـٰقِبَةَ","لِلۡمُتَّقِينَ"],"11:50":["وَإِلَىٰ","عَادٍ","أَخَاهُمۡ","هُودًا‌ۚ","قَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥٓ‌ۖ","إِنۡ","أَنتُمۡ","إِلَّا","مُفۡتَرُونَ"],"11:51":["يَـٰقَوۡمِ","لَآ","أَسۡــَٔلُكُمۡ","عَلَيۡهِ","أَجۡرًا‌ۖ","إِنۡ","أَجۡرِىَ","إِلَّا","عَلَى","ٱلَّذِى","فَطَرَنِىٓ‌ۚ","أَفَلَا","تَعۡقِلُونَ"],"11:52":["وَيَـٰقَوۡمِ","ٱسۡتَغۡفِرُواۡ","رَبَّكُمۡ","ثُمَّ","تُوبُوٓاۡ","إِلَيۡهِ","يُرۡسِلِ","ٱلسَّمَآءَ","عَلَيۡكُم","مِّدۡرَارًا","وَيَزِدۡكُمۡ","قُوَّةً","إِلَىٰ","قُوَّتِكُمۡ","وَلَا","تَتَوَلَّوۡاۡ","مُجۡرِمِينَ"],"11:53":["قَالُواۡ","يَـٰهُودُ","مَا","جِئۡتَنَا","بِبَيِّنَةٍ","وَمَا","نَحۡنُ","بِتَارِكِىٓ","ءَالِهَتِنَا","عَن","قَوۡلِكَ","وَمَا","نَحۡنُ","لَكَ","بِمُؤۡمِنِينَ"],"11:54":["إِن","نَّقُولُ","إِلَّا","ٱعۡتَرَٮٰكَ","بَعۡضُ","ءَالِهَتِنَا","بِسُوٓءٍ‌ۗ","قَالَ","إِنِّىٓ","أُشۡهِدُ","ٱللَّهَ","وَٱشۡهَدُوٓاۡ","أَنِّى","بَرِىٓءٌ","مِّمَّا","تُشۡرِكُونَ"],"11:57":["فَإِن","تَوَلَّوۡاۡ","فَقَدۡ","أَبۡلَغۡتُكُم","مَّآ","أُرۡسِلۡتُ","بِهِۦٓ","إِلَيۡكُمۡ‌ۚ","وَيَسۡتَخۡلِفُ","رَبِّى","قَوۡمًا","غَيۡرَكُمۡ","وَلَا","تَضُرُّونَهُۥ","شَيۡــًٔا‌ۚ","إِنَّ","رَبِّى","عَلَىٰ","كُلِّ","شَىۡءٍ","حَفِيظٌ"],"11:58":["وَلَمَّا","جَآءَ","أَمۡرُنَا","نَجَّيۡنَا","هُودًا","وَٱلَّذِينَ","ءَامَنُواۡ","مَعَهُۥ","بِرَحۡمَةٍ","مِّنَّا","وَنَجَّيۡنَـٰهُم","مِّنۡ","عَذَابٍ","غَلِيظٍ"],"11:60":["وَأُتۡبِعُواۡ","فِى","هَـٰذِهِ","ٱلدُّنۡيَا","لَعۡنَةً","وَيَوۡمَ","ٱلۡقِيَـٰمَةِ‌ۗ","أَلَآ","إِنَّ","عَادًا","كَفَرُواۡ","رَبَّهُمۡ‌ۗ","أَلَا","بُعۡدًا","لِّعَادٍ","قَوۡمِ","هُودٍ"],"11:61":["۞وَإِلَىٰ","ثَمُودَ","أَخَاهُمۡ","صَـٰلِحًا‌ۚ","قَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥ‌ۖ","هُوَ","أَنشَأَكُم","مِّنَ","ٱلۡأَرۡضِ","وَٱسۡتَعۡمَرَكُمۡ","فِيهَا","فَٱسۡتَغۡفِرُوهُ","ثُمَّ","تُوبُوٓاۡ","إِلَيۡهِ‌ۚ","إِنَّ","رَبِّى","قَرِيبٌ","مُّجِيبٌ"],"11:62":["قَالُواۡ","يَـٰصَـٰلِحُ","قَدۡ","كُنتَ","فِينَا","مَرۡجُوًّا","قَبۡلَ","هَـٰذَآ‌ۖ","أَتَنۡهَـٰنَآ","أَن","نَّعۡبُدَ","مَا","يَعۡبُدُ","ءَابَآؤُنَا","وَإِنَّنَا","لَفِى","شَكٍّ","مِّمَّا","تَدۡعُونَآ","إِلَيۡهِ","مُرِيبٍ"],"11:63":["قَالَ","يَـٰقَوۡمِ","أَرَءَيۡتُمۡ","إِن","كُنتُ","عَلَىٰ","بَيِّنَةٍ","مِّن","رَّبِّى","وَءَاتَـٰنِى","مِنۡهُ","رَحۡمَةً","فَمَن","يَنصُرُنِى","مِنَ","ٱللَّهِ","إِنۡ","عَصَيۡتُهُۥ‌ۖ","فَمَا","تَزِيدُونَنِى","غَيۡرَ","تَخۡسِيرٍ"],"11:64":["وَيَـٰقَوۡمِ","هَـٰذِهِۦ","نَاقَةُ","ٱللَّهِ","لَكُمۡ","ءَايَةً","فَذَرُوهَا","تَأۡكُلۡ","فِىٓ","أَرۡضِ","ٱللَّهِ","وَلَا","تَمَسُّوهَا","بِسُوٓءٍ","فَيَأۡخُذَكُمۡ","عَذَابٌ","قَرِيبٌ"],"11:66":["فَلَمَّا","جَآءَ","أَمۡرُنَا","نَجَّيۡنَا","صَـٰلِحًا","وَٱلَّذِينَ","ءَامَنُواۡ","مَعَهُۥ","بِرَحۡمَةٍ","مِّنَّا","وَمِنۡ","خِزۡىِ","يَوۡمِئِذٍ‌ۗ","إِنَّ","رَبَّكَ","هُوَ","ٱلۡقَوِىُّ","ٱلۡعَزِيزُ"],"11:67":["وَأَخَذَ","ٱلَّذِينَ","ظَلَمُواۡ","ٱلصَّيۡحَةُ","فَأَصۡبَحُواۡ","فِى","دِيَـٰرِهِمۡ","جَـٰثِمِينَ"],"11:68":["كَأَن","لَّمۡ","يَغۡنَوۡاۡ","فِيهَآ‌ۗ","أَلَآ","إِنَّ","ثَمُودَاۡ","كَفَرُواۡ","رَبَّهُمۡ‌ۗ","أَلَا","بُعۡدًا","لِّثَمُودَ"],"11:69":["وَلَقَدۡ","جَآءَتۡ","رُسُلُنَآ","إِبۡرٰهِيمَ","بِٱلۡبُشۡرَىٰ","قَالُواۡ","سَلَـٰمًا‌ۖ","قَالَ","سَلَـٰمٌ‌ۖ","فَمَا","لَبِثَ","أَن","جَآءَ","بِعِجۡلٍ","حَنِيذٍ"],"11:70":["فَلَمَّا","رَءَآ","أَيۡدِيَهُمۡ","لَا","تَصِلُ","إِلَيۡهِ","نَكِرَهُمۡ","وَأَوۡجَسَ","مِنۡهُمۡ","خِيفَةً‌ۚ","قَالُواۡ","لَا","تَخَفۡ","إِنَّآ","أُرۡسِلۡنَآ","إِلَىٰ","قَوۡمِ","لُوطٍ"],"11:77":["وَلَمَّا","جَآءَتۡ","رُسُلُنَا","لُوطًا","سِىٓءَ","بِهِمۡ","وَضَاقَ","بِهِمۡ","ذَرۡعًا","وَقَالَ","هَـٰذَا","يَوۡمٌ","عَصِيبٌ"],"11:81":["قَالُواۡ","يَـٰلُوطُ","إِنَّا","رُسُلُ","رَبِّكَ","لَن","يَصِلُوٓاۡ","إِلَيۡكَ‌ۖ","فَأَسۡرِ","بِأَهۡلِكَ","بِقِطۡعٍ","مِّنَ","ٱلَّيۡلِ","وَلَا","يَلۡتَفِتۡ","مِنكُمۡ","أَحَدٌ","إِلَّا","ٱمۡرَأَتَكَ‌ۖ","إِنَّهُۥ","مُصِيبُهَا","مَآ","أَصَابَهُمۡ‌ۚ","إِنَّ","مَوۡعِدَهُمُ","ٱلصُّبۡحُ‌ۚ","أَلَيۡسَ","ٱلصُّبۡحُ","بِقَرِيبٍ"],"11:82":["فَلَمَّا","جَآءَ","أَمۡرُنَا","جَعَلۡنَا","عَـٰلِيَهَا","سَافِلَهَا","وَأَمۡطَرۡنَا","عَلَيۡهَا","حِجَارَةً","مِّن","سِجِّيلٍ","مَّنضُودٍ"],"11:84":["۞وَإِلَىٰ","مَدۡيَنَ","أَخَاهُمۡ","شُعَيۡبًا‌ۚ","قَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥ‌ۖ","وَلَا","تَنقُصُواۡ","ٱلۡمِكۡيَالَ","وَٱلۡمِيزَانَ‌ۚ","إِنِّىٓ","أَرَٮٰكُم","بِخَيۡرٍ","وَإِنِّىٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","مُّحِيطٍ"],"11:85":["وَيَـٰقَوۡمِ","أَوۡفُواۡ","ٱلۡمِكۡيَالَ","وَٱلۡمِيزَانَ","بِٱلۡقِسۡطِ‌ۖ","وَلَا","تَبۡخَسُواۡ","ٱلنَّاسَ","أَشۡيَآءَهُمۡ","وَلَا","تَعۡثَوۡاۡ","فِى","ٱلۡأَرۡضِ","مُفۡسِدِينَ"],"11:88":["قَالَ","يَـٰقَوۡمِ","أَرَءَيۡتُمۡ","إِن","كُنتُ","عَلَىٰ","بَيِّنَةٍ","مِّن","رَّبِّى","وَرَزَقَنِى","مِنۡهُ","رِزۡقًا","حَسَنًا‌ۚ","وَمَآ","أُرِيدُ","أَنۡ","أُخَالِفَكُمۡ","إِلَىٰ","مَآ","أَنۡهَـٰكُمۡ","عَنۡهُ‌ۚ","إِنۡ","أُرِيدُ","إِلَّا","ٱلۡإِصۡلَـٰحَ","مَا","ٱسۡتَطَعۡتُ‌ۚ","وَمَا","تَوۡفِيقِىٓ","إِلَّا","بِٱللَّهِ‌ۚ","عَلَيۡهِ","تَوَكَّلۡتُ","وَإِلَيۡهِ","أُنِيبُ"],"11:93":["وَيَـٰقَوۡمِ","ٱعۡمَلُواۡ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّى","عَـٰمِلٌ‌ۖ","سَوۡفَ","تَعۡلَمُونَ","مَن","يَأۡتِيهِ","عَذَابٌ","يُخۡزِيهِ","وَمَنۡ","هُوَ","كَـٰذِبٌ‌ۖ","وَٱرۡتَقِبُوٓاۡ","إِنِّى","مَعَكُمۡ","رَقِيبٌ"],"11:94":["وَلَمَّا","جَآءَ","أَمۡرُنَا","نَجَّيۡنَا","شُعَيۡبًا","وَٱلَّذِينَ","ءَامَنُواۡ","مَعَهُۥ","بِرَحۡمَةٍ","مِّنَّا","وَأَخَذَتِ","ٱلَّذِينَ","ظَلَمُواۡ","ٱلصَّيۡحَةُ","فَأَصۡبَحُواۡ","فِى","دِيَـٰرِهِمۡ","جَـٰثِمِينَ"],"11:95":["كَأَن","لَّمۡ","يَغۡنَوۡاۡ","فِيهَآ‌ۗ","أَلَا","بُعۡدًا","لِّمَدۡيَنَ","كَمَا","بَعِدَتۡ","ثَمُودُ"],"11:96":["وَلَقَدۡ","أَرۡسَلۡنَا","مُوسَىٰ","بِـَٔـايَـٰتِنَا","وَسُلۡطَـٰنٍ","مُّبِينٍ"],"11:97":["إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦ","فَٱتَّبَعُوٓاۡ","أَمۡرَ","فِرۡعَوۡنَ‌ۖ","وَمَآ","أَمۡرُ","فِرۡعَوۡنَ","بِرَشِيدٍ"],"11:99":["وَأُتۡبِعُواۡ","فِى","هَـٰذِهِۦ","لَعۡنَةً","وَيَوۡمَ","ٱلۡقِيَـٰمَةِ‌ۚ","بِئۡسَ","ٱلرِّفۡدُ","ٱلۡمَرۡفُودُ"],"11:110":["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَـٰبَ","فَٱخۡتُلِفَ","فِيهِ‌ۚ","وَلَوۡلَا","كَلِمَةٌ","سَبَقَتۡ","مِن","رَّبِّكَ","لَقُضِىَ","بَيۡنَهُمۡ‌ۚ","وَإِنَّهُمۡ","لَفِى","شَكٍّ","مِّنۡهُ","مُرِيبٍ"],"11:111":["وَإِنَّ","كُلاًّ","لَّمَّا","لَيُوَفِّيَنَّهُمۡ","رَبُّكَ","أَعۡمَـٰلَهُمۡ‌ۚ","إِنَّهُۥ","بِمَا","يَعۡمَلُونَ","خَبِيرٌ"],"11:112":["فَٱسۡتَقِمۡ","كَمَآ","أُمِرۡتَ","وَمَن","تَابَ","مَعَكَ","وَلَا","تَطۡغَوۡاۡ‌ۚ","إِنَّهُۥ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"11:117":["وَمَا","كَانَ","رَبُّكَ","لِيُهۡلِكَ","ٱلۡقُرَىٰ","بِظُلۡمٍ","وَأَهۡلُهَا","مُصۡلِحُونَ"],"11:119":["إِلَّا","مَن","رَّحِمَ","رَبُّكَ‌ۚ","وَلِذٰلِكَ","خَلَقَهُمۡ‌ۗ","وَتَمَّتۡ","كَلِمَةُ","رَبِّكَ","لَأَمۡلَأَنَّ","جَهَنَّمَ","مِنَ","ٱلۡجِنَّةِ","وَٱلنَّاسِ","أَجۡمَعِينَ"],"12:69":["وَلَمَّا","دَخَلُواۡ","عَلَىٰ","يُوسُفَ","ءَاوَىٰٓ","إِلَيۡهِ","أَخَاهُ‌ۖ","قَالَ","إِنِّىٓ","أَنَاۡ","أَخُوكَ","فَلَا","تَبۡتَئِسۡ","بِمَا","كَانُواۡ","يَعۡمَلُونَ"],"12:102":["ذٰلِكَ","مِنۡ","أَنۢبَآءِ","ٱلۡغَيۡبِ","نُوحِيهِ","إِلَيۡكَ‌ۖ","وَمَا","كُنتَ","لَدَيۡهِمۡ","إِذۡ","أَجۡمَعُوٓاۡ","أَمۡرَهُمۡ","وَهُمۡ","يَمۡكُرُونَ"],"13:1":["الٓمٓر‌ۚ","تِلۡكَ","ءَايَـٰتُ","ٱلۡكِتَـٰبِ‌ۗ","وَٱلَّذِىٓ","أُنزِلَ","إِلَيۡكَ","مِن","رَّبِّكَ","ٱلۡحَقُّ","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يُؤۡمِنُونَ"],"14:9":["أَلَمۡ","يَأۡتِكُمۡ","نَبَؤُاۡ","ٱلَّذِينَ","مِن","قَبۡلِكُمۡ","قَوۡمِ","نُوحٍ","وَعَادٍ","وَثَمُودَ‌ۛ","وَٱلَّذِينَ","مِنۢ","بَعۡدِهِمۡ‌ۛ","لَا","يَعۡلَمُهُمۡ","إِلَّا","ٱللَّهُ‌ۚ","جَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَـٰتِ","فَرَدُّوٓاۡ","أَيۡدِيَهُمۡ","فِىٓ","أَفۡوٰهِهِمۡ","وَقَالُوٓاۡ","إِنَّا","كَفَرۡنَا","بِمَآ","أُرۡسِلۡتُم","بِهِۦ","وَإِنَّا","لَفِى","شَكٍّ","مِّمَّا","تَدۡعُونَنَآ","إِلَيۡهِ","مُرِيبٍ"],"15:65":["فَأَسۡرِ","بِأَهۡلِكَ","بِقِطۡعٍ","مِّنَ","ٱلَّيۡلِ","وَٱتَّبِعۡ","أَدۡبَـٰرَهُمۡ","وَلَا","يَلۡتَفِتۡ","مِنكُمۡ","أَحَدٌ","وَٱمۡضُواۡ","حَيۡثُ","تُؤۡمَرُونَ"],"15:74":["فَجَعَلۡنَا","عَـٰلِيَهَا","سَافِلَهَا","وَأَمۡطَرۡنَا","عَلَيۡهِمۡ","حِجَارَةً","مِّن","سِجِّيلٍ"],"16:109":["لَا","جَرَمَ","أَنَّهُمۡ","فِى","ٱلۡأَخِرَةِ","هُمُ","ٱلۡخَـٰسِرُونَ"],"16:110":["ثُمَّ","إِنَّ","رَبَّكَ","لِلَّذِينَ","هَاجَرُواۡ","مِنۢ","بَعۡدِ","مَا","فُتِنُواۡ","ثُمَّ","جَـٰهَدُواۡ","وَصَبَرُوٓاۡ","إِنَّ","رَبَّكَ","مِنۢ","بَعۡدِهَا","لَغَفُورٌ","رَّحِيمٌ"],"23:23":["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦ","فَقَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥٓ‌ۖ","أَفَلَا","تَتَّقُونَ"],"23:24":["فَقَالَ","ٱلۡمَلَؤُاۡ","ٱلَّذِينَ","كَفَرُواۡ","مِن","قَوۡمِهِۦ","مَا","هَـٰذَآ","إِلَّا","بَشَرٌ","مِّثۡلُكُمۡ","يُرِيدُ","أَن","يَتَفَضَّلَ","عَلَيۡكُمۡ","وَلَوۡ","شَآءَ","ٱللَّهُ","لَأَنزَلَ","مَلَـٰٓئِكَةً","مَّا","سَمِعۡنَا","بِهَـٰذَا","فِىٓ","ءَابَآئِنَا","ٱلۡأَوَّلِينَ"],"23:27":["فَأَوۡحَيۡنَآ","إِلَيۡهِ","أَنِ","ٱصۡنَعِ","ٱلۡفُلۡكَ","بِأَعۡيُنِنَا","وَوَحۡيِنَا","فَإِذَا","جَآءَ","أَمۡرُنَا","وَفَارَ","ٱلتَّنُّورُ‌ۙ","فَٱسۡلُكۡ","فِيهَا","مِن","كُلٍّ","زَوۡجَيۡنِ","ٱثۡنَيۡنِ","وَأَهۡلَكَ","إِلَّا","مَن","سَبَقَ","عَلَيۡهِ","ٱلۡقَوۡلُ","مِنۡهُمۡ‌ۖ","وَلَا","تُخَـٰطِبۡنِى","فِى","ٱلَّذِينَ","ظَلَمُوٓاۡ‌ۖ","إِنَّهُم","مُّغۡرَقُونَ"],"23:33":["وَقَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِهِ","ٱلَّذِينَ","كَفَرُواۡ","وَكَذَّبُواۡ","بِلِقَآءِ","ٱلۡأَخِرَةِ","وَأَتۡرَفۡنَـٰهُمۡ","فِى","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","مَا","هَـٰذَآ","إِلَّا","بَشَرٌ","مِّثۡلُكُمۡ","يَأۡكُلُ","مِمَّا","تَأۡكُلُونَ","مِنۡهُ","وَيَشۡرَبُ","مِمَّا","تَشۡرَبُونَ"],"25:59":["ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۚ","ٱلرَّحۡمَـٰنُ","فَسۡــَٔلۡ","بِهِۦ","خَبِيرًا"],"28:50":["فَإِن","لَّمۡ","يَسۡتَجِيبُواۡ","لَكَ","فَٱعۡلَمۡ","أَنَّمَا","يَتَّبِعُونَ","أَهۡوَآءَهُمۡ‌ۚ","وَمَنۡ","أَضَلُّ","مِمَّنِ","ٱتَّبَعَ","هَوَٮٰهُ","بِغَيۡرِ","هُدًى","مِّنَ","ٱللَّهِ‌ۚ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِى","ٱلۡقَوۡمَ","ٱلظَّـٰلِمِينَ"],"28:59":["وَمَا","كَانَ","رَبُّكَ","مُهۡلِكَ","ٱلۡقُرَىٰ","حَتَّىٰ","يَبۡعَثَ","فِىٓ","أُمِّهَا","رَسُولاً","يَتۡلُواۡ","عَلَيۡهِمۡ","ءَايَـٰتِنَا‌ۚ","وَمَا","كُنَّا","مُهۡلِكِى","ٱلۡقُرَىٰٓ","إِلَّا","وَأَهۡلُهَا","ظَـٰلِمُونَ"],"29:31":["وَلَمَّا","جَآءَتۡ","رُسُلُنَآ","إِبۡرٰهِيمَ","بِٱلۡبُشۡرَىٰ","قَالُوٓاۡ","إِنَّا","مُهۡلِكُوٓاۡ","أَهۡلِ","هَـٰذِهِ","ٱلۡقَرۡيَةِ‌ۖ","إِنَّ","أَهۡلَهَا","كَانُواۡ","ظَـٰلِمِينَ"],"29:33":["وَلَمَّآ","أَن","جَآءَتۡ","رُسُلُنَا","لُوطًا","سِىٓءَ","بِهِمۡ","وَضَاقَ","بِهِمۡ","ذَرۡعًا","وَقَالُواۡ","لَا","تَخَفۡ","وَلَا","تَحۡزَنۡ‌ۖ","إِنَّا","مُنَجُّوكَ","وَأَهۡلَكَ","إِلَّا","ٱمۡرَأَتَكَ","كَانَتۡ","مِنَ","ٱلۡغَـٰبِرِينَ"],"29:36":["وَإِلَىٰ","مَدۡيَنَ","أَخَاهُمۡ","شُعَيۡبًا","فَقَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","وَٱرۡجُواۡ","ٱلۡيَوۡمَ","ٱلۡأَخِرَ","وَلَا","تَعۡثَوۡاۡ","فِى","ٱلۡأَرۡضِ","مُفۡسِدِينَ"],"29:68":["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","كَذَّبَ","بِٱلۡحَقِّ","لَمَّا","جَآءَهُۥٓ‌ۚ","أَلَيۡسَ","فِى","جَهَنَّمَ","مَثۡوًى","لِّلۡكَـٰفِرِينَ"],"32:4":["ٱللَّهُ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۖ","مَا","لَكُم","مِّن","دُونِهِۦ","مِن","وَلِىٍّ","وَلَا","شَفِيعٍ‌ۚ","أَفَلَا","تَتَذَكَّرُونَ"],"38:85":["لَأَمۡلَأَنَّ","جَهَنَّمَ","مِنكَ","وَمِمَّن","تَبِعَكَ","مِنۡهُمۡ","أَجۡمَعِينَ"],"39:39":["قُلۡ","يَـٰقَوۡمِ","ٱعۡمَلُواۡ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّى","عَـٰمِلٌ‌ۖ","فَسَوۡفَ","تَعۡلَمُونَ"],"40:23":["وَلَقَدۡ","أَرۡسَلۡنَا","مُوسَىٰ","بِـَٔـايَـٰتِنَا","وَسُلۡطَـٰنٍ","مُّبِينٍ"],"40:24":["إِلَىٰ","فِرۡعَوۡنَ","وَهَـٰمَـٰنَ","وَقَـٰرُونَ","فَقَالُواۡ","سَـٰحِرٌ","كَذَّابٌ"],"40:59":["إِنَّ","ٱلسَّاعَةَ","لَأَتِيَةٌ","لَّا","رَيۡبَ","فِيهَا","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يُؤۡمِنُونَ"],"41:45":["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَـٰبَ","فَٱخۡتُلِفَ","فِيهِ‌ۗ","وَلَوۡلَا","كَلِمَةٌ","سَبَقَتۡ","مِن","رَّبِّكَ","لَقُضِىَ","بَيۡنَهُمۡ‌ۚ","وَإِنَّهُمۡ","لَفِى","شَكٍّ","مِّنۡهُ","مُرِيبٍ"],"41:46":["مَّنۡ","عَمِلَ","صَـٰلِحًا","فَلِنَفۡسِهِۦ‌ۖ","وَمَنۡ","أَسَآءَ","فَعَلَيۡهَا‌ۗ","وَمَا","رَبُّكَ","بِظَلَّـٰمٍ","لِّلۡعَبِيدِ"],"41:50":["وَلَئِنۡ","أَذَقۡنَـٰهُ","رَحۡمَةً","مِّنَّا","مِنۢ","بَعۡدِ","ضَرَّآءَ","مَسَّتۡهُ","لَيَقُولَنَّ","هَـٰذَا","لِى","وَمَآ","أَظُنُّ","ٱلسَّاعَةَ","قَآئِمَةً","وَلَئِن","رُّجِعۡتُ","إِلَىٰ","رَبِّىٓ","إِنَّ","لِى","عِندَهُۥ","لَلۡحُسۡنَىٰ‌ۚ","فَلَنُنَبِّئَنَّ","ٱلَّذِينَ","كَفَرُواۡ","بِمَا","عَمِلُواۡ","وَلَنُذِيقَنَّهُم","مِّنۡ","عَذَابٍ","غَلِيظٍ"],"42:15":["فَلِذٰلِكَ","فَٱدۡعُ‌ۖ","وَٱسۡتَقِمۡ","كَمَآ","أُمِرۡتَ‌ۖ","وَلَا","تَتَّبِعۡ","أَهۡوَآءَهُمۡ‌ۖ","وَقُلۡ","ءَامَنتُ","بِمَآ","أَنزَلَ","ٱللَّهُ","مِن","كِتَـٰبٍ‌ۖ","وَأُمِرۡتُ","لِأَعۡدِلَ","بَيۡنَكُمُ‌ۖ","ٱللَّهُ","رَبُّنَا","وَرَبُّكُمۡ‌ۖ","لَنَآ","أَعۡمَـٰلُنَا","وَلَكُمۡ","أَعۡمَـٰلُكُمۡ‌ۖ","لَا","حُجَّةَ","بَيۡنَنَا","وَبَيۡنَكُمُ‌ۖ","ٱللَّهُ","يَجۡمَعُ","بَيۡنَنَا‌ۖ","وَإِلَيۡهِ","ٱلۡمَصِيرُ"],"43:46":["وَلَقَدۡ","أَرۡسَلۡنَا","مُوسَىٰ","بِـَٔـايَـٰتِنَآ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦ","فَقَالَ","إِنِّى","رَسُولُ","رَبِّ","ٱلۡعَـٰلَمِينَ"],"43:47":["فَلَمَّا","جَآءَهُم","بِـَٔـايَـٰتِنَآ","إِذَا","هُم","مِّنۡهَا","يَضۡحَكُونَ"],"43:65":["فَٱخۡتَلَفَ","ٱلۡأَحۡزَابُ","مِنۢ","بَيۡنِهِمۡ‌ۖ","فَوَيۡلٌ","لِّلَّذِينَ","ظَلَمُواۡ","مِنۡ","عَذَابِ","يَوۡمٍ","أَلِيمٍ"],"46:21":["۞وَٱذۡكُرۡ","أَخَا","عَادٍ","إِذۡ","أَنذَرَ","قَوۡمَهُۥ","بِٱلۡأَحۡقَافِ","وَقَدۡ","خَلَتِ","ٱلنُّذُرُ","مِنۢ","بَيۡنِ","يَدَيۡهِ","وَمِنۡ","خَلۡفِهِۦٓ","أَلَّا","تَعۡبُدُوٓاۡ","إِلَّا","ٱللَّهَ","إِنِّىٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","عَظِيمٍ"],"51:28":["فَأَوۡجَسَ","مِنۡهُمۡ","خِيفَةً‌ۖ","قَالُواۡ","لَا","تَخَفۡ‌ۖ","وَبَشَّرُوهُ","بِغُلَـٰمٍ","عَلِيمٍ"],"57:4":["هُوَ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۚ","يَعۡلَمُ","مَا","يَلِجُ","فِى","ٱلۡأَرۡضِ","وَمَا","يَخۡرُجُ","مِنۡهَا","وَمَا","يَنزِلُ","مِنَ","ٱلسَّمَآءِ","وَمَا","يَعۡرُجُ","فِيهَا‌ۖ","وَهُوَ","مَعَكُمۡ","أَيۡنَ","مَا","كُنتُمۡ‌ۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"61:7":["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","وَهُوَ","يُدۡعَىٰٓ","إِلَى","ٱلۡإِسۡلَـٰمِ‌ۚ","وَٱللَّهُ","لَا","يَهۡدِى","ٱلۡقَوۡمَ","ٱلظَّـٰلِمِينَ"],"71:11":["يُرۡسِلِ","ٱلسَّمَآءَ","عَلَيۡكُم","مِّدۡرَارًا"],"71:12":["وَيُمۡدِدۡكُم","بِأَمۡوٰلٍ","وَبَنِينَ","وَيَجۡعَل","لَّكُمۡ","جَنَّـٰتٍ","وَيَجۡعَ