","كَانُواۡ","هُمُ","ٱلۡخَـٰسِرِينَ"],"9:39":["إِلَّا","تَنفِرُواۡ","يُعَذِّبۡكُمۡ","عَذَابًا","أَلِيمًا","وَيَسۡتَبۡدِلۡ","قَوۡمًا","غَيۡرَكُمۡ","وَلَا","تَضُرُّوهُ","شَيۡــًٔا‌ۗ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَىۡءٍ","قَدِيرٌ"],"10:3":["إِنَّ","رَبَّكُمُ","ٱللَّهُ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۖ","يُدَبِّرُ","ٱلۡأَمۡرَ‌ۖ","مَا","مِن","شَفِيعٍ","إِلَّا","مِنۢ","بَعۡدِ","إِذۡنِهِۦ‌ۚ","ذٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","فَٱعۡبُدُوهُ‌ۚ","أَفَلَا","تَذَكَّرُونَ"],"10:38":["أَمۡ","يَقُولُونَ","ٱفۡتَرَٮٰهُ‌ۖ","قُلۡ","فَأۡتُواۡ","بِسُورَةٍ","مِّثۡلِهِۦ","وَٱدۡعُواۡ","مَنِ","ٱسۡتَطَعۡتُم","مِّن","دُونِ","ٱللَّهِ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"10:39":["بَلۡ","كَذَّبُواۡ","بِمَا","لَمۡ","يُحِيطُواۡ","بِعِلۡمِهِۦ","وَلَمَّا","يَأۡتِهِمۡ","تَأۡوِيلُهُۥ‌ۚ","كَذٰلِكَ","كَذَّبَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ‌ۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلظَّـٰلِمِينَ"],"10:78":["قَالُوٓاۡ","أَجِئۡتَنَا","لِتَلۡفِتَنَا","عَمَّا","وَجَدۡنَا","عَلَيۡهِ","ءَابَآءَنَا","وَتَكُونَ","لَكُمَا","ٱلۡكِبۡرِيَآءُ","فِى","ٱلۡأَرۡضِ","وَمَا","نَحۡنُ","لَكُمَا","بِمُؤۡمِنِينَ"],"10:79":["وَقَالَ","فِرۡعَوۡنُ","ٱئۡتُونِى","بِكُلِّ","سَـٰحِرٍ","عَلِيمٍ"],"11:6":["۞وَمَا","مِن","دَآبَّةٍ","فِى","ٱلۡأَرۡضِ","إِلَّا","عَلَى","ٱللَّهِ","رِزۡقُهَا","وَيَعۡلَمُ","مُسۡتَقَرَّهَا","وَمُسۡتَوۡدَعَهَا‌ۚ","كُلٌّ","فِى","كِتَـٰبٍ","مُّبِينٍ"],"11:7":["وَهُوَ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","فِى","سِتَّةِ","أَيَّامٍ","وَكَانَ","عَرۡشُهُۥ","عَلَى","ٱلۡمَآءِ","لِيَبۡلُوَكُمۡ","أَيُّكُمۡ","أَحۡسَنُ","عَمَلاً‌ۗ","وَلَئِن","قُلۡتَ","إِنَّكُم","مَّبۡعُوثُونَ","مِنۢ","بَعۡدِ","ٱلۡمَوۡتِ","لَيَقُولَنَّ","ٱلَّذِينَ","كَفَرُوٓاۡ","إِنۡ","هَـٰذَآ","إِلَّا","سِحۡرٌ","مُّبِينٌ"],"11:10":["وَلَئِنۡ","أَذَقۡنَـٰهُ","نَعۡمَآءَ","بَعۡدَ","ضَرَّآءَ","مَسَّتۡهُ","لَيَقُولَنَّ","ذَهَبَ","ٱلسَّيِّـَٔـاتُ","عَنِّىٓ‌ۚ","إِنَّهُۥ","لَفَرِحٌ","فَخُورٌ"],"11:13":["أَمۡ","يَقُولُونَ","ٱفۡتَرَٮٰهُ‌ۖ","قُلۡ","فَأۡتُواۡ","بِعَشۡر