ِن","ذِكۡرٍ","مِّن","رَّبِّهِم","مُّحۡدَثٍ","إِلَّا","ٱسۡتَمَعُوهُ","وَهُمۡ","يَلۡعَبُونَ"],"26:5":["وَمَا","يَأۡتِيهِم","مِّن","ذِكۡرٍ","مِّنَ","ٱلرَّحۡمَـٰنِ","مُحۡدَثٍ","إِلَّا","كَانُواۡ","عَنۡهُ","مُعۡرِضِينَ"],"26:6":["فَقَدۡ","كَذَّبُواۡ","فَسَيَأۡتِيهِمۡ","أَنۢبَـٰٓؤُاۡ","مَا","كَانُواۡ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"26:7":["أَوَلَمۡ","يَرَوۡاۡ","إِلَى","ٱلۡأَرۡضِ","كَمۡ","أَنۢبَتۡنَا","فِيهَا","مِن","كُلِّ","زَوۡجٍ","كَرِيمٍ"],"26:15":["قَالَ","كَلَّا‌ۖ","فَٱذۡهَبَا","بِـَٔـايَـٰتِنَآ‌ۖ","إِنَّا","مَعَكُم","مُّسۡتَمِعُونَ"],"26:16":["فَأۡتِيَا","فِرۡعَوۡنَ","فَقُولَآ","إِنَّا","رَسُولُ","رَبِّ","ٱلۡعَـٰلَمِينَ"],"26:24":["قَالَ","رَبُّ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ","وَمَا","بَيۡنَهُمَآ‌ۖ","إِن","كُنتُم","مُّوقِنِينَ"],"26:25":["قَالَ","لِمَنۡ","حَوۡلَهُۥٓ","أَلَا","تَسۡتَمِعُونَ"],"26:26":["قَالَ","رَبُّكُمۡ","وَرَبُّ","ءَابَآئِكُمُ","ٱلۡأَوَّلِينَ"],"26:27":["قَالَ","إِنَّ","رَسُولَكُمُ","ٱلَّذِىٓ","أُرۡسِلَ","إِلَيۡكُمۡ","لَمَجۡنُونٌ"],"26:31":["قَالَ","فَأۡتِ","بِهِۦٓ","إِن","كُنتَ","مِنَ","ٱلصَّـٰدِقِينَ"],"26:32":["فَأَلۡقَىٰ","عَصَاهُ","فَإِذَا","هِىَ","ثُعۡبَانٌ","مُّبِينٌ"],"26:33":["وَنَزَعَ","يَدَهُۥ","فَإِذَا","هِىَ","بَيۡضَآءُ","لِلنَّـٰظِرِينَ"],"26:34":["قَالَ","لِلۡمَلَإِ","حَوۡلَهُۥٓ","إِنَّ","هَـٰذَا","لَسَـٰحِرٌ","عَلِيمٌ"],"26:35":["يُرِيدُ","أَن","يُخۡرِجَكُم","مِّنۡ","أَرۡضِكُم","بِسِحۡرِهِۦ","فَمَاذَا","تَأۡمُرُونَ"],"26:36":["قَالُوٓاۡ","أَرۡجِهۡ","وَأَخَاهُ","وَٱبۡعَثۡ","فِى","ٱلۡمَدَآئِنِ","حَـٰشِرِينَ"],"26:37":["يَأۡتُوكَ","بِكُلِّ","سَحَّارٍ","عَلِيمٍ"],"26:41":["فَلَمَّا","جَآءَ","ٱلسَّحَرَةُ","قَالُواۡ","لِفِرۡعَوۡنَ","أَئِنَّ","لَنَا","لَأَجۡرًا","إِن","كُنَّا","نَحۡنُ","ٱلۡغَـٰلِبِينَ"],"26:42":["قَالَ","نَعَمۡ","وَإِنَّكُمۡ","إِذًا","لَّمِنَ","ٱلۡمُقَرَّبِينَ"],"26:43":["قَالَ","لَهُم","مُّوسَىٰٓ","أَلۡقُواۡ","مَآ","أَنتُم","مُّلۡقُونَ"],"26:44":["فَأَلۡقَوۡاۡ","حِبَالَهُمۡ","وَعِصِيَّهُمۡ","وَقَالُواۡ","بِعِزَّةِ","فِرۡعَوۡنَ","إِنَّا","لَنَحۡنُ","ٱلۡغَـٰلِبُونَ"],"26:45":["فَأَلۡقَىٰ","مُوسَىٰ","عَصَاهُ","فَإِذَا","