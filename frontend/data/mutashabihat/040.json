","خَيۡرًا‌ۗ","لِّلَّذِينَ","أَحۡسَنُواۡ","فِى","هَـٰذِهِ","ٱلدُّنۡيَا","حَسَنَةٌ‌ۚ","وَلَدَارُ","ٱلۡأَخِرَةِ","خَيۡرٌ‌ۚ","وَلَنِعۡمَ","دَارُ","ٱلۡمُتَّقِينَ"],"16:97":["مَنۡ","عَمِلَ","صَـٰلِحًا","مِّن","ذَكَرٍ","أَوۡ","أُنثَىٰ","وَهُوَ","مُؤۡمِنٌ","فَلَنُحۡيِيَنَّهُۥ","حَيَوٰةً","طَيِّبَةً‌ۖ","وَلَنَجۡزِيَنَّهُمۡ","أَجۡرَهُم","بِأَحۡسَنِ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"22:5":["يَـٰٓأَيُّهَا","ٱلنَّاسُ","إِن","كُنتُمۡ","فِى","رَيۡبٍ","مِّنَ","ٱلۡبَعۡثِ","فَإِنَّا","خَلَقۡنَـٰكُم","مِّن","تُرَابٍ","ثُمَّ","مِن","نُّطۡفَةٍ","ثُمَّ","مِنۡ","عَلَقَةٍ","ثُمَّ","مِن","مُّضۡغَةٍ","مُّخَلَّقَةٍ","وَغَيۡرِ","مُخَلَّقَةٍ","لِّنُبَيِّنَ","لَكُمۡ‌ۚ","وَنُقِرُّ","فِى","ٱلۡأَرۡحَامِ","مَا","نَشَآءُ","إِلَىٰٓ","أَجَلٍ","مُّسَمًّى","ثُمَّ","نُخۡرِجُكُمۡ","طِفۡلاً","ثُمَّ","لِتَبۡلُغُوٓاۡ","أَشُدَّكُمۡ‌ۖ","وَمِنكُم","مَّن","يُتَوَفَّىٰ","وَمِنكُم","مَّن","يُرَدُّ","إِلَىٰٓ","أَرۡذَلِ","ٱلۡعُمُرِ","لِكَيۡلَا","يَعۡلَمَ","مِنۢ","بَعۡدِ","عِلۡمٍ","شَيۡــًٔا‌ۚ","وَتَرَى","ٱلۡأَرۡضَ","هَامِدَةً","فَإِذَآ","أَنزَلۡنَا","عَلَيۡهَا","ٱلۡمَآءَ","ٱهۡتَزَّتۡ","وَرَبَتۡ","وَأَنۢبَتَتۡ","مِن","كُلِّ","زَوۡجِۭ","بَهِيجٍ"],"22:7":["وَأَنَّ","ٱلسَّاعَةَ","ءَاتِيَةٌ","لَّا","رَيۡبَ","فِيهَا","وَأَنَّ","ٱللَّهَ","يَبۡعَثُ","مَن","فِى","ٱلۡقُبُورِ"],"23:22":["وَعَلَيۡهَا","وَعَلَى","ٱلۡفُلۡكِ","تُحۡمَلُونَ"],"23:23":["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦ","فَقَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥٓ‌ۖ","أَفَلَا","تَتَّقُونَ"],"26:93":["مِن","دُونِ","ٱللَّهِ","هَلۡ","يَنصُرُونَكُمۡ","أَوۡ","يَنتَصِرُونَ"],"27:73":["وَإِنَّ","رَبَّكَ","لَذُو","فَضۡلٍ","عَلَى","ٱلنَّاسِ","وَلَـٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَشۡكُرُونَ"],"27:74":["وَإِنَّ","رَبَّكَ","لَيَعۡلَمُ","مَا","تُكِنُّ","صُدُورُهُمۡ","وَمَا","يُعۡلِنُونَ"],"27:86":["أَلَمۡ","يَرَوۡاۡ","أَنَّا","جَعَلۡنَا","ٱلَّيۡلَ","لِيَسۡكُنُواۡ","فِيهِ","وَٱلنَّهَارَ","مُبۡصِرًا‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"28:38":["وَقَالَ","فِرۡعَوۡنُ","يَـٰٓأَيُّهَا","ٱل