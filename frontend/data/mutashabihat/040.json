","أَزۡوٰجًاۚ","وَمَا","تَحۡمِلُ","مِنۡ","أُنثَىٰ","وَلَا","تَضَعُ","إِلَّا","بِعِلۡمِهِۚۦ","وَمَا","يُعَمَّرُ","مِن","مُّعَمَّرٍ","وَلَا","يُنقَصُ","مِنۡ","عُمُرِهِۦٓ","إِلَّا","فِى","كِتَـٰبٍۚ","إِنَّ","ذٰلِكَ","عَلَى","ٱللَّهِ","يَسِيرٌ"],"35:44":["أَوَلَمۡ","يَسِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَيَنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","وَكَانُوٓاۡ","أَشَدَّ","مِنۡهُمۡ","قُوَّۚةً","وَمَا","كَانَ","ٱللَّهُ","لِيُعۡجِزَهُۥ","مِن","شَىۡءٍ","فِى","ٱلسَّمَـٰوٰتِ","وَلَا","فِى","ٱلۡأَرۡضِۚ","إِنَّهُۥ","كَانَ","عَلِيمًا","قَدِيرًا"],"39:23":["ٱللَّهُ","نَزَّلَ","أَحۡسَنَ","ٱلۡحَدِيثِ","كِتَـٰبًا","مُّتَشَـٰبِهًا","مَّثَانِىَ","تَقۡشَعِرُّ","مِنۡهُ","جُلُودُ","ٱلَّذِينَ","يَخۡشَوۡنَ","رَبَّهُمۡ","ثُمَّ","تَلِينُ","جُلُودُهُمۡ","وَقُلُوبُهُمۡ","إِلَىٰ","ذِكۡرِ","ٱللَّهِ‌ۚ","ذٰلِكَ","هُدَى","ٱللَّهِ","يَهۡدِى","بِهِۦ","مَن","يَشَآءُ‌ۚ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَمَا","لَهُۥ","مِنۡ","هَادٍ"],"39:24":["أَفَمَن","يَتَّقِى","بِوَجۡهِهِۦ","سُوٓءَ","ٱلۡعَذَابِ","يَوۡمَ","ٱلۡقِيَـٰمَةِ‌ۚ","وَقِيلَ","لِلظَّـٰلِمِينَ","ذُوقُواۡ","مَا","كُنتُمۡ","تَكۡسِبُونَ"],"39:36":["أَلَيۡسَ","ٱللَّهُ","بِكَافٍ","عَبۡدَهُۥ‌ۖ","وَيُخَوِّفُونَكَ","بِٱلَّذِينَ","مِن","دُونِهِۦ‌ۚ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَمَا","لَهُۥ","مِنۡ","هَادٍ"],"39:37":["وَمَن","يَهۡدِ","ٱللَّهُ","فَمَا","لَهُۥ","مِن","مُّضِلٍّ‌ۗ","أَلَيۡسَ","ٱللَّهُ","بِعَزِيزٍ","ذِى","ٱنتِقَامٍ"],"39:72":["قِيلَ","ٱدۡخُلُوٓاۡ","أَبۡوٰبَ","جَهَنَّمَ","خَـٰلِدِينَ","فِيهَا‌ۖ","فَبِئۡسَ","مَثۡوَى","ٱلۡمُتَكَبِّرِينَ"],"39:73":["وَسِيقَ","ٱلَّذِينَ","ٱتَّقَوۡاۡ","رَبَّهُمۡ","إِلَى","ٱلۡجَنَّةِ","زُمَرًا‌ۖ","حَتَّىٰٓ","إِذَا","جَآءُوهَا","وَفُتِحَتۡ","أَبۡوٰبُهَا","وَقَالَ","لَهُمۡ","خَزَنَتُهَا","سَلَـٰمٌ","عَلَيۡكُمۡ","طِبۡتُمۡ","فَٱدۡخُلُوهَا","خَـٰلِدِينَ"],"40:6":["وَكَذٰلِكَ","حَقَّتۡ","كَلِمَتُ","رَبِّكَ","عَلَى","ٱلَّذِينَ","كَفَرُوٓاۡ","أَنَّهُمۡ","أَصۡحَـٰبُ","ٱلنَّارِ"],"40:7":["ٱلَّذِينَ","يَحۡمِلُونَ","ٱلۡعَرۡشَ","وَمَنۡ","حَوۡلَهُۥ","يُسَبِّحُونَ","بِحَمۡدِ","رَبِّهِمۡ","وَيُؤۡمِنُونَ","بِهِ