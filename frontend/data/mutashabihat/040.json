َبۡلُ","بِٱلۡبَيِّنَـٰتِ","فَمَا","زِلۡتُمۡ","فِى","شَكٍّ","مِّمَّا","جَآءَكُم","بِهِۦۖ","حَتَّىٰٓ","إِذَا","هَلَكَ","قُلۡتُمۡ","لَن","يَبۡعَثَ","ٱللَّهُ","مِنۢ","بَعۡدِهِۦ","رَسُوۚلاً","كَذٰلِكَ","يُضِلُّ","ٱللَّهُ","مَنۡ","هُوَ","مُسۡرِفٌ","مُّرۡتَابٌ"],"40:35":["ٱلَّذِينَ","يُجَـٰدِلُونَ","فِىٓ","ءَايَـٰتِ","ٱللَّهِ","بِغَيۡرِ","سُلۡطَـٰنٍ","أَتَـٰهُمۡۖ","كَبُرَ","مَقۡتًا","عِندَ","ٱللَّهِ","وَعِندَ","ٱلَّذِينَ","ءَامَنُواۡۚ","كَذٰلِكَ","يَطۡبَعُ","ٱللَّهُ","عَلَىٰ","كُلِّ","قَلۡبِ","مُتَكَبِّرٍ","جَبَّارٍ"],"40:37":["أَسۡبَـٰبَ","ٱلسَّمَـٰوٰتِ","فَأَطَّلِعَ","إِلَىٰٓ","إِلَـٰهِ","مُوسَىٰ","وَإِنِّى","لَأَظُنُّهُۥ","كَـٰذِبًاۚ","وَكَذٰلِكَ","زُيِّنَ","لِفِرۡعَوۡنَ","سُوٓءُ","عَمَلِهِۦ","وَصُدَّ","عَنِ","ٱلسَّبِيلِۚ","وَمَا","كَيۡدُ","فِرۡعَوۡنَ","إِلَّا","فِى","تَبَابٍ"],"40:40":["مَنۡ","عَمِلَ","سَيِّئَةً","فَلَا","يُجۡزَىٰٓ","إِلَّا","مِثۡلَهَاۖ","وَمَنۡ","عَمِلَ","صَـٰلِحًا","مِّن","ذَكَرٍ","أَوۡ","أُنثَىٰ","وَهُوَ","مُؤۡمِنٌ","فَأُوۡلَـٰٓئِكَ","يَدۡخُلُونَ","ٱلۡجَنَّةَ","يُرۡزَقُونَ","فِيهَا","بِغَيۡرِ","حِسَابٍ"],"40:47":["وَإِذۡ","يَتَحَآجُّونَ","فِى","ٱلنَّارِ","فَيَقُولُ","ٱلضُّعَفَـٰٓؤُاۡ","لِلَّذِينَ","ٱسۡتَكۡبَرُوٓاۡ","إِنَّا","كُنَّا","لَكُمۡ","تَبَعًا","فَهَلۡ","أَنتُم","مُّغۡنُونَ","عَنَّا","نَصِيبًا","مِّنَ","ٱلنَّارِ"],"40:52":["يَوۡمَ","لَا","يَنفَعُ","ٱلظَّـٰلِمِينَ","مَعۡذِرَتُهُمۡۖ","وَلَهُمُ","ٱللَّعۡنَةُ","وَلَهُمۡ","سُوٓءُ","ٱلدَّارِ"],"40:55":["فَٱصۡبِرۡ","إِنَّ","وَعۡدَ","ٱللَّهِ","حَقٌّ","وَٱسۡتَغۡفِرۡ","لِذَنۢبِكَ","وَسَبِّحۡ","بِحَمۡدِ","رَبِّكَ","بِٱلۡعَشِىِّ","وَٱلۡإِبۡكَـٰرِ"],"40:56":["إِنَّ","ٱلَّذِينَ","يُجَـٰدِلُونَ","فِىٓ","ءَايَـٰتِ","ٱللَّهِ","بِغَيۡرِ","سُلۡطَـٰنٍ","أَتَـٰهُمۡۙ","إِن","فِى","صُدُورِهِمۡ","إِلَّا","كِبۡرٌ","مَّا","هُم","بِبَـٰلِغِيهِۚ","فَٱسۡتَعِذۡ","بِٱللَّهِۖ","إِنَّهُۥ","هُوَ","ٱلسَّمِيعُ","ٱلۡبَصِيرُ"],"40:59":["إِنَّ","ٱلسَّاعَةَ","لَأَتِيَةٌ","لَّا","رَيۡبَ","فِيهَا","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يُؤۡمِنُونَ"],"40:61":["ٱللَّهُ","ٱلَّذِى","جَعَلَ","لَكُمُ","ٱلَّيۡلَ","لِتَسۡكُنُواۡ","فِيه