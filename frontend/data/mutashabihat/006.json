43":["فَلَوۡلَآ","إِذۡ","جَآءَهُم","بَأۡسُنَا","تَضَرَّعُواۡ","وَلَـٰكِن","قَسَتۡ","قُلُوبُهُمۡ","وَزَيَّنَ","لَهُمُ","ٱلشَّيۡطَـٰنُ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"6:44":["فَلَمَّا","نَسُواۡ","مَا","ذُكِّرُواۡ","بِهِۦ","فَتَحۡنَا","عَلَيۡهِمۡ","أَبۡوٰبَ","كُلِّ","شَىۡءٍ","حَتَّىٰٓ","إِذَا","فَرِحُواۡ","بِمَآ","أُوتُوٓاۡ","أَخَذۡنَـٰهُم","بَغۡتَةً","فَإِذَا","هُم","مُّبۡلِسُونَ"],"6:47":["قُلۡ","أَرَءَيۡتَكُمۡ","إِنۡ","أَتَـٰكُمۡ","عَذَابُ","ٱللَّهِ","بَغۡتَةً","أَوۡ","جَهۡرَةً","هَلۡ","يُهۡلَكُ","إِلَّا","ٱلۡقَوۡمُ","ٱلظَّـٰلِمُونَ"],"6:48":["وَمَا","نُرۡسِلُ","ٱلۡمُرۡسَلِينَ","إِلَّا","مُبَشِّرِينَ","وَمُنذِرِينَ‌ۖ","فَمَنۡ","ءَامَنَ","وَأَصۡلَحَ","فَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"6:50":["قُل","لَّآ","أَقُولُ","لَكُمۡ","عِندِى","خَزَآئِنُ","ٱللَّهِ","وَلَآ","أَعۡلَمُ","ٱلۡغَيۡبَ","وَلَآ","أَقُولُ","لَكُمۡ","إِنِّى","مَلَكٌ‌ۖ","إِنۡ","أَتَّبِعُ","إِلَّا","مَا","يُوحَىٰٓ","إِلَىَّ‌ۚ","قُلۡ","هَلۡ","يَسۡتَوِى","ٱلۡأَعۡمَىٰ","وَٱلۡبَصِيرُ‌ۚ","أَفَلَا","تَتَفَكَّرُونَ"],"6:51":["وَأَنذِرۡ","بِهِ","ٱلَّذِينَ","يَخَافُونَ","أَن","يُحۡشَرُوٓاۡ","إِلَىٰ","رَبِّهِمۡ‌ۙ","لَيۡسَ","لَهُم","مِّن","دُونِهِۦ","وَلِىٌّ","وَلَا","شَفِيعٌ","لَّعَلَّهُمۡ","يَتَّقُونَ"],"6:52":["وَلَا","تَطۡرُدِ","ٱلَّذِينَ","يَدۡعُونَ","رَبَّهُم","بِٱلۡغَدَوٰةِ","وَٱلۡعَشِىِّ","يُرِيدُونَ","وَجۡهَهُۥ‌ۖ","مَا","عَلَيۡكَ","مِنۡ","حِسَابِهِم","مِّن","شَىۡءٍ","وَمَا","مِنۡ","حِسَابِكَ","عَلَيۡهِم","مِّن","شَىۡءٍ","فَتَطۡرُدَهُمۡ","فَتَكُونَ","مِنَ","ٱلظَّـٰلِمِينَ"],"6:56":["قُلۡ","إِنِّى","نُهِيتُ","أَنۡ","أَعۡبُدَ","ٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ‌ۚ","قُل","لَّآ","أَتَّبِعُ","أَهۡوَآءَكُمۡ‌ۙ","قَدۡ","ضَلَلۡتُ","إِذًا","وَمَآ","أَنَاۡ","مِنَ","ٱلۡمُهۡتَدِينَ"],"6:61":["وَهُوَ","ٱلۡقَاهِرُ","فَوۡقَ","عِبَادِهِۦ‌ۖ","وَيُرۡسِلُ","عَلَيۡكُمۡ","حَفَظَةً","حَتَّىٰٓ","إِذَا","جَآءَ","أَحَدَكُمُ","ٱلۡمَوۡتُ","تَوَفَّتۡهُ","رُسُلُنَا","وَهُمۡ","لَا","يُفَرِّطُونَ"],"6:69":["وَمَا","عَلَى","ٱلَّذِينَ","يَتَّقُونَ","مِنۡ","حِسَابِهِم","مِّن","شَىۡءٍ","وَلَـٰكِن","ذِكۡرَىٰ","لَعَلَّهُمۡ","يَتَّقُونَ"],"6:70":["وَذَرِ","ٱلَّذِينَ","ٱتَّخَذُواۡ","دِينَهُمۡ","لَعِبًا","وَلَهۡوًا","وَغَرَّتۡهُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا‌ۚ","وَذَكِّرۡ","بِهِۦٓ","أَن","تُبۡسَلَ","نَفۡسُۢ","بِمَا","كَسَبَتۡ","لَيۡسَ","لَهَا","مِن","دُونِ","ٱللَّهِ","وَلِىٌّ","وَلَا","شَفِيعٌ","وَإِن","تَعۡدِلۡ","كُلَّ","عَدۡلٍ","لَّا","يُؤۡخَذۡ","مِنۡهَآ‌ۗ","أُوۡلَـٰٓئِكَ","ٱلَّذِينَ","أُبۡسِلُواۡ","بِمَا","كَسَبُواۡ‌ۖ","لَهُمۡ","شَرَابٌ","مِّنۡ","حَمِيمٍ","وَعَذَابٌ","أَلِيمُۢ","بِمَا","كَانُواۡ","يَكۡفُرُونَ"],"6:71":["قُلۡ","أَنَدۡعُواۡ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُنَا","وَلَا","يَضُرُّنَا","وَنُرَدُّ","عَلَىٰٓ","أَعۡقَابِنَا","بَعۡدَ","إِذۡ","هَدَٮٰنَا","ٱللَّهُ","كَٱلَّذِى","ٱسۡتَهۡوَتۡهُ","ٱلشَّيَـٰطِينُ","فِى","ٱلۡأَرۡضِ","حَيۡرَانَ","لَهُۥٓ","أَصۡحَـٰبٌ","يَدۡعُونَهُۥٓ","إِلَى","ٱلۡهُدَى","ٱئۡتِنَا‌ۗ","قُلۡ","إِنَّ","هُدَى","ٱللَّهِ","هُوَ","ٱلۡهُدَىٰ‌ۖ","وَأُمِرۡنَا","لِنُسۡلِمَ","لِرَبِّ","ٱلۡعَـٰلَمِينَ"],"6:73":["وَهُوَ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","بِٱلۡحَقِّ‌ۖ","وَيَوۡمَ","يَقُولُ","كُن","فَيَكُونُ‌ۚ","قَوۡلُهُ","ٱلۡحَقُّ‌ۚ","وَلَهُ","ٱلۡمُلۡكُ","يَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ‌ۚ","عَـٰلِمُ","ٱلۡغَيۡبِ","وَٱلشَّهَـٰدَةِ‌ۚ","وَهُوَ","ٱلۡحَكِيمُ","ٱلۡخَبِيرُ"],"6:74":["۞وَإِذۡ","قَالَ","إِبۡرٰهِيمُ","لِأَبِيهِ","ءَازَرَ","أَتَتَّخِذُ","أَصۡنَامًا","ءَالِهَةً‌ۖ","إِنِّىٓ","أَرَٮٰكَ","وَقَوۡمَكَ","فِى","ضَلَـٰلٍ","مُّبِينٍ"],"6:84":["وَوَهَبۡنَا","لَهُۥٓ","إِسۡحَـٰقَ","وَيَعۡقُوبَ‌ۚ","كُلاًّ","هَدَيۡنَا‌ۚ","وَنُوحًا","هَدَيۡنَا","مِن","قَبۡلُ‌ۖ","وَمِن","ذُرِّيَّتِهِۦ","دَاوُۥدَ","وَسُلَيۡمَـٰنَ","وَأَيُّوبَ","وَيُوسُفَ","وَمُوسَىٰ","وَهَـٰرُونَ‌ۚ","وَكَذٰلِكَ","نَجۡزِى","ٱلۡمُحۡسِنِينَ"],"6:91":["وَمَا","قَدَرُواۡ","ٱللَّهَ","حَقَّ","قَدۡرِهِۦٓ","إِذۡ","قَالُواۡ","مَآ","أَنزَلَ","ٱللَّهُ","عَلَىٰ","بَشَرٍ","مِّن","شَىۡءٍ‌ۗ","قُلۡ","مَنۡ","أَنزَلَ","ٱلۡكِتَـٰبَ","ٱلَّذِى","جَآءَ","بِهِۦ","مُوسَىٰ","نُورًا","وَهُدًى","لِّلنَّاسِ‌ۖ","تَجۡعَلُونَهُۥ","قَرَاطِيسَ","تُبۡدُونَهَا","وَتُخۡفُونَ","كَثِيرًا‌ۖ","وَعُلِّمۡتُم","مَّا","لَمۡ","تَعۡلَمُوٓاۡ","أَنتُمۡ","وَلَآ","ءَابَآؤُكُمۡ‌ۖ","قُلِ","ٱللَّهُ‌ۖ","ثُمَّ","ذَرۡهُمۡ","فِى","خَوۡضِهِمۡ","يَلۡعَبُونَ"],"6:92":["وَهَـٰذَا","كِتَـٰبٌ","أَنزَلۡنَـٰهُ","مُبَارَكٌ","مُّصَدِّقُ","ٱلَّذِى","بَيۡنَ","يَدَيۡهِ","وَلِتُنذِرَ","أُمَّ","ٱلۡقُرَىٰ","وَمَنۡ","حَوۡلَهَا‌ۚ","وَٱلَّذِينَ","يُؤۡمِنُونَ","بِٱلۡأَخِرَةِ","يُؤۡمِنُونَ","بِهِۦ‌ۖ","وَهُمۡ","عَلَىٰ","صَلَاتِهِمۡ","يُحَافِظُونَ"],"6:93":["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","قَالَ","أُوحِىَ","إِلَىَّ","وَلَمۡ","يُوحَ","إِلَيۡهِ","شَىۡءٌ","وَمَن","قَالَ","سَأُنزِلُ","مِثۡلَ","مَآ","أَنزَلَ","ٱللَّهُ‌ۗ","وَلَوۡ","تَرَىٰٓ","إِذِ","ٱلظَّـٰلِمُونَ","فِى","غَمَرٰتِ","ٱلۡمَوۡتِ","وَٱلۡمَلَـٰٓئِكَةُ","بَاسِطُوٓاۡ","أَيۡدِيهِمۡ","أَخۡرِجُوٓاۡ","أَنفُسَكُمُ‌ۖ","ٱلۡيَوۡمَ","تُجۡزَوۡنَ","عَذَابَ","ٱلۡهُونِ","بِمَا","كُنتُمۡ","تَقُولُونَ","عَلَى","ٱللَّهِ","غَيۡرَ","ٱلۡحَقِّ","وَكُنتُمۡ","عَنۡ","ءَايَـٰتِهِۦ","تَسۡتَكۡبِرُونَ"],"6:94":["وَلَقَدۡ","جِئۡتُمُونَا","فُرٰدَىٰ","كَمَا","خَلَقۡنَـٰكُمۡ","أَوَّلَ","مَرَّةٍ","وَتَرَكۡتُم","مَّا","خَوَّلۡنَـٰكُمۡ","وَرَآءَ","ظُهُورِكُمۡ‌ۖ","وَمَا","نَرَىٰ","مَعَكُمۡ","شُفَعَآءَكُمُ","ٱلَّذِينَ","زَعَمۡتُمۡ","أَنَّهُمۡ","فِيكُمۡ","شُرَكَـٰٓؤُاۡ‌ۚ","لَقَد","تَّقَطَّعَ","بَيۡنَكُمۡ","وَضَلَّ","عَنكُم","مَّا","كُنتُمۡ","تَزۡعُمُونَ"],"6:95":["۞إِنَّ","ٱللَّهَ","فَالِقُ","ٱلۡحَبِّ","وَٱلنَّوَىٰ‌ۖ","يُخۡرِجُ","ٱلۡحَىَّ","مِنَ","ٱلۡمَيِّتِ","وَمُخۡرِجُ","ٱلۡمَيِّتِ","مِنَ","ٱلۡحَىِّ‌ۚ","ذٰلِكُمُ","ٱللَّهُ‌ۖ","فَأَنَّىٰ","تُؤۡفَكُونَ"],"6:99":["وَهُوَ","ٱلَّذِىٓ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً","فَأَخۡرَجۡنَا","بِهِۦ","نَبَاتَ","كُلِّ","شَىۡءٍ","فَأَخۡرَجۡنَا","مِنۡهُ","خَضِرًا","نُّخۡرِجُ","مِنۡهُ","حَبًّا","مُّتَرَاكِبًا","وَمِنَ","ٱلنَّخۡلِ","مِن","طَلۡعِهَا","قِنۡوَانٌ","دَانِيَةٌ","وَجَنَّـٰتٍ","مِّنۡ","أَعۡنَابٍ","وَٱلزَّيۡتُونَ","وَٱلرُّمَّانَ","مُشۡتَبِهًا","وَغَيۡرَ","مُتَشَـٰبِهٍ‌ۗ","ٱنظُرُوٓاۡ","إِلَىٰ","ثَمَرِهِۦٓ","إِذَآ","أَثۡمَرَ","وَيَنۡعِهِۦٓ‌ۚ","إِنَّ","فِى","ذٰلِكُمۡ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"6:100":["وَجَعَلُواۡ","لِلَّهِ","شُرَكَآءَ","ٱلۡجِنَّ","وَخَلَقَهُمۡ‌ۖ","وَخَرَقُواۡ","لَهُۥ","بَنِينَ","وَبَنَـٰتِۭ","بِغَيۡرِ","عِلۡمٍ‌ۚ","سُبۡحَـٰنَهُۥ","وَتَعَـٰلَىٰ","عَمَّا","يَصِفُونَ"],"6:102":["ذٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ‌ۖ","لَآ","إِلَـٰهَ","إِلَّا","هُوَ‌ۖ","خَـٰلِقُ","كُلِّ","شَىۡءٍ","فَٱعۡبُدُوهُ‌ۚ","وَهُوَ","عَلَىٰ","كُلِّ","شَىۡءٍ","وَكِيلٌ"],"6:103":["لَّا","تُدۡرِكُهُ","ٱلۡأَبۡصَـٰرُ","وَهُوَ","يُدۡرِكُ","ٱلۡأَبۡصَـٰرَ‌ۖ","وَهُوَ","ٱللَّطِيفُ","ٱلۡخَبِيرُ"],"6:109":["وَأَقۡسَمُواۡ","بِٱللَّهِ","جَهۡدَ","أَيۡمَـٰنِهِمۡ","لَئِن","جَآءَتۡهُمۡ","ءَايَةٌ","لَّيُؤۡمِنُنَّ","بِهَا‌ۚ","قُلۡ","إِنَّمَا","ٱلۡأَيَـٰتُ","عِندَ","ٱللَّهِ‌ۖ","وَمَا","يُشۡعِرُكُمۡ","أَنَّهَآ","إِذَا","جَآءَتۡ","لَا","يُؤۡمِنُونَ"],"6:112":["وَكَذٰلِكَ","جَعَلۡنَا","لِكُلِّ","نَبِىٍّ","عَدُوًّا","شَيَـٰطِينَ","ٱلۡإِنسِ","وَٱلۡجِنِّ","يُوحِى","بَعۡضُهُمۡ","إِلَىٰ","بَعۡضٍ","زُخۡرُفَ","ٱلۡقَوۡلِ","غُرُورًا‌ۚ","وَلَوۡ","شَآءَ","رَبُّكَ","مَا","فَعَلُوهُ‌ۖ","فَذَرۡهُمۡ","وَمَا","يَفۡتَرُونَ"],"6:116":["وَإِن","تُطِعۡ","أَكۡثَرَ","مَن","فِى","ٱلۡأَرۡضِ","يُضِلُّوكَ","عَن","سَبِيلِ","ٱللَّهِ‌ۚ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَإِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"6:117":["إِنَّ","رَبَّكَ","هُوَ","أَعۡلَمُ","مَن","يَضِلُّ","عَن","سَبِيلِهِۦ‌ۖ","وَهُوَ","أَعۡلَمُ","بِٱلۡمُهۡتَدِينَ"],"6:118":["فَكُلُواۡ","مِمَّا","ذُكِرَ","ٱسۡمُ","ٱللَّهِ","عَلَيۡهِ","إِن","كُنتُم","بِـَٔـايَـٰتِهِۦ","مُؤۡمِنِينَ"],"6:119":["وَمَا","لَكُمۡ","أَلَّا","تَأۡكُلُواۡ","مِمَّا","ذُكِرَ","ٱسۡمُ","ٱللَّهِ","عَلَيۡهِ","وَقَدۡ","فَصَّلَ","لَكُم","مَّا","حَرَّمَ","عَلَيۡكُمۡ","إِلَّا","مَا","ٱضۡطُرِرۡتُمۡ","إِلَيۡهِ‌ۗ","وَإِنَّ","كَثِيرًا","لَّيُضِلُّونَ","بِأَهۡوَآئِهِم","بِغَيۡرِ","عِلۡمٍ‌ۗ","إِنَّ","رَبَّكَ","هُوَ","أَعۡلَمُ","بِٱلۡمُعۡتَدِينَ"],"6:121":["وَلَا","تَأۡكُلُواۡ","مِمَّا","لَمۡ","يُذۡكَرِ","ٱسۡمُ","ٱللَّهِ","عَلَيۡهِ","وَإِنَّهُۥ","لَفِسۡقٌ‌ۗ","وَإِنَّ","ٱلشَّيَـٰطِينَ","لَيُوحُونَ","إِلَىٰٓ","أَوۡلِيَآئِهِمۡ","لِيُجَـٰدِلُوكُمۡ‌ۖ","وَإِنۡ","أَطَعۡتُمُوهُمۡ","إِنَّكُمۡ","لَمُشۡرِكُونَ"],"6:122":["أَوَمَن","كَانَ","مَيۡتًا","فَأَحۡيَيۡنَـٰهُ","وَجَعَلۡنَا","لَهُۥ","نُورًا","يَمۡشِى","بِهِۦ","فِى","ٱلنَّاسِ","كَمَن","مَّثَلُهُۥ","فِى","ٱلظُّلُمَـٰتِ","لَيۡسَ","بِخَارِجٍ","مِّنۡهَا‌ۚ","كَذٰلِكَ","زُيِّنَ","لِلۡكَـٰفِرِينَ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"6:130":["يَـٰمَعۡشَرَ","ٱلۡجِنِّ","وَٱلۡإِنسِ","أَلَمۡ","يَأۡتِكُمۡ","رُسُلٌ","مِّنكُمۡ","يَقُصُّونَ","عَلَيۡكُمۡ","ءَايَـٰتِى","وَيُنذِرُونَكُمۡ","لِقَآءَ","يَوۡمِكُمۡ","هَـٰذَا‌ۚ","قَالُواۡ","شَهِدۡنَا","عَلَىٰٓ","أَنفُسِنَا‌ۖ","وَغَرَّتۡهُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","وَشَهِدُواۡ","عَلَىٰٓ","أَنفُسِهِمۡ","أَنَّهُمۡ","كَانُواۡ","كَـٰفِرِينَ"],"6:131":["ذٰلِكَ","أَن","لَّمۡ","يَكُن","رَّبُّكَ","مُهۡلِكَ","ٱلۡقُرَىٰ","بِظُلۡمٍ","وَأَهۡلُهَا","غَـٰفِلُونَ"],"6:132":["وَلِكُلٍّ","دَرَجَـٰتٌ","مِّمَّا","عَمِلُواۡ‌ۚ","وَمَا","رَبُّكَ","بِغَـٰفِلٍ","عَمَّا","يَعۡمَلُونَ"],"6:135":["قُلۡ","يَـٰقَوۡمِ","ٱعۡمَلُواۡ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّى","عَامِلٌ‌ۖ","فَسَوۡفَ","تَعۡلَمُونَ","مَن","تَكُونُ","لَهُۥ","عَـٰقِبَةُ","ٱلدَّارِ‌ۗ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلظَّـٰلِمُونَ"],"6:136":["وَجَعَلُواۡ","لِلَّهِ","مِمَّا","ذَرَأَ","مِنَ","ٱلۡحَرۡثِ","وَٱلۡأَنۡعَـٰمِ","نَصِيبًا","فَقَالُواۡ","هَـٰذَا","لِلَّهِ","بِزَعۡمِهِمۡ","وَهَـٰذَا","لِشُرَكَآئِنَا‌ۖ","فَمَا","كَانَ","لِشُرَكَآئِهِمۡ","فَلَا","يَصِلُ","إِلَى","ٱللَّهِ‌ۖ","وَمَا","كَانَ","لِلَّهِ","فَهُوَ","يَصِلُ","إِلَىٰ","شُرَكَآئِهِمۡ‌ۗ","سَآءَ","مَا","يَحۡكُمُونَ"],"6:137":["وَكَذٰلِكَ","زَيَّنَ","لِكَثِيرٍ","مِّنَ","ٱلۡمُشۡرِكِينَ","قَتۡلَ","أَوۡلَـٰدِهِمۡ","شُرَكَآؤُهُمۡ","لِيُرۡدُوهُمۡ","وَلِيَلۡبِسُواۡ","عَلَيۡهِمۡ","دِينَهُمۡ‌ۖ","وَلَوۡ","شَآءَ","ٱللَّهُ","مَا","فَعَلُوهُ‌ۖ","فَذَرۡهُمۡ","وَمَا","يَفۡتَرُونَ"],"6:140":["قَدۡ","خَسِرَ","ٱلَّذِينَ","قَتَلُوٓاۡ","أَوۡلَـٰدَهُمۡ","سَفَهَۢا","بِغَيۡرِ","عِلۡمٍ","وَحَرَّمُواۡ","مَا","رَزَقَهُمُ","ٱللَّهُ","ٱفۡتِرَآءً","عَلَى","ٱللَّهِ‌ۚ","قَدۡ","ضَلُّواۡ","وَمَا","كَانُواۡ","مُهۡتَدِينَ"],"6:141":["۞وَهُوَ","ٱلَّذِىٓ","أَنشَأَ","جَنَّـٰتٍ","مَّعۡرُوشَـٰتٍ","وَغَيۡرَ","مَعۡرُوشَـٰتٍ","وَٱلنَّخۡلَ","وَٱلزَّرۡعَ","مُخۡتَلِفًا","أُكُلُهُۥ","وَٱلزَّيۡتُونَ","وَٱلرُّمَّانَ","مُتَشَـٰبِهًا","وَغَيۡرَ","مُتَشَـٰبِهٍ‌ۚ","كُلُواۡ","مِن","ثَمَرِهِۦٓ","إِذَآ","أَثۡمَرَ","وَءَاتُواۡ","حَقَّهُۥ","يَوۡمَ","حَصَادِهِۦ‌ۖ","وَلَا","تُسۡرِفُوٓاۡ‌ۚ","إِنَّهُۥ","لَا","يُحِبُّ","ٱلۡمُسۡرِفِينَ"],"6:144":["وَمِنَ","ٱلۡإِبِلِ","ٱثۡنَيۡنِ","وَمِنَ","ٱلۡبَقَرِ","ٱثۡنَيۡنِ‌ۗ","قُلۡ","ءَآلذَّكَرَيۡنِ","حَرَّمَ","أَمِ","ٱلۡأُنثَيَيۡنِ","أَمَّا","ٱشۡتَمَلَتۡ","عَلَيۡهِ","أَرۡحَامُ","ٱلۡأُنثَيَيۡنِ‌ۖ","أَمۡ","كُنتُمۡ","شُهَدَآءَ","إِذۡ","وَصَّـٰكُمُ","ٱللَّهُ","بِهَـٰذَا‌ۚ","فَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","لِّيُضِلَّ","ٱلنَّاسَ","بِغَيۡرِ","عِلۡمٍ‌ۗ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِى","ٱلۡقَوۡمَ","ٱلظَّـٰلِمِينَ"],"6:145":["قُل","لَّآ","أَجِدُ","فِى","مَآ","أُوحِىَ","إِلَىَّ","مُحَرَّمًا","عَلَىٰ","طَاعِمٍ","يَطۡعَمُهُۥٓ","إِلَّآ","أَن","يَكُونَ","مَيۡتَةً","أَوۡ","دَمًا","مَّسۡفُوحًا","أَوۡ","لَحۡمَ","خِنزِيرٍ","فَإِنَّهُۥ","رِجۡسٌ","أَوۡ","فِسۡقًا","أُهِلَّ","لِغَيۡرِ","ٱللَّهِ","بِهِۦ‌ۚ","فَمَنِ","ٱضۡطُرَّ","غَيۡرَ","بَاغٍ","وَلَا","عَادٍ","فَإِنَّ","رَبَّكَ","غَفُورٌ","رَّحِيمٌ"],"6:147":["فَإِن","كَذَّبُوكَ","فَقُل","رَّبُّكُمۡ","ذُو","رَحۡمَةٍ","وٰسِعَةٍ","وَلَا","يُرَدُّ","بَأۡسُهُۥ","عَنِ","ٱلۡقَوۡمِ","ٱلۡمُجۡرِمِينَ"],"6:148":["سَيَقُولُ","ٱلَّذِينَ","أَشۡرَكُواۡ","لَوۡ","شَآءَ","ٱللَّهُ","مَآ","أَشۡرَكۡنَا","وَلَآ","ءَابَآؤُنَا","وَلَا","حَرَّمۡنَا","مِن","شَىۡءٍ‌ۚ","كَذٰلِكَ","كَذَّبَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","حَتَّىٰ","ذَاقُواۡ","بَأۡسَنَا‌ۗ","قُلۡ","هَلۡ","عِندَكُم","مِّنۡ","عِلۡمٍ","فَتُخۡرِجُوهُ","لَنَآ‌ۖ","إِن","تَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَإِنۡ","أَنتُمۡ","إِلَّا","تَخۡرُصُونَ"],"6:149":["قُلۡ","فَلِلَّهِ","ٱلۡحُجَّةُ","ٱلۡبَـٰلِغَةُ‌ۖ","فَلَوۡ","شَآءَ","لَهَدَٮٰكُمۡ","أَجۡمَعِينَ"],"6:150":["قُلۡ","هَلُمَّ","شُهَدَآءَكُمُ","ٱلَّذِينَ","يَشۡهَدُونَ","أَنَّ","ٱللَّهَ","حَرَّمَ","هَـٰذَا‌ۖ","فَإِن","شَهِدُواۡ","فَلَا","تَشۡهَدۡ","مَعَهُمۡ‌ۚ","وَلَا","تَتَّبِعۡ","أَهۡوَآءَ","ٱلَّذِينَ","كَذَّبُواۡ","بِـَٔـايَـٰتِنَا","وَٱلَّذِينَ","لَا","يُؤۡمِنُونَ","بِٱلۡأَخِرَةِ","وَهُم","بِرَبِّهِمۡ","يَعۡدِلُونَ"],"6:151":["۞قُلۡ","تَعَالَوۡاۡ","أَتۡلُ","مَا","حَرَّمَ","رَبُّكُمۡ","عَلَيۡكُمۡ‌ۖ","أَلَّا","تُشۡرِكُواۡ","بِهِۦ","شَيۡــًٔا‌ۖ","وَبِٱلۡوٰلِدَيۡنِ","إِحۡسَـٰنًا‌ۖ","وَلَا","تَقۡتُلُوٓاۡ","أَوۡلَـٰدَكُم","مِّنۡ","إِمۡلَـٰقٍ‌ۖ","نَّحۡنُ","نَرۡزُقُكُمۡ","وَإِيَّاهُمۡ‌ۖ","وَلَا","تَقۡرَبُواۡ","ٱلۡفَوٰحِشَ","مَا","ظَهَرَ","مِنۡهَا","وَمَا","بَطَنَ‌ۖ","وَلَا","تَقۡتُلُواۡ","ٱلنَّفۡسَ","ٱلَّتِى","حَرَّمَ","ٱللَّهُ","إِلَّا","بِٱلۡحَقِّ‌ۚ","ذٰلِكُمۡ","وَصَّـٰكُم","بِهِۦ","لَعَلَّكُمۡ","تَعۡقِلُونَ"],"6:152":["وَلَا","تَقۡرَبُواۡ","مَالَ","ٱلۡيَتِيمِ","إِلَّا","بِٱلَّتِى","هِىَ","أَحۡسَنُ","حَتَّىٰ","يَبۡلُغَ","أَشُدَّهُۥ‌ۖ","وَأَوۡفُواۡ","ٱلۡكَيۡلَ","وَٱلۡمِيزَانَ","بِٱلۡقِسۡطِ‌ۖ","لَا","نُكَلِّفُ","نَفۡسًا","إِلَّا","وُسۡعَهَا‌ۖ","وَإِذَا","قُلۡتُمۡ","فَٱعۡدِلُواۡ","وَلَوۡ","كَانَ","ذَا","قُرۡبَىٰ‌ۖ","وَبِعَهۡدِ","ٱللَّهِ","أَوۡفُواۡ‌ۚ","ذٰلِكُمۡ","وَصَّـٰكُم","بِهِۦ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"6:155":["وَهَـٰذَا","كِتَـٰبٌ","أَنزَلۡنَـٰهُ","مُبَارَكٌ","فَٱتَّبِعُوهُ","وَٱتَّقُواۡ","لَعَلَّكُمۡ","تُرۡحَمُونَ"],"6:158":["هَلۡ","يَنظُرُونَ","إِلَّآ","أَن","تَأۡتِيَهُمُ","ٱلۡمَلَـٰٓئِكَةُ","أَوۡ","يَأۡتِىَ","رَبُّكَ","أَوۡ","يَأۡتِىَ","بَعۡضُ","ءَايَـٰتِ","رَبِّكَ‌ۗ","يَوۡمَ","يَأۡتِى","بَعۡضُ","ءَايَـٰتِ","رَبِّكَ","لَا","يَنفَعُ","نَفۡسًا","إِيمَـٰنُهَا","لَمۡ","تَكُنۡ","ءَامَنَتۡ","مِن","قَبۡلُ","أَوۡ","كَسَبَتۡ","فِىٓ","إِيمَـٰنِهَا","خَيۡرًا‌ۗ","قُلِ","ٱنتَظِرُوٓاۡ","إِنَّا","مُنتَظِرُونَ"],"6:159":["إِنَّ","ٱلَّذِينَ","فَرَّقُواۡ","دِينَهُمۡ","وَكَانُواۡ","شِيَعًا","لَّسۡتَ","مِنۡهُمۡ","فِى","شَىۡءٍ‌ۚ","إِنَّمَآ","أَمۡرُهُمۡ","إِلَى","ٱللَّهِ","ثُمَّ","يُنَبِّئُهُم","بِمَا","كَانُواۡ","يَفۡعَلُونَ"],"6:160":["مَن","جَآءَ","بِٱلۡحَسَنَةِ","فَلَهُۥ","عَشۡرُ","أَمۡثَالِهَا‌ۖ","وَمَن","جَآءَ","بِٱلسَّيِّئَةِ","فَلَا","يُجۡزَىٰٓ","إِلَّا","مِثۡلَهَا","وَهُمۡ","لَا","يُظۡلَمُونَ"],"6:164":["قُلۡ","أَغَيۡرَ","ٱللَّهِ","أَبۡغِى","رَبًّا","وَهُوَ","رَبُّ","كُلِّ","شَىۡءٍ‌ۚ","وَلَا","تَكۡسِبُ","كُلُّ","نَفۡسٍ","إِلَّا","عَلَيۡهَا‌ۚ","وَلَا","تَزِرُ","وَازِرَةٌ","وِزۡرَ","أُخۡرَىٰ‌ۚ","ثُمَّ","إِلَىٰ","رَبِّكُم","مَّرۡجِعُكُمۡ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","فِيهِ","تَخۡتَلِفُونَ"],"6:165":["وَهُوَ","ٱلَّذِى","جَعَلَكُمۡ","خَلَـٰٓئِفَ","ٱلۡأَرۡضِ","وَرَفَعَ","بَعۡضَكُمۡ","فَوۡقَ","بَعۡضٍ","دَرَجَـٰتٍ","لِّيَبۡلُوَكُمۡ","فِى","مَآ","ءَاتَـٰكُمۡ‌ۗ","إِنَّ","رَبَّكَ","سَرِيعُ","ٱلۡعِقَابِ","وَإِنَّهُۥ","لَغَفُورٌ","رَّحِيمُۢ"],"7:35":["يَـٰبَنِىٓ","ءَادَمَ","إِمَّا","يَأۡتِيَنَّكُمۡ","رُسُلٌ","مِّنكُمۡ","يَقُصُّونَ","عَلَيۡكُمۡ","ءَايَـٰتِى‌ۙ","فَمَنِ","ٱتَّقَىٰ","وَأَصۡلَحَ","فَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"7:37":["فَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","كَذَّبَ","بِـَٔـايَـٰتِهِۦٓ‌ۚ","أُوۡلَـٰٓئِكَ","يَنَالُهُمۡ","نَصِيبُهُم","مِّنَ","ٱلۡكِتَـٰبِ‌ۖ","حَتَّىٰٓ","إِذَا","جَآءَتۡهُمۡ","رُسُلُنَا","يَتَوَفَّوۡنَهُمۡ","قَالُوٓاۡ","أَيۡنَ","مَا","كُنتُمۡ","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ‌ۖ","قَالُواۡ","ضَلُّواۡ","عَنَّا","وَشَهِدُواۡ","عَلَىٰٓ","أَنفُسِهِمۡ","أَنَّهُمۡ","كَانُواۡ","كَـٰفِرِينَ"],"7:53":["هَلۡ","يَنظُرُونَ","إِلَّا","تَأۡوِيلَهُۥ‌ۚ","يَوۡمَ","يَأۡتِى","تَأۡوِيلُهُۥ","يَقُولُ","ٱلَّذِينَ","نَسُوهُ","مِن","قَبۡلُ","قَدۡ","جَآءَتۡ","رُسُلُ","رَبِّنَا","بِٱلۡحَقِّ","فَهَل","لَّنَا","مِن","شُفَعَآءَ","فَيَشۡفَعُواۡ","لَنَآ","أَوۡ","نُرَدُّ","فَنَعۡمَلَ","غَيۡرَ","ٱلَّذِى","كُنَّا","نَعۡمَلُ‌ۚ","قَدۡ","خَسِرُوٓاۡ","أَنفُسَهُمۡ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواۡ","يَفۡتَرُونَ"],"7:94":["وَمَآ","أَرۡسَلۡنَا","فِى","قَرۡيَةٍ","مِّن","نَّبِىٍّ","إِلَّآ","أَخَذۡنَآ","أَهۡلَهَا","بِٱلۡبَأۡسَآءِ","وَٱلضَّرَّآءِ","لَعَلَّهُمۡ","يَضَّرَّعُونَ"],"7:95":["ثُمَّ","بَدَّلۡنَا","مَكَانَ","ٱلسَّيِّئَةِ","ٱلۡحَسَنَةَ","حَتَّىٰ","عَفَواۡ","وَّقَالُواۡ","قَدۡ","مَسَّ","ءَابَآءَنَا","ٱلضَّرَّآءُ","وَٱلسَّرَّآءُ","فَأَخَذۡنَـٰهُم","بَغۡتَةً","وَهُمۡ","لَا","يَشۡعُرُونَ"],"7:165":["فَلَمَّا","نَسُواۡ","مَا","ذُكِّرُواۡ","بِهِۦٓ","أَنجَيۡنَا","ٱلَّذِينَ","يَنۡهَوۡنَ","عَنِ","ٱلسُّوٓءِ","وَأَخَذۡنَا","ٱلَّذِينَ","ظَلَمُواۡ","بِعَذَابِۭ","بَــِٔيسِۭ","بِمَا","كَانُواۡ","يَفۡسُقُونَ"],"7:169":["فَخَلَفَ","مِنۢ","بَعۡدِهِمۡ","خَلۡفٌ","وَرِثُواۡ","ٱلۡكِتَـٰبَ","يَأۡخُذُونَ","عَرَضَ","هَـٰذَا","ٱلۡأَدۡنَىٰ","وَيَقُولُونَ","سَيُغۡفَرُ","لَنَا","وَإِن","يَأۡتِهِمۡ","عَرَضٌ","مِّثۡلُهُۥ","يَأۡخُذُوهُ‌ۚ","أَلَمۡ","يُؤۡخَذۡ","عَلَيۡهِم","مِّيثَـٰقُ","ٱلۡكِتَـٰبِ","أَن","لَّا","يَقُولُواۡ","عَلَى","ٱللَّهِ","إِلَّا","ٱلۡحَقَّ","وَدَرَسُواۡ","مَا","فِيهِ‌ۗ","وَٱلدَّارُ","ٱلۡأَخِرَةُ","خَيۡرٌ","لِّلَّذِينَ","يَتَّقُونَ‌ۗ","أَفَلَا","تَعۡقِلُونَ"],"7:188":["قُل","لَّآ","أَمۡلِكُ","لِنَفۡسِى","نَفۡعًا","وَلَا","ضَرًّا","إِلَّا","مَا","شَآءَ","ٱللَّهُ‌ۚ","وَلَوۡ","كُنتُ","أَعۡلَمُ","ٱلۡغَيۡبَ","لَٱسۡتَكۡثَرۡتُ","مِنَ","ٱلۡخَيۡرِ","وَمَا","مَسَّنِىَ","ٱلسُّوٓءُ‌ۚ","إِنۡ","أَنَاۡ","إِلَّا","نَذِيرٌ","وَبَشِيرٌ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"10:12":["وَإِذَا","مَسَّ","ٱلۡإِنسَـٰنَ","ٱلضُّرُّ","دَعَانَا","لِجَنۢبِهِۦٓ","أَوۡ","قَاعِدًا","أَوۡ","قَآئِمًا","فَلَمَّا","كَشَفۡنَا","عَنۡهُ","ضُرَّهُۥ","مَرَّ","كَأَن","لَّمۡ","يَدۡعُنَآ","إِلَىٰ","ضُرٍّ","مَّسَّهُۥ‌ۚ","كَذٰلِكَ","زُيِّنَ","لِلۡمُسۡرِفِينَ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"10:14":["ثُمَّ","جَعَلۡنَـٰكُمۡ","خَلَـٰٓئِفَ","فِى","ٱلۡأَرۡضِ","مِنۢ","بَعۡدِهِمۡ","لِنَنظُرَ","كَيۡفَ","تَعۡمَلُونَ"],"10:15":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَاتُنَا","بَيِّنَـٰتٍ‌ۙ","قَالَ","ٱلَّذِينَ","لَا","يَرۡجُونَ","لِقَآءَنَا","ٱئۡتِ","بِقُرۡءَانٍ","غَيۡرِ","هَـٰذَآ","أَوۡ","بَدِّلۡهُ‌ۚ","قُلۡ","مَا","يَكُونُ","لِىٓ","أَنۡ","أُبَدِّلَهُۥ","مِن","تِلۡقَآىِٕ","نَفۡسِىٓ‌ۖ","إِنۡ","أَتَّبِعُ","إِلَّا","مَا","يُوحَىٰٓ","إِلَىَّ‌ۖ","إِنِّىٓ","أَخَافُ","إِنۡ","عَصَيۡتُ","رَبِّى","عَذَابَ","يَوۡمٍ","عَظِيمٍ"],"10:16":["قُل","لَّوۡ","شَآءَ","ٱللَّهُ","مَا","تَلَوۡتُهُۥ","عَلَيۡكُمۡ","وَلَآ","أَدۡرَٮٰكُم","بِهِۦ‌ۖ","فَقَدۡ","لَبِثۡتُ","فِيكُمۡ","عُمُرًا","مِّن","قَبۡلِهِۦٓ‌ۚ","أَفَلَا","تَعۡقِلُونَ"],"10:17":["فَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","كَذَّبَ","بِـَٔـايَـٰتِهِۦٓ‌ۚ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلۡمُجۡرِمُونَ"],"10:28":["وَيَوۡمَ","نَحۡشُرُهُمۡ","جَمِيعًا","ثُمَّ","نَقُولُ","لِلَّذِينَ","أَشۡرَكُواۡ","مَكَانَكُمۡ","أَنتُمۡ","وَشُرَكَآؤُكُمۡ‌ۚ","فَزَيَّلۡنَا","بَيۡنَهُمۡ‌ۖ","وَقَالَ","شُرَكَآؤُهُم","مَّا","كُنتُمۡ","إِيَّانَا","تَعۡبُدُونَ"],"10:31":["قُلۡ","مَن","يَرۡزُقُكُم","مِّنَ","ٱلسَّمَآءِ","وَٱلۡأَرۡضِ","أَمَّن","يَمۡلِكُ","ٱلسَّمۡعَ","وَٱلۡأَبۡصَـٰرَ","وَمَن","يُخۡرِجُ","ٱلۡحَىَّ","مِنَ","ٱلۡمَيِّتِ","وَيُخۡرِجُ","ٱلۡمَيِّتَ","مِنَ","ٱلۡحَىِّ","وَمَن","يُدَبِّرُ","ٱلۡأَمۡرَ‌ۚ","فَسَيَقُولُونَ","ٱللَّهُ‌ۚ","فَقُلۡ","أَفَلَا","تَتَّقُونَ"],"10:66":["أَلَآ","إِنَّ","لِلَّهِ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ‌ۗ","وَمَا","يَتَّبِعُ","ٱلَّذِينَ","يَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","شُرَكَآءَ‌ۚ","إِن","يَتَّبِعُونَ","إِلَّا","ٱلظَّنَّ","وَإِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"10:106":["وَلَا","تَدۡعُ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُكَ","وَلَا","يَضُرُّكَ‌ۖ","فَإِن","فَعَلۡتَ","فَإِنَّكَ","إِذًا","مِّنَ","ٱلظَّـٰلِمِينَ"],"10:107":["وَإِن","يَمۡسَسۡكَ","ٱللَّهُ","بِضُرٍّ","فَلَا","كَاشِفَ","لَهُۥٓ","إِلَّا","هُوَ‌ۖ","وَإِن","يُرِدۡكَ","بِخَيۡرٍ","فَلَا","رَآدَّ","لِفَضۡلِهِۦ‌ۚ","يُصِيبُ","بِهِۦ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ‌ۚ","وَهُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"11:6":["۞وَمَا","مِن","دَآبَّةٍ","فِى","ٱلۡأَرۡضِ","إِلَّا","عَلَى","ٱللَّهِ","رِزۡقُهَا","وَيَعۡلَمُ","مُسۡتَقَرَّهَا","وَمُسۡتَوۡدَعَهَا‌ۚ","كُلٌّ","فِى","كِتَـٰبٍ","مُّبِينٍ"],"11:18":["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا‌ۚ","أُوۡلَـٰٓئِكَ","يُعۡرَضُونَ","عَلَىٰ","رَبِّهِمۡ","وَيَقُولُ","ٱلۡأَشۡهَـٰدُ","هَـٰٓؤُلَآءِ","ٱلَّذِينَ","كَذَبُواۡ","عَلَىٰ","رَبِّهِمۡ‌ۚ","أَلَا","لَعۡنَةُ","ٱللَّهِ","عَلَى","ٱلظَّـٰلِمِينَ"],"11:19":["ٱلَّذِينَ","يَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","وَيَبۡغُونَهَا","عِوَجًا","وَهُم","بِٱلۡأَخِرَةِ","هُمۡ","كَـٰفِرُونَ"],"11:21":["أُوۡلَـٰٓئِكَ","ٱلَّذِينَ","خَسِرُوٓاۡ","أَنفُسَهُمۡ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواۡ","يَفۡتَرُونَ"],"11:31":["وَلَآ","أَقُولُ","لَكُمۡ","عِندِى","خَزَآئِنُ","ٱللَّهِ","وَلَآ","أَعۡلَمُ","ٱلۡغَيۡبَ","وَلَآ","أَقُولُ","إِنِّى","مَلَكٌ","وَلَآ","أَقُولُ","لِلَّذِينَ","تَزۡدَرِىٓ","أَعۡيُنُكُمۡ","لَن","يُؤۡتِيَهُمُ","ٱللَّهُ","خَيۡرًا‌ۖ","ٱللَّهُ","أَعۡلَمُ","بِمَا","فِىٓ","أَنفُسِهِمۡ‌ۖ","إِنِّىٓ","إِذًا","لَّمِنَ","ٱلظَّـٰلِمِينَ"],"11:93":["وَيَـٰقَوۡمِ","ٱعۡمَلُواۡ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّى","عَـٰمِلٌ‌ۖ","سَوۡفَ","تَعۡلَمُونَ","مَن","يَأۡتِيهِ","عَذَابٌ","يُخۡزِيهِ","وَمَنۡ","هُوَ","كَـٰذِبٌ‌ۖ","وَٱرۡتَقِبُوٓاۡ","إِنِّى","مَعَكُمۡ","رَقِيبٌ"],"11:117":["وَمَا","كَانَ","رَبُّكَ","لِيُهۡلِكَ","ٱلۡقُرَىٰ","بِظُلۡمٍ","وَأَهۡلُهَا","مُصۡلِحُونَ"],"12:109":["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","إِلَّا","رِجَالاً","نُّوحِىٓ","إِلَيۡهِم","مِّنۡ","أَهۡلِ","ٱلۡقُرَىٰٓ‌ۗ","أَفَلَمۡ","يَسِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَيَنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ‌ۗ","وَلَدَارُ","ٱلۡأَخِرَةِ","خَيۡرٌ","لِّلَّذِينَ","ٱتَّقَوۡاۡ‌ۗ","أَفَلَا","تَعۡقِلُونَ"],"12:110":["حَتَّىٰٓ","إِذَا","ٱسۡتَيۡــَٔسَ","ٱلرُّسُلُ","وَظَنُّوٓاۡ","أَنَّهُمۡ","قَدۡ","كُذِبُواۡ","جَآءَهُمۡ","نَصۡرُنَا","فَنُجِّىَ","مَن","نَّشَآءُ‌ۖ","وَلَا","يُرَدُّ","بَأۡسُنَا","عَنِ","ٱلۡقَوۡمِ","ٱلۡمُجۡرِمِينَ"],"13:16":["قُلۡ","مَن","رَّبُّ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ","قُلِ","ٱللَّهُ‌ۚ","قُلۡ","أَفَٱتَّخَذۡتُم","مِّن","دُونِهِۦٓ","أَوۡلِيَآءَ","لَا","يَمۡلِكُونَ","لِأَنفُسِهِمۡ","نَفۡعًا","وَلَا","ضَرًّا‌ۚ","قُلۡ","هَلۡ","يَسۡتَوِى","ٱلۡأَعۡمَىٰ","وَٱلۡبَصِيرُ","أَمۡ","هَلۡ","تَسۡتَوِى","ٱلظُّلُمَـٰتُ","وَٱلنُّورُ‌ۗ","أَمۡ","جَعَلُواۡ","لِلَّهِ","شُرَكَآءَ","خَلَقُواۡ","كَخَلۡقِهِۦ","فَتَشَـٰبَهَ","ٱلۡخَلۡقُ","عَلَيۡهِمۡ‌ۚ","قُلِ","ٱللَّهُ","خَـٰلِقُ","كُلِّ","شَىۡءٍ","وَهُوَ","ٱلۡوٰحِدُ","ٱلۡقَهَّـٰرُ"],"13:32":["وَلَقَدِ","ٱسۡتُهۡزِئَ","بِرُسُلٍ","مِّن","قَبۡلِكَ","فَأَمۡلَيۡتُ","لِلَّذِينَ","كَفَرُواۡ","ثُمَّ","أَخَذۡتُهُمۡ‌ۖ","فَكَيۡفَ","كَانَ","عِقَابِ"],"13:33":["أَفَمَنۡ","هُوَ","قَآئِمٌ","عَلَىٰ","كُلِّ","نَفۡسِۭ","بِمَا","كَسَبَتۡ‌ۗ","وَجَعَلُواۡ","لِلَّهِ","شُرَكَآءَ","قُلۡ","سَمُّوهُمۡ‌ۚ","أَمۡ","تُنَبِّــُٔونَهُۥ","بِمَا","لَا","يَعۡلَمُ","فِى","ٱلۡأَرۡضِ","أَم","بِظَـٰهِرٍ","مِّنَ","ٱلۡقَوۡلِ‌ۗ","بَلۡ","زُيِّنَ","لِلَّذِينَ","كَفَرُواۡ","مَكۡرُهُمۡ","وَصُدُّواۡ","عَنِ","ٱلسَّبِيلِ‌ۗ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَمَا","لَهُۥ","مِنۡ","هَادٍ"],"16:9":["وَعَلَى","ٱللَّهِ","قَصۡدُ","ٱلسَّبِيلِ","وَمِنۡهَا","جَآئِرٌ‌ۚ","وَلَوۡ","شَآءَ","لَهَدَٮٰكُمۡ","أَجۡمَعِينَ"],"16:10":["هُوَ","ٱلَّذِىٓ","أَنزَلَ","مِنَ","ٱلسَّمَآءِ","مَآءً‌ۖ","لَّكُم","مِّنۡهُ","شَرَابٌ","وَمِنۡهُ","شَجَرٌ","فِيهِ","تُسِيمُونَ"],"16:33":["هَلۡ","يَنظُرُونَ","إِلَّآ","أَن","تَأۡتِيَهُمُ","ٱلۡمَلَـٰٓئِكَةُ","أَوۡ","يَأۡتِىَ","أَمۡرُ","رَبِّكَ‌ۚ","كَذٰلِكَ","فَعَلَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ‌ۚ","وَمَا","ظَلَمَهُمُ","ٱللَّهُ","وَلَـٰكِن","كَانُوٓاۡ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"16:35":["وَقَالَ","ٱلَّذِينَ","أَشۡرَكُواۡ","لَوۡ","شَآءَ","ٱللَّهُ","مَا","عَبَدۡنَا","مِن","دُونِهِۦ","مِن","شَىۡءٍ","نَّحۡنُ","وَلَآ","ءَابَآؤُنَا","وَلَا","حَرَّمۡنَا","مِن","دُونِهِۦ","مِن","شَىۡءٍ‌ۚ","كَذٰلِكَ","فَعَلَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ‌ۚ","فَهَلۡ","عَلَى","ٱلرُّسُلِ","إِلَّا","ٱلۡبَلَـٰغُ","ٱلۡمُبِينُ"],"16:36":["وَلَقَدۡ","بَعَثۡنَا","فِى","كُلِّ","أُمَّةٍ","رَّسُولاً","أَنِ","ٱعۡبُدُواۡ","ٱللَّهَ","وَٱجۡتَنِبُواۡ","ٱلطَّـٰغُوتَ‌ۖ","فَمِنۡهُم","مَّنۡ","هَدَى","ٱللَّهُ","وَمِنۡهُم","مَّنۡ","حَقَّتۡ","عَلَيۡهِ","ٱلضَّلَـٰلَةُ‌ۚ","فَسِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُكَذِّبِينَ"],"16:38":["وَأَقۡسَمُواۡ","بِٱللَّهِ","جَهۡدَ","أَيۡمَـٰنِهِمۡ‌ۙ","لَا","يَبۡعَثُ","ٱللَّهُ","مَن","يَمُوتُ‌ۚ","بَلَىٰ","وَعۡدًا","عَلَيۡهِ","حَقًّا","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"16:115":["إِنَّمَا","حَرَّمَ","عَلَيۡكُمُ","ٱلۡمَيۡتَةَ","وَٱلدَّمَ","وَلَحۡمَ","ٱلۡخِنزِيرِ","وَمَآ","أُهِلَّ","لِغَيۡرِ","ٱللَّهِ","بِهِۦ‌ۖ","فَمَنِ","ٱضۡطُرَّ","غَيۡرَ","بَاغٍ","وَلَا","عَادٍ","فَإِنَّ","ٱللَّهَ","غَفُورٌ","رَّحِيمٌ"],"16:125":["ٱدۡعُ","إِلَىٰ","سَبِيلِ","رَبِّكَ","بِٱلۡحِكۡمَةِ","وَٱلۡمَوۡعِظَةِ","ٱلۡحَسَنَةِ‌ۖ","وَجَـٰدِلۡهُم","بِٱلَّتِى","هِىَ","أَحۡسَنُ‌ۚ","إِنَّ","رَبَّكَ","هُوَ","أَعۡلَمُ","بِمَن","ضَلَّ","عَن","سَبِيلِهِۦ‌ۖ","وَهُوَ","أَعۡلَمُ","بِٱلۡمُهۡتَدِينَ"],"16:126":["وَإِنۡ","عَاقَبۡتُمۡ","فَعَاقِبُواۡ","بِمِثۡلِ","مَا","عُوقِبۡتُم","بِهِۦ‌ۖ","وَلَئِن","صَبَرۡتُمۡ","لَهُوَ","خَيۡرٌ","لِّلصَّـٰبِرِينَ"],"17:15":["مَّنِ","ٱهۡتَدَىٰ","فَإِنَّمَا","يَهۡتَدِى","لِنَفۡسِهِۦ‌ۖ","وَمَن","ضَلَّ","فَإِنَّمَا","يَضِلُّ","عَلَيۡهَا‌ۚ","وَلَا","تَزِرُ","وَازِرَةٌ","وِزۡرَ","أُخۡرَىٰ‌ۗ","وَمَا","كُنَّا","مُعَذِّبِينَ","حَتَّىٰ","نَبۡعَثَ","رَسُولاً"],"17:17":["وَكَمۡ","أَهۡلَكۡنَا","مِنَ","ٱلۡقُرُونِ","مِنۢ","بَعۡدِ","نُوحٍ‌ۗ","وَكَفَىٰ","بِرَبِّكَ","بِذُنُوبِ","عِبَادِهِۦ","خَبِيرَۢا","بَصِيرًا"],"17:31":["وَلَا","تَقۡتُلُوٓاۡ","أَوۡلَـٰدَكُمۡ","خَشۡيَةَ","إِمۡلَـٰقٍ‌ۖ","نَّحۡنُ","نَرۡزُقُهُمۡ","وَإِيَّاكُمۡ‌ۚ","إِنَّ","قَتۡلَهُمۡ","كَانَ","خِطۡــًٔا","كَبِيرًا"],"17:34":["وَلَا","تَقۡرَبُواۡ","مَالَ","ٱلۡيَتِيمِ","إِلَّا","بِٱلَّتِى","هِىَ","أَحۡسَنُ","حَتَّىٰ","يَبۡلُغَ","أَشُدَّهُۥ‌ۚ","وَأَوۡفُواۡ","بِٱلۡعَهۡدِ‌ۖ","إِنَّ","ٱلۡعَهۡدَ","كَانَ","مَسۡــُٔولاً"],"17:46":["وَجَعَلۡنَا","عَلَىٰ","قُلُوبِهِمۡ","أَكِنَّةً","أَن","يَفۡقَهُوهُ","وَفِىٓ","ءَاذَانِهِمۡ","وَقۡرًا‌ۚ","وَإِذَا","ذَكَرۡتَ","رَبَّكَ","فِى","ٱلۡقُرۡءَانِ","وَحۡدَهُۥ","وَلَّوۡاۡ","عَلَىٰٓ","أَدۡبَـٰرِهِمۡ","نُفُورًا"],"18:28":["وَٱصۡبِرۡ","نَفۡسَكَ","مَعَ","ٱلَّذِينَ","يَدۡعُونَ","رَبَّهُم","بِٱلۡغَدَوٰةِ","وَٱلۡعَشِىِّ","يُرِيدُونَ","وَجۡهَهُۥ‌ۖ","وَلَا","تَعۡدُ","عَيۡنَاكَ","عَنۡهُمۡ","تُرِيدُ","زِينَةَ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا‌ۖ","وَلَا","تُطِعۡ","مَنۡ","أَغۡفَلۡنَا","قَلۡبَهُۥ","عَن","ذِكۡرِنَا","وَٱتَّبَعَ","هَوَٮٰهُ","وَكَانَ","أَمۡرُهُۥ","فُرُطًا"],"18:56":["وَمَا","نُرۡسِلُ","ٱلۡمُرۡسَلِينَ","إِلَّا","مُبَشِّرِينَ","وَمُنذِرِينَ‌ۚ","وَيُجَـٰدِلُ","ٱلَّذِينَ","كَفَرُواۡ","بِٱلۡبَـٰطِلِ","لِيُدۡحِضُواۡ","بِهِ","ٱلۡحَقَّ‌ۖ","وَٱتَّخَذُوٓاۡ","ءَايَـٰتِى","وَمَآ","أُنذِرُواۡ","هُزُوًا"],"18:57":["وَمَنۡ","أَظۡلَمُ","مِمَّن","ذُكِّرَ","بِـَٔـايَـٰتِ","رَبِّهِۦ","فَأَعۡرَضَ","عَنۡهَا","وَنَسِىَ","مَا","قَدَّمَتۡ","يَدَاهُ‌ۚ","إِنَّا","جَعَلۡنَا","عَلَىٰ","قُلُوبِهِمۡ","أَكِنَّةً","أَن","يَفۡقَهُوهُ","وَفِىٓ","ءَاذَانِهِمۡ","وَقۡرًا‌ۖ","وَإِن","تَدۡعُهُمۡ","إِلَى","ٱلۡهُدَىٰ","فَلَن","يَهۡتَدُوٓاۡ","إِذًا","أَبَدًا"],"20:102":["يَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ‌ۚ","وَنَحۡشُرُ","ٱلۡمُجۡرِمِينَ","يَوۡمَئِذٍ","زُرۡقًا"],"20:128":["أَفَلَمۡ","يَهۡدِ","لَهُمۡ","كَمۡ","أَهۡلَكۡنَا","قَبۡلَهُم","مِّنَ","ٱلۡقُرُونِ","يَمۡشُونَ","فِى","مَسَـٰكِنِهِمۡ‌ۗ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّأُوۡلِى","ٱلنُّهَىٰ"],"21:41":["وَلَقَدِ","ٱسۡتُهۡزِئَ","بِرُسُلٍ","مِّن","قَبۡلِكَ","فَحَاقَ","بِٱلَّذِينَ","سَخِرُواۡ","مِنۡهُم","مَّا","كَانُواۡ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"21:42":["قُلۡ","مَن","يَكۡلَؤُكُم","بِٱلَّيۡلِ","وَٱلنَّهَارِ","مِنَ","ٱلرَّحۡمَـٰنِ‌ۗ","بَلۡ","هُمۡ","عَن","ذِكۡرِ","رَبِّهِم","مُّعۡرِضُونَ"],"21:66":["قَالَ","أَفَتَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُكُمۡ","شَيۡــًٔا","وَلَا","يَضُرُّكُمۡ"],"21:72":["وَوَهَبۡنَا","لَهُۥٓ","إِسۡحَـٰقَ","وَيَعۡقُوبَ","نَافِلَةً‌ۖ","وَكُلاًّ","جَعَلۡنَا","صَـٰلِحِينَ"],"23:31":["ثُمَّ","أَنشَأۡنَا","مِنۢ","بَعۡدِهِمۡ","قَرۡنًا","ءَاخَرِينَ"],"23:37":["إِنۡ","هِىَ","إِلَّا","حَيَاتُنَا","ٱلدُّنۡيَا","نَمُوتُ","وَنَحۡيَا","وَمَا","نَحۡنُ","بِمَبۡعُوثِينَ"],"23:42":["ثُمَّ","أَنشَأۡنَا","مِنۢ","بَعۡدِهِمۡ","قُرُونًا","ءَاخَرِينَ"],"24:53":["۞وَأَقۡسَمُواۡ","بِٱللَّهِ","جَهۡدَ","أَيۡمَـٰنِهِمۡ","لَئِنۡ","أَمَرۡتَهُمۡ","لَيَخۡرُجُنَّ‌ۖ","قُل","لَّا","تُقۡسِمُواۡ‌ۖ","طَاعَةٌ","مَّعۡرُوفَةٌ‌ۚ","إِنَّ","ٱللَّهَ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"25:31":["وَكَذٰلِكَ","جَعَلۡنَا","لِكُلِّ","نَبِىٍّ","عَدُوًّا","مِّنَ","ٱلۡمُجۡرِمِينَ‌ۗ","وَكَفَىٰ","بِرَبِّكَ","هَادِيًا","وَنَصِيرًا"],"25:55":["وَيَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُهُمۡ","وَلَا","يَضُرُّهُمۡ‌ۗ","وَكَانَ","ٱلۡكَافِرُ","عَلَىٰ","رَبِّهِۦ","ظَهِيرًا"],"25:68":["وَٱلَّذِينَ","لَا","يَدۡعُونَ","مَعَ","ٱللَّهِ","إِلَـٰهًا","ءَاخَرَ","وَلَا","يَقۡتُلُونَ","ٱلنَّفۡسَ","ٱلَّتِى","حَرَّمَ","ٱللَّهُ","إِلَّا","بِٱلۡحَقِّ","وَلَا","يَزۡنُونَ‌ۚ","وَمَن","يَفۡعَلۡ","ذٰلِكَ","يَلۡقَ","أَثَامًا"],"26:6":["فَقَدۡ","كَذَّبُواۡ","فَسَيَأۡتِيهِمۡ","أَنۢبَـٰٓؤُاۡ","مَا","كَانُواۡ","بِهِۦ","يَسۡتَهۡزِءُونَ"],"26:7":["أَوَلَمۡ","يَرَوۡاۡ","إِلَى","ٱلۡأَرۡضِ","كَمۡ","أَنۢبَتۡنَا","فِيهَا","مِن","كُلِّ","زَوۡجٍ","كَرِيمٍ"],"27:69":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُجۡرِمِينَ"],"27:87":["وَيَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ","فَفَزِعَ","مَن","فِى","ٱلسَّمَـٰوٰتِ","وَمَن","فِى","ٱلۡأَرۡضِ","إِلَّا","مَن","شَآءَ","ٱللَّهُ‌ۚ","وَكُلٌّ","أَتَوۡهُ","دٰخِرِينَ"],"27:89":["مَن","جَآءَ","بِٱلۡحَسَنَةِ","فَلَهُۥ","خَيۡرٌ","مِّنۡهَا","وَهُم","مِّن","فَزَعٍ","يَوۡمَئِذٍ","ءَامِنُونَ"],"28:59":["وَمَا","كَانَ","رَبُّكَ","مُهۡلِكَ","ٱلۡقُرَىٰ","حَتَّىٰ","يَبۡعَثَ","فِىٓ","أُمِّهَا","رَسُولاً","يَتۡلُواۡ","عَلَيۡهِمۡ","ءَايَـٰتِنَا‌ۚ","وَمَا","كُنَّا","مُهۡلِكِى","ٱلۡقُرَىٰٓ","إِلَّا","وَأَهۡلُهَا","ظَـٰلِمُونَ"],"28:84":["مَن","جَآءَ","بِٱلۡحَسَنَةِ","فَلَهُۥ","خَيۡرٌ","مِّنۡهَا‌ۖ","وَمَن","جَآءَ","بِٱلسَّيِّئَةِ","فَلَا","يُجۡزَى","ٱلَّذِينَ","عَمِلُواۡ","ٱلسَّيِّـَٔـاتِ","إِلَّا","مَا","كَانُواۡ","يَعۡمَلُونَ"],"29:20":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","بَدَأَ","ٱلۡخَلۡقَ‌ۚ","ثُمَّ","ٱللَّهُ","يُنشِئُ","ٱلنَّشۡأَةَ","ٱلۡأَخِرَةَ‌ۚ","إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَىۡءٍ","قَدِيرٌ"],"29:27":["وَوَهَبۡنَا","لَهُۥٓ","إِسۡحَـٰقَ","وَيَعۡقُوبَ","وَجَعَلۡنَا","فِى","ذُرِّيَّتِهِ","ٱلنُّبُوَّةَ","وَٱلۡكِتَـٰبَ","وَءَاتَيۡنَـٰهُ","أَجۡرَهُۥ","فِى","ٱلدُّنۡيَا‌ۖ","وَإِنَّهُۥ","فِى","ٱلۡأَخِرَةِ","لَمِنَ","ٱلصَّـٰلِحِينَ"],"29:64":["وَمَا","هَـٰذِهِ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَآ","إِلَّا","لَهۡوٌ","وَلَعِبٌ‌ۚ","وَإِنَّ","ٱلدَّارَ","ٱلۡأَخِرَةَ","لَهِىَ","ٱلۡحَيَوَانُ‌ۚ","لَوۡ","كَانُواۡ","يَعۡلَمُونَ"],"29:68":["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًا","أَوۡ","كَذَّبَ","بِٱلۡحَقِّ","لَمَّا","جَآءَهُۥٓ‌ۚ","أَلَيۡسَ","فِى","جَهَنَّمَ","مَثۡوًى","لِّلۡكَـٰفِرِينَ"],"29:69":["وَٱلَّذِينَ","جَـٰهَدُواۡ","فِينَا","لَنَهۡدِيَنَّهُمۡ","سُبُلَنَا‌ۚ","وَإِنَّ","ٱللَّهَ","لَمَعَ","ٱلۡمُحۡسِنِينَ"],"30:19":["يُخۡرِجُ","ٱلۡحَىَّ","مِنَ","ٱلۡمَيِّتِ","وَيُخۡرِجُ","ٱلۡمَيِّتَ","مِنَ","ٱلۡحَىِّ","وَيُحۡىِ","ٱلۡأَرۡضَ","بَعۡدَ","مَوۡتِهَا‌ۚ","وَكَذٰلِكَ","تُخۡرَجُونَ"],"30:32":["مِنَ","ٱلَّذِينَ","فَرَّقُواۡ","دِينَهُمۡ","وَكَانُواۡ","شِيَعًا‌ۖ","كُلُّ","حِزۡبِۭ","بِمَا","لَدَيۡهِمۡ","فَرِحُونَ"],"30:42":["قُلۡ","سِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلُ‌ۚ","كَانَ","أَكۡثَرُهُم","مُّشۡرِكِينَ"],"32:4":["ٱللَّهُ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۖ","مَا","لَكُم","مِّن","دُونِهِۦ","مِن","وَلِىٍّ","وَلَا","شَفِيعٍ‌ۚ","أَفَلَا","تَتَذَكَّرُونَ"],"32:26":["أَوَلَمۡ","يَهۡدِ","لَهُمۡ","كَمۡ","أَهۡلَكۡنَا","مِن","قَبۡلِهِم","مِّنَ","ٱلۡقُرُونِ","يَمۡشُونَ","فِى","مَسَـٰكِنِهِمۡ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ‌ۖ","أَفَلَا","يَسۡمَعُونَ"],"34:42":["فَٱلۡيَوۡمَ","لَا","يَمۡلِكُ","بَعۡضُكُمۡ","لِبَعۡضٍ","نَّفۡعًا","وَلَا","ضَرًّا","وَنَقُولُ","لِلَّذِينَ","ظَلَمُواۡ","ذُوقُواۡ","عَذَابَ","ٱلنَّارِ","ٱلَّتِى","كُنتُم","بِهَا","تُكَذِّبُونَ"],"35:18":["وَلَا","تَزِرُ","وَازِرَةٌ","وِزۡرَ","أُخۡرَىٰۚ","وَإِن","تَدۡعُ","مُثۡقَلَةٌ","إِلَىٰ","حِمۡلِهَا","لَا","يُحۡمَلۡ","مِنۡهُ","شَىۡءٌ","وَلَوۡ","كَانَ","ذَا","قُرۡبَىٰٓۗ","إِنَّمَا","تُنذِرُ","ٱلَّذِينَ","يَخۡشَوۡنَ","رَبَّهُم","بِٱلۡغَيۡبِ","وَأَقَامُواۡ","ٱلصَّلَوٰةَۚ","وَمَن","تَزَكَّىٰ","فَإِنَّمَا","يَتَزَكَّىٰ","لِنَفۡسِهِۚۦ","وَإِلَى","ٱللَّهِ","ٱلۡمَصِيرُ"],"35:39":["هُوَ","ٱلَّذِى","جَعَلَكُمۡ","خَلَـٰٓئِفَ","فِى","ٱلۡأَرۡضِۚ","فَمَن","كَفَرَ","فَعَلَيۡهِ","كُفۡرُهُۖۥ","وَلَا","يَزِيدُ","ٱلۡكَـٰفِرِينَ","كُفۡرُهُمۡ","عِندَ","رَبِّهِمۡ","إِلَّا","مَقۡتًاۖ","وَلَا","يَزِيدُ","ٱلۡكَـٰفِرِينَ","كُفۡرُهُمۡ","إِلَّا","خَسَارًا"],"35:42":["وَأَقۡسَمُواۡ","بِٱللَّهِ","جَهۡدَ","أَيۡمَـٰنِهِمۡ","لَئِن","جَآءَهُمۡ","نَذِيرٌ","لَّيَكُونُنَّ","أَهۡدَىٰ","مِنۡ","إِحۡدَى","ٱلۡأُمَمِۖ","فَلَمَّا","جَآءَهُمۡ","نَذِيرٌ","مَّا","زَادَهُمۡ","إِلَّا","نُفُورًا"],"36:31":["أَلَمۡ","يَرَوۡاۡ","كَمۡ","أَهۡلَكۡنَا","قَبۡلَهُم","مِّنَ","ٱلۡقُرُونِ","أَنَّهُمۡ","إِلَيۡهِمۡ","لَا","يَرۡجِعُونَ"],"36:46":["وَمَا","تَأۡتِيهِم","مِّنۡ","ءَايَةٍ","مِّنۡ","ءَايَـٰتِ","رَبِّهِمۡ","إِلَّا","كَانُواۡ","عَنۡهَا","مُعۡرِضِينَ"],"36:47":["وَإِذَا","قِيلَ","لَهُمۡ","أَنفِقُواۡ","مِمَّا","رَزَقَكُمُ","ٱللَّهُ","قَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلَّذِينَ","ءَامَنُوٓاۡ","أَنُطۡعِمُ","مَن","لَّوۡ","يَشَآءُ","ٱللَّهُ","أَطۡعَمَهُۥٓ","إِنۡ","أَنتُمۡ","إِلَّا","فِى","ضَلَـٰلٍ","مُّبِينٍ"],"38:3":["كَمۡ","أَهۡلَكۡنَا","مِن","قَبۡلِهِم","مِّن","قَرۡنٍ","فَنَادَواۡ","وَّلَاتَ","حِينَ","مَنَاصٍ"],"39:7":["إِن","تَكۡفُرُواۡ","فَإِنَّ","ٱللَّهَ","غَنِىٌّ","عَنكُمۡ‌ۖ","وَلَا","يَرۡضَىٰ","لِعِبَادِهِ","ٱلۡكُفۡرَ‌ۖ","وَإِن","تَشۡكُرُواۡ","يَرۡضَهُ","لَكُمۡ‌ۗ","وَلَا","تَزِرُ","وَازِرَةٌ","وِزۡرَ","أُخۡرَىٰ‌ۗ","ثُمَّ","إِلَىٰ","رَبِّكُم","مَّرۡجِعُكُمۡ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ‌ۚ","إِنَّهُۥ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"39:13":["قُلۡ","إِنِّىٓ","أَخَافُ","إِنۡ","عَصَيۡتُ","رَبِّى","عَذَابَ","يَوۡمٍ","عَظِيمٍ"],"39:14":["قُلِ","ٱللَّهَ","أَعۡبُدُ","مُخۡلِصًا","لَّهُۥ","دِينِى"],"39:39":["قُلۡ","يَـٰقَوۡمِ","ٱعۡمَلُواۡ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّى","عَـٰمِلٌ‌ۖ","فَسَوۡفَ","تَعۡلَمُونَ"],"39:67":["وَمَا","قَدَرُواۡ","ٱللَّهَ","حَقَّ","قَدۡرِهِۦ","وَٱلۡأَرۡضُ","جَمِيعًا","قَبۡضَتُهُۥ","يَوۡمَ","ٱلۡقِيَـٰمَةِ","وَٱلسَّمَـٰوٰتُ","مَطۡوِيَّـٰتُۢ","بِيَمِينِهِۦ‌ۚ","سُبۡحَـٰنَهُۥ","وَتَعَـٰلَىٰ","عَمَّا","يُشۡرِكُونَ"],"39:71":["وَسِيقَ","ٱلَّذِينَ","كَفَرُوٓاۡ","إِلَىٰ","جَهَنَّمَ","زُمَرًا‌ۖ","حَتَّىٰٓ","إِذَا","جَآءُوهَا","فُتِحَتۡ","أَبۡوٰبُهَا","وَقَالَ","لَهُمۡ","خَزَنَتُهَآ","أَلَمۡ","يَأۡتِكُمۡ","رُسُلٌ","مِّنكُمۡ","يَتۡلُونَ","عَلَيۡكُمۡ","ءَايَـٰتِ","رَبِّكُمۡ","وَيُنذِرُونَكُمۡ","لِقَآءَ","يَوۡمِكُمۡ","هَـٰذَا‌ۚ","قَالُواۡ","بَلَىٰ","وَلَـٰكِنۡ","حَقَّتۡ","كَلِمَةُ","ٱلۡعَذَابِ","عَلَى","ٱلۡكَـٰفِرِينَ"],"40:62":["ذٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","خَـٰلِقُ","كُلِّ","شَىۡءٍ","لَّآ","إِلَـٰهَ","إِلَّا","هُوَۖ","فَأَنَّىٰ","تُؤۡفَكُونَ"],"40:63":["كَذٰلِكَ","يُؤۡفَكُ","ٱلَّذِينَ","كَانُواۡ","بِـَٔـايَـٰتِ","ٱللَّهِ","يَجۡحَدُونَ"],"40:66":["۞قُلۡ","إِنِّى","نُهِيتُ","أَنۡ","أَعۡبُدَ","ٱلَّذِينَ","تَدۡعُونَ","مِن","دُونِ","ٱللَّهِ","لَمَّا","جَآءَنِىَ","ٱلۡبَيِّنَـٰتُ","مِن","رَّبِّى","وَأُمِرۡتُ","أَنۡ","أُسۡلِمَ","لِرَبِّ","ٱلۡعَـٰلَمِينَ"],"43:20":["وَقَالُواۡ","لَوۡ","شَآءَ","ٱلرَّحۡمَـٰنُ","مَا","عَبَدۡنَـٰهُم‌ۗ","مَّا","لَهُم","بِذٰلِكَ","مِنۡ","عِلۡمٍ‌ۖ","إِنۡ","هُمۡ","إِلَّا","يَخۡرُصُونَ"],"43:26":["وَإِذۡ","قَالَ","إِبۡرٰهِيمُ","لِأَبِيهِ","وَقَوۡمِهِۦٓ","إِنَّنِى","بَرَآءٌ","مِّمَّا","تَعۡبُدُونَ"],"45:24":["وَقَالُواۡ","مَا","هِىَ","إِلَّا","حَيَاتُنَا","ٱلدُّنۡيَا","نَمُوتُ","وَنَحۡيَا","وَمَا","يُهۡلِكُنَآ","إِلَّا","ٱلدَّهۡرُ‌ۚ","وَمَا","لَهُم","بِذٰلِكَ","مِنۡ","عِلۡمٍ‌ۖ","إِنۡ","هُمۡ","إِلَّا","يَظُنُّونَ"],"46:19":["وَلِكُلٍّ","دَرَجَـٰتٌ","مِّمَّا","عَمِلُواۡ‌ۖ","وَلِيُوَفِّيَهُمۡ","أَعۡمَـٰلَهُمۡ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"47:16":["وَمِنۡهُم","مَّن","يَسۡتَمِعُ","إِلَيۡكَ","حَتَّىٰٓ","إِذَا","خَرَجُواۡ","مِنۡ","عِندِكَ","قَالُواۡ","لِلَّذِينَ","أُوتُواۡ","ٱلۡعِلۡمَ","مَاذَا","قَالَ","ءَانِفًا‌ۚ","أُوۡلَـٰٓئِكَ","ٱلَّذِينَ","طَبَعَ","ٱللَّهُ","عَلَىٰ","قُلُوبِهِمۡ","وَٱتَّبَعُوٓاۡ","أَهۡوَآءَهُمۡ"],"47:36":["إِنَّمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","لَعِبٌ","وَلَهۡوٌ‌ۚ","وَإِن","تُؤۡمِنُواۡ","وَتَتَّقُواۡ","يُؤۡتِكُمۡ","أُجُورَكُمۡ","وَلَا","يَسۡــَٔلۡكُمۡ","أَمۡوٰلَكُمۡ"],"57:20":["ٱعۡلَمُوٓاۡ","أَنَّمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","لَعِبٌ","وَلَهۡوٌ","وَزِينَةٌ","وَتَفَاخُرُۢ","بَيۡنَكُمۡ","وَتَكَاثُرٌ","فِى","ٱلۡأَمۡوٰلِ","وَٱلۡأَوۡلَـٰدِ‌ۖ","كَمَثَلِ","غَيۡثٍ","أَعۡجَبَ","ٱلۡكُفَّارَ","نَبَاتُهُۥ","ثُمَّ","يَهِيجُ","فَتَرَٮٰهُ","مُصۡفَرًّا","ثُمَّ","يَكُونُ","حُطَـٰمًا‌ۖ","وَفِى","ٱلۡأَخِرَةِ","عَذَابٌ","شَدِيدٌ","وَمَغۡفِرَةٌ","مِّنَ","ٱللَّهِ","وَرِضۡوٰنٌ‌ۚ","وَمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَآ","إِلَّا","مَتَـٰعُ","ٱلۡغُرُورِ"],"61:7":["وَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","ٱلۡكَذِبَ","وَهُوَ","يُدۡعَىٰٓ","إِلَى","ٱلۡإِسۡلَـٰمِ‌ۚ","وَٱللَّهُ","لَا","يَهۡدِى","ٱلۡقَوۡمَ","ٱلظَّـٰلِمِينَ"],"61:8":["يُرِيدُونَ","لِيُطۡفِــُٔواۡ","نُورَ","ٱللَّهِ","بِأَفۡوٰهِهِمۡ","وَٱللَّهُ","مُتِمُّ","نُورِهِۦ","وَلَوۡ","كَرِهَ","ٱلۡكَـٰفِرُونَ"],"78:18":["يَوۡمَ","يُنفَخُ","فِى","ٱلصُّورِ","فَتَأۡتُونَ","أَفۡوَاجًا"]}}