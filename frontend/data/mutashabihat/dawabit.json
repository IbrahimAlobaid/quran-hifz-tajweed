{"rules":[{"id":"alpha","name":"ترتيب الحروف الهجائية","explain":"إذا اختلف الموضعان في كلمة، فالكلمة التي حرفها أسبق في الترتيب الهجائي تكون في الموضع الأسبق.","examples":[{"a":"2:12","b":"2:13","dabit":"«يشعرون» ثم «يعلمون»: الشين قبل العين في الترتيب الهجائي، والآية ١٢ قبل ١٣."}]},{"id":"single","name":"الموضع المنفرد","explain":"إذا تكررت عبارة في مواضع كثيرة وخالفها موضع واحد، فاحفظ الموضع المخالف وحده، وكل ما سواه على الأصل.","examples":[{"a":"6:117","b":"68:7","dabit":"«أعلم مَن يضلّ» في الأنعام وحدها. وفي النحل والنجم والقلم: «أعلم بمن ضلّ»."},{"a":"16:125","b":"53:30","dabit":"وهذان على الأصل: «أعلم بمن ضلّ عن سبيله»، كالقلم. والمخالف هو الأنعام ١١٧ وحده."}]},{"id":"waw-fa","name":"الواو قبل الفاء","explain":"إذا كان الفرق واوًا في موضع وفاءً في آخر، فالغالب أن الواو في الموضع الأسبق من المصحف. وهو أغلبي لا مطّرد، فتحقّق من المصحف.","examples":[{"a":"28:60","b":"42:36","dabit":"«وما أوتيتم» في القصص، ثم «فما أوتيتم» في الشورى. القصص أسبق، والواو قبل الفاء."}]},{"id":"surah-name","name":"الربط باسم السورة","explain":"اربط حرفًا أو حركة في الكلمة المختلفة بحرف أو حركة في اسم سورتها.","examples":[{"a":"29:8","b":"46:15","dabit":"همزة «إحسانًا» مع همزة «الأحقاف». و«حُسنًا» في العنكبوت."},{"a":"37:47","b":"56:19","dabit":"فتحة الزاي في «يُنزَفون» مع فتحة الصاد في «الصَّافات»، وكسرة الزاي في «يُنزِفون» مع كسرة القاف في «الواقِعة»."}]},{"id":"later-adds","name":"الزيادة في الموضع المتأخر","explain":"إذا زاد أحد الموضعين كلمة أو جملة، فقد تكون الزيادة في الموضع المتأخر في المصحف. انظر أين وقعت الزيادة واربطها بموضعها.","examples":[{"a":"11:81","b":"15:65","dabit":"«واتّبع أدبارهم» زيادة في الحِجر، وهي بعد هود في المصحف."}]},{"id":"sentence","name":"جملة تجمع الموضعين","explain":"اصنع جملة قصيرة من كلمات الموضعين نفسها، تحفظ بها أيهما أولًا.","examples":[{"a":"5:15","b":"5:19","dabit":"«ما خفي كان أسبق»: «تُخفون» في الآية ١٥، ثم «على فترة من الرسل» في الآية ١٩."}]},{"id":"indef-first","name":"النكرة قبل المعرفة، والمذكر قبل المؤنث","explain":"إذا جاءت الكلمة نكرة في موضع ومعرفة في آخر، فالنكرة أولًا. وكذلك المذكّر قبل المؤنث.","examples":[{"a":"19:15","b":"19:33","dabit":"«وسلامٌ» نكرة في الآية ١٥ عن يحيى، ثم «والسلامُ» معرفة في الآية ٣٣ على لسان عيسى عليهما السلام."},{"a":"32:20","b":"34:42","dabit":"«الذي كنتم به» بالتذكير في السجدة، ثم «التي كنتم بها» بالتأنيث في سبأ بعدها."}]},{"id":"longer-surah","name":"الزيادة في السورة الأطول","explain":"قد تكون الكلمة الزائدة في السورة الأطول. وهذا ضابط للمثال نفسه، لا قاعدة لكل زيادة.","examples":[{"a":"2:136","b":"3:84","dabit":"«وما أوتي النبيون» بزيادة «وما أوتي» في البقرة، وهي أطول من آل عمران. وفيها أيضًا «إلينا» و«إلى إبراهيم»، وفي آل عمران «علينا» و«على إبراهيم»."},{"a":"2:35","b":"7:19","dabit":"«وكُلا منها رغدًا» بزيادة «منها رغدًا» في البقرة الأطول، و«فكُلا من حيث شئتما» في الأعراف."}]},{"id":"page-side","name":"موقع الآية في الصفحة","explain":"في مصحف المدينة: إذا كانت مواضع أحد اللفظين كلها في الصفحة اليمنى، ومواضع الآخر في اليسرى، فاحفظ الجهة مع اللفظ. ويصلح هذا لمن يحفظ من هذه الطبعة وحدها.","examples":[{"a":"20:15","b":"15:85","dabit":"«الساعة آتيةٌ» في طه ٢٠:١٥ والحج ٢٢:٧، وكلاهما في الصفحة اليمنى. و«الساعة لآتيةٌ» باللام في الحِجر ١٥:٨٥ وغافر ٤٠:٥٩، وكلاهما في اليسرى."},{"a":"22:7","b":"40:59","dabit":"«آتيةٌ» بلا لام في الحج على الصفحة اليمنى، و«لآتيةٌ» في غافر على اليسرى."}]},{"id":"agreement","name":"المجاورة والموافقة","explain":"اربط الكلمة المختلفة بكلمة تشبهها في الآية نفسها: حرف بمثله، أو معنى بما يناسبه.","examples":[{"a":"10:13","b":"10:74","dabit":"«وجاءتهم... وما كانوا» واو مع واو، و«فجاءوهم... فما كانوا» فاء مع فاء."},{"a":"40:28","b":"40:34","dabit":"«مسرفٌ كذّاب» مع «كاذبًا» في الآية ٢٨، و«مسرفٌ مرتاب» مع «في شكّ» في الآية ٣٤. ويضبط بالترتيب الهجائي أيضًا: الكاف قبل الميم."}]},{"id":"meaning","name":"فهم المعنى","explain":"كثير من الفروق له سبب في المعنى ذكره المفسرون. إذا فهمت لماذا اختلف اللفظ لم يعد يشتبه عليك.","examples":[{"a":"6:151","b":"17:31","dabit":"في الأنعام «من إملاق»: الفقر واقع بالآباء، فقدّم رزقهم «نرزقكم وإياهم». وفي الإسراء «خشية إملاق»: يخافون فقرًا يأتي مع الأولاد، فقدّم رزق الأولاد «نرزقهم وإياكم»."}]},{"id":"order","name":"التقديم والتأخير","explain":"قد تتفق الكلمات وتختلف في ترتيبها. ضع الموضعين أمامك، وحدّد ما تقدّم في كل منهما، ثم اجعل لنفسك علامة.","examples":[{"a":"2:58","b":"7:161","dabit":"في البقرة «ادخلوا... فكلوا... رغدًا، وادخلوا الباب سجدًا وقولوا حطّة» والسجود أولًا. وفي الأعراف «اسكنوا... وكلوا... وقولوا حطّة وادخلوا الباب سجدًا» والقول أولًا، بلا «رغدًا»."}]}],"text":{"2:12":["أَلَآ","إِنَّهُمۡ","هُمُ","ٱلۡمُفۡسِدُونَ","وَلَـٰكِن","لَّا","يَشۡعُرُونَ"],"2:13":["وَإِذَا","قِيلَ","لَهُمۡ","ءَامِنُواۡ","كَمَآ","ءَامَنَ","ٱلنَّاسُ","قَالُوٓاۡ","أَنُؤۡمِنُ","كَمَآ","ءَامَنَ","ٱلسُّفَهَآءُ‌ۗ","أَلَآ","إِنَّهُمۡ","هُمُ","ٱلسُّفَهَآءُ","وَلَـٰكِن","لَّا","يَعۡلَمُونَ"],"2:35":["وَقُلۡنَا","يَـٰٓـــَٔادَمُ","ٱسۡكُنۡ","أَنتَ","وَزَوۡجُكَ","ٱلۡجَنَّةَ","وَكُلَا","مِنۡهَا","رَغَدًا","حَيۡثُ","شِئۡتُمَا","وَلَا","تَقۡرَبَا","هَـٰذِهِ","ٱلشَّجَرَةَ","فَتَكُونَا","مِنَ","ٱلظَّـٰلِمِينَ"],"2:58":["وَإِذۡ","قُلۡنَا","ٱدۡخُلُواۡ","هَـٰذِهِ","ٱلۡقَرۡيَةَ","فَكُلُواۡ","مِنۡهَا","حَيۡثُ","شِئۡتُمۡ","رَغَدًا","وَٱدۡخُلُواۡ","ٱلۡبَابَ","سُجَّدًا","وَقُولُواۡ","حِطَّةٌ","نَّغۡفِرۡ","لَكُمۡ","خَطَـٰيَـٰكُمۡ‌ۚ","وَسَنَزِيدُ","ٱلۡمُحۡسِنِينَ"],"2:136":["قُولُوٓاۡ","ءَامَنَّا","بِٱللَّهِ","وَمَآ","أُنزِلَ","إِلَيۡنَا","وَمَآ","أُنزِلَ","إِلَىٰٓ","إِبۡرٰهِــۧمَ","وَإِسۡمَـٰعِيلَ","وَإِسۡحَـٰقَ","وَيَعۡقُوبَ","وَٱلۡأَسۡبَاطِ","وَمَآ","أُوتِىَ","مُوسَىٰ","وَعِيسَىٰ","وَمَآ","أُوتِىَ","ٱلنَّبِيُّونَ","مِن","رَّبِّهِمۡ","لَا","نُفَرِّقُ","بَيۡنَ","أَحَدٍ","مِّنۡهُمۡ","وَنَحۡنُ","لَهُۥ","مُسۡلِمُونَ"],"3:84":["قُلۡ","ءَامَنَّا","بِٱللَّهِ","وَمَآ","أُنزِلَ","عَلَيۡنَا","وَمَآ","أُنزِلَ","عَلَىٰٓ","إِبۡرٰهِيمَ","وَإِسۡمَـٰعِيلَ","وَإِسۡحَـٰقَ","وَيَعۡقُوبَ","وَٱلۡأَسۡبَاطِ","وَمَآ","أُوتِىَ","مُوسَىٰ","وَعِيسَىٰ","وَٱلنَّبِيُّونَ","مِن","رَّبِّهِمۡ","لَا","نُفَرِّقُ","بَيۡنَ","أَحَدٍ","مِّنۡهُمۡ","وَنَحۡنُ","لَهُۥ","مُسۡلِمُونَ"],"5:15":["يَـٰٓأَهۡلَ","ٱلۡكِتَـٰبِ","قَدۡ","جَآءَكُمۡ","رَسُولُنَا","يُبَيِّنُ","لَكُمۡ","كَثِيرًا","مِّمَّا","كُنتُمۡ","تُخۡفُونَ","مِنَ","ٱلۡكِتَـٰبِ","وَيَعۡفُواۡ","عَن","كَثِيرٍ‌ۚ","قَدۡ","جَآءَكُم","مِّنَ","ٱللَّهِ","نُورٌ","وَكِتَـٰبٌ","مُّبِينٌ"],"5:19":["يَـٰٓأَهۡلَ","ٱلۡكِتَـٰبِ","قَدۡ","جَآءَكُمۡ","رَسُولُنَا","يُبَيِّنُ","لَكُمۡ","عَلَىٰ","فَتۡرَةٍ","مِّنَ","ٱلرُّسُلِ","أَن","تَقُولُواۡ","مَا","جَآءَنَا","مِنۢ","بَشِيرٍ","وَلَا","نَذِيرٍ‌ۖ","فَقَدۡ","جَآءَكُم","بَشِيرٌ","وَنَذِيرٌ‌ۗ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَىۡءٍ","قَدِيرٌ"],"6:117":["إِنَّ","رَبَّكَ","هُوَ","أَعۡلَمُ","مَن","يَضِلُّ","عَن","سَبِيلِهِۦ‌ۖ","وَهُوَ","أَعۡلَمُ","بِٱلۡمُهۡتَدِينَ"],"6:151":["۞قُلۡ","تَعَالَوۡاۡ","أَتۡلُ","مَا","حَرَّمَ","رَبُّكُمۡ","عَلَيۡكُمۡ‌ۖ","أَلَّا","تُشۡرِكُواۡ","بِهِۦ","شَيۡــًٔا‌ۖ","وَبِٱلۡوٰلِدَيۡنِ","إِحۡسَـٰنًا‌ۖ","وَلَا","تَقۡتُلُوٓاۡ","أَوۡلَـٰدَكُم","مِّنۡ","إِمۡلَـٰقٍ‌ۖ","نَّحۡنُ","نَرۡزُقُكُمۡ","وَإِيَّاهُمۡ‌ۖ","وَلَا","تَقۡرَبُواۡ","ٱلۡفَوٰحِشَ","مَا","ظَهَرَ","مِنۡهَا","وَمَا","بَطَنَ‌ۖ","وَلَا","تَقۡتُلُواۡ","ٱلنَّفۡسَ","ٱلَّتِى","حَرَّمَ","ٱللَّهُ","إِلَّا","بِٱلۡحَقِّ‌ۚ","ذٰلِكُمۡ","وَصَّـٰكُم","بِهِۦ","لَعَلَّكُمۡ","تَعۡقِلُونَ"],"7:19":["وَيَـٰٓــَٔـادَمُ","ٱسۡكُنۡ","أَنتَ","وَزَوۡجُكَ","ٱلۡجَنَّةَ","فَكُلَا","مِنۡ","حَيۡثُ","شِئۡتُمَا","وَلَا","تَقۡرَبَا","هَـٰذِهِ","ٱلشَّجَرَةَ","فَتَكُونَا","مِنَ","ٱلظَّـٰلِمِينَ"],"7:161":["وَإِذۡ","قِيلَ","لَهُمُ","ٱسۡكُنُواۡ","هَـٰذِهِ","ٱلۡقَرۡيَةَ","وَكُلُواۡ","مِنۡهَا","حَيۡثُ","شِئۡتُمۡ","وَقُولُواۡ","حِطَّةٌ","وَٱدۡخُلُواۡ","ٱلۡبَابَ","سُجَّدًا","نَّغۡفِرۡ","لَكُمۡ","خَطِيٓـَٔـٰتِكُمۡ‌ۚ","سَنَزِيدُ","ٱلۡمُحۡسِنِينَ"],"10:13":["وَلَقَدۡ","أَهۡلَكۡنَا","ٱلۡقُرُونَ","مِن","قَبۡلِكُمۡ","لَمَّا","ظَلَمُواۡ‌ۙ","وَجَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَـٰتِ","وَمَا","كَانُواۡ","لِيُؤۡمِنُواۡ‌ۚ","كَذٰلِكَ","نَجۡزِى","ٱلۡقَوۡمَ","ٱلۡمُجۡرِمِينَ"],"10:74":["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِۦ","رُسُلاً","إِلَىٰ","قَوۡمِهِمۡ","فَجَآءُوهُم","بِٱلۡبَيِّنَـٰتِ","فَمَا","كَانُواۡ","لِيُؤۡمِنُواۡ","بِمَا","كَذَّبُواۡ","بِهِۦ","مِن","قَبۡلُ‌ۚ","كَذٰلِكَ","نَطۡبَعُ","عَلَىٰ","ق