بَرٍ","أَوۡ","جَذۡوَةٍ","مِّنَ","ٱلنَّارِ","لَعَلَّكُمۡ","تَصۡطَلُونَ"],"28:30":["فَلَمَّآ","أَتَـٰهَا","نُودِىَ","مِن","شَـٰطِىِٕ","ٱلۡوَادِ","ٱلۡأَيۡمَنِ","فِى","ٱلۡبُقۡعَةِ","ٱلۡمُبَـٰرَكَةِ","مِنَ","ٱلشَّجَرَةِ","أَن","يَـٰمُوسَىٰٓ","إِنِّىٓ","أَنَا","ٱللَّهُ","رَبُّ","ٱلۡعَـٰلَمِينَ"],"28:31":["وَأَنۡ","أَلۡقِ","عَصَاكَ‌ۖ","فَلَمَّا","رَءَاهَا","تَهۡتَزُّ","كَأَنَّهَا","جَآنٌّ","وَلَّىٰ","مُدۡبِرًا","وَلَمۡ","يُعَقِّبۡ‌ۚ","يَـٰمُوسَىٰٓ","أَقۡبِلۡ","وَلَا","تَخَفۡ‌ۖ","إِنَّكَ","مِنَ","ٱلۡأَمِنِينَ"],"28:32":["ٱسۡلُكۡ","يَدَكَ","فِى","جَيۡبِكَ","تَخۡرُجۡ","بَيۡضَآءَ","مِنۡ","غَيۡرِ","سُوٓءٍ","وَٱضۡمُمۡ","إِلَيۡكَ","جَنَاحَكَ","مِنَ","ٱلرَّهۡبِ‌ۖ","فَذٰنِكَ","بُرۡهَـٰنَانِ","مِن","رَّبِّكَ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦٓ‌ۚ","إِنَّهُمۡ","كَانُواۡ","قَوۡمًا","فَـٰسِقِينَ"],"28:36":["فَلَمَّا","جَآءَهُم","مُّوسَىٰ","بِـَٔـايَـٰتِنَا","بَيِّنَـٰتٍ","قَالُواۡ","مَا","هَـٰذَآ","إِلَّا","سِحۡرٌ","مُّفۡتَرًى","وَمَا","سَمِعۡنَا","بِهَـٰذَا","فِىٓ","ءَابَآئِنَا","ٱلۡأَوَّلِينَ"],"28:37":["وَقَالَ","مُوسَىٰ","رَبِّىٓ","أَعۡلَمُ","بِمَن","جَآءَ","بِٱلۡهُدَىٰ","مِنۡ","عِندِهِۦ","وَمَن","تَكُونُ","لَهُۥ","عَـٰقِبَةُ","ٱلدَّارِ‌ۖ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلظَّـٰلِمُونَ"],"28:38":["وَقَالَ","فِرۡعَوۡنُ","يَـٰٓأَيُّهَا","ٱلۡمَلَأُ","مَا","عَلِمۡتُ","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرِى","فَأَوۡقِدۡ","لِى","يَـٰهَـٰمَـٰنُ","عَلَى","ٱلطِّينِ","فَٱجۡعَل","لِّى","صَرۡحًا","لَّعَلِّىٓ","أَطَّلِعُ","إِلَىٰٓ","إِلَـٰهِ","مُوسَىٰ","وَإِنِّى","لَأَظُنُّهُۥ","مِنَ","ٱلۡكَـٰذِبِينَ"],"28:40":["فَأَخَذۡنَـٰهُ","وَجُنُودَهُۥ","فَنَبَذۡنَـٰهُمۡ","فِى","ٱلۡيَمِّ‌ۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلظَّـٰلِمِينَ"],"28:41":["وَجَعَلۡنَـٰهُمۡ","أَئِمَّةً","يَدۡعُونَ","إِلَى","ٱلنَّارِ‌ۖ","وَيَوۡمَ","ٱلۡقِيَـٰمَةِ","لَا","يُنصَرُونَ"],"28:44":["وَمَا","كُنتَ","بِجَانِبِ","ٱلۡغَرۡبِىِّ","إِذۡ","قَضَيۡنَآ","إِلَىٰ","مُوسَى","ٱلۡأَمۡرَ","وَمَا","كُنتَ","مِنَ","ٱلشَّـٰهِدِينَ"],"28:46":["وَمَا","كُنتَ","بِجَانِبِ","ٱلطُّورِ","إِذۡ","نَادَيۡنَا","وَلَـٰكِن","رَّحۡمَةً","مِّن","رَّبِّكَ","لِتُنذِرَ","قَوۡمًا","مَّآ","أَتَـٰهُم","مِّن","نَّذِيرٍ","مِّن","قَبۡلِكَ","لَعَلَّهُمۡ","يَتَذَكَّرُونَ"],"28:47":["وَلَوۡلَآ","أَن","تُصِيبَهُم","مُّصِيبَةُۢ","بِمَا","قَدَّمَتۡ","أَيۡدِيهِمۡ","فَيَقُولُواۡ","رَبَّنَا","لَوۡلَآ","أَرۡسَلۡتَ","إِلَيۡنَا","رَسُولاً","فَنَتَّبِعَ","ءَايَـٰتِكَ","وَنَكُونَ","مِنَ","ٱلۡمُؤۡمِنِينَ"],"28:48":["فَلَمَّا","جَآءَهُمُ","ٱلۡحَقُّ","مِنۡ","عِندِنَا","قَالُواۡ","لَوۡلَآ","أُوتِىَ","مِثۡلَ","مَآ","أُوتِىَ","مُوسَىٰٓ‌ۚ","أَوَلَمۡ","يَكۡفُرُواۡ","بِمَآ","أُوتِىَ","مُوسَىٰ","مِن","قَبۡلُ‌ۖ","قَالُواۡ","سِحۡرَانِ","تَظَـٰهَرَا","وَقَالُوٓاۡ","إِنَّا","بِكُلٍّ","كَـٰفِرُونَ"],"28:50":["فَإِن","لَّمۡ","يَسۡتَجِيبُواۡ","لَكَ","فَٱعۡلَمۡ","أَنَّمَا","يَتَّبِعُونَ","أَهۡوَآءَهُمۡ‌ۚ","وَمَنۡ","أَضَلُّ","مِمَّنِ","ٱتَّبَعَ","هَوَٮٰهُ","بِغَيۡرِ","هُدًى","مِّنَ","ٱللَّهِ‌ۚ","إِنَّ","ٱللَّهَ","لَا","يَهۡدِى","ٱلۡقَوۡمَ","ٱلظَّـٰلِمِينَ"],"28:59":["وَمَا","كَانَ","رَبُّكَ","مُهۡلِكَ","ٱلۡقُرَىٰ","حَتَّىٰ","يَبۡعَثَ","فِىٓ","أُمِّهَا","رَسُولاً","يَتۡلُواۡ","عَلَيۡهِمۡ","ءَايَـٰتِنَا‌ۚ","وَمَا","كُنَّا","مُهۡلِكِى","ٱلۡقُرَىٰٓ","إِلَّا","وَأَهۡلُهَا","ظَـٰلِمُونَ"],"28:60":["وَمَآ","أُوتِيتُم","مِّن","شَىۡءٍ","فَمَتَـٰعُ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَزِينَتُهَا‌ۚ","وَمَا","عِندَ","ٱللَّهِ","خَيۡرٌ","وَأَبۡقَىٰٓ‌ۚ","أَفَلَا","تَعۡقِلُونَ"],"28:64":["وَقِيلَ","ٱدۡعُواۡ","شُرَكَآءَكُمۡ","فَدَعَوۡهُمۡ","فَلَمۡ","يَسۡتَجِيبُواۡ","لَهُمۡ","وَرَأَوُاۡ","ٱلۡعَذَابَ‌ۚ","لَوۡ","أَنَّهُمۡ","كَانُواۡ","يَهۡتَدُونَ"],"28:67":["فَأَمَّا","مَن","تَابَ","وَءَامَنَ","وَعَمِلَ","صَـٰلِحًا","فَعَسَىٰٓ","أَن","يَكُونَ","مِنَ","ٱلۡمُفۡلِحِينَ"],"28:80":["وَقَالَ","ٱلَّذِينَ","أُوتُواۡ","ٱلۡعِلۡمَ","وَيۡلَكُمۡ","ثَوَابُ","ٱللَّهِ","خَيۡرٌ","لِّمَنۡ","ءَامَنَ","وَعَمِلَ","صَـٰلِحًا","وَلَا","يُلَقَّـٰهَآ","إِلَّا","ٱلصَّـٰبِرُونَ"],"28:81":["فَخَسَفۡنَا","بِهِۦ","وَبِدَارِهِ","ٱلۡأَرۡضَ","فَمَا","كَانَ","لَهُۥ","مِن","فِئَةٍ","يَنصُرُونَهُۥ","مِن","دُونِ","ٱللَّهِ","وَمَا","كَانَ","مِنَ","ٱلۡمُنتَصِرِينَ"],"28:82":["وَأَصۡبَحَ","ٱلَّذِينَ","تَمَنَّوۡاۡ","مَكَانَهُۥ","بِٱلۡأَمۡسِ","يَقُولُونَ","وَيۡكَأَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ‌ۖ","لَوۡلَآ","أَن","مَّنَّ","ٱللَّهُ","عَلَيۡنَا","لَخَسَفَ","بِنَا‌ۖ","وَيۡكَأَنَّهُۥ","لَا","يُفۡلِحُ","ٱلۡكَـٰفِرُونَ"],"28:84":["مَن","جَآءَ","بِٱلۡحَسَنَةِ","فَلَهُۥ","خَيۡرٌ","مِّنۡهَا‌ۖ","وَمَن","جَآءَ","بِٱلسَّيِّئَةِ","فَلَا","يُجۡزَى","ٱلَّذِينَ","عَمِلُواۡ","ٱلسَّيِّـَٔـاتِ","إِلَّا","مَا","كَانُواۡ","يَعۡمَلُونَ"],"28:85":["إِنَّ","ٱلَّذِى","فَرَضَ","عَلَيۡكَ","ٱلۡقُرۡءَانَ","لَرَآدُّكَ","إِلَىٰ","مَعَادٍ‌ۚ","قُل","رَّبِّىٓ","أَعۡلَمُ","مَن","جَآءَ","بِٱلۡهُدَىٰ","وَمَنۡ","هُوَ","فِى","ضَلَـٰلٍ","مُّبِينٍ"],"28:87":["وَلَا","يَصُدُّنَّكَ","عَنۡ","ءَايَـٰتِ","ٱللَّهِ","بَعۡدَ","إِذۡ","أُنزِلَتۡ","إِلَيۡكَ‌ۖ","وَٱدۡعُ","إِلَىٰ","رَبِّكَ‌ۖ","وَلَا","تَكُونَنَّ","مِنَ","ٱلۡمُشۡرِكِينَ"],"29:62":["ٱللَّهُ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ","لَهُۥٓ‌ۚ","إِنَّ","ٱللَّهَ","بِكُلِّ","شَىۡءٍ","عَلِيمٌ"],"30:37":["أَوَلَمۡ","يَرَوۡاۡ","أَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"30:56":["وَقَالَ","ٱلَّذِينَ","أُوتُواۡ","ٱلۡعِلۡمَ","وَٱلۡإِيمَـٰنَ","لَقَدۡ","لَبِثۡتُمۡ","فِى","كِتَـٰبِ","ٱللَّهِ","إِلَىٰ","يَوۡمِ","ٱلۡبَعۡثِ‌ۖ","فَهَـٰذَا","يَوۡمُ","ٱلۡبَعۡثِ","وَلَـٰكِنَّكُمۡ","كُنتُمۡ","لَا","تَعۡلَمُونَ"],"32:3":["أَمۡ","يَقُولُونَ","ٱفۡتَرَ>ٮٰهُ‌ۚ","بَلۡ","هُوَ","ٱلۡحَقُّ","مِن","رَّبِّكَ","لِتُنذِرَ","قَوۡمًا","مَّآ","أَتَـٰهُم","مِّن","نَّذِيرٍ","مِّن","قَبۡلِكَ","لَعَلَّهُمۡ","يَهۡتَدُونَ"],"32:24":["وَجَعَلۡنَا","مِنۡهُمۡ","أَئِمَّةً","يَهۡدُونَ","بِأَمۡرِنَا","لَمَّا","صَبَرُواۡ‌ۖ","وَكَانُواۡ","بِـَٔـايَـٰتِنَا","يُوقِنُونَ"],"34:36":["قُلۡ","إِنَّ","رَبِّى","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"34:39":["قُلۡ","إِنَّ","رَبِّى","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ","لَهُۥۚ","وَمَآ","أَنفَقۡتُم","مِّن","شَىۡءٍ","فَهُوَ","يُخۡلِفُهُۖۥ","وَهُوَ","خَيۡرُ","ٱلرّٰزِقِينَ"],"34:43":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","قَالُواۡ","مَا","هَـٰذَآ","إِلَّا","رَجُلٌ","يُرِيدُ","أَن","يَصُدَّكُمۡ","عَمَّا","كَانَ","يَعۡبُدُ","ءَابَآؤُكُمۡ","وَقَالُواۡ","مَا","هَـٰذَآ","إِلَّآ","إِفۡكٌ","مُّفۡتَرًىۚ","وَقَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلۡحَقِّ","لَمَّا","جَآءَهُمۡ","إِنۡ","هَـٰذَآ","إِلَّا","سِحۡرٌ","مُّبِينٌ"],"36:20":["وَجَآءَ","مِنۡ","أَقۡصَا","ٱلۡمَدِينَةِ","رَجُلٌ","يَسۡعَىٰ","قَالَ","يَـٰقَوۡمِ","ٱتَّبِعُواۡ","ٱلۡمُرۡسَلِينَ"],"37:102":["فَلَمَّا","بَلَغَ","مَعَهُ","ٱلسَّعۡىَ","قَالَ","يَـٰبُنَىَّ","إِنِّىٓ","أَرَىٰ","فِى","ٱلۡمَنَامِ","أَنِّىٓ","أَذۡبَحُكَ","فَٱنظُرۡ","مَاذَا","تَرَىٰ‌ۚ","قَالَ","يَـٰٓأَبَتِ","ٱفۡعَلۡ","مَا","تُؤۡمَرُ‌ۖ","سَتَجِدُنِىٓ","إِن","شَآءَ","ٱللَّهُ","مِنَ","ٱلصَّـٰبِرِينَ"],"37:103":["فَلَمَّآ","أَسۡلَمَا","وَتَلَّهُۥ","لِلۡجَبِينِ"],"39:52":["أَوَلَمۡ","يَعۡلَمُوٓاۡ","أَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"40:25":["فَلَمَّا","جَآءَهُم","بِٱلۡحَقِّ","مِنۡ","عِندِنَا","قَالُواۡ","ٱقۡتُلُوٓاۡ","أَبۡنَآءَ","ٱلَّذِينَ","ءَامَنُواۡ","مَعَهُۥ","وَٱسۡتَحۡيُواۡ","نِسَآءَهُمۡۚ","وَمَا","كَيۡدُ","ٱلۡكَـٰفِرِينَ","إِلَّا","فِى","ضَلَـٰلٍ"],"40:37":["أَسۡبَـٰبَ","ٱلسَّمَـٰوٰتِ","فَأَطَّلِعَ","إِلَىٰٓ","إِلَـٰهِ","مُوسَىٰ","وَإِنِّى","لَأَظُنُّهُۥ","كَـٰذِبًاۚ","وَكَذٰلِكَ","زُيِّنَ","لِفِرۡعَوۡنَ","سُوٓءُ","عَمَلِهِۦ","وَصُدَّ","عَنِ","ٱلسَّبِيلِۚ","وَمَا","كَيۡدُ","فِرۡعَوۡنَ","إِلَّا","فِى","تَبَابٍ"],"41:14":["إِذۡ","جَآءَتۡهُمُ","ٱلرُّسُلُ","مِنۢ","بَيۡنِ","أَيۡدِيهِمۡ","وَمِنۡ","خَلۡفِهِمۡ","أَلَّا","تَعۡبُدُوٓاۡ","إِلَّا","ٱللَّهَ‌ۖ","قَالُواۡ","لَوۡ","شَآءَ","رَبُّنَا","لَأَنزَلَ","مَلَـٰٓئِكَةً","فَإِنَّا","بِمَآ","أُرۡسِلۡتُم","بِهِۦ","كَـٰفِرُونَ"],"42:12":["لَهُۥ","مَقَالِيدُ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ‌ۖ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّهُۥ","بِكُلِّ","شَىۡءٍ","عَلِيمٌ"],"42:36":["فَمَآ","أُوتِيتُم","مِّن","شَىۡءٍ","فَمَتَـٰعُ","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا‌ۖ","وَمَا","عِندَ","ٱللَّهِ","خَيۡرٌ","وَأَبۡقَىٰ","لِلَّذِينَ","ءَامَنُواۡ","وَعَلَىٰ","رَبِّهِمۡ","يَتَوَكَّلُونَ"],"51:40":["فَأَخَذۡنَـٰهُ","وَجُنُودَهُۥ","فَنَبَذۡنَـٰهُمۡ","فِى","ٱلۡيَمِّ","وَهُوَ","مُلِيمٌ"]}}