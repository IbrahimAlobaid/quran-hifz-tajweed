,"ٱلَّذِى","تَسۡتَعۡجِلُونَ"],"28:36":["فَلَمَّا","جَآءَهُم","مُّوسَىٰ","بِـَٔـايَـٰتِنَا","بَيِّنَـٰتٍ","قَالُواۡ","مَا","هَـٰذَآ","إِلَّا","سِحۡرٌ","مُّفۡتَرًى","وَمَا","سَمِعۡنَا","بِهَـٰذَا","فِىٓ","ءَابَآئِنَا","ٱلۡأَوَّلِينَ"],"28:82":["وَأَصۡبَحَ","ٱلَّذِينَ","تَمَنَّوۡاۡ","مَكَانَهُۥ","بِٱلۡأَمۡسِ","يَقُولُونَ","وَيۡكَأَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ‌ۖ","لَوۡلَآ","أَن","مَّنَّ","ٱللَّهُ","عَلَيۡنَا","لَخَسَفَ","بِنَا‌ۖ","وَيۡكَأَنَّهُۥ","لَا","يُفۡلِحُ","ٱلۡكَـٰفِرُونَ"],"29:62":["ٱللَّهُ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ","لَهُۥٓ‌ۚ","إِنَّ","ٱللَّهَ","بِكُلِّ","شَىۡءٍ","عَلِيمٌ"],"30:37":["أَوَلَمۡ","يَرَوۡاۡ","أَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"31:7":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِ","ءَايَـٰتُنَا","وَلَّىٰ","مُسۡتَكۡبِرًا","كَأَن","لَّمۡ","يَسۡمَعۡهَا","كَأَنَّ","فِىٓ","أُذُنَيۡهِ","وَقۡرًا‌ۖ","فَبَشِّرۡهُ","بِعَذَابٍ","أَلِيمٍ"],"32:20":["وَأَمَّا","ٱلَّذِينَ","فَسَقُواۡ","فَمَأۡوَٮٰهُمُ","ٱلنَّارُ‌ۖ","كُلَّمَآ","أَرَادُوٓاۡ","أَن","يَخۡرُجُواۡ","مِنۡهَآ","أُعِيدُواۡ","فِيهَا","وَقِيلَ","لَهُمۡ","ذُوقُواۡ","عَذَابَ","ٱلنَّارِ","ٱلَّذِى","كُنتُم","بِهِۦ","تُكَذِّبُونَ"],"32:28":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡفَتۡحُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"32:29":["قُلۡ","يَوۡمَ","ٱلۡفَتۡحِ","لَا","يَنفَعُ","ٱلَّذِينَ","كَفَرُوٓاۡ","إِيمَـٰنُهُمۡ","وَلَا","هُمۡ","يُنظَرُونَ"],"34:2":["يَعۡلَمُ","مَا","يَلِجُ","فِى","ٱلۡأَرۡضِ","وَمَا","يَخۡرُجُ","مِنۡهَا","وَمَا","يَنزِلُ","مِنَ","ٱلسَّمَآءِ","وَمَا","يَعۡرُجُ","فِيهَاۚ","وَهُوَ","ٱلرَّحِيمُ","ٱلۡغَفُورُ"],"34:3":["وَقَالَ","ٱلَّذِينَ","كَفَرُواۡ","لَا","تَأۡتِينَا","ٱلسَّاعَةُۖ","قُلۡ","بَلَىٰ","وَرَبِّى","لَتَأۡتِيَنَّكُمۡ","عَـٰلِمِ","ٱلۡغَيۡبِۖ","لَا","يَعۡزُبُ","عَنۡهُ","مِثۡقَالُ","ذَرَّةٍ","فِى","ٱلسَّمَـٰوٰتِ","وَلَا","فِى","ٱلۡأَرۡضِ","وَلَآ","أَصۡغَرُ","مِن","ذٰلِكَ","وَلَآ","أَكۡبَرُ","إِل