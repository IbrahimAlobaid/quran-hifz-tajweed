ُواۡ","بَلۡ","مَكۡرُ","ٱلَّيۡلِ","وَٱلنَّهَارِ","إِذۡ","تَأۡمُرُونَنَآ","أَن","نَّكۡفُرَ","بِٱللَّهِ","وَنَجۡعَلَ","لَهُۥٓ","أَندَادًاۚ","وَأَسَرُّواۡ","ٱلنَّدَامَةَ","لَمَّا","رَأَوُاۡ","ٱلۡعَذَابَ","وَجَعَلۡنَا","ٱلۡأَغۡلَـٰلَ","فِىٓ","أَعۡنَاقِ","ٱلَّذِينَ","كَفَرُواۡۚ","هَلۡ","يُجۡزَوۡنَ","إِلَّا","مَا","كَانُواۡ","يَعۡمَلُونَ"],"34:34":["وَمَآ","أَرۡسَلۡنَا","فِى","قَرۡيَةٍ","مِّن","نَّذِيرٍ","إِلَّا","قَالَ","مُتۡرَفُوهَآ","إِنَّا","بِمَآ","أُرۡسِلۡتُم","بِهِۦ","كَـٰفِرُونَ"],"34:36":["قُلۡ","إِنَّ","رَبِّى","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"34:38":["وَٱلَّذِينَ","يَسۡعَوۡنَ","فِىٓ","ءَايَـٰتِنَا","مُعَـٰجِزِينَ","أُوۡلَـٰٓئِكَ","فِى","ٱلۡعَذَابِ","مُحۡضَرُونَ"],"34:39":["قُلۡ","إِنَّ","رَبِّى","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","مِنۡ","عِبَادِهِۦ","وَيَقۡدِرُ","لَهُۥۚ","وَمَآ","أَنفَقۡتُم","مِّن","شَىۡءٍ","فَهُوَ","يُخۡلِفُهُۖۥ","وَهُوَ","خَيۡرُ","ٱلرّٰزِقِينَ"],"34:42":["فَٱلۡيَوۡمَ","لَا","يَمۡلِكُ","بَعۡضُكُمۡ","لِبَعۡضٍ","نَّفۡعًا","وَلَا","ضَرًّا","وَنَقُولُ","لِلَّذِينَ","ظَلَمُواۡ","ذُوقُواۡ","عَذَابَ","ٱلنَّارِ","ٱلَّتِى","كُنتُم","بِهَا","تُكَذِّبُونَ"],"34:43":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","قَالُواۡ","مَا","هَـٰذَآ","إِلَّا","رَجُلٌ","يُرِيدُ","أَن","يَصُدَّكُمۡ","عَمَّا","كَانَ","يَعۡبُدُ","ءَابَآؤُكُمۡ","وَقَالُواۡ","مَا","هَـٰذَآ","إِلَّآ","إِفۡكٌ","مُّفۡتَرًىۚ","وَقَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلۡحَقِّ","لَمَّا","جَآءَهُمۡ","إِنۡ","هَـٰذَآ","إِلَّا","سِحۡرٌ","مُّبِينٌ"],"34:45":["وَكَذَّبَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","وَمَا","بَلَغُواۡ","مِعۡشَارَ","مَآ","ءَاتَيۡنَـٰهُمۡ","فَكَذَّبُواۡ","رُسُلِىۖ","فَكَيۡفَ","كَانَ","نَكِيرِ"],"36:48":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"36:49":["مَا","يَنظُرُونَ","إِلَّا","صَيۡحَةً","وٰحِدَةً","تَأۡخُذُهُمۡ","وَهُمۡ","يَخِصِّمُونَ"],"37:30":["وَمَا","كَانَ","لَنَا","عَلَيۡكُم","مِّن","سُلۡطَـٰنِۭ‌ۖ","بَلۡ","كُنتُمۡ","قَوۡمًا","طَـٰغِينَ"],"39:25":["كَذَّبَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","فَأَتَـٰهُمُ","ٱلۡعَذَابُ","مِنۡ","حَيۡثُ","لَا","يَشۡعُرُونَ"],"39:52":["أَوَلَمۡ","يَعۡلَمُوٓاۡ","أَنَّ","ٱللَّهَ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"42:12":["لَهُۥ","مَقَالِيدُ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ‌ۖ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُ‌ۚ","إِنَّهُۥ","بِكُلِّ","شَىۡءٍ","عَلِيمٌ"],"43:23":["وَكَذٰلِكَ","مَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","فِى","قَرۡيَةٍ","مِّن","نَّذِيرٍ","إِلَّا","قَالَ","مُتۡرَفُوهَآ","إِنَّا","وَجَدۡنَآ","ءَابَآءَنَا","عَلَىٰٓ","أُمَّةٍ","وَإِنَّا","عَلَىٰٓ","ءَاثَـٰرِهِم","مُّقۡتَدُونَ"],"43:24":["۞قَـٰلَ","أَوَلَوۡ","جِئۡتُكُم","بِأَهۡدَىٰ","مِمَّا","وَجَدتُّمۡ","عَلَيۡهِ","ءَابَآءَكُمۡ‌ۖ","قَالُوٓاۡ","إِنَّا","بِمَآ","أُرۡسِلۡتُم","بِهِۦ","كَـٰفِرُونَ"],"45:25":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","مَّا","كَانَ","حُجَّتَهُمۡ","إِلَّآ","أَن","قَالُواۡ","ٱئۡتُواۡ","بِـَٔـابَآئِنَآ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"46:7":["وَإِذَا","تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَـٰتُنَا","بَيِّنَـٰتٍ","قَالَ","ٱلَّذِينَ","كَفَرُواۡ","لِلۡحَقِّ","لَمَّا","جَآءَهُمۡ","هَـٰذَا","سِحۡرٌ","مُّبِينٌ"],"57:4":["هُوَ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۚ","يَعۡلَمُ","مَا","يَلِجُ","فِى","ٱلۡأَرۡضِ","وَمَا","يَخۡرُجُ","مِنۡهَا","وَمَا","يَنزِلُ","مِنَ","ٱلسَّمَآءِ","وَمَا","يَعۡرُجُ","فِيهَا‌ۖ","وَهُوَ","مَعَكُمۡ","أَيۡنَ","مَا","كُنتُمۡ‌ۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"67:25":["وَيَقُولُونَ","مَتَىٰ","هَـٰذَا","ٱلۡوَعۡدُ","إِن","كُنتُمۡ","صَـٰدِقِينَ"],"67:26":["قُلۡ","إِنَّمَا","ٱلۡعِلۡمُ","عِندَ","ٱللَّهِ","وَإِنَّمَآ","أَنَاۡ","نَذِيرٌ","مُّبِينٌ"]}}