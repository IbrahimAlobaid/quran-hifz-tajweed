ِن","وَلِىٍّ","وَلَا","شَفِيعٍ‌ۚ","أَفَلَا","تَتَذَكَّرُونَ"],"34:30":["قُل","لَّكُم","مِّيعَادُ","يَوۡمٍ","لَّا","تَسۡتَــٔۡخِرُونَ","عَنۡهُ","سَاعَةً","وَلَا","تَسۡتَقۡدِمُونَ"],"34:31":["وَقَالَ","ٱلَّذِينَ","كَفَرُواۡ","لَن","نُّؤۡمِنَ","بِهَـٰذَا","ٱلۡقُرۡءَانِ","وَلَا","بِٱلَّذِى","بَيۡنَ","يَدَيۡهِۗ","وَلَوۡ","تَرَىٰٓ","إِذِ","ٱلظَّـٰلِمُونَ","مَوۡقُوفُونَ","عِندَ","رَبِّهِمۡ","يَرۡجِعُ","بَعۡضُهُمۡ","إِلَىٰ","بَعۡضٍ","ٱلۡقَوۡلَ","يَقُولُ","ٱلَّذِينَ","ٱسۡتُضۡعِفُواۡ","لِلَّذِينَ","ٱسۡتَكۡبَرُواۡ","لَوۡلَآ","أَنتُمۡ","لَكُنَّا","مُؤۡمِنِينَ"],"34:42":["فَٱلۡيَوۡمَ","لَا","يَمۡلِكُ","بَعۡضُكُمۡ","لِبَعۡضٍ","نَّفۡعًا","وَلَا","ضَرًّا","وَنَقُولُ","لِلَّذِينَ","ظَلَمُواۡ","ذُوقُواۡ","عَذَابَ","ٱلنَّارِ","ٱلَّتِى","كُنتُم","بِهَا","تُكَذِّبُونَ"],"38:61":["قَالُواۡ","رَبَّنَا","مَن","قَدَّمَ","لَنَا","هَـٰذَا","فَزِدۡهُ","عَذَابًا","ضِعۡفًا","فِى","ٱلنَّارِ"],"38:74":["إِلَّآ","إِبۡلِيسَ","ٱسۡتَكۡبَرَ","وَكَانَ","مِنَ","ٱلۡكَـٰفِرِينَ"],"38:79":["قَالَ","رَبِّ","فَأَنظِرۡنِىٓ","إِلَىٰ","يَوۡمِ","يُبۡعَثُونَ"],"38:80":["قَالَ","فَإِنَّكَ","مِنَ","ٱلۡمُنظَرِينَ"],"38:85":["لَأَمۡلَأَنَّ","جَهَنَّمَ","مِنكَ","وَمِمَّن","تَبِعَكَ","مِنۡهُمۡ","أَجۡمَعِينَ"],"39:6":["خَلَقَكُم","مِّن","نَّفۡسٍ","وٰحِدَةٍ","ثُمَّ","جَعَلَ","مِنۡهَا","زَوۡجَهَا","وَأَنزَلَ","لَكُم","مِّنَ","ٱلۡأَنۡعَـٰمِ","ثَمَـٰنِيَةَ","أَزۡوٰجٍ‌ۚ","يَخۡلُقُكُمۡ","فِى","بُطُونِ","أُمَّهَـٰتِكُمۡ","خَلۡقًا","مِّنۢ","بَعۡدِ","خَلۡقٍ","فِى","ظُلُمَـٰتٍ","ثَلَـٰثٍ‌ۚ","ذٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","لَهُ","ٱلۡمُلۡكُ‌ۖ","لَآ","إِلَـٰهَ","إِلَّا","هُوَ‌ۖ","فَأَنَّىٰ","تُصۡرَفُونَ"],"41:36":["وَإِمَّا","يَنزَغَنَّكَ","مِنَ","ٱلشَّيۡطَـٰنِ","نَزۡغٌ","فَٱسۡتَعِذۡ","بِٱللَّهِ‌ۖ","إِنَّهُۥ","هُوَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"41:37":["وَمِنۡ","ءَايَـٰتِهِ","ٱلَّيۡلُ","وَٱلنَّهَارُ","وَٱلشَّمۡسُ","وَٱلۡقَمَرُ‌ۚ","لَا","تَسۡجُدُواۡ","لِلشَّمۡسِ","وَلَا","لِلۡقَمَرِ","وَٱسۡجُدُواۡ","لِلَّهِ","ٱلَّذِى","خَلَقَهُنَّ","إِن","كُنتُمۡ","إِيَّاهُ","تَعۡبُدُونَ"],"43:50":["فَلَمَّا","كَشَفۡنَا","عَنۡهُمُ","ٱلۡعَذَابَ","إ