هَا","جَمِيعًا","قَالَتۡ","أُخۡرَٮٰهُمۡ","لِأُولَـٰهُمۡ","رَبَّنَا","هَـٰٓؤُلَآءِ","أَضَلُّونَا","فَـَٔـاتِهِمۡ","عَذَابًا","ضِعۡفًا","مِّنَ","ٱلنَّارِ‌ۖ","قَالَ","لِكُلٍّ","ضِعۡفٌ","وَلَـٰكِن","لَّا","تَعۡلَمُونَ"],"7:43":["وَنَزَعۡنَا","مَا","فِى","صُدُورِهِم","مِّنۡ","غِلٍّ","تَجۡرِى","مِن","تَحۡتِهِمُ","ٱلۡأَنۡهَـٰرُ‌ۖ","وَقَالُواۡ","ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِى","هَدَٮٰنَا","لِهَـٰذَا","وَمَا","كُنَّا","لِنَهۡتَدِىَ","لَوۡلَآ","أَنۡ","هَدَٮٰنَا","ٱللَّهُ‌ۖ","لَقَدۡ","جَآءَتۡ","رُسُلُ","رَبِّنَا","بِٱلۡحَقِّ‌ۖ","وَنُودُوٓاۡ","أَن","تِلۡكُمُ","ٱلۡجَنَّةُ","أُورِثۡتُمُوهَا","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"7:44":["وَنَادَىٰٓ","أَصۡحَـٰبُ","ٱلۡجَنَّةِ","أَصۡحَـٰبَ","ٱلنَّارِ","أَن","قَدۡ","وَجَدۡنَا","مَا","وَعَدَنَا","رَبُّنَا","حَقًّا","فَهَلۡ","وَجَدتُّم","مَّا","وَعَدَ","رَبُّكُمۡ","حَقًّا‌ۖ","قَالُواۡ","نَعَمۡ‌ۚ","فَأَذَّنَ","مُؤَذِّنُۢ","بَيۡنَهُمۡ","أَن","لَّعۡنَةُ","ٱللَّهِ","عَلَى","ٱلظَّـٰلِمِينَ"],"7:45":["ٱلَّذِينَ","يَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","وَيَبۡغُونَهَا","عِوَجًا","وَهُم","بِٱلۡأَخِرَةِ","كَـٰفِرُونَ"],"7:46":["وَبَيۡنَهُمَا","حِجَابٌ‌ۚ","وَعَلَى","ٱلۡأَعۡرَافِ","رِجَالٌ","يَعۡرِفُونَ","كُلاَّۢ","بِسِيمَـٰهُمۡ‌ۚ","وَنَادَوۡاۡ","أَصۡحَـٰبَ","ٱلۡجَنَّةِ","أَن","سَلَـٰمٌ","عَلَيۡكُمۡ‌ۚ","لَمۡ","يَدۡخُلُوهَا","وَهُمۡ","يَطۡمَعُونَ"],"7:48":["وَنَادَىٰٓ","أَصۡحَـٰبُ","ٱلۡأَعۡرَافِ","رِجَالاً","يَعۡرِفُونَهُم","بِسِيمَـٰهُمۡ","قَالُواۡ","مَآ","أَغۡنَىٰ","عَنكُمۡ","جَمۡعُكُمۡ","وَمَا","كُنتُمۡ","تَسۡتَكۡبِرُونَ"],"7:50":["وَنَادَىٰٓ","أَصۡحَـٰبُ","ٱلنَّارِ","أَصۡحَـٰبَ","ٱلۡجَنَّةِ","أَنۡ","أَفِيضُواۡ","عَلَيۡنَا","مِنَ","ٱلۡمَآءِ","أَوۡ","مِمَّا","رَزَقَكُمُ","ٱللَّهُ‌ۚ","قَالُوٓاۡ","إِنَّ","ٱللَّهَ","حَرَّمَهُمَا","عَلَى","ٱلۡكَـٰفِرِينَ"],"7:51":["ٱلَّذِينَ","ٱتَّخَذُواۡ","دِينَهُمۡ","لَهۡوًا","وَلَعِبًا","وَغَرَّتۡهُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا‌ۚ","فَٱلۡيَوۡمَ","نَنسَـٰهُمۡ","كَمَا","نَسُواۡ","لِقَآءَ","يَوۡمِهِمۡ","هَـٰذَا","وَمَا","كَانُواۡ","بِـَٔـايَـٰتِنَا","يَجۡحَدُونَ"],"7:53":["هَلۡ","يَنظُرُونَ","إِلَّا","تَأۡوِيلَهُۥ‌ۚ","يَوۡمَ","يَأۡتِى","تَأۡوِيلُهُۥ","يَقُولُ","ٱلَّذِينَ","نَسُوهُ","مِن","قَبۡلُ","قَدۡ","جَآءَتۡ","رُسُلُ","رَبِّنَا","بِٱلۡحَقِّ","فَهَل","لَّنَا","مِن","شُفَعَآءَ","فَيَشۡفَعُواۡ","لَنَآ","أَوۡ","نُرَدُّ","فَنَعۡمَلَ","غَيۡرَ","ٱلَّذِى","كُنَّا","نَعۡمَلُ‌ۚ","قَدۡ","خَسِرُوٓاۡ","أَنفُسَهُمۡ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواۡ","يَفۡتَرُونَ"],"7:54":["إِنَّ","رَبَّكُمُ","ٱللَّهُ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ","يُغۡشِى","ٱلَّيۡلَ","ٱلنَّهَارَ","يَطۡلُبُهُۥ","حَثِيثًا","وَٱلشَّمۡسَ","وَٱلۡقَمَرَ","وَٱلنُّجُومَ","مُسَخَّرٰتِۭ","بِأَمۡرِهِۦٓ‌ۗ","أَلَا","لَهُ","ٱلۡخَلۡقُ","وَٱلۡأَمۡرُ‌ۗ","تَبَارَكَ","ٱللَّهُ","رَبُّ","ٱلۡعَـٰلَمِينَ"],"7:55":["ٱدۡعُواۡ","رَبَّكُمۡ","تَضَرُّعًا","وَخُفۡيَةً‌ۚ","إِنَّهُۥ","لَا","يُحِبُّ","ٱلۡمُعۡتَدِينَ"],"7:57":["وَهُوَ","ٱلَّذِى","يُرۡسِلُ","ٱلرِّيَـٰحَ","بُشۡرَۢا","بَيۡنَ","يَدَىۡ","رَحۡمَتِهِۦ‌ۖ","حَتَّىٰٓ","إِذَآ","أَقَلَّتۡ","سَحَابًا","ثِقَالاً","سُقۡنَـٰهُ","لِبَلَدٍ","مَّيِّتٍ","فَأَنزَلۡنَا","بِهِ","ٱلۡمَآءَ","فَأَخۡرَجۡنَا","بِهِۦ","مِن","كُلِّ","ٱلثَّمَرٰتِ‌ۚ","كَذٰلِكَ","نُخۡرِجُ","ٱلۡمَوۡتَىٰ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"7:59":["لَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦ","فَقَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥٓ","إِنِّىٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","عَظِيمٍ"],"7:60":["قَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِهِۦٓ","إِنَّا","لَنَرَٮٰكَ","فِى","ضَلَـٰلٍ","مُّبِينٍ"],"7:61":["قَالَ","يَـٰقَوۡمِ","لَيۡسَ","بِى","ضَلَـٰلَةٌ","وَلَـٰكِنِّى","رَسُولٌ","مِّن","رَّبِّ","ٱلۡعَـٰلَمِينَ"],"7:62":["أُبَلِّغُكُمۡ","رِسَـٰلَـٰتِ","رَبِّى","وَأَنصَحُ","لَكُمۡ","وَأَعۡلَمُ","مِنَ","ٱللَّهِ","مَا","لَا","تَعۡلَمُونَ"],"7:63":["أَوَعَجِبۡتُمۡ","أَن","جَآءَكُمۡ","ذِكۡرٌ","مِّن","رَّبِّكُمۡ","عَلَىٰ","رَجُلٍ","مِّنكُمۡ","لِيُنذِرَكُمۡ","وَلِتَتَّقُواۡ","وَلَعَلَّكُمۡ","تُرۡحَمُونَ"],"7:64":["فَكَذَّبُوهُ","فَأَنجَيۡنَـٰهُ","وَٱلَّذِينَ","مَعَهُۥ","فِى","ٱلۡفُلۡكِ","وَأَغۡرَقۡنَا","ٱلَّذِينَ","كَذَّبُواۡ","بِـَٔـايَـٰتِنَآ‌ۚ","إِنَّهُمۡ","كَانُواۡ","قَوۡمًا","عَمِينَ"],"7:65":["۞وَإِلَىٰ","عَادٍ","أَخَاهُمۡ","هُودًا‌ۗ","قَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥٓ‌ۚ","أَفَلَا","تَتَّقُونَ"],"7:66":["قَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","كَفَرُواۡ","مِن","قَوۡمِهِۦٓ","إِنَّا","لَنَرَٮٰكَ","فِى","سَفَاهَةٍ","وَإِنَّا","لَنَظُنُّكَ","مِنَ","ٱلۡكَـٰذِبِينَ"],"7:67":["قَالَ","يَـٰقَوۡمِ","لَيۡسَ","بِى","سَفَاهَةٌ","وَلَـٰكِنِّى","رَسُولٌ","مِّن","رَّبِّ","ٱلۡعَـٰلَمِينَ"],"7:68":["أُبَلِّغُكُمۡ","رِسَـٰلَـٰتِ","رَبِّى","وَأَنَاۡ","لَكُمۡ","نَاصِحٌ","أَمِينٌ"],"7:69":["أَوَعَجِبۡتُمۡ","أَن","جَآءَكُمۡ","ذِكۡرٌ","مِّن","رَّبِّكُمۡ","عَلَىٰ","رَجُلٍ","مِّنكُمۡ","لِيُنذِرَكُمۡ‌ۚ","وَٱذۡكُرُوٓاۡ","إِذۡ","جَعَلَكُمۡ","خُلَفَآءَ","مِنۢ","بَعۡدِ","قَوۡمِ","نُوحٍ","وَزَادَكُمۡ","فِى","ٱلۡخَلۡقِ","بَصۜۡطَةً‌ۖ","فَٱذۡكُرُوٓاۡ","ءَالَآءَ","ٱللَّهِ","لَعَلَّكُمۡ","تُفۡلِحُونَ"],"7:70":["قَالُوٓاۡ","أَجِئۡتَنَا","لِنَعۡبُدَ","ٱللَّهَ","وَحۡدَهُۥ","وَنَذَرَ","مَا","كَانَ","يَعۡبُدُ","ءَابَآؤُنَا‌ۖ","فَأۡتِنَا","بِمَا","تَعِدُنَآ","إِن","كُنتَ","مِنَ","ٱلصَّـٰدِقِينَ"],"7:71":["قَالَ","قَدۡ","وَقَعَ","عَلَيۡكُم","مِّن","رَّبِّكُمۡ","رِجۡسٌ","وَغَضَبٌ‌ۖ","أَتُجَـٰدِلُونَنِى","فِىٓ","أَسۡمَآءٍ","سَمَّيۡتُمُوهَآ","أَنتُمۡ","وَءَابَآؤُكُم","مَّا","نَزَّلَ","ٱللَّهُ","بِهَا","مِن","سُلۡطَـٰنٍ‌ۚ","فَٱنتَظِرُوٓاۡ","إِنِّى","مَعَكُم","مِّنَ","ٱلۡمُنتَظِرِينَ"],"7:72":["فَأَنجَيۡنَـٰهُ","وَٱلَّذِينَ","مَعَهُۥ","بِرَحۡمَةٍ","مِّنَّا","وَقَطَعۡنَا","دَابِرَ","ٱلَّذِينَ","كَذَّبُواۡ","بِـَٔـايَـٰتِنَا‌ۖ","وَمَا","كَانُواۡ","مُؤۡمِنِينَ"],"7:73":["وَإِلَىٰ","ثَمُودَ","أَخَاهُمۡ","صَـٰلِحًا‌ۗ","قَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥ‌ۖ","قَدۡ","جَآءَتۡكُم","بَيِّنَةٌ","مِّن","رَّبِّكُمۡ‌ۖ","هَـٰذِهِۦ","نَاقَةُ","ٱللَّهِ","لَكُمۡ","ءَايَةً‌ۖ","فَذَرُوهَا","تَأۡكُلۡ","فِىٓ","أَرۡضِ","ٱللَّهِ‌ۖ","وَلَا","تَمَسُّوهَا","بِسُوٓءٍ","فَيَأۡخُذَكُمۡ","عَذَابٌ","أَلِيمٌ"],"7:74":["وَٱذۡكُرُوٓاۡ","إِذۡ","جَعَلَكُمۡ","خُلَفَآءَ","مِنۢ","بَعۡدِ","عَادٍ","وَبَوَّأَكُمۡ","فِى","ٱلۡأَرۡضِ","تَتَّخِذُونَ","مِن","سُهُولِهَا","قُصُورًا","وَتَنۡحِتُونَ","ٱلۡجِبَالَ","بُيُوتًا‌ۖ","فَٱذۡكُرُوٓاۡ","ءَالَآءَ","ٱللَّهِ","وَلَا","تَعۡثَوۡاۡ","فِى","ٱلۡأَرۡضِ","مُفۡسِدِينَ"],"7:75":["قَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","ٱسۡتَكۡبَرُواۡ","مِن","قَوۡمِهِۦ","لِلَّذِينَ","ٱسۡتُضۡعِفُواۡ","لِمَنۡ","ءَامَنَ","مِنۡهُمۡ","أَتَعۡلَمُونَ","أَنَّ","صَـٰلِحًا","مُّرۡسَلٌ","مِّن","رَّبِّهِۦ‌ۚ","قَالُوٓاۡ","إِنَّا","بِمَآ","أُرۡسِلَ","بِهِۦ","مُؤۡمِنُونَ"],"7:78":["فَأَخَذَتۡهُمُ","ٱلرَّجۡفَةُ","فَأَصۡبَحُواۡ","فِى","دَارِهِمۡ","جَـٰثِمِينَ"],"7:79":["فَتَوَلَّىٰ","عَنۡهُمۡ","وَقَالَ","يَـٰقَوۡمِ","لَقَدۡ","أَبۡلَغۡتُكُمۡ","رِسَالَةَ","رَبِّى","وَنَصَحۡتُ","لَكُمۡ","وَلَـٰكِن","لَّا","تُحِبُّونَ","ٱلنَّـٰصِحِينَ"],"7:80":["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","أَتَأۡتُونَ","ٱلۡفَـٰحِشَةَ","مَا","سَبَقَكُم","بِهَا","مِنۡ","أَحَدٍ","مِّنَ","ٱلۡعَـٰلَمِينَ"],"7:81":["إِنَّكُمۡ","لَتَأۡتُونَ","ٱلرِّجَالَ","شَهۡوَةً","مِّن","دُونِ","ٱلنِّسَآءِ‌ۚ","بَلۡ","أَنتُمۡ","قَوۡمٌ","مُّسۡرِفُونَ"],"7:82":["وَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُوٓاۡ","أَخۡرِجُوهُم","مِّن","قَرۡيَتِكُمۡ‌ۖ","إِنَّهُمۡ","أُنَاسٌ","يَتَطَهَّرُونَ"],"7:83":["فَأَنجَيۡنَـٰهُ","وَأَهۡلَهُۥٓ","إِلَّا","ٱمۡرَأَتَهُۥ","كَانَتۡ","مِنَ","ٱلۡغَـٰبِرِينَ"],"7:84":["وَأَمۡطَرۡنَا","عَلَيۡهِم","مَّطَرًا‌ۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُجۡرِمِينَ"],"7:85":["وَإِلَىٰ","مَدۡيَنَ","أَخَاهُمۡ","شُعَيۡبًا‌ۗ","قَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥ‌ۖ","قَدۡ","جَآءَتۡكُم","بَيِّنَةٌ","مِّن","رَّبِّكُمۡ‌ۖ","فَأَوۡفُواۡ","ٱلۡكَيۡلَ","وَٱلۡمِيزَانَ","وَلَا","تَبۡخَسُواۡ","ٱلنَّاسَ","أَشۡيَآءَهُمۡ","وَلَا","تُفۡسِدُواۡ","فِى","ٱلۡأَرۡضِ","بَعۡدَ","إِصۡلَـٰحِهَا‌ۚ","ذٰلِكُمۡ","خَيۡرٌ","لَّكُمۡ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"7:86":["وَلَا","تَقۡعُدُواۡ","بِكُلِّ","صِرٰطٍ","تُوعِدُونَ","وَتَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","مَنۡ","ءَامَنَ","بِهِۦ","وَتَبۡغُونَهَا","عِوَجًا‌ۚ","وَٱذۡكُرُوٓاۡ","إِذۡ","كُنتُمۡ","قَلِيلاً","فَكَثَّرَكُمۡ‌ۖ","وَٱنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُفۡسِدِينَ"],"7:87":["وَإِن","كَانَ","طَآئِفَةٌ","مِّنكُمۡ","ءَامَنُواۡ","بِٱلَّذِىٓ","أُرۡسِلۡتُ","بِهِۦ","وَطَآئِفَةٌ","لَّمۡ","يُؤۡمِنُواۡ","فَٱصۡبِرُواۡ","حَتَّىٰ","يَحۡكُمَ","ٱللَّهُ","بَيۡنَنَا‌ۚ","وَهُوَ","خَيۡرُ","ٱلۡحَـٰكِمِينَ"],"7:88":["۞قَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","ٱسۡتَكۡبَرُواۡ","مِن","قَوۡمِهِۦ","لَنُخۡرِجَنَّكَ","يَـٰشُعَيۡبُ","وَٱلَّذِينَ","ءَامَنُواۡ","مَعَكَ","مِن","قَرۡيَتِنَآ","أَوۡ","لَتَعُودُنَّ","فِى","مِلَّتِنَا‌ۚ","قَالَ","أَوَلَوۡ","كُنَّا","كَـٰرِهِينَ"],"7:90":["وَقَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","كَفَرُواۡ","مِن","قَوۡمِهِۦ","لَئِنِ","ٱتَّبَعۡتُمۡ","شُعَيۡبًا","إِنَّكُمۡ","إِذًا","لَّخَـٰسِرُونَ"],"7:91":["فَأَخَذَتۡهُمُ","ٱلرَّجۡفَةُ","فَأَصۡبَحُواۡ","فِى","دَارِهِمۡ","جَـٰثِمِينَ"],"7:92":["ٱلَّذِينَ","كَذَّبُواۡ","شُعَيۡبًا","كَأَن","لَّمۡ","يَغۡنَوۡاۡ","فِيهَا‌ۚ","ٱلَّذِينَ","كَذَّبُواۡ","شُعَيۡبًا","كَانُواۡ","هُمُ","ٱلۡخَـٰسِرِينَ"],"7:93":["فَتَوَلَّىٰ","عَنۡهُمۡ","وَقَالَ","يَـٰقَوۡمِ","لَقَدۡ","أَبۡلَغۡتُكُمۡ","رِسَـٰلَـٰتِ","رَبِّى","وَنَصَحۡتُ","لَكُمۡ‌ۖ","فَكَيۡفَ","ءَاسَىٰ","عَلَىٰ","قَوۡمٍ","كَـٰفِرِينَ"],"7:94":["وَمَآ","أَرۡسَلۡنَا","فِى","قَرۡيَةٍ","مِّن","نَّبِىٍّ","إِلَّآ","أَخَذۡنَآ","أَهۡلَهَا","بِٱلۡبَأۡسَآءِ","وَٱلضَّرَّآءِ","لَعَلَّهُمۡ","يَضَّرَّعُونَ"],"7:95":["ثُمَّ","بَدَّلۡنَا","مَكَانَ","ٱلسَّيِّئَةِ","ٱلۡحَسَنَةَ","حَتَّىٰ","عَفَواۡ","وَّقَالُواۡ","قَدۡ","مَسَّ","ءَابَآءَنَا","ٱلضَّرَّآءُ","وَٱلسَّرَّآءُ","فَأَخَذۡنَـٰهُم","بَغۡتَةً","وَهُمۡ","لَا","يَشۡعُرُونَ"],"7:101":["تِلۡكَ","ٱلۡقُرَىٰ","نَقُصُّ","عَلَيۡكَ","مِنۡ","أَنۢبَآئِهَا‌ۚ","وَلَقَدۡ","جَآءَتۡهُمۡ","رُسُلُهُم","بِٱلۡبَيِّنَـٰتِ","فَمَا","كَانُواۡ","لِيُؤۡمِنُواۡ","بِمَا","كَذَّبُواۡ","مِن","قَبۡلُ‌ۚ","كَذٰلِكَ","يَطۡبَعُ","ٱللَّهُ","عَلَىٰ","قُلُوبِ","ٱلۡكَـٰفِرِينَ"],"7:103":["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِم","مُّوسَىٰ","بِـَٔـايَـٰتِنَآ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦ","فَظَلَمُواۡ","بِهَا‌ۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُفۡسِدِينَ"],"7:106":["قَالَ","إِن","كُنتَ","جِئۡتَ","بِـَٔـايَةٍ","فَأۡتِ","بِهَآ","إِن","كُنتَ","مِنَ","ٱلصَّـٰدِقِينَ"],"7:107":["فَأَلۡقَىٰ","عَصَاهُ","فَإِذَا","هِىَ","ثُعۡبَانٌ","مُّبِينٌ"],"7:108":["وَنَزَعَ","يَدَهُۥ","فَإِذَا","هِىَ","بَيۡضَآءُ","لِلنَّـٰظِرِينَ"],"7:109":["قَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِ","فِرۡعَوۡنَ","إِنَّ","هَـٰذَا","لَسَـٰحِرٌ","عَلِيمٌ"],"7:110":["يُرِيدُ","أَن","يُخۡرِجَكُم","مِّنۡ","أَرۡضِكُمۡ‌ۖ","فَمَاذَا","تَأۡمُرُونَ"],"7:111":["قَالُوٓاۡ","أَرۡجِهۡ","وَأَخَاهُ","وَأَرۡسِلۡ","فِى","ٱلۡمَدَآئِنِ","حَـٰشِرِينَ"],"7:112":["يَأۡتُوكَ","بِكُلِّ","سَـٰحِرٍ","عَلِيمٍ"],"7:113":["وَجَآءَ","ٱلسَّحَرَةُ","فِرۡعَوۡنَ","قَالُوٓاۡ","إِنَّ","لَنَا","لَأَجۡرًا","إِن","كُنَّا","نَحۡنُ","ٱلۡغَـٰلِبِينَ"],"7:114":["قَالَ","نَعَمۡ","وَإِنَّكُمۡ","لَمِنَ","ٱلۡمُقَرَّبِينَ"],"7:115":["قَالُواۡ","يَـٰمُوسَىٰٓ","إِمَّآ","أَن","تُلۡقِىَ","وَإِمَّآ","أَن","نَّكُونَ","نَحۡنُ","ٱلۡمُلۡقِينَ"],"7:116":["قَالَ","أَلۡقُواۡ‌ۖ","فَلَمَّآ","أَلۡقَوۡاۡ","سَحَرُوٓاۡ","أَعۡيُنَ","ٱلنَّاسِ","وَٱسۡتَرۡهَبُوهُمۡ","وَجَآءُو","بِسِحۡرٍ","عَظِيمٍ"],"7:117":["۞وَأَوۡحَيۡنَآ","إِلَىٰ","مُوسَىٰٓ","أَنۡ","أَلۡقِ","عَصَاكَ‌ۖ","فَإِذَا","هِىَ","تَلۡقَفُ","مَا","يَأۡفِكُونَ"],"7:118":["فَوَقَعَ","ٱلۡحَقُّ","وَبَطَلَ","مَا","كَانُواۡ","يَعۡمَلُونَ"],"7:120":["وَأُلۡقِىَ","ٱلسَّحَرَةُ","سَـٰجِدِينَ"],"7:121":["قَالُوٓاۡ","ءَامَنَّا","بِرَبِّ","ٱلۡعَـٰلَمِينَ"],"7:122":["رَبِّ","مُوسَىٰ","وَهَـٰرُونَ"],"7:123":["قَالَ","فِرۡعَوۡنُ","ءَامَنتُم","بِهِۦ","قَبۡلَ","أَنۡ","ءَاذَنَ","لَكُمۡ‌ۖ","إِنَّ","هَـٰذَا","لَمَكۡرٌ","مَّكَرۡتُمُوهُ","فِى","ٱلۡمَدِينَةِ","لِتُخۡرِجُواۡ","مِنۡهَآ","أَهۡلَهَا‌ۖ","فَسَوۡفَ","تَعۡلَمُونَ"],"7:125":["قَالُوٓاۡ","إِنَّآ","إِلَىٰ","رَبِّنَا","مُنقَلِبُونَ"],"7:126":["وَمَا","تَنقِمُ","مِنَّآ","إِلَّآ","أَنۡ","ءَامَنَّا","بِـَٔـايَـٰتِ","رَبِّنَا","لَمَّا","جَآءَتۡنَا‌ۚ","رَبَّنَآ","أَفۡرِغۡ","عَلَيۡنَا","صَبۡرًا","وَتَوَفَّنَا","مُسۡلِمِينَ"],"7:127":["وَقَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِ","فِرۡعَوۡنَ","أَتَذَرُ","مُوسَىٰ","وَقَوۡمَهُۥ","لِيُفۡسِدُواۡ","فِى","ٱلۡأَرۡضِ","وَيَذَرَكَ","وَءَالِهَتَكَ‌ۚ","قَالَ","سَنُقَتِّلُ","أَبۡنَآءَهُمۡ","وَنَسۡتَحۡىِۦ","نِسَآءَهُمۡ","وَإِنَّا","فَوۡقَهُمۡ","قَـٰهِرُونَ"],"7:135":["فَلَمَّا","كَشَفۡنَا","عَنۡهُمُ","ٱلرِّجۡزَ","إِلَىٰٓ","أَجَلٍ","هُم","بَـٰلِغُوهُ","إِذَا","هُمۡ","يَنكُثُونَ"],"7:136":["فَٱنتَقَمۡنَا","مِنۡهُمۡ","فَأَغۡرَقۡنَـٰهُمۡ","فِى","ٱلۡيَمِّ","بِأَنَّهُمۡ","كَذَّبُواۡ","بِـَٔـايَـٰتِنَا","وَكَانُواۡ","عَنۡهَا","غَـٰفِلِينَ"],"7:138":["وَجَـٰوَزۡنَا","بِبَنِىٓ","إِسۡرٰٓءِيلَ","ٱلۡبَحۡرَ","فَأَتَوۡاۡ","عَلَىٰ","قَوۡمٍ","يَعۡكُفُونَ","عَلَىٰٓ","أَصۡنَامٍ","لَّهُمۡ‌ۚ","قَالُواۡ","يَـٰمُوسَى","ٱجۡعَل","لَّنَآ","إِلَـٰهًا","كَمَا","لَهُمۡ","ءَالِهَةٌ‌ۚ","قَالَ","إِنَّكُمۡ","قَوۡمٌ","تَجۡهَلُونَ"],"7:141":["وَإِذۡ","أَنجَيۡنَـٰكُم","مِّنۡ","ءَالِ","فِرۡعَوۡنَ","يَسُومُونَكُمۡ","سُوٓءَ","ٱلۡعَذَابِ‌ۖ","يُقَتِّلُونَ","أَبۡنَآءَكُمۡ","وَيَسۡتَحۡيُونَ","نِسَآءَكُمۡ‌ۚ","وَفِى","ذٰلِكُم","بَلَآءٌ","مِّن","رَّبِّكُمۡ","عَظِيمٌ"],"7:150":["وَلَمَّا","رَجَعَ","مُوسَىٰٓ","إِلَىٰ","قَوۡمِهِۦ","غَضۡبَـٰنَ","أَسِفًا","قَالَ","بِئۡسَمَا","خَلَفۡتُمُونِى","مِنۢ","بَعۡدِىٓ‌ۖ","أَعَجِلۡتُمۡ","أَمۡرَ","رَبِّكُمۡ‌ۖ","وَأَلۡقَى","ٱلۡأَلۡوَاحَ","وَأَخَذَ","بِرَأۡسِ","أَخِيهِ","يَجُرُّهُۥٓ","إِلَيۡهِ‌ۚ","قَالَ","ٱبۡنَ","أُمَّ","إِنَّ","ٱلۡقَوۡمَ","ٱسۡتَضۡعَفُونِى","وَكَادُواۡ","يَقۡتُلُونَنِى","فَلَا","تُشۡمِتۡ","بِىَ","ٱلۡأَعۡدَآءَ","وَلَا","تَجۡعَلۡنِى","مَعَ","ٱلۡقَوۡمِ","ٱلظَّـٰلِمِينَ"],"7:159":["وَمِن","قَوۡمِ","مُوسَىٰٓ","أُمَّةٌ","يَهۡدُونَ","بِٱلۡحَقِّ","وَبِهِۦ","يَعۡدِلُونَ"],"7:160":["وَقَطَّعۡنَـٰهُمُ","ٱثۡنَتَىۡ","عَشۡرَةَ","أَسۡبَاطًا","أُمَمًا‌ۚ","وَأَوۡحَيۡنَآ","إِلَىٰ","مُوسَىٰٓ","إِذِ","ٱسۡتَسۡقَـٰهُ","قَوۡمُهُۥٓ","أَنِ","ٱضۡرِب","بِّعَصَاكَ","ٱلۡحَجَرَ‌ۖ","فَٱنۢبَجَسَتۡ","مِنۡهُ","ٱثۡنَتَا","عَشۡرَةَ","عَيۡنًا‌ۖ","قَدۡ","عَلِمَ","كُلُّ","أُنَاسٍ","مَّشۡرَبَهُمۡ‌ۚ","وَظَلَّلۡنَا","عَلَيۡهِمُ","ٱلۡغَمَـٰمَ","وَأَنزَلۡنَا","عَلَيۡهِمُ","ٱلۡمَنَّ","وَٱلسَّلۡوَىٰ‌ۖ","كُلُواۡ","مِن","طَيِّبَـٰتِ","مَا","رَزَقۡنَـٰكُمۡ‌ۚ","وَمَا","ظَلَمُونَا","وَلَـٰكِن","كَانُوٓاۡ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"7:161":["وَإِذۡ","قِيلَ","لَهُمُ","ٱسۡكُنُواۡ","هَـٰذِهِ","ٱلۡقَرۡيَةَ","وَكُلُواۡ","مِنۡهَا","حَيۡثُ","شِئۡتُمۡ","وَقُولُواۡ","حِطَّةٌ","وَٱدۡخُلُواۡ","ٱلۡبَابَ","سُجَّدًا","نَّغۡفِرۡ","لَكُمۡ","خَطِيٓـَٔـٰتِكُمۡ‌ۚ","سَنَزِيدُ","ٱلۡمُحۡسِنِينَ"],"7:162":["فَبَدَّلَ","ٱلَّذِينَ","ظَلَمُواۡ","مِنۡهُمۡ","قَوۡلاً","غَيۡرَ","ٱلَّذِى","قِيلَ","لَهُمۡ","فَأَرۡسَلۡنَا","عَلَيۡهِمۡ","رِجۡزًا","مِّنَ","ٱلسَّمَآءِ","بِمَا","كَانُواۡ","يَظۡلِمُونَ"],"7:165":["فَلَمَّا","نَسُواۡ","مَا","ذُكِّرُواۡ","بِهِۦٓ","أَنجَيۡنَا","ٱلَّذِينَ","يَنۡهَوۡنَ","عَنِ","ٱلسُّوٓءِ","وَأَخَذۡنَا","ٱلَّذِينَ","ظَلَمُواۡ","بِعَذَابِۭ","بَــِٔيسِۭ","بِمَا","كَانُواۡ","يَفۡسُقُونَ"],"7:168":["وَقَطَّعۡنَـٰهُمۡ","فِى","ٱلۡأَرۡضِ","أُمَمًا‌ۖ","مِّنۡهُمُ","ٱلصَّـٰلِحُونَ","وَمِنۡهُمۡ","دُونَ","ذٰلِكَ‌ۖ","وَبَلَوۡنَـٰهُم","بِٱلۡحَسَنَـٰتِ","وَٱلسَّيِّـَٔـاتِ","لَعَلَّهُمۡ","يَرۡجِعُونَ"],"7:169":["فَخَلَفَ","مِنۢ","بَعۡدِهِمۡ","خَلۡفٌ","وَرِثُواۡ","ٱلۡكِتَـٰبَ","يَأۡخُذُونَ","عَرَضَ","هَـٰذَا","ٱلۡأَدۡنَىٰ","وَيَقُولُونَ","سَيُغۡفَرُ","لَنَا","وَإِن","يَأۡتِهِمۡ","عَرَضٌ","مِّثۡلُهُۥ","يَأۡخُذُوهُ‌ۚ","أَلَمۡ","يُؤۡخَذۡ","عَلَيۡهِم","مِّيثَـٰقُ","ٱلۡكِتَـٰبِ","أَن","لَّا","يَقُولُواۡ","عَلَى","ٱللَّهِ","إِلَّا","ٱلۡحَقَّ","وَدَرَسُواۡ","مَا","فِيهِ‌ۗ","وَٱلدَّارُ","ٱلۡأَخِرَةُ","خَيۡرٌ","لِّلَّذِينَ","يَتَّقُونَ‌ۗ","أَفَلَا","تَعۡقِلُونَ"],"7:178":["مَن","يَهۡدِ","ٱللَّهُ","فَهُوَ","ٱلۡمُهۡتَدِى‌ۖ","وَمَن","يُضۡلِلۡ","فَأُوۡلَـٰٓئِكَ","هُمُ","ٱلۡخَـٰسِرُونَ"],"7:181":["وَمِمَّنۡ","خَلَقۡنَآ","أُمَّةٌ","يَهۡدُونَ","بِٱلۡحَقِّ","وَبِهِۦ","يَعۡدِلُونَ"],"7:182":["وَٱلَّذِينَ","كَذَّبُواۡ","بِـَٔـايَـٰتِنَا","سَنَسۡتَدۡرِجُهُم","مِّنۡ","حَيۡثُ","لَا","يَعۡلَمُونَ"],"7:188":["قُل","لَّآ","أَمۡلِكُ","لِنَفۡسِى","نَفۡعًا","وَلَا","ضَرًّا","إِلَّا","مَا","شَآءَ","ٱللَّهُ‌ۚ","وَلَوۡ","كُنتُ","أَعۡلَمُ","ٱلۡغَيۡبَ","لَٱسۡتَكۡثَرۡتُ","مِنَ","ٱلۡخَيۡرِ","وَمَا","مَسَّنِىَ","ٱلسُّوٓءُ‌ۚ","إِنۡ","أَنَاۡ","إِلَّا","نَذِيرٌ","وَبَشِيرٌ","لِّقَوۡمٍ","يُؤۡمِنُونَ"],"7:189":["۞هُوَ","ٱلَّذِى","خَلَقَكُم","مِّن","نَّفۡسٍ","وٰحِدَةٍ","وَجَعَلَ","مِنۡهَا","زَوۡجَهَا","لِيَسۡكُنَ","إِلَيۡهَا‌ۖ","فَلَمَّا","تَغَشَّـٰهَا","حَمَلَتۡ","حَمۡلاً","خَفِيفًا","فَمَرَّتۡ","بِهِۦ‌ۖ","فَلَمَّآ","أَثۡقَلَت","دَّعَوَا","ٱللَّهَ","رَبَّهُمَا","لَئِنۡ","ءَاتَيۡتَنَا","صَـٰلِحًا","لَّنَكُونَنَّ","مِنَ","ٱلشَّـٰكِرِينَ"],"7:200":["وَإِمَّا","يَنزَغَنَّكَ","مِنَ","ٱلشَّيۡطَـٰنِ","نَزۡغٌ","فَٱسۡتَعِذۡ","بِٱللَّهِ‌ۚ","إِنَّهُۥ","سَمِيعٌ","عَلِيمٌ"],"7:201":["إِنَّ","ٱلَّذِينَ","ٱتَّقَوۡاۡ","إِذَا","مَسَّهُمۡ","طَـٰٓئِفٌ","مِّنَ","ٱلشَّيۡطَـٰنِ","تَذَكَّرُواۡ","فَإِذَا","هُم","مُّبۡصِرُونَ"],"7:205":["وَٱذۡكُر","رَّبَّكَ","فِى","نَفۡسِكَ","تَضَرُّعًا","وَخِيفَةً","وَدُونَ","ٱلۡجَهۡرِ","مِنَ","ٱلۡقَوۡلِ","بِٱلۡغُدُوِّ","وَٱلۡأَصَالِ","وَلَا","تَكُن","مِّنَ","ٱلۡغَـٰفِلِينَ"],"10:3":["إِنَّ","رَبَّكُمُ","ٱللَّهُ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۖ","يُدَبِّرُ","ٱلۡأَمۡرَ‌ۖ","مَا","مِن","شَفِيعٍ","إِلَّا","مِنۢ","بَعۡدِ","إِذۡنِهِۦ‌ۚ","ذٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡ","فَٱعۡبُدُوهُ‌ۚ","أَفَلَا","تَذَكَّرُونَ"],"10:20":["وَيَقُولُونَ","لَوۡلَآ","أُنزِلَ","عَلَيۡهِ","ءَايَةٌ","مِّن","رَّبِّهِۦ‌ۖ","فَقُلۡ","إِنَّمَا","ٱلۡغَيۡبُ","لِلَّهِ","فَٱنتَظِرُوٓاۡ","إِنِّى","مَعَكُم","مِّنَ","ٱلۡمُنتَظِرِينَ"],"10:49":["قُل","لَّآ","أَمۡلِكُ","لِنَفۡسِى","ضَرًّا","وَلَا","نَفۡعًا","إِلَّا","مَا","شَآءَ","ٱللَّهُ‌ۗ","لِكُلِّ","أُمَّةٍ","أَجَلٌ‌ۚ","إِذَا","جَآءَ","أَجَلُهُمۡ","فَلَا","يَسۡتَــٔۡخِرُونَ","سَاعَةً‌ۖ","وَلَا","يَسۡتَقۡدِمُونَ"],"10:50":["قُلۡ","أَرَءَيۡتُمۡ","إِنۡ","أَتَـٰكُمۡ","عَذَابُهُۥ","بَيَـٰتًا","أَوۡ","نَهَارًا","مَّاذَا","يَسۡتَعۡجِلُ","مِنۡهُ","ٱلۡمُجۡرِمُونَ"],"10:73":["فَكَذَّبُوهُ","فَنَجَّيۡنَـٰهُ","وَمَن","مَّعَهُۥ","فِى","ٱلۡفُلۡكِ","وَجَعَلۡنَـٰهُمۡ","خَلَـٰٓئِفَ","وَأَغۡرَقۡنَا","ٱلَّذِينَ","كَذَّبُواۡ","بِـَٔـايَـٰتِنَا‌ۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُنذَرِينَ"],"10:74":["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِۦ","رُسُلاً","إِلَىٰ","قَوۡمِهِمۡ","فَجَآءُوهُم","بِٱلۡبَيِّنَـٰتِ","فَمَا","كَانُواۡ","لِيُؤۡمِنُواۡ","بِمَا","كَذَّبُواۡ","بِهِۦ","مِن","قَبۡلُ‌ۚ","كَذٰلِكَ","نَطۡبَعُ","عَلَىٰ","قُلُوبِ","ٱلۡمُعۡتَدِينَ"],"10:75":["ثُمَّ","بَعَثۡنَا","مِنۢ","بَعۡدِهِم","مُّوسَىٰ","وَهَـٰرُونَ","إِلَىٰ","فِرۡعَوۡنَ","وَمَلَإِيۡهِۦ","بِـَٔـايَـٰتِنَا","فَٱسۡتَكۡبَرُواۡ","وَكَانُواۡ","قَوۡمًا","مُّجۡرِمِينَ"],"10:78":["قَالُوٓاۡ","أَجِئۡتَنَا","لِتَلۡفِتَنَا","عَمَّا","وَجَدۡنَا","عَلَيۡهِ","ءَابَآءَنَا","وَتَكُونَ","لَكُمَا","ٱلۡكِبۡرِيَآءُ","فِى","ٱلۡأَرۡضِ","وَمَا","نَحۡنُ","لَكُمَا","بِمُؤۡمِنِينَ"],"10:81":["فَلَمَّآ","أَلۡقَوۡاۡ","قَالَ","مُوسَىٰ","مَا","جِئۡتُم","بِهِ","ٱلسِّحۡرُ‌ۖ","إِنَّ","ٱللَّهَ","سَيُبۡطِلُهُۥٓ‌ۖ","إِنَّ","ٱللَّهَ","لَا","يُصۡلِحُ","عَمَلَ","ٱلۡمُفۡسِدِينَ"],"10:90":["۞وَجَـٰوَزۡنَا","بِبَنِىٓ","إِسۡرٰٓءِيلَ","ٱلۡبَحۡرَ","فَأَتۡبَعَهُمۡ","فِرۡعَوۡنُ","وَجُنُودُهُۥ","بَغۡيًا","وَعَدۡوًا‌ۖ","حَتَّىٰٓ","إِذَآ","أَدۡرَكَهُ","ٱلۡغَرَقُ","قَالَ","ءَامَنتُ","أَنَّهُۥ","لَآ","إِلَـٰهَ","إِلَّا","ٱلَّذِىٓ","ءَامَنَتۡ","بِهِۦ","بَنُوٓاۡ","إِسۡرٰٓءِيلَ","وَأَنَاۡ","مِنَ","ٱلۡمُسۡلِمِينَ"],"10:102":["فَهَلۡ","يَنتَظِرُونَ","إِلَّا","مِثۡلَ","أَيَّامِ","ٱلَّذِينَ","خَلَوۡاۡ","مِن","قَبۡلِهِمۡ‌ۚ","قُلۡ","فَٱنتَظِرُوٓاۡ","إِنِّى","مَعَكُم","مِّنَ","ٱلۡمُنتَظِرِينَ"],"10:106":["وَلَا","تَدۡعُ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُكَ","وَلَا","يَضُرُّكَ‌ۖ","فَإِن","فَعَلۡتَ","فَإِنَّكَ","إِذًا","مِّنَ","ٱلظَّـٰلِمِينَ"],"10:109":["وَٱتَّبِعۡ","مَا","يُوحَىٰٓ","إِلَيۡكَ","وَٱصۡبِرۡ","حَتَّىٰ","يَحۡكُمَ","ٱللَّهُ‌ۚ","وَهُوَ","خَيۡرُ","ٱلۡحَـٰكِمِينَ"],"11:7":["وَهُوَ","ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","فِى","سِتَّةِ","أَيَّامٍ","وَكَانَ","عَرۡشُهُۥ","عَلَى","ٱلۡمَآءِ","لِيَبۡلُوَكُمۡ","أَيُّكُمۡ","أَحۡسَنُ","عَمَلاً‌ۗ","وَلَئِن","قُلۡتَ","إِنَّكُم","مَّبۡعُوثُونَ","مِنۢ","بَعۡدِ","ٱلۡمَوۡتِ","لَيَقُولَنَّ","ٱلَّذِينَ","كَفَرُوٓاۡ","إِنۡ","هَـٰذَآ","إِلَّا","سِحۡرٌ","مُّبِينٌ"],"11:19":["ٱلَّذِينَ","يَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِ","وَيَبۡغُونَهَا","عِوَجًا","وَهُم","بِٱلۡأَخِرَةِ","هُمۡ","كَـٰفِرُونَ"],"11:20":["أُوۡلَـٰٓئِكَ","لَمۡ","يَكُونُواۡ","مُعۡجِزِينَ","فِى","ٱلۡأَرۡضِ","وَمَا","كَانَ","لَهُم","مِّن","دُونِ","ٱللَّهِ","مِنۡ","أَوۡلِيَآءَ‌ۘ","يُضَـٰعَفُ","لَهُمُ","ٱلۡعَذَابُ‌ۚ","مَا","كَانُواۡ","يَسۡتَطِيعُونَ","ٱلسَّمۡعَ","وَمَا","كَانُواۡ","يُبۡصِرُونَ"],"11:21":["أُوۡلَـٰٓئِكَ","ٱلَّذِينَ","خَسِرُوٓاۡ","أَنفُسَهُمۡ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواۡ","يَفۡتَرُونَ"],"11:25":["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦٓ","إِنِّى","لَكُمۡ","نَذِيرٌ","مُّبِينٌ"],"11:27":["فَقَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","كَفَرُواۡ","مِن","قَوۡمِهِۦ","مَا","نَرَٮٰكَ","إِلَّا","بَشَرًا","مِّثۡلَنَا","وَمَا","نَرَٮٰكَ","ٱتَّبَعَكَ","إِلَّا","ٱلَّذِينَ","هُمۡ","أَرَاذِلُنَا","بَادِىَ","ٱلرَّأۡىِ","وَمَا","نَرَىٰ","لَكُمۡ","عَلَيۡنَا","مِن","فَضۡلِۭ","بَلۡ","نَظُنُّكُمۡ","كَـٰذِبِينَ"],"11:50":["وَإِلَىٰ","عَادٍ","أَخَاهُمۡ","هُودًا‌ۚ","قَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥٓ‌ۖ","إِنۡ","أَنتُمۡ","إِلَّا","مُفۡتَرُونَ"],"11:61":["۞وَإِلَىٰ","ثَمُودَ","أَخَاهُمۡ","صَـٰلِحًا‌ۚ","قَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥ‌ۖ","هُوَ","أَنشَأَكُم","مِّنَ","ٱلۡأَرۡضِ","وَٱسۡتَعۡمَرَكُمۡ","فِيهَا","فَٱسۡتَغۡفِرُوهُ","ثُمَّ","تُوبُوٓاۡ","إِلَيۡهِ‌ۚ","إِنَّ","رَبِّى","قَرِيبٌ","مُّجِيبٌ"],"11:64":["وَيَـٰقَوۡمِ","هَـٰذِهِۦ","نَاقَةُ","ٱللَّهِ","لَكُمۡ","ءَايَةً","فَذَرُوهَا","تَأۡكُلۡ","فِىٓ","أَرۡضِ","ٱللَّهِ","وَلَا","تَمَسُّوهَا","بِسُوٓءٍ","فَيَأۡخُذَكُمۡ","عَذَابٌ","قَرِيبٌ"],"11:67":["وَأَخَذَ","ٱلَّذِينَ","ظَلَمُواۡ","ٱلصَّيۡحَةُ","فَأَصۡبَحُواۡ","فِى","دِيَـٰرِهِمۡ","جَـٰثِمِينَ"],"11:68":["كَأَن","لَّمۡ","يَغۡنَوۡاۡ","فِيهَآ‌ۗ","أَلَآ","إِنَّ","ثَمُودَاۡ","كَفَرُواۡ","رَبَّهُمۡ‌ۗ","أَلَا","بُعۡدًا","لِّثَمُودَ"],"11:84":["۞وَإِلَىٰ","مَدۡيَنَ","أَخَاهُمۡ","شُعَيۡبًا‌ۚ","قَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥ‌ۖ","وَلَا","تَنقُصُواۡ","ٱلۡمِكۡيَالَ","وَٱلۡمِيزَانَ‌ۚ","إِنِّىٓ","أَرَٮٰكُم","بِخَيۡرٍ","وَإِنِّىٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","مُّحِيطٍ"],"11:85":["وَيَـٰقَوۡمِ","أَوۡفُواۡ","ٱلۡمِكۡيَالَ","وَٱلۡمِيزَانَ","بِٱلۡقِسۡطِ‌ۖ","وَلَا","تَبۡخَسُواۡ","ٱلنَّاسَ","أَشۡيَآءَهُمۡ","وَلَا","تَعۡثَوۡاۡ","فِى","ٱلۡأَرۡضِ","مُفۡسِدِينَ"],"11:86":["بَقِيَّتُ","ٱللَّهِ","خَيۡرٌ","لَّكُمۡ","إِن","كُنتُم","مُّؤۡمِنِينَ‌ۚ","وَمَآ","أَنَاۡ","عَلَيۡكُم","بِحَفِيظٍ"],"11:94":["وَلَمَّا","جَآءَ","أَمۡرُنَا","نَجَّيۡنَا","شُعَيۡبًا","وَٱلَّذِينَ","ءَامَنُواۡ","مَعَهُۥ","بِرَحۡمَةٍ","مِّنَّا","وَأَخَذَتِ","ٱلَّذِينَ","ظَلَمُواۡ","ٱلصَّيۡحَةُ","فَأَصۡبَحُواۡ","فِى","دِيَـٰرِهِمۡ","جَـٰثِمِينَ"],"11:95":["كَأَن","لَّمۡ","يَغۡنَوۡاۡ","فِيهَآ‌ۗ","أَلَا","بُعۡدًا","لِّمَدۡيَنَ","كَمَا","بَعِدَتۡ","ثَمُودُ"],"11:119":["إِلَّا","مَن","رَّحِمَ","رَبُّكَ‌ۚ","وَلِذٰلِكَ","خَلَقَهُمۡ‌ۗ","وَتَمَّتۡ","كَلِمَةُ","رَبِّكَ","لَأَمۡلَأَنَّ","جَهَنَّمَ","مِنَ","ٱلۡجِنَّةِ","وَٱلنَّاسِ","أَجۡمَعِينَ"],"12:40":["مَا","تَعۡبُدُونَ","مِن","دُونِهِۦٓ","إِلَّآ","أَسۡمَآءً","سَمَّيۡتُمُوهَآ","أَنتُمۡ","وَءَابَآؤُكُم","مَّآ","أَنزَلَ","ٱللَّهُ","بِهَا","مِن","سُلۡطَـٰنٍ‌ۚ","إِنِ","ٱلۡحُكۡمُ","إِلَّا","لِلَّهِ‌ۚ","أَمَرَ","أَلَّا","تَعۡبُدُوٓاۡ","إِلَّآ","إِيَّاهُ‌ۚ","ذٰلِكَ","ٱلدِّينُ","ٱلۡقَيِّمُ","وَلَـٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"12:109":["وَمَآ","أَرۡسَلۡنَا","مِن","قَبۡلِكَ","إِلَّا","رِجَالاً","نُّوحِىٓ","إِلَيۡهِم","مِّنۡ","أَهۡلِ","ٱلۡقُرَىٰٓ‌ۗ","أَفَلَمۡ","يَسِيرُواۡ","فِى","ٱلۡأَرۡضِ","فَيَنظُرُواۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ‌ۗ","وَلَدَارُ","ٱلۡأَخِرَةِ","خَيۡرٌ","لِّلَّذِينَ","ٱتَّقَوۡاۡ‌ۗ","أَفَلَا","تَعۡقِلُونَ"],"13:16":["قُلۡ","مَن","رَّبُّ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضِ","قُلِ","ٱللَّهُ‌ۚ","قُلۡ","أَفَٱتَّخَذۡتُم","مِّن","دُونِهِۦٓ","أَوۡلِيَآءَ","لَا","يَمۡلِكُونَ","لِأَنفُسِهِمۡ","نَفۡعًا","وَلَا","ضَرًّا‌ۚ","قُلۡ","هَلۡ","يَسۡتَوِى","ٱلۡأَعۡمَىٰ","وَٱلۡبَصِيرُ","أَمۡ","هَلۡ","تَسۡتَوِى","ٱلظُّلُمَـٰتُ","وَٱلنُّورُ‌ۗ","أَمۡ","جَعَلُواۡ","لِلَّهِ","شُرَكَآءَ","خَلَقُواۡ","كَخَلۡقِهِۦ","فَتَشَـٰبَهَ","ٱلۡخَلۡقُ","عَلَيۡهِمۡ‌ۚ","قُلِ","ٱللَّهُ","خَـٰلِقُ","كُلِّ","شَىۡءٍ","وَهُوَ","ٱلۡوٰحِدُ","ٱلۡقَهَّـٰرُ"],"14:6":["وَإِذۡ","قَالَ","مُوسَىٰ","لِقَوۡمِهِ","ٱذۡكُرُواۡ","نِعۡمَةَ","ٱللَّهِ","عَلَيۡكُمۡ","إِذۡ","أَنجَـٰكُم","مِّنۡ","ءَالِ","فِرۡعَوۡنَ","يَسُومُونَكُمۡ","سُوٓءَ","ٱلۡعَذَابِ","وَيُذَبِّحُونَ","أَبۡنَآءَكُمۡ","وَيَسۡتَحۡيُونَ","نِسَآءَكُمۡ‌ۚ","وَفِى","ذٰلِكُم","بَلَآءٌ","مِّن","رَّبِّكُمۡ","عَظِيمٌ"],"15:20":["وَجَعَلۡنَا","لَكُمۡ","فِيهَا","مَعَـٰيِشَ","وَمَن","لَّسۡتُمۡ","لَهُۥ","بِرٰزِقِينَ"],"15:31":["إِلَّآ","إِبۡلِيسَ","أَبَىٰٓ","أَن","يَكُونَ","مَعَ","ٱلسَّـٰجِدِينَ"],"15:36":["قَالَ","رَبِّ","فَأَنظِرۡنِىٓ","إِلَىٰ","يَوۡمِ","يُبۡعَثُونَ"],"15:37":["قَالَ","فَإِنَّكَ","مِنَ","ٱلۡمُنظَرِينَ"],"15:39":["قَالَ","رَبِّ","بِمَآ","أَغۡوَيۡتَنِى","لَأُزَيِّنَنَّ","لَهُمۡ","فِى","ٱلۡأَرۡضِ","وَلَأُغۡوِيَنَّهُمۡ","أَجۡمَعِينَ"],"16:12":["وَسَخَّرَ","لَكُمُ","ٱلَّيۡلَ","وَٱلنَّهَارَ","وَٱلشَّمۡسَ","وَٱلۡقَمَرَ‌ۖ","وَٱلنُّجُومُ","مُسَخَّرٰتُۢ","بِأَمۡرِهِۦٓ‌ۗ","إِنَّ","فِى","ذٰلِكَ","لَأَيَـٰتٍ","لِّقَوۡمٍ","يَعۡقِلُونَ"],"16:61":["وَلَوۡ","يُؤَاخِذُ","ٱللَّهُ","ٱلنَّاسَ","بِظُلۡمِهِم","مَّا","تَرَكَ","عَلَيۡهَا","مِن","دَآبَّةٍ","وَلَـٰكِن","يُؤَخِّرُهُمۡ","إِلَىٰٓ","أَجَلٍ","مُّسَمًّى‌ۖ","فَإِذَا","جَآءَ","أَجَلُهُمۡ","لَا","يَسۡتَــٔۡخِرُونَ","سَاعَةً‌ۖ","وَلَا","يَسۡتَقۡدِمُونَ"],"16:62":["وَيَجۡعَلُونَ","لِلَّهِ","مَا","يَكۡرَهُونَ","وَتَصِفُ","أَلۡسِنَتُهُمُ","ٱلۡكَذِبَ","أَنَّ","لَهُمُ","ٱلۡحُسۡنَىٰ‌ۖ","لَا","جَرَمَ","أَنَّ","لَهُمُ","ٱلنَّارَ","وَأَنَّهُم","مُّفۡرَطُونَ"],"17:61":["وَإِذۡ","قُلۡنَا","لِلۡمَلَـٰٓئِكَةِ","ٱسۡجُدُواۡ","لِأَدَمَ","فَسَجَدُوٓاۡ","إِلَّآ","إِبۡلِيسَ","قَالَ","ءَأَسۡجُدُ","لِمَنۡ","خَلَقۡتَ","طِينًا"],"17:97":["وَمَن","يَهۡدِ","ٱللَّهُ","فَهُوَ","ٱلۡمُهۡتَدِ‌ۖ","وَمَن","يُضۡلِلۡ","فَلَن","تَجِدَ","لَهُمۡ","أَوۡلِيَآءَ","مِن","دُونِهِۦ‌ۖ","وَنَحۡشُرُهُمۡ","يَوۡمَ","ٱلۡقِيَـٰمَةِ","عَلَىٰ","وُجُوهِهِمۡ","عُمۡيًا","وَبُكۡمًا","وَصُمًّا‌ۖ","مَّأۡوَٮٰهُمۡ","جَهَنَّمُ‌ۖ","كُلَّمَا","خَبَتۡ","زِدۡنَـٰهُمۡ","سَعِيرًا"],"18:17":["۞وَتَرَى","ٱلشَّمۡسَ","إِذَا","طَلَعَت","تَّزٰوَرُ","عَن","كَهۡفِهِمۡ","ذَاتَ","ٱلۡيَمِينِ","وَإِذَا","غَرَبَت","تَّقۡرِضُهُمۡ","ذَاتَ","ٱلشِّمَالِ","وَهُمۡ","فِى","فَجۡوَةٍ","مِّنۡهُ‌ۚ","ذٰلِكَ","مِنۡ","ءَايَـٰتِ","ٱللَّهِ‌ۗ","مَن","يَهۡدِ","ٱللَّهُ","فَهُوَ","ٱلۡمُهۡتَدِ‌ۖ","وَمَن","يُضۡلِلۡ","فَلَن","تَجِدَ","لَهُۥ","وَلِيًّا","مُّرۡشِدًا"],"18:50":["وَإِذۡ","قُلۡنَا","لِلۡمَلَـٰٓئِكَةِ","ٱسۡجُدُواۡ","لِأَدَمَ","فَسَجَدُوٓاۡ","إِلَّآ","إِبۡلِيسَ","كَانَ","مِنَ","ٱلۡجِنِّ","فَفَسَقَ","عَنۡ","أَمۡرِ","رَبِّهِۦٓ‌ۗ","أَفَتَتَّخِذُونَهُۥ","وَذُرِّيَّتَهُۥٓ","أَوۡلِيَآءَ","مِن","دُونِى","وَهُمۡ","لَكُمۡ","عَدُوُّۢ‌ۚ","بِئۡسَ","لِلظَّـٰلِمِينَ","بَدَلاً"],"20:65":["قَالُواۡ","يَـٰمُوسَىٰٓ","إِمَّآ","أَن","تُلۡقِىَ","وَإِمَّآ","أَن","نَّكُونَ","أَوَّلَ","مَنۡ","أَلۡقَىٰ"],"20:66":["قَالَ","بَلۡ","أَلۡقُواۡ‌ۖ","فَإِذَا","حِبَالُهُمۡ","وَعِصِيُّهُمۡ","يُخَيَّلُ","إِلَيۡهِ","مِن","سِحۡرِهِمۡ","أَنَّهَا","تَسۡعَىٰ"],"20:70":["فَأُلۡقِىَ","ٱلسَّحَرَةُ","سُجَّدًا","قَالُوٓاۡ","ءَامَنَّا","بِرَبِّ","هَـٰرُونَ","وَمُوسَىٰ"],"20:71":["قَالَ","ءَامَنتُمۡ","لَهُۥ","قَبۡلَ","أَنۡ","ءَاذَنَ","لَكُمۡ‌ۖ","إِنَّهُۥ","لَكَبِيرُكُمُ","ٱلَّذِى","عَلَّمَكُمُ","ٱلسِّحۡرَ‌ۖ","فَلَأُقَطِّعَنَّ","أَيۡدِيَكُمۡ","وَأَرۡجُلَكُم","مِّنۡ","خِلَـٰفٍ","وَلَأُصَلِّبَنَّكُمۡ","فِى","جُذُوعِ","ٱلنَّخۡلِ","وَلَتَعۡلَمُنَّ","أَيُّنَآ","أَشَدُّ","عَذَابًا","وَأَبۡقَىٰ"],"20:86":["فَرَجَعَ","مُوسَىٰٓ","إِلَىٰ","قَوۡمِهِۦ","غَضۡبَـٰنَ","أَسِفًا‌ۚ","قَالَ","يَـٰقَوۡمِ","أَلَمۡ","يَعِدۡكُمۡ","رَبُّكُمۡ","وَعۡدًا","حَسَنًا‌ۚ","أَفَطَالَ","عَلَيۡكُمُ","ٱلۡعَهۡدُ","أَمۡ","أَرَدتُّمۡ","أَن","يَحِلَّ","عَلَيۡكُمۡ","غَضَبٌ","مِّن","رَّبِّكُمۡ","فَأَخۡلَفۡتُم","مَّوۡعِدِى"],"20:89":["أَفَلَا","يَرَوۡنَ","أَلَّا","يَرۡجِعُ","إِلَيۡهِمۡ","قَوۡلاً","وَلَا","يَمۡلِكُ","لَهُمۡ","ضَرًّا","وَلَا","نَفۡعًا"],"20:116":["وَإِذۡ","قُلۡنَا","لِلۡمَلَـٰٓئِكَةِ","ٱسۡجُدُواۡ","لِأَدَمَ","فَسَجَدُوٓاۡ","إِلَّآ","إِبۡلِيسَ","أَبَىٰ"],"21:66":["قَالَ","أَفَتَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُكُمۡ","شَيۡــًٔا","وَلَا","يَضُرُّكُمۡ"],"23:23":["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦ","فَقَالَ","يَـٰقَوۡمِ","ٱعۡبُدُواۡ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَـٰهٍ","غَيۡرُهُۥٓ‌ۖ","أَفَلَا","تَتَّقُونَ"],"23:24":["فَقَالَ","ٱلۡمَلَؤُاۡ","ٱلَّذِينَ","كَفَرُواۡ","مِن","قَوۡمِهِۦ","مَا","هَـٰذَآ","إِلَّا","بَشَرٌ","مِّثۡلُكُمۡ","يُرِيدُ","أَن","يَتَفَضَّلَ","عَلَيۡكُمۡ","وَلَوۡ","شَآءَ","ٱللَّهُ","لَأَنزَلَ","مَلَـٰٓئِكَةً","مَّا","سَمِعۡنَا","بِهَـٰذَا","فِىٓ","ءَابَآئِنَا","ٱلۡأَوَّلِينَ"],"23:33":["وَقَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِهِ","ٱلَّذِينَ","كَفَرُواۡ","وَكَذَّبُواۡ","بِلِقَآءِ","ٱلۡأَخِرَةِ","وَأَتۡرَفۡنَـٰهُمۡ","فِى","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","مَا","هَـٰذَآ","إِلَّا","بَشَرٌ","مِّثۡلُكُمۡ","يَأۡكُلُ","مِمَّا","تَأۡكُلُونَ","مِنۡهُ","وَيَشۡرَبُ","مِمَّا","تَشۡرَبُونَ"],"23:102":["فَمَن","ثَقُلَتۡ","مَوٰزِينُهُۥ","فَأُوۡلَـٰٓئِكَ","هُمُ","ٱلۡمُفۡلِحُونَ"],"23:103":["وَمَنۡ","خَفَّتۡ","مَوٰزِينُهُۥ","فَأُوۡلَـٰٓئِكَ","ٱلَّذِينَ","خَسِرُوٓاۡ","أَنفُسَهُمۡ","فِى","جَهَنَّمَ","خَـٰلِدُونَ"],"25:3":["وَٱتَّخَذُواۡ","مِن","دُونِهِۦٓ","ءَالِهَةً","لَّا","يَخۡلُقُونَ","شَيۡــًٔا","وَهُمۡ","يُخۡلَقُونَ","وَلَا","يَمۡلِكُونَ","لِأَنفُسِهِمۡ","ضَرًّا","وَلَا","نَفۡعًا","وَلَا","يَمۡلِكُونَ","مَوۡتًا","وَلَا","حَيَوٰةً","وَلَا","نُشُورًا"],"25:48":["وَهُوَ","ٱلَّذِىٓ","أَرۡسَلَ","ٱلرِّيَـٰحَ","بُشۡرَۢا","بَيۡنَ","يَدَىۡ","رَحۡمَتِهِۦ‌ۚ","وَأَنزَلۡنَا","مِنَ","ٱلسَّمَآءِ","مَآءً","طَهُورًا"],"25:55":["وَيَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","مَا","لَا","يَنفَعُهُمۡ","وَلَا","يَضُرُّهُمۡ‌ۗ","وَكَانَ","ٱلۡكَافِرُ","عَلَىٰ","رَبِّهِۦ","ظَهِيرًا"],"25:59":["ٱلَّذِى","خَلَقَ","ٱلسَّمَـٰوٰتِ","وَٱلۡأَرۡضَ","وَمَا","بَيۡنَهُمَا","فِى","سِتَّةِ","أَيَّامٍ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِ‌ۚ","ٱلرَّحۡمَـٰنُ","فَسۡــَٔلۡ","بِهِۦ","خَبِيرًا"],"26:31":["قَالَ","فَأۡتِ","بِهِۦٓ","إِن","كُنتَ","مِنَ","ٱلصَّـٰدِقِينَ"],"26:32":["فَأَلۡقَىٰ","عَصَاهُ","فَإِذَا","هِىَ","ثُعۡبَانٌ","مُّبِينٌ"],"26:33":["وَنَزَعَ","يَدَهُۥ","فَإِذَا","هِىَ","بَيۡضَآءُ","لِلنَّـٰظِرِينَ"],"26:34":["قَالَ","لِلۡمَلَإِ","حَوۡلَهُۥٓ","إِنَّ","هَـٰذَا","لَسَـٰحِرٌ","عَلِيمٌ"],"26:35":["يُرِيدُ","أَن","يُخۡرِجَكُم","مِّنۡ","أَرۡضِكُم","بِسِحۡرِهِۦ","فَمَاذَا","تَأۡمُرُونَ"],"26:36":["قَالُوٓاۡ","أَرۡجِهۡ","وَأَخَاهُ","وَٱبۡعَثۡ","فِى","ٱلۡمَدَآئِنِ","حَـٰشِرِينَ"],"26:37":["يَأۡتُوكَ","بِكُلِّ","سَحَّارٍ","عَلِيمٍ"],"26:41":["فَلَمَّا","جَآءَ","ٱلسَّحَرَةُ","قَالُواۡ","لِفِرۡعَوۡنَ","أَئِنَّ","لَنَا","لَأَجۡرًا","إِن","كُنَّا","نَحۡنُ","ٱلۡغَـٰلِبِينَ"],"26:42":["قَالَ","نَعَمۡ","وَإِنَّكُمۡ","إِذًا","لَّمِنَ","ٱلۡمُقَرَّبِينَ"],"26:43":["قَالَ","لَهُم","مُّوسَىٰٓ","أَلۡقُواۡ","مَآ","أَنتُم","مُّلۡقُونَ"],"26:44":["فَأَلۡقَوۡاۡ","حِبَالَهُمۡ","وَعِصِيَّهُمۡ","وَقَالُواۡ","بِعِزَّةِ","فِرۡعَوۡنَ","إِنَّا","لَنَحۡنُ","ٱلۡغَـٰلِبُونَ"],"26:45":["فَأَلۡقَىٰ","مُوسَىٰ","عَصَاهُ","فَإِذَا","هِىَ","تَلۡقَفُ","مَا","يَأۡفِكُونَ"],"26:46":["فَأُلۡقِىَ","ٱلسَّحَرَةُ","سَـٰجِدِينَ"],"26:47":["قَالُوٓاۡ","ءَامَنَّا","بِرَبِّ","ٱلۡعَـٰلَمِينَ"],"26:48":["رَبِّ","مُوسَىٰ","وَهَـٰرُونَ"],"26:49":["قَالَ","ءَامَنتُمۡ","لَهُۥ","قَبۡلَ","أَنۡ","ءَاذَنَ","لَكُمۡ‌ۖ","إِنَّهُۥ","لَكَبِيرُكُمُ","ٱلَّذِى","عَلَّمَكُمُ","ٱلسِّحۡرَ","فَلَسَوۡفَ","تَعۡلَمُونَ‌ۚ","لَأُقَطِّعَنَّ","أَيۡدِيَكُمۡ","وَأَرۡجُلَكُم","مِّنۡ","خِلَـٰفٍ","وَلَأُصَلِّبَنَّكُمۡ","أَجۡمَعِينَ"],"26:50":["قَالُواۡ","لَا","ضَيۡرَ‌ۖ","إِنَّآ","إِلَىٰ","رَبِّنَا","مُنقَلِبُونَ"],"26:51":["إِنَّا","نَطۡمَعُ","أَن","يَغۡفِرَ","لَنَا","رَبُّنَا","خَطَـٰيَـٰنَآ","أَن","كُنَّآ","أَوَّلَ","ٱلۡمُؤۡمِنِينَ"],"26:119":["فَأَنجَيۡنَـٰهُ","وَمَن","مَّعَهُۥ","فِى","ٱلۡفُلۡكِ","ٱلۡمَشۡحُونِ"],"26:173":["وَأَمۡطَرۡنَا","عَلَيۡهِم","مَّطَرًا‌ۖ","فَسَآءَ","مَطَرُ","ٱلۡمُنذَرِينَ"],"27:14":["وَجَحَدُواۡ","بِهَا","وَٱسۡتَيۡقَنَتۡهَآ","أَنفُسُهُمۡ","ظُلۡمًا","وَعُلُوًّا‌ۚ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَـٰقِبَةُ","ٱلۡمُفۡسِدِينَ"],"27:54":["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","أَتَأۡتُونَ","ٱلۡفَـٰحِشَةَ","وَأَنتُمۡ","تُبۡصِرُونَ"],"27:55":["أَئِنَّكُمۡ","لَتَأۡتُونَ","ٱلرِّجَ