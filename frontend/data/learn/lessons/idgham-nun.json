": "idgham_wo_ghunnah"}, {"t": "َّدُنۡهُ"}], "text": "لَّدُنۡهُ"}], "hl": [5, 6], "note": "ل", "rule": "idgham-no-ghunnah"}, {"surah": 2, "ayah": 5, "words": [{"p": 4, "segs": [{"t": "م", "r": "idgham_ghunnah"}, {"t": "ّ"}, {"t": "ِن", "r": "idgham_wo_ghunnah"}], "text": "مِّن"}, {"p": 5, "segs": [{"t": "ر", "r": "idgham_wo_ghunnah"}, {"t": "َّبِّهِمۡ‌ۖ"}], "text": "رَّبِّهِمۡ‌ۖ"}], "hl": [4, 5], "note": "ر", "rule": "idgham-no-ghunnah"}]}, {"t": "md", "html": "<h3>وفي التنوين، الحكم نفسه</h3>"}, {"t": "examples", "rule": "idgham-ghunnah", "title": null, "items": [{"surah": 99, "ayah": 7, "words": [{"p": 5, "segs": [{"t": "خَيۡ"}, {"t": "رًا", "r": "idgham_ghunnah"}], "text": "خَيۡرًا"}, {"p": 6, "segs": [{"t": "ي", "r": "idgham_ghunnah"}, {"t": "َرَهُۥ"}], "text": "يَرَهُۥ"}], "hl": [5, 5], "note": "ي", "rule": "idgham-ghunnah"}, {"surah": 75, "ayah": 22, "words": [{"p": 1, "segs": [{"t": "وُجُو"}, {"t": "هٌ", "r": "idgham_ghunnah"}], "text": "وُجُوهٌ"}, {"p": 2, "segs": [{"t": "ي", "r": "idgham_ghunnah"}, {"t": "َوۡمَئِ"}, {"t": "ذٍ", "r": "idgham_ghunnah"}], "text": "يَوۡمَئِذٍ"}, {"p": 3, "segs": [{"t": "ن", "r": "idgham_ghunnah"}, {"t": "َّاضِرَةٌ"}], "text": "نَّاضِرَةٌ"}], "hl": [2, 3], "note": "ن", "rule": "idgham-ghunnah"}, {"surah": 2, "ayah": 142, "words": [{"p": 20, "segs": [{"t": "صِر"}, {"t": "ٰ", "r": "madda_normal"}, {"t": "طٍ", "r": "idgham_ghunnah"}], "text": "صِرٰطٍ"}, {"p": 21, "segs": [{"t": "م", "r": "idgham_ghunnah"}, {"t": "ُّسۡتَق"}, {"t": "ِي", "r": "madda_permissible"}, {"t": "مٍ"}], "text": "مُّسۡتَقِيمٍ"}], "hl": [20, 20], "note": "م", "rule": "idgham-ghunnah"}, {"surah": 2, "ayah": 7, "words": [{"p": 9, "segs": [{"t": "غِشَ"}, {"t": "ـٰ", "r": "madda_normal"}, {"t": "وَ"}, {"t": "ةٌ‌ۖ", "r": "idgham_ghunnah"}], "text": "غِشَـٰوَةٌ‌ۖ"}, {"p": 10, "segs": [{"t": "و", "r": "idgham_ghunnah"}, {"t": "َلَهُمۡ"}], "text": "وَلَهُمۡ"}], "hl": [9, 9], "note": "و", "rule": "idgham-ghunnah"}]}, {"t": "examples", "rule": "idgham-no-ghunnah", "title": null, "items": [{"surah": 2, "ayah": 2, "words": [{"p": 6, "segs": [{"t": "هُ"}, {"t": "دًى", "r": "idgham_wo_ghunnah"}], "text": "هُدًى"}, {"p": 7, "segs": [{"t": "ل", "r": "idgham_wo_ghunnah"}, {"t": "ِّلۡمُتَّق"}, {"t": "ِي", "r": "madda_permissible"}, {"t": "نَ"}], "text": "لِّلۡمُتَّقِينَ"}], "hl": [6, 6], "note": "ل", "rule": "idgham-no-ghunnah"}, {"surah": 2, "ayah": 173, "words": [{"p": 24, "segs": [{"t": "غَفُو"}, {"t": "رٌ", "r": "idgham_wo_ghunnah"}], "text": "غَفُورٌ"}, {"p": 25, "segs": [{"t": "ر", "r": "idgham_wo_ghunnah"}, {"t": "َّح"}, {"t": "ِي", "r": "madda_permissible"}, {"t": "مٌ"}], "text": "رَّحِيمٌ"}], "hl": [24, 24], "note": "ر", "rule": "idgham-no-ghunnah"}]}, {"t": "md", "html": "<h2>المصحف يكشف لك الحكم</h2>"}, {"t": "callout", "kind": "rule", "html": "<p>انظر إلى <strong>الشدّة</strong> على الحرف الثاني، وإلى <strong>السكون</strong> على النون:</p>\n<ul>\n<li>النون <strong>بلا سكون</strong>، والحرف بعدها <strong>مشدَّد</strong> ← إدغام.</li>\n<li>النون <strong>عليها سكون</strong> ← إظهار أو إخفاء، لا إدغام.</li>\n</ul>"}, {"t": "md", "html": "<p>وفي حروف الغنّة الأربعة تفصيلٌ ألطف: مع <strong>النون والميم</strong> ترى الشدّة على الحرف الثاني، ومع <strong>الواو والياء</strong> لا ترى شدّة. وذلك لأنّ الإدغام في الواو والياء <strong>ناقص</strong>: تذهب ذات النون وتبقى غنّتها، فلا يتمّ التشديد.</p>"}, {"t": "ayah", "surah": 77, "ayah": 20, "name": "المرسلات", "words": [{"p": 3, "segs": [{"t": "م", "r": "idgham_shafawi"}, {"t": "ّ"}, {"t": "ِن", "r": "idgham_ghunnah"}], "text": "مِّن"}, {"p": 4, "segs": [{"t": "م", "r": "idgham_ghunnah"}, {"t": "ّ"}, {"t": "َا", "r": "madda_obligatory_mottasel"}, {"t": "ٓ"}, {"t": "ءٍ", "r": "idgham_ghunnah"}], "text": "مَّآءٍ"}, {"p": 5, "segs": [{"t": "م", "r": "idgham_ghunnah"}, {"t": "َّه"}, {"t": "ِي", "r": "madda_permissible"}, {"t": "نٍ"}], "text": "مَّهِينٍ"}], "whole": false, "marks": [{"from": 3, "to": 4, "rule": "idgham-ghunnah"}], "note": "لاحِظ الشدّة على الميم، والنون بلا سكون. هذا إدغامٌ كامل."}, {"t": "ayah", "surah": 13, "ayah": 11, "name": "الرعد", "words": [{"p": 34, "segs": [{"t": "م"}, {"t": "ِن", "r": "idgham_ghunnah"}], "text": "مِن"}, {"p": 35, "segs": [{"t": "و", "r": "idgham_ghunnah"}, {"t": "َا", "r": "madda_permissible"}, {"t": "لٍ"}], "text": "وَالٍ"}], "whole": false, "marks": [{"from": 34, "to": 35, "rule": "idgham-ghunnah"}], "note": "لا شدّة على الواو، والنون بلا سكون. هذا إدغامٌ ناقص، تبقى فيه الغنّة."}, {"t": "md", "html": "<h2>الاستثناء: الإظهار المطلق</h2>"}, {"t": "callout", "kind": "warning", "html": "<p>شرط الإدغام أن تكون النون في <strong>آخر كلمة</strong> والحرف في <strong>أوّل الكلمة التي بعدها</strong>. فإن اجتمعا في كلمةٍ واحدةٍ وجب <strong>الإظهار</strong>، ويسمّى <span class=\"q-inline\">«الإظهار المطلق»</span> لأنّه لم يُقيَّد بحلقٍ ولا شفة.</p>\n<p>ولم يقع ذلك في القرآن إلّا في <strong>أربع كلمات</strong>.</p>"}, {"t": "examples", "rule": "izhar", "title": null, "items": [{"surah": 2, "ayah": 85, "words": [{"p": 37, "segs": [{"t": "ٱ", "r": "ham_wasl"}, {"t": "لۡحَيَ"}, {"t": "و", "r": "slnt"}, {"t": "ٰ", "r": "madda_normal"}, {"t": "ةِ"}], "text": "ٱلۡحَيَوٰةِ"}, {"p": 38, "segs": [{"t": "ٱ", "r": "ham_wasl"}, {"t": "ل", "r": "laam_shamsiyah"}, {"t": "دُّنۡيَا‌ۖ"}], "text": "ٱلدُّنۡيَا‌ۖ"}], "hl": [38, 38], "note": "الدنيا", "rule": "izhar"}, {"surah": 61, "ayah": 4, "words": [{"p": 10, "segs": [{"t": "ب", "r": "ikhafa_shafawi"}, {"t": "ُنۡيَ"}, {"t": "ـٰ", "r": "madda_normal"}, {"t": "نٌ", "r": "idgham_ghunnah"}], "text": "بُنۡيَـٰنٌ"}, {"p": 11, "segs": [{"t": "م", "r": "idgham_ghunnah"}, {"t": "َّرۡص"}, {"t": "ُو", "r": "madda_permissible"}, {"t": "صٌ"}], "text": "مَّرۡصُوصٌ"}], "hl": [10, 10], "note": "بُنيان", "rule": "izhar"}, {"surah": 13, "ayah": 4, "words": [{"p": 9, "segs": [{"t": "و", "r": "idgham_ghunnah"}, {"t": "َنَخِي"}, {"t": "لٌ", "r": "ikhafa"}], "text": "وَنَخِيلٌ"}, {"p": 10, "segs": [{"t": "ص", "r": "ikhafa"}, {"t": "ِنۡوَا"}, {"t": "نٌ", "r": "idgham_ghunnah"}], "text": "صِنۡوَانٌ"}], "hl": [10, 10], "note": "صِنوان", "rule": "izhar"}, {"surah": 6, "ayah": 99, "words": [{"p": 23, "segs": [{"t": "قِنۡوَا"}, {"t": "نٌ", "r": "ikhafa"}], "text": "قِنۡوَانٌ"}, {"p": 24, "segs": [{"t": "د", "r": "ikhafa"}, {"t": "َانِيَ"}, {"t": "ةٌ", "r": "idgham_ghunnah"}], "text": "دَانِيَةٌ"}], "hl": [23, 23], "note": "قِنوان", "rule": "izhar"}]}, {"t": "callout", "kind": "note", "html": "<p><strong>لماذا مُنِع الإدغام في هذه الأربع؟</strong> لأنّه لو أُدغِمت النون لالتبست الكلمة بكلمةٍ أخرى مضاعَفة الحروف، فيضيع أصل بنائها ومعناها. فبقيت النون ظاهرةً حفظًا للكلمة.</p>\n<p>وانتبِه: <strong>قِنوان في سورة الأنعام، وصِنوان في سورة الرعد.</strong> يخلط بينهما كثيرٌ من الكتب لتشابه صورتهما.</p>"}, {"t": "md", "html": "<h2>الخطأ الشائع</h2>"}, {"t": "mistake", "wrong": "إبقاء أثرٍ من النون قبل الحرف المشدَّد، فتُسمَع <span class=\"q-inline\">«مِنْ رَّبِّهِمْ»</span> بنونٍ خفيّةٍ ثمّ راء.", "right": "راءٌ مشدَّدةٌ خالصةٌ بلا أثرٍ للنون، وبلا غنّة.", "why": "الإدغام في اللام والراء <strong>كامل</strong>: تذهب النون ذاتًا وصفةً. فإن بقي منها شيءٌ لم يكن إدغامًا. والغنّة هنا خطأٌ صريح."}, {"t": "quiz", "title": null, "questions": [{"id": "idgham-nun-1", "q": "ما حكم النون في <span class=\"q-inline\">«مِن لَّدُنْهُ»</span>؟", "options": ["إدغامٌ بغير غنّة", "إدغامٌ بغنّة", "إظهار", "إخفاء"], "answer": 0, "why": "اللام والراء من حروف الإدغام، والإدغام فيهما بلا غنّة. فتُنطق لامًا مشدَّدةً خالصة.", "lesson": "idgham-nun", "surah": 18, "ayah": 2, "words": [{"p": 5, "segs": [{"t": "م", "r": "idgham_ghunnah"}, {"t": "ّ"}, {"t": "ِن", "r": "idgham_wo_ghunnah"}], "text": "مِّن"}, {"p": 6, "segs": [{"t": "ل", "r": "idgham_wo_ghunnah"}, {"t": "َّدُنۡهُ"}], "text": "لَّدُنۡهُ"}]}, {"id": "idgham-nun-2", "q": "ما حكم النون في <span class=\"q-inline\">«الدُّنْيَا»</span>؟", "options": ["إظهارٌ مطلق", "إدغامٌ بغنّة", "إخفاء", "إظهارٌ حلقيّ"], "answer": 0, "why": "النون والياء اجتمعتا في كلمةٍ واحدة، والإدغام يشترط أن يكونا في كلمتين. فوجب الإظهار، وهو المسمّى بالإظهار المطلق.", "lesson": "idgham-nun", "surah": 2, "ayah": 85, "words": [{"p": 38, "segs": [{"t": "ٱ", "r": "ham_wasl"}, {"t": "ل", "r": "laam_shamsiyah"}, {"t": "دُّنۡيَا‌ۖ"}], "text": "ٱلدُّنۡيَا‌ۖ"}]}, {"id": "idgham-nun-3", "q": "كم كلمةً في القرآن فيها الإظهار المطلق؟", "options": ["أربع كلمات", "ستّ كلمات", "كلمتان", "خمس عشرة كلمة"], "answer": 0, "why": "أربعٌ فقط، وهي الدنيا وبُنيان وصِنوان وقِنوان.", "lesson": "idgham-nun"}]}]}