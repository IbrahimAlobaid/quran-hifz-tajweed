[{"key": "tuhfah", "title": "تحفة الأطفال والغلمان في تجويد القرآن", "author": "سليمان الجمزوري", "source": "ويكي مصدر (ar.wikisource.org)", "sections": [{"title": "المقدمة", "lines": [{"n": 1, "a": "يَقُــولُ رَاجِـي رَحمةِ الْغَـفُـورِ", "b": "دَوْمَـاً سُلَـيْمَانُ هُـوَ الْجَمـْزُورِى"}, {"n": 2, "a": "الْحَمْــدُ لِلَّــهِ مُصَـلّـِياً عَـلـى", "b": "مُـحَمَـــدٍ وآلِــهِ وَمَـنْ تَـلاَ"}, {"n": 3, "a": "وَبَعْـدُ هـذَا النَّـظْـمُ لِلْـمُرِيــدِ", "b": "فــي النُـونِ والتَّـنْوِينِ وَالْمُدُودِ"}, {"n": 4, "a": "سَــمَّيتُــهُ بِتُحفَـة الأَطْفَالِ", "b": "عَـنْ شَيْـخِنَا الْمِيـهِىِّ ذِي الْكَمالِ"}, {"n": 5, "a": "أَرْجُــو بِـه أَنْ يَنْـفَعَ الطُّـلاَّبَـا", "b": "وَالأَجْــرَ وَالْقَـبُـولَ وَالثَّـوَابـا"}]}, {"title": "النون الساكنة والتنوين", "lines": [{"n": 6, "a": "لِلـنُّــونِ إِنْ تَسْـكُنْ وَلِلتّـَنْوِينِ", "b": "أَرْبَـعُ أَحْكَـامٍ فَخُـذْ تَبْـيِـيـنِـي"}, {"n": 7, "a": "فَـالأَوَّلُ الإظْـهَارُ قَـبْـلَ أَحْـرُفِ", "b": "لِلْحَـلْـقِ سِـتٍ رُتِّبَتْ فَلـتَـعْرِفِ"}, {"n": 8, "a": "هَمْـزٌ فَـهَـاءٌ ثُـمَّ عَـيْـنٌ حَـاءُ", "b": "مُـهْمَلَـتَانِ ثُــمَّ غَيْـنٌ خَــاءُ"}, {"n": 9, "a": "والـثّـَانـي إِدْغَـامٌ بِسـتَّةٍ أَتَـتْ", "b": "فِـي يَـرْمَـلُـونَ عِنْدَهُمْ قَدْ ثَبَتَتْ"}, {"n": 10, "a": "لَـكِنَّهَا قِسْـمَانِ قِسْــمٌ يُـدْغَـمَا", "b": "فِـيهِ بِـغُـنّـَةٍ بِيَـنْـمُو عُلِـمَـا"}, {"n": 11, "a": "إِلاَّ إِذَا كَـانَـا بِـكــِلْمَـةٍ فَــلاَ", "b": "تُـدْغِـمْ كَدُنْـيَا ثُمَّ صِـنْوَانٍ تَـلاَ"}, {"n": 12, "a": "وَالثَّـانـي إِدْغَــامٌ بِغَيْــرِ غُـنَّةْ", "b": "فـي الـلاَّمِ وَالـرَّا ثُـمَّ كَـرّرَنَّـهْ"}, {"n": 13, "a": "وَّالثَـالـثُ الإِقْـلاَبُ عِنْـدَ الْبَـاءِ", "b": "مِيــماً بِغُـنَــةٍ مَـعَ الإِخْـفَـاءِ"}, {"n": 14, "a": "وَالرَّابِـعُ الإِخْـفَاءُ عِنْـدَ الْفاضِـلِ", "b": "مِـنَ الحُـرُوفِ وَاجِـبٌ لِلْفَاضِـلِ"}, {"n": 15, "a": "فـي خَمْسَـةٍ مِنْ بَعْدِ عَشْرٍ رَمْزُهَا", "b": "فِـي كِلْمِ هذَا البَيْتِ قَـدْ ضَمَّنـْتُـهَا"}, {"n": 16, "a": "صِفْ ذَا ثَـنَا كَمْ جَادَ شَخْصٌ قَدْ سمَا", "b": "دُمْ طَيّـَباً زِدْ فِي تُـقَىً ضَعْ ظَالِـمَا"}]}, {"title": "الميم والنون المشددتين", "lines": [{"n": 17, "a": "وَغُـنَّ مِيـماً ثُـمَّ نُونـاً شُــدِّدَا", "b": "وَسَــمِّ كُـلاً حَـرْفَ غُـنَّةٍ بَـدَا"}]}, {"title": "الميم الساكنة", "lines": [{"n": 18, "a": "وَالِميـمُ إِنْ تَسْـكُنْ تَجِى قَبْلَ الْهِجَا", "b": "لاَ أَلــفٍ لَيِّــنَةٍ لِــذِى الْحِـجَا"}, {"n": 19, "a": "أَحْـكَامُـهَا ثَـلاَثَـةٌ لِمَـنْ ضَبَـطْ", "b": "إِخْـفَاءٌ ادْغَـامٌ وَإِظْـهَـارٌ فَقَــطْ"}, {"n": 20, "a": "فَـالأَوَّلُ الإِخْـفَـاءُ عِنْـدَ الْبَــاءِ", "b": "وَسَـمِّـهِ الشَّفْــوِىَّ لِلْـقُــرَّاءِ"}, {"n": 21, "a": "وَالثّـَانـى إِدْغَـامٌ بِمِـثْلِـهَا أَتَـى", "b": "وَسَـمِّ إدغـاماً صَـغـِيراً يَا فَـتَى"}, {"n": 22, "a": "وَالثـَّالِـثُ الإِظْـهَارُ فِـى الْبَقِيَّـةْ", "b": "مِـنْ أَحْـرُفٍ وَسَـمِّـهَا شَفْوِيَّـهْ"}, {"n": 23, "a": "وَاحْـذَرْ لَدَى وَاوٍ وَفَـا أَنْ تَخْتَـفىِ", "b": "لِـقُـرْبِــهَا وَلاتحادِ فَاعْـرِفِ"}]}, {"title": "لام آل ولام الفعل", "lines": [{"n": 24, "a": "لِلاَمِ أَلْ حَـالاَنِ قَـبْـلَ الأَحْــرُفِ", "b": "أُولاَهُــمَا إِظْـهَـارُهَا فَلْتـَعْـرِفِ"}, {"n": 25, "a": "قَبْلَ ارْبَـعٍ مَعْ عَشْرَةٍ خُـذْ عِلْمَـهُ", "b": "مِنَ ابْـغِ حَجَّـكَ وَخَـفْ عَقِيـمـهُ"}, {"n": 26, "a": "ثَانِيـهِـمَا إِدْغَـامُـهَا فـى أَرْبَـعٍ", "b": "وَعَـشْـرَةٍ أَيْـضاً وَرَمْـزَهَا فَـعِ"}, {"n": 27, "a": "طِبْ ثُمَّ صِلْ رُحْمَاً تَفُـزْ ضِفْ ذَا نِعَم", "b": "دَعْ سُـوءَ ظَنٍ زُرْ شَرِيـفَاً لِلْكَـرَم"}, {"n": 28, "a": "وَاللاَّمَ الاُولَـى سَـمِّـهَا قَمْـرِيَّـهْ", "b": "وَالـلاَّمَ الاُخْـرىَ سَمِّـهَا شَمْسِـيَّهْ"}, {"n": 29, "a": "وأظْـهِـرَنَّ لاَمَ فِـعْــلٍ مُطْلَــقاً", "b": "فـى نَحْـوِ قُلْ نَعَمْ وَقُلْـنَا وَالْتَقَـى"}]}, {"title": "المثلين والمتقاربين والمتجانسين", "lines": [{"n": 30, "a": "إِنْ فِي الصِّفَاتِ وَالمَخَـارِجِ اتَّفَـقْ", "b": "حَـرْفَانِ فَالْمِثْـلاَنِ فِـيهِـمَا أَحَـقْ"}, {"n": 31, "a": "وَإِنْ يَكُـونَا مَخْـرَجـا ًتَـقَـارَبَـا", "b": "وَفـي الصِّـفَاتِ اخْتَـلَـفَا يُلَقَّــبَا"}, {"n": 32, "a": "مُـتْـقَارِبَـيْنِ أَوْ يَكُــونَا اتَّفَـقَا", "b": "فِـي مَـخْرَجٍ دُونَ الصِّفَاتِ حُقِّـقَا"}, {"n": 33, "a": "بِالْمُتَجَانِسَــيْنِ ثُــمَّ إِنْ سـَكَـنْ", "b": "أَوَّلُ كُـلٍّ فَالصَّـغِـيرَ سَـمِّـيَـنْ"}, {"n": 34, "a": "أَوْ حُـرِّكَ الحَـرْفَـانِ فى كُلٍّ فَقُـلْ", "b": "كُـلٌّ كَبِــيرُ وافْهَمَـنْـهُ بِالْمُـثُلْ"}]}, {"title": "أقسام المد", "lines": [{"n": 35, "a": "وَالمـَدُّ أَصْلِـىُّ وَ فَـرْعِــىٌّ لَـهُ", "b": "وَسَــمِّ أَوَّلاً طَبِيـعِـيّاً وَهُـــو"}, {"n": 36, "a": "مَـالاَ تَوَقُّـفٌ لَـهُ عَـلـى سَـبَبْ", "b": "وَلابِـدُونِهِ الحُـرُوفُ تُجْـتَـلَـبْ"}, {"n": 37, "a": "بلْ أَىُّ حَرْفٍ غَيْرُ هَمْزٍ أَوْ سُـكُونْ", "b": "جَا بَعْـدَ مَـدٍّ فَالطَّبِــيِعىَّ يَكُـونْ"}, {"n": 38, "a": "وَالآخَرُ الْفَرْعِـىُّ مَوْقُـوفٌ عَلـي", "b": "سَـبَبْ كَهَمْزٍ أَوْ سُكُونٍ مُسْـجَـلاً"}, {"n": 39, "a": "حُـرُوفُــهُ ثَـــلاَثَـةٌ فَعِـيـهَا", "b": "مِنْ لَفْـظِ وَاىٍ وَهْىَ فى نُوحِـيـهَا"}, {"n": 40, "a": "وَالكَسْرُ قَبْـلَ الْيَا وَقَبْلَ الْواوِ ضَـمْ", "b": "شَـرْطٌ وَفَـتْحٌ قَبْـلَ أَلفٍ يُلْتَــزَمْ"}, {"n": 41, "a": "وَاللِّـينُ مِنْـهَا الْيَا وَوَاوٌ سَـكَـنَا", "b": "إِنِ انْفِــتَاحٌ قَبْـلَ كُـلٍّ أُعْـلِـنَا"}]}, {"title": "أحكام المد", "lines": [{"n": 42, "a": "لِلْمَــدِّ أَحْـكَـامٌ ثَـلاَثَـةٌ تَـدُومْ", "b": "وَهْـيَ الْوُجُوبُ وَالْجَوَازُ وَاللُّـزُومْ"}, {"n": 43, "a": "فَـوَاجِبٌ إِنْ جَـاءَ هَمْـزٌ بَعْدَ مَـدْ", "b": "فِـي كِلْمَــةٍ وَذَا بِمُتَّصْــلٍ يُعَـدْ"}, {"n": 44, "a": "وَجَـائـزٌ مَـدٌ وَقَصْـرٌ إِنْ فُصِـل", "b": "كُـلٌّ بِكِلْمَــةٍ وَهَذَا المُـنْفَصِــلْ"}, {"n": 45, "a": "وَمِثـْلُ ذَا إِنْ عَـرَضَ السُّـكُـونُ", "b": "وَقْـفَاً كَتَعْـلَـمُـونَ نَسْـتَعِــينُ"}, {"n": 46, "a": "أَوْ قُـدِّمَ الْهَمْـزُ عَـلَـي المَـدِّ وَذَا", "b": "بَـدَلْ كَـآمَـنُوا وَإِيَـماناً خُــذَا"}, {"n": 47, "a": "وَلاَزِمٌ إِنِ السُّـكُـونُ أُصِّــــلاَ", "b": "وَصْلاَ وَوَقْـفاً بَعْـدَ مَـدٍّ طُــوّلاَ"}]}, {"title": "أقسام المد اللازم", "lines": [{"n": 48, "a": "أَقْسَــامُ لاَزِمٍ لَـدَيهم أَرْبَـعَـةْ", "b": "وَتِـلْكَ كِـلْمِـيُّ وَحَرْفِـيٌّ مَعَــهْ"}, {"n": 49, "a": "كِـلاَهُـمَا مُـخَـفَّـفٌ مُـثَـقَّـلُ", "b": "فَـهَـــذِهِ أَرْبَـعَـةٌ تُـفَصَّــلُ"}, {"n": 50, "a": "فَـإِنْ بِـكِلْمَـةٍ سُـكُونٌ اجْـتَمَـعْ", "b": "مَـعْ حَرْفِ مَـدٍّ فَهْوَ كِلْمِـيُّ وَقَـعْ"}, {"n": 51, "a": "أَوْ فـي ثُـلاَثِـيِّ الحُرُوفِ وُجِـدَا", "b": "وَالمَـدُّ وَسْـطُهُ فَحَـرْفِــيٌّ بَـدَا"}, {"n": 52, "a": "كِـلاَهُـمَا مُثَـــقّـلٌ إِنْ أُدْغِـمَا", "b": "مَخَفَّـفٌ كُــلُّ إِذَا لَـمْ يُـدْغَـمَا"}, {"n": 53, "a": "وَالـلاَّزِمُ الْحَـرفِـيُّ أَوَّلَ السُّــوَرْ", "b": "وُجُـودُهُ وَفِـي ثَمَـانٍ انحَصَــرْ"}, {"n": 54, "a": "يَـجْمَعُـهَا حُـرُوفُ كَمْ عَسَلْ نَقَصْ", "b": "وَعَيْنُ ذُو وَجْهَـيْنِ والطُّولُ أَخَصْ"}, {"n": 55, "a": "وَمَا سِوَي الحَرْفِ الثُّلاَثِي لاَ أَلِـفْ", "b": "فـَمُـدُّه مَـدّاً طَبِيـعِـيَّا أُلِــفْ"}, {"n": 56, "a": "وَذَاكَ أَيْضـاً فِـي فَـوَاتِحِ السُّـوَرْ", "b": "فِي لَفْظِ حَيٍّ طَـاهِرٍ قَـدِ انْحَصَـرْ"}, {"n": 57, "a": "وَيَجْمَـعُ الْفَوَاتِـحَ الأَرْبَـعْ عَشَـرْ", "b": "صِلْهُ سُحَيْراً مَنْ قَطَعْك ذَا اشْـتَهَرْ"}]}, {"title": "الخاتمة", "lines": [{"n": 58, "a": "وَتَــمَّ ذَا النَّـظْمُ بِحَـمْدِ اللَّـــهِ", "b": "عَـلَـى تَمَامِـهِ بِـلاَ تَــنَاهِـى"}, {"n": 59, "a": "أَبْـيَاتُـهُ نَـدٌّ بَـداَ لِـذِى النُّـهَى", "b": "تَارِيخُهُ بُشْـرَى لِمَـنْ يُـتْقِـنُـهَا"}, {"n": 60, "a": "ثُـمَّ الصَّـلاَةُ وَالسَّــلاَمُ أَبَـــداَ", "b": "عِـلـى خِـتَامِ الأَنْبِـيَاءِ أَحْـمَـدَا"}, {"n": 61, "a": "وَالآلِ وَالصَّــحْبِ وَكُـلِّ تَـابِـعِ", "b": "وَكُــلِّ قَـارِئٍ وكُـلِّ سَــامِـعِ"}]}]}, {"key": "jazariyyah", "title": "المقدمة فيما يجب على قارئ القرآن أن يعلمه (الجزرية)", "author": "محمد بن الجزري", "source": "ويكي مصدر (ar.wikisource.org)", "sections": [{"title": "المقدمة", "lines": [{"n": 1, "a": "يقول راجي عفو رب سامع", "b": "محمد بن الجزري الشافعي"}, {"n": 2, "a": "الحمد لله وصلى الله", "b": "على نبيه ومصطفاه"}, {"n": 3, "a": "محمد وآله وصحبه", "b": "ومقرئ القرآن مع محبه"}, {"n": 4, "a": "وبعد إن هذه مقدمه", "b": "فيما على قارئه أن يعلمه"}, {"n": 5, "a": "إذ واجب عليهم محتم", "b": "قبل الشروع أولا أن يعلموا"}, {"n": 6, "a": "مخارج الحروف والصفات", "b": "ليلفظوا بأفصح اللغات"}, {"n": 7, "a": "محرري التجويد والمواقف", "b": "وما الذي رسم في المصاحف"}, {"n": 8, "a": "من كل مقطوع وموصول بها", "b": "وتاء أنثى لم تكن تكتب بها"}]}, {"title": "باب مخارج الحروف", "lines": [{"n": 9, "a": "مخارج الحروف سبعة عشر", "b": "على الذي يختاره من اختبر"}, {"n": 10, "a": "فألف الجوف وأختاها وهي", "b": "حروف مد للهواء تنتهي"}, {"n": 11, "a": "ثم لأقصى الحلق همز هاء", "b": "ثم لوسطه فعين حاء"}, {"n": 12, "a": "أدناه غين خاؤها والقاف", "b": "أقصى اللسان فوق ثم الكاف"}, {"n": 13, "a": "أسفل والوسط فجيم الشين يا", "b": "والضاد من حافته إذ وليا"}, {"n": 14, "a": "لاضراس من أيسر أو يمناها", "b": "واللام أدناها لمنتهاها"}, {"n": 15, "a": "والنون من طرفه تحت اجعلوا", "b": "والرا يدانيه لظهر أدخل"}, {"n": 16, "a": "والطاء والدال وتا منه ومن", "b": "عليا الثنايا والصفير مستكن"}, {"n": 17, "a": "من طرفيهما ومن بطن الشفة", "b": "فالفا مع اطراف الثنايا المشرفة"}, {"n": 18, "a": "للشفتين الواو باء ميم", "b": "وغنة مخرجها الخيشوم"}]}, {"title": "صفات الحروف", "lines": [{"n": 19, "a": "صفاتها جهر ورخو مستفل", "b": "منفتح مصمتة والضد قل"}, {"n": 20, "a": "مهموسها فحثه شخص سكت", "b": "شديدها لفظ أجد قط بكت"}, {"n": 21, "a": "وبين رخو والشديد لن عمر", "b": "وسبع علو خص ضغط قظ حصر"}, {"n": 22, "a": "وصاد ضاد طاء ظاء مطبقة", "b": "وفر من لب الحروف المذلقة"}, {"n": 23, "a": "صفيرها صاد وزاي سين", "b": "قلقلة قطب جد واللين"}, {"n": 24, "a": "واو وياء سكنا وانفتحا", "b": "قبلهما والانحراف صححا"}, {"n": 25, "a": "في اللام والرا وبتكرير جعل", "b": "وللتفشي الشين ضادا استطل"}]}, {"title": "باب معرفة التجويد", "lines": [{"n": 26, "a": "والأخذ بالتجويد حتم لازم", "b": "من لم يجود القرآن آثم"}, {"n": 27, "a": "لأنه به الإله أنزلا", "b": "وهكذا منه إلينا وصلا"}, {"n": 28, "a": "وهو أيضا حلية التلاوة", "b": "وزينة الأداء والقراءة"}, {"n": 29, "a": "وهو إعطاء الحروف حقها", "b": "من صفة لها ومستحقها"}, {"n": 30, "a": "ورد كل واحد لأصله", "b": "واللفظ في نظيره كمثله"}, {"n": 31, "a": "مكملا من غير ما تكلف", "b": "باللطف في النطق بلا تعسف"}, {"n": 32, "a": "وليس بينه وبين تركه", "b": "سوى رياضة امرئ بفكه"}]}, {"title": "باب الترقيق", "lines": [{"n": 33, "a": "فرققن مستفلا من أحرف", "b": "وحاذرن تفخيم لفظ الألف"}]}, {"title": "باب استعمال الحروف", "lines": [{"n": 34, "a": "وهمز الحمد أعوذ اهدنا", "b": "ألله ثم لام لله لنا"}, {"n": 35, "a": "وليتلطف وعلى الله ولا الض", "b": "والميم من مخمصة ومن مرض"}, {"n": 36, "a": "وباء برق باطل بهم بذي", "b": "فاحرص على الشدة والجهر الذي"}, {"n": 37, "a": "فيها وفي الجيم كحب الصبر", "b": "ربوة اجتثت وحج الفجر"}, {"n": 38, "a": "وبينن مقلقلا إن سكنا", "b": "وإن يكن في الوقف كان أبينا"}, {"n": 39, "a": "وحاء حصحص أحطت الحق", "b": "وسين مستقيم يسطوا يسقوا"}]}, {"title": "باب الراءات", "lines": [{"n": 40, "a": "ورقق الراء إذا ما كسرت", "b": "كذاك بعد الكسر حيث سكنت"}, {"n": 41, "a": "إن لم تكن من قبل حرف استعلا", "b": "أو كانت الكسرة ليست أصلا"}, {"n": 42, "a": "والخلف في فرق لكسر يوجد", "b": "وأخف تكريرا إذا تشدد"}]}, {"title": "باب اللامات", "lines": [{"n": 43, "a": "وفخم اللام من اسم الله", "b": "عن فتح اوضم كعبد الله"}, {"n": 44, "a": "وحرف الاستعلاء فخم واخصصا", "b": "الاطباق أقوى نحو قال والعصا"}, {"n": 45, "a": "وبين الاطباق من أحطت مع", "b": "بسطت والخلف بنخلقكم وقع"}, {"n": 46, "a": "واحرص على السكون في جعلنا", "b": "أنعمت والمغضوب مع ضللنا"}, {"n": 47, "a": "وخلص انفتاح محذورا عسى", "b": "خوف اشتباهه بمحظورا عصى"}, {"n": 48, "a": "وراع شدة بكاف وبتا", "b": "كشرككم وتتوفى فتنتا"}, {"n": 49, "a": "وأولي مثل وجنس إن سكن", "b": "أدغم كقل رب وبل لا وأبن"}, {"n": 50, "a": "في يوم مع قالوا وهم وقل نعم", "b": "سبحه لا تزغ قلوب فالتقم"}]}, {"title": "باب الضاد والظاء", "lines": [{"n": 51, "a": "والضاد باستطالة ومخرج", "b": "ميز من الظاء وكلها تجي"}, {"n": 52, "a": "في الظعن ظل الظهر عظم الحفظ", "b": "أيقظ وانظر عظم ظهر اللفظ"}, {"n": 53, "a": "ظاهر لظى شواظ كظم ظلما", "b": "أغلظ ظلام ظفر انتظر ظما"}, {"n": 54, "a": "أظفر ظنا كيف جا وعظ سوى", "b": "عضين ظل النحل زخرف سوا"}, {"n": 55, "a": "فظلت ظلتم وبروم ظلوا", "b": "كالحجر ظلت شعرا نظل"}, {"n": 56, "a": "يظللن محظورا مع المحتظر", "b": "وكنت فظا وجميع النظر"}, {"n": 57, "a": "إلا بويل وهل وأولى ناضره", "b": "والغيظ لا الرعد وهود قاصره"}, {"n": 58, "a": "والحظ لا الحض على الطعام", "b": "وفي ضنين الخلاف سامي"}, {"n": 59, "a": "وإن تلاقيا البيان لازم", "b": "أنقض ظهرك يعض الظالم"}, {"n": 60, "a": "واضطر مع وعظت مع أفضتم", "b": "وصف ها جباههم عليهم"}, {"n": 61, "a": "وأظهر الغنة من نون", "b": "ومن ميم إذا ما شددا وأخفين"}, {"n": 62, "a": "الميم إن تسكن بغنة عند الباء", "b": "على المختار من أهل الأداء"}, {"n": 63, "a": "وأظهرنها عند باقي الأحرف", "b": "واحذر لدى واو وفا أن تختفي"}]}, {"title": "باب النون الساكنة والتنوين", "lines": [{"n": 64, "a": "وحكم تنوين ونون يلفى", "b": "اظهار ادغام وقلب إخفا"}, {"n": 65, "a": "فعند حرف الحلق أظهر وادغم", "b": "في اللام والرا لا بغنة لزم"}, {"n": 66, "a": "وأدغمن بغنة في يومن", "b": "إلا بكلمة كدنيا عنونوا"}, {"n": 67, "a": "والقلب عند البا بغنة كذا", "b": "إخفا لدى باقي الحروف أخذا"}]}, {"title": "باب المد والقصر", "lines": [{"n": 68, "a": "والمد لازم وواجب أتى", "b": "وجائز وهو وقصر ثبتا"}, {"n": 69, "a": "فلازم إن جاء بعد حرف مد", "b": "ساكن حالين وبالطول يمد"}, {"n": 70, "a": "وواجب إن جاء قبل همزة", "b": "متصلا إن جمعا بكلمة"}, {"n": 71, "a": "وجائز إذا أتى منفصلا", "b": "أو عرض السكون وقفا مسجلا"}]}, {"title": "باب الوقف على أواخر الكلم", "lines": [{"n": 72, "a": "وبعد تجويدك للحروف", "b": "لا بد من معرفة الوقوف"}, {"n": 73, "a": "والابتداء وهي تنقسم إذن", "b": "ثلاثة تام وكاف وحسن"}, {"n": 74, "a": "وهي لما تم فإن لم يوجد", "b": "تعلق أوكان معنى فابتدي"}, {"n": 75, "a": "فالتام فالكافي ولفظا فامنعن", "b": "إلا رؤوس الآي جوز فالحسن"}, {"n": 76, "a": "وغير ما تم قبيح وله", "b": "يوقف مضطرا ويبدا قبله"}, {"n": 77, "a": "وليس في القرآن من وقف وجب", "b": "ولا حرام غير ما له سبب"}]}, {"title": "باب المقطوع والموصول والتاء", "lines": [{"n": 78, "a": "واعرف لمقطوع وموصول وتا", "b": "في مصحف الإمام فيما قد أتى"}, {"n": 79, "a": "فاقطع بعشر كلمات أن لا", "b": "مع ملجأ ولا إله إلا"}, {"n": 80, "a": "وتعبدوا ياسين ثاني هود لا", "b": "يشركن تشرك يدخلن تعلوا على"}, {"n": 81, "a": "أن لا يقولوا لا إله إن ما", "b": "بالرعد كالمفتوح صل وعن ما"}, {"n": 82, "a": "نهوا اقطعوا من ما بروم والنسا", "b": "خلف المنافقين أم من أسسا"}, {"n": 83, "a": "فصلت النسا وذبح حيث ما", "b": "وأن لم المفتوح كسر إن ما"}, {"n": 84, "a": "الانعام والمفتوح يدعون معا", "b": "وخلف الانفال ونحل وقعا"}, {"n": 85, "a": "وكل ما سألتموه واختلف", "b": "ردوا كذا قل بئسما والوصل صف"}, {"n": 86, "a": "خلفتموني واشتروا في ما", "b": "اقطعا أوحي أفضتم اشتهت نبلوا معا"}, {"n": 87, "a": "ثاني فعلن وقعت روم كلا", "b": "تنزيل شعراء وغيرها صلا"}, {"n": 88, "a": "فأينما كالنحل صل ومختلف", "b": "في الشعرا الاحزاب والنسا وصف"}, {"n": 89, "a": "وصل فإلم هود ألن نجعلا", "b": "نجمع كيلا تحزنوا تأسوا على"}, {"n": 90, "a": "حج عليك حرج وقطعهم", "b": "عن من يشاء من تولى يوم هم"}, {"n": 91, "a": "ومال هذا والذين هؤلا", "b": "تحين في الإمام وصلا وقيل لا"}, {"n": 92, "a": "كالوهم أو وزنوهم صل", "b": "كذا من أل ويا وها لا تفصل"}]}, {"title": "باب هاء الـتأنيث التي رسمت تاء", "lines": [{"n": 93, "a": "ورحمتا الزخرف بالتا زبره", "b": "الاعراف روم هود كاف البقرة"}, {"n": 94, "a": "نعمتها ثلاث نحل ابرهم", "b": "معا أخيرات عقود الثان هم"}, {"n": 95, "a": "لقمان ثم فاطر كالطور", "b": "عمران لعنت بها والنور"}, {"n": 96, "a": "وامرأت يوسف عمران القصص", "b": "تحريم معصيت بقد سمع يخص"}, {"n": 97, "a": "شجرت الدخان سنت فاطر", "b": "كلا والانفال وحرف غافر"}, {"n": 98, "a": "قرت عين جنت في وقعت", "b": "فطرت بقيت وابنت وكلمت"}, {"n": 99, "a": "أوسط الأعراف وكل مااختلف", "b": "جمعا وفردا فيه بالتاء عرف"}]}, {"title": "باب همز الوصل", "lines": [{"n": 100, "a": "وابدأ بهمز الوصل من فعل بضم", "b": "إن كان ثالث من الفعل يضم"}, {"n": 101, "a": "واكسره حال الكسر والفتح وفي", "b": "الاسماء غير اللام كسرها وفي"}, {"n": 102, "a": "ابن مع ابنة امرئ واثنين", "b": "وامرأة واسم مع اثنتين"}, {"n": 103, "a": "وحاذر الوقف بكل الحركة", "b": "إلا إذا رمت فبعض حركة"}, {"n": 104, "a": "إلا بفتح أو بنصب وأشم", "b": "إشارة بالضم في رفع وضم"}]}, {"title": "خاتمة", "lines": [{"n": 105, "a": "وقد تقضى نظمي المقدمة", "b": "مني لقارئ القرآن تقدمة"}, {"n": 106, "a": "والحمد لله لها ختام", "b": "ثم الصلاة بعد والسلام"}, {"n": 107, "a": "على النبي المصطفى محمدا", "b": "وآله وصحبه ذوي الهدى"}, {"n": 108, "a": "أبياتها قاف وزاي بالعدد", "b": "من يحسن التجويد يظفر بالرشد"}]}]}]